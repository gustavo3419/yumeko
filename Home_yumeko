rotocol || '').toUpperCase() + ' · ' + (item.security || '') + '|' + (item.selected ? 'selected' : ''); }\n  });\n\n  syncSheetUI(type);\n  renderSheetList(type);\n}\n\n// Sincroniza abas (Todos/Favoritos) e o campo de busca com o estado atual do sheet\nfunction syncSheetUI(type) {\n  var st = sheetState[type];\n  if (!st) return;\n  var tabs = document.querySelectorAll('#sheet-' + type + ' .sheet-tab');\n  tabs.forEach(function(t) { t.classList.toggle('active', t.getAttribute('data-filter') === st.filter); });\n  var input = document.getElementById(type + '-search');\n  if (input) input.value = st.search || '';\n}\n\nfunction isVipItem(i) { return ((i && i.plan) || 'free').trim().toLowerCase() === 'vip'; }\nfunction hasSavedCreds() {\n  var c = bp(B && B.getManualCredentials ? B.getManualCredentials() : '{}', {});\n  return !!((c.username && c.username !== '••••') || (c.password && c.password !== '••••'));\n}\nfunction setSheetFilter(type, filter) {\n  if (!sheetState[type]) return;\n  sheetState[type].filter = filter;\n  syncSheetUI(type);\n  renderSheetList(type);\n}\n\nfunction filterSheetList(type) {\n  if (!sheetState[type]) return;\n  var input = document.getElementById(type + '-search');\n  sheetState[type].search = input ? input.value.trim().toLowerCase() : '';\n  renderSheetList(type);\n}\n\nfunction renderSheetList(type) {\n  var st = sheetState[type];\n  if (!st) return;\n  var items = st.items || [];\n  if (st.filter === 'fav') items = items.filter(function(i) { return isFavorite(i.id); });\n  else if (st.filter === 'vip') items = items.filter(function(i) { return isVipItem(i); });\n  else if (st.filter === 'free') items = items.filter(function(i) { return !isVipItem(i); });\n  if (st.search) {\n    var q = st.search;\n    items = items.filter(function(i) {\n      var hay = [i.name, i.operator, i.country, i.protocol, i.method, i.networkType, i.security].filter(Boolean).join(' ').toLowerCase();\n      return hay.indexOf(q) !== -1;\n    });\n  }\n  buildList(type + '-list', items, st.onSelect, st.getInfo, type);\n}\n\nfunction buildList(containerId, items, onSelect, getInfo, type) {\n  var el = document.getElementById(containerId);\n  el.innerHTML = '';\n  if (!items.length) { el.innerHTML = '<div style=\"padding:36px 20px;text-align:center;color:var(--muted2);font-size:12px;\">Nenhum item encontrado</div>'; return; }\n  var sorted = items.slice().sort(function(a, b) { return (isFavorite(b.id)?1:0) - (isFavorite(a.id)?1:0); });\n  var badgeMap = { ssh: 'PROXY', payload: 'PAYLOAD', xray: 'XRAY' };\n  // Fonte única de seleção: pega o PRIMEIRO item que o backend reportar como\n  // selected (na ordem original, antes de reordenar por favorito) e só ELE\n  // (por referência de objeto, não por id) pode ficar marcado. Usar o id\n  // pra comparar não é seguro: se o backend mandar dois itens com o MESMO\n  // id (ex.: dois perfis \"Freedom/None\" com id vazio/duplicado), os dois\n  // ficavam marcados como selecionado ao mesmo tempo. Comparando o objeto\n  // em si, só a entrada exata que veio com selected:true acende.\n  var trueSelectedItem = null;\n  for (var i = 0; i < items.length; i++) {\n    var infoI = getInfo(items[i]).split('|');\n    if (infoI[2] === 'selected') { trueSelectedItem = items[i]; break; }\n  }\n  sorted.forEach(function(item) {\n    var info = getInfo(item).split('|');\n    var selected = item === trueSelectedItem;\n    var div = document.createElement('div');\n    div.className = 'sheet-item' + (selected ? ' selected' : '');\n    var flagUrl = getItemFlagUrl(item);\n    var iconHtml = '';\n    if (flagUrl) {\n      iconHtml = '<img class=\"flag\" src=\"' + flagUrl + '\" alt=\"flag\">';\n    } else {\n      var emojiMap = { ssh: '🖥️', payload: '📦', xray: '⚡' };\n      iconHtml = emojiMap[type] || '📡';\n    }\n    var badgeLabel = selected ? '✓ Selecionado' : (badgeMap[type] || '');\n    div.innerHTML = '<div class=\"sheet-item-icon\">' + iconHtml + '</div>'\n      + '<div class=\"sheet-item-meta\">