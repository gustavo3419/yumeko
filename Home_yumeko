reds-field-icon\">🔑<\/span>\n          <input id=\"creds-pass-display\" type=\"password\" placeholder=\"Senha\" readonly>\n        <\/div>\n      <\/div>\n\n      <!-- Action Row -->\n      <div class=\"action-row\">\n        <button class=\"action-pill\" onclick=\"openMethodModal()\">\n          <span class=\"ap-icon\">🛡️<\/span>\n          <span>Método<\/span>\n        <\/button>\n        <button class=\"action-pill\" onclick=\"openCredsModal()\">\n          <span class=\"ap-icon\">🔐<\/span>\n          <span>Credenciais<\/span>\n        <\/button>\n        <button class=\"action-pill\" onclick=\"copyConfig()\">\n          <span class=\"ap-icon\">📋<\/span>\n          <span>Copiar<\/span>\n        <\/button>\n      <\/div>\n\n      <!-- Branding -->\n      <div class=\"branding-wrap\">\n        <div class=\"branding-text\">@gustavovpn<\/div>\n      <\/div>\n\n      <div class=\"version-row\" id=\"version-row\">MOTO GARAGE VPN<\/div>\n\n    <\/div>\n  <\/div><!-- \/page-home -->\n\n  <!-- ══ SERVERS PAGE ══ -->\n  <div class=\"page\" id=\"page-servers\">\n    <div class=\"page-header\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"\/><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"\/><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"\/><\/svg>\n      <span class=\"page-title\">Servidores<\/span>\n    <\/div>\n    <div class=\"server-list-wrap\" id=\"server-list\">\n      <div style=\"text-align:center;padding:40px 0;color:var(--muted);font-size:13px;\">\n        Nenhum servidor disponível\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- ══ SPEED PAGE ══ -->\n  <div class=\"page\" id=\"page-speed\">\n    <div class=\"page-header\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"\/><\/svg>\n      <span class=\"page-title\">Velocidade<\/span>\n    <\/div>\n    <div class=\"speed-page-body\">\n      <div class=\"speed-cards-row\">\n        <div class=\"speed-big-card\">\n          <div class=\"speed-big-label\">Download<\/div>\n          <div class=\"speed-big-val speed-dl\" id=\"speed-big-dl\">0.00<\/div>\n          <div class=\"speed-big-unit\">MB\/s<\/div>\n        <\/div>\n        <div class=\"speed-big-card\">\n          <div class=\"speed-big-label\">Upload<\/div>\n          <div class=\"speed-big-val speed-ul\" id=\"speed-big-ul\">0.00<\/div>\n          <div class=\"speed-big-unit\">MB\/s<\/div>\n        <\/div>\n      <\/div>\n      <div class=\"speed-big-card\" style=\"text-align:left;padding:16px 20px;\">\n        <div class=\"speed-big-label\" style=\"margin-bottom:12px;\">Detalhes<\/div>\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;\">\n          <div><div style=\"font-size:10px;color:var(--muted);font-weight:700;font-family:'Share Tech Mono',monospace;\">Ping<\/div><div style=\"font-size:22px;font-weight:400;color:var(--green);font-family:'Bebas Neue',sans-serif;letter-spacing:.05em;\" id=\"speed-ping\">— ms<\/div><\/div>\n          <div><div style=\"font-size:10px;color:var(--muted);font-weight:700;font-family:'Share Tech Mono',monospace;\">Jitter<\/div><div style=\"font-size:22px;font-weight:400;color:var(--amber);font-family:'Bebas Neue',sans-serif;letter-spacing:.05em;\" id=\"speed-jitter\">— ms<\/div><\/div>\n          <div><div style=\"font-size:10px;color:var(--muted);font-weight:700;font-family:'Share Tech Mono',monospace;\">Total DL<\/div><div style=\"font-size:22px;font-weight:400;color:var(--blue2);font-family:'Bebas Neue',sans-serif;letter-spacing:.05em;\" id=\"speed-total-dl\">0 MB<\/div><\/div>\n          <div><div style=\"font-size:10px;color:var(--muted);font-weight:700;font-family:'Share Tech Mono',monospace;\">Total UL<\/div><div style=\"font-size:22px;font-weight:400;color:var(--blue2);font-family:'Bebas Neue',sans-serif;letter-spacing:.05em;\" id=\"speed-total-ul\">0 MB<\/div><\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- ══ TOOLS PAGE ══ -->\n  <div class=\"page\" id=\"page-tools\">\n    <div class=\"page-header\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"\/><\/svg>\n      <span class=\"page-title\">Ferramentas<\/span>\n    <\/div>\n    <div class=\"tools-body\">\n      <button class=\"tool-btn\" onclick=\"toolPing()\">\n        <div class=\"tool-btn-icon\">📡<\/div>\n        <div class=\"tool-btn-text\">\n          <div class=\"tool-btn-title\">Teste de Ping<\/div>\n          <div class=\"tool-btn-sub\">Verificar latência da conexão<\/div>\n        <\/div>\n        <div class=\"tool-btn-chev\">›<\/div>\n      <\/button>\n      <button class=\"tool-btn\" onclick=\"toolDNS()\">\n        <div class=\"tool-btn-icon\">🔍<\/div>\n        <div class=\"tool-btn-text\">\n          <div class=\"tool-btn-title\">Consulta DNS<\/div>\n          <div class=\"tool-btn-sub\">Resolver endereços de domínio<\/div>\n        <\/div>\n        <div class=\"tool-btn-chev\">›<\/div>\n      <\/button>\n      <button class=\"tool-btn\" onclick=\"toolPort()\">\n        <div class=\"tool-btn-icon\">🚪<\/div>\n        <div class=\"tool-btn-text\">\n          <div class=\"tool-btn-title\">Verificar Porta<\/div>\n          <div class=\"tool-btn-sub\">Testar acessibilidade de portas<\/div>\n        <\/div>\n        <div class=\"tool-btn-chev\">›<\/div>\n      <\/button>\n      <button class=\"tool-btn\" onclick=\"showLogs()\">\n        <div class=\"tool-btn-icon\">📋<\/div>\n        <div class=\"tool-btn-text\">\n          <div class=\"tool-btn-title\">Logs do Sistema<\/div>\n          <div class=\"tool-btn-sub\">Visualizar registros de conexão<\/div>\n        <\/div>\n        <div class=\"tool-btn-chev\">›<\/div>\n      <\/button>\n    <\/div>\n  <\/div>\n\n  <!-- Bottom Nav -->\n  <nav class=\"bottom-nav\">\n    <button class=\"nav-btn active\" id=\"nav-home\" onclick=\"showPage('home',this)\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"\/><polyline points=\"9 22 9 12 15 12 15 22\"\/><\/svg>\n      Início\n    <\/button>\n    <button class=\"nav-btn\" id=\"nav-servers\" onclick=\"showPage('servers',this)\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"\/><rect x=\"2\" y=\"14\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"\/><line x1=\"6\" y1=\"6\" x2=\"6.01\" y2=\"6\"\/><line x1=\"6\" y1=\"18\" x2=\"6.01\" y2=\"18\"\/><\/svg>\n      Servidores\n    <\/button>\n    <button class=\"nav-btn\" id=\"nav-speed\" onclick=\"showPage('speed',this)\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"\/><\/svg>\n      Velocidade\n    <\/button>\n    <button class=\"nav-btn\" id=\"nav-tools\" onclick=\"showPage('tools',this)\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"\/><path d=\"M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14\"\/><\/svg>\n      Ferramentas\n    <\/button>\n  <\/nav>\n<\/div><!-- \/app-shell -->\n\n<!-- ══ METHOD MODAL ══ -->\n<div class=\"modal-mask\" id=\"method-modal-mask\" onclick=\"closeMethodModal(event)\">\n  <div class=\"modal-box active method-modal-box\">\n    <div class=\"method-modal-head\">\n      <span class=\"method-modal-title\">Método VPN<\/span>\n      <button class=\"method-close-btn\" onclick=\"closeMethodModal()\">FECHAR<\/button>\n    <\/div>\n    <div class=\"method-modal-sub\">Selecione o protocolo de conexão<\/div>\n    <div class=\"method-list\" id=\"method-list\">\n      <!-- populated by JS -->\n    <\/div>\n  <\/div>\n<\/div>\n\n<!-- ══ CREDS MODAL ══ -->\n<div class=\"modal-mask\" id=\"creds-modal-mask\" onclick=\"closeCredsModal(event)\">\n  <div class=\"modal-box active creds-modal-box\">\n    <div class=\"creds-modal-head\">\n      <span class=\"creds-modal-title\">Credenciais<\/span>\n      <button class=\"icon-btn\" onclick=\"closeCredsModal()\">✕<\/button>\n    <\/div>\n    <div class=\"creds-modal-sub\">Configure usuário e senha para autenticação<\/div>\n    <div class=\"creds-modal-body\">\n      <div class=\"creds-section-title\">Usuário<\/div>\n      <div class=\"creds-input-wrap\">\n        <span class=\"ci-icon\">👤<\/span>\n        <input id=\"creds-user-input\" placeholder=\"Digite o usuário\" type=\"text\" autocomplete=\"username\">\n      <\/div>\n      <div class=\"creds-section-title\">Senha<\/div>\n      <div class=\"creds-input-wrap\">\n        <span class=\"ci-icon\">🔑<\/span>\n        <input id=\"creds-pass-input\" placeholder=\"Digite a senha\" type=\"password\" autocomplete=\"current-password\">\n        <button class=\"ci-eye\" onclick=\"togglePassVis()\">👁<\/button>\n      <\/div>\n      <div class=\"creds-section-title\">UUID \/ Chave<\/div>\n      <div class=\"creds-input-wrap\">\n        <span class=\"ci-icon\">🔐<\/span>\n        <input id=\"creds-uuid-input\" placeholder=\"UUID opcional\" type=\"text\">\n      <\/div>\n    <\/div>\n    <div class=\"creds-modal-footer\">\n      <button class=\"creds-cancel-btn\" onclick=\"closeCredsModal()\">Cancelar<\/button>\n      <button class=\"creds-save-btn\" onclick=\"saveCreds()\">Salvar<\/button>\n    <\/div>\n  <\/div>\n<\/div>\n\n<!-- ══ LOGS MODAL ══ -->\n<div class=\"modal-mask\" id=\"logs-modal-mask\" onclick=\"closeLogsModal(event)\">\n  <div class=\"modal-box active\" style=\"background:#0d0a07;border-color:rgba(255,106,0,.3);max-height:85vh;\">\n    <div class=\"modal-head\">\n      <span class=\"modal-title\">Logs do Sistema<\/span>\n      <button class=\"icon-btn\" onclick=\"closeLogsModal()\">✕<\/button>\n    <\/div>\n    <div class=\"modal-body\">\n      <div class=\"logs-toolbar\">\n        <button class=\"log-action-btn\" onclick=\"copyLogs()\">Copiar<\/button>\n        <button class=\"log-action-btn danger\" onclick=\"clearLogs()\">Limpar<\/button>\n      <\/div>\n      <div id=\"log-container\"><\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<!-- Toast -->\n<div class=\"toast-box\"><div class=\"toast\" id=\"toast\"><\/div><\/div>\n\n<script>\n\/\/ ─── STATE ───────────────────────────────────────────────────────────────────\nvar vpnState = 'disconnected';\nvar currentMethod = null;\nvar connectionTimer = null;\nvar connectionSeconds = 0;\nvar totalDL = 0, totalUL = 0;\nvar logs = [];\nvar userData = {};\nvar methods = [];\n\nvar DEFAULT_METHODS = [\n  {id:'v2ray',  name:'V2Ray',   sub:'VMess \/ VLESS',   icon:'🚀'},\n  {id:'ssh',    name:'SSH',     sub:'Secure Shell',     icon:'🖥️'},\n  {id:'trojan', name:'Trojan',  sub:'TLS Obfuscation',  icon:'🛡️'},\n  {id:'sstp',   name:'SSTP',    sub:'SSL\/HTTPS',        icon:'🔒'},\n  {id:'socks5', name:'SOCKS5',  sub:'Proxy tunnel',     icon:'🔗'}\n];\n\n\/\/ ─── ANDROID BRIDGE ──────────────────────────────────────────────────────────\nvar Android = (function(){\n  var w = window;\n  return w.Android || w.vpnBridge || w.AndroidBridge || {\n    connect:      function(d){ addLog('Conectando: '+d,'DEBUG'); },\n    disconnect:   function(){ addLog('Desconectando','DEBUG'); },\n    getServers:   function(){ return '[]'; },\n    getMethods:   function(){ return '[]'; },\n    installUpdate:function(){ addLog('Instalando atualização','INFO'); },\n    openUrl:      function(u){ try{window.open(u);}catch(e){} },\n    copyText:     function(t){ try{navigator.clipboard.writeText(t);}catch(e){} },\n    showAd:       function(){ addLog('Exibindo anúncio','INFO'); },\n    getCredentials: function(){ return '{}'; },\n    saveCredentials:function(d){ addLog('Credenciais salvas','INFO'); },\n    checkPing:    function(){ addLog('Verificando ping','DEBUG'); },\n    checkDNS:     function(){ addLog('Consultando DNS','DEBUG'); },\n    checkPort:    function(){ addLog('Verificando porta','DEBUG'); }\n  };\n})();\n\n\/\/ ─── CALLBACKS FROM ANDROID ──────────────────────────────────────────────────\nfunction onVpnStatus(status){\n  var s = (status||'').toLowerCase();\n  if(s==='connected'||s==='conectado')     setVpnState('connected');\n  else if(s==='connecting'||s==='conectando') setVpnState('connecting');\n  else if(s==='disconnected'||s==='desconectado') setVpnState('disconnected');\n  else if(s==='error'||s==='erro')         setVpnState('error');\n}\n\nfunction onSpeedUpdate(dl, ul){\n  var d=parseFloat(dl)||0, u=parseFloat(ul)||0;\n  totalDL+=d\/10; totalUL+=u\/10;\n  setEl('speed-dl',    d.toFixed(2));\n  setEl('speed-ul',    u.toFixed(2));\n  setEl('speed-big-dl',d.toFixed(2));\n  setEl('speed-big-ul',u.toFixed(2));\n  setEl('speed-total-dl', fmtBytes(totalDL));\n  setEl('speed-total-ul', fmtBytes(totalUL));\n}\n\nfunction onUserData(jsonStr){\n  try{\n    userData = JSON.parse(jsonStr);\n    updateUserCard();\n  }catch(e){ addLog('Erro ao processar dados do usuário: '+e,'ERROR'); }\n}\n\nfunction onPingResult(ping, jitter){\n  setEl('speed-ping', (parseInt(ping)||0)+' ms');\n  setEl('speed-jitter',(parseInt(jitter)||0)+' ms');\n}\n\nfunction onVersionInfo(current, newVer, hasUpdate){\n  if(current){ setEl('lbl-version-current','V. '+current); }\n  if(hasUpdate && newVer){\n    setEl('lbl-version-new','V. '+newVer);\n    show('btn-new-version');\n    showClass('btn-install-update','show');\n  }\n}\n\nfunction onMessage(text){\n  if(!text) return;\n  setEl('msg-text', text);\n  showClass('message-card','show');\n}\n\nfunction onLoadServers(jsonStr){\n  try{\n    var srvs = JSON.parse(jsonStr);\n    renderServerList(srvs);\n  }catch(e){ addLog('Erro ao carregar servidores: '+e,'ERROR'); }\n}\n\nfunction onLoadMethods(jsonStr){\n  try{\n    methods = JSON.parse(jsonStr);\n    if(!methods||!methods.length) methods = DEFAULT_METHODS;\n    renderMethodList();\n  }catch(e){ methods = DEFAULT_METHODS; renderMethodList(); }\n}\n\nfunction onTimeUpdate(seconds, maxSeconds){\n  var s=parseInt(seconds)||0, m=parseInt(maxSeconds)||1800;\n  var mm=Math.floor(s\/60), ss=s%60;\n  setEl('time-remaining', pad(mm)+':'+pad(ss));\n  var pct=Math.max(0,Math.min(100,(s\/m)*100));\n  var el=document.getElementById('time-bar-fill');\n  if(el) el.style.width=pct+'%';\n  showClass('time-card','show');\n}\n\n\/\/ ─── VPN CONTROL ─────────────────────────────────────────────────────────────\nfunction toggleVPN(){\n  if(vpnState==='disconnected'||vpnState==='error') startConnect();\n  else if(vpnState==='connected') disconnect();\n}\n\nfunction startConnect(){\n  setVpnState('connecting');\n  addLog('Iniciando conexão...','INFO');\n  try{ Android.connect(JSON.stringify({method:currentMethod})); }catch(e){ addLog('Erro ao conectar: '+e,'ERROR'); }\n}\n\nfunction disconnect(){\n  setVpnState('disconnected');\n  addLog('Conexão encerrada pelo usuário','INFO');\n  try{ Android.disconnect(); }catch(e){}\n}\n\nfunction setVpnState(state){\n  vpnState = state;\n  document.body.className = '';\n  var title = document.getElementById('status-title');\n  var speedRow = document.getElementById('speed-row');\n\n  if(state==='connected'){\n    document.body.classList.add('st-conectado');\n    title.textContent = 'CONEXÃO ESTABELECIDA';\n    startTimer();\n    if(speedRow) speedRow.style.display='grid';\n    showClass('timer-bar','show');\n    addLog('VPN conectada com sucesso','INFO');\n  } else if(state==='connecting'){\n    document.body.classList.add('st-conectando');\n    title.textContent = 'CONECTANDO...';\n    stopTimer();\n    if(speedRow) speedRow.style.display='none';\n  } else if(state==='error'){\n    document.body.classList.add('st-erro');\n    title.textContent = 'ERRO DE CONEXÃO';\n    stopTimer();\n    if(speedRow) speedRow.style.display='none';\n    hideClass('timer-bar','show');\n    addLog('Erro na conexão VPN','ERROR');\n    showToast('Falha ao conectar','err');\n  } else {\n    title.textContent = 'DESCONECTADO';\n    stopTimer();\n    if(speedRow) speedRow.style.display='none';\n    hideClass('timer-bar','show');\n    totalDL=0;totalUL=0;\n    setEl('speed-dl','0.00');setEl('speed-ul','0.00');\n    setEl('speed-big-dl','0.00');setEl('speed-big-ul','0.00');\n  }\n}\n\n\/\/ ─── TIMER ───────────────────────────────────────────────────────────────────\nfunction startTimer(){\n  stopTimer();\n  connectionSeconds=0;\n  connectionTimer=setInterval(function(){\n    connectionSeconds++;\n    var h=Math.floor(connectionSeconds\/3600);\n    var m=Math.floor((connectionSeconds%3600)\/60);\n    var s=connectionSeconds%60;\n    setEl('timer-val',pad(h)+':'+pad(m)+':'+pad(s));\n  },1000);\n}\nfunction stopTimer(){\n  if(connectionTimer){clearInterval(connectionTimer);connectionTimer=null;}\n  setEl('timer-val','00:00:00');\n}\n\n\/\/ ─── USER DATA CARD ───────────────────────────────────────────────────────────\nfunction updateUserCard(){\n  var d=userData;\n  if(!d||Object.keys(d).length===0) return;\n  setEl('cu-expiry', d.expiry||d.vencimento||'—');\n  setEl('cu-days',   d.days||d.dias||'—');\n  setEl('cu-limit',  d.limit||d.limite||'—');\n  setEl('cu-key',    d.key||d.chave||'—');\n  setEl('cu-adblock',d.adblock||d.bloqueio||'—');\n  showClass('checkuser-card','show');\n\n  var credUser=d.user||d.usuario||'';\n  var credPass=d.pass||d.senha||'';\n  if(credUser){\n    var u=document.getElementById('creds-user-display');\n    var p=document.getElementById('creds-pass-display');\n    if(u) u.value=credUser;\n    if(p) p.value=credPass;\n    show('creds-block');\n  }\n}\n\n\/\/ ─── METHOD MODAL ─────────────────────────────────────────────────────────────\nfunction renderMethodList(){\n  var list=document.getElementById('method-list');\n  if(!list) return;\n  list.innerHTML='';\n  (methods.length?methods:DEFAULT_METHODS).forEach(function(m){\n    var active=(currentMethod&&currentMethod.id===m.id)||(!currentMethod&&m.id==='v2ray');\n    var el=document.createElement('div');\n    el.className='method-item'+(active?' active-method':'');\n    el.innerHTML='<div><div class=\"mi-title\">'+m.icon+' '+m.name+'<\/div><div class=\"mi-sub\">'+m.sub+'<\/div><\/div><span class=\"mi-badge\">ATIVO<\/span>';\n    el.onclick=function(){selectMethod(m);};\n    list.appendChild(el);\n  });\n}\n\nfunction selectMethod(m){\n  currentMethod=m;\n  var sc=document.getElementById('sc-title');\n  var si=document.getElementById('sc-icon');\n  if(sc) sc.textContent=m.name+(m.country?' - '+m.country:'');\n  if(si) si.textContent=m.icon||'🏍️';\n  renderMethodList();\n  closeMethodModal();\n  addLog('Método selecionado: '+m.name,'INFO');\n  if(vpnState==='connected'){disconnect();setTimeout(startConnect,600);}\n}\n\nfunction openMethodModal(){\n  renderMethodList();\n  document.getElementById('method-modal-mask').classList.add('show');\n}\nfunction closeMethodModal(e){\n  if(!e||e.target===document.getElementById('method-modal-mask'))\n    document.getElementById('method-modal-mask').classList.remove('show');\n}\n\n\/\/ ─── CREDS MODAL ─────────────────────────────────────────────────────────────\nfunction openCredsModal(){\n  try{\n    var d=JSON.parse(Android.getCredentials()||'{}');\n    var u=document.getElementById('creds-user-input');\n    var p=document.getElementById('creds-pass-input');\n    var uid=document.getElementById('creds-uuid-input');\n    if(u) u.value=d.user||d.usuario||'';\n    if(p) p.value=d.pass||d.senha||'';\n    if(uid) uid.value=d.uuid||d.key||'';\n  }catch(e){}\n  document.getElementById('creds-modal-mask').classList.add('show');\n}\nfunction closeCredsModal(e){\n  if(!e||e.target===document.getElementById('creds-modal-mask'))\n    document.getElementById('creds-modal-mask').classList.remove('show');\n}\nfunction saveCreds(){\n  var u=document.getElementById('creds-user-input').value.trim();\n  var p=document.getElementById('creds-pass-input').value;\n  var uuid=document.getElementById('creds-uuid-input').value.trim();\n  try{ Android.saveCredentials(JSON.stringify({user:u,pass:p,uuid:uuid})); }catch(e){}\n  var du=document.getElementById('creds-user-display');\n  var dp=document.getElementById('creds-pass-display');\n  if(du) du.value=u;\n  if(dp) dp.value=p;\n  if(u) show('creds-block');\n  closeCredsModal();\n  showToast('Credenciais salvas','ok');\n  addLog('Credenciais atualizadas','INFO');\n}\nfunction togglePassVis(){\n  var p=document.getElementById('creds-pass-input');\n  if(p) p.type=p.type==='password'?'text':'password';\n}\n\n\/\/ ─── LOGS MODAL ──────────────────────────────────────────────────────────────\nfunction showLogs(){\n  document.getElementById('logs-modal-mask').classList.add('show');\n}\nfunction closeLogsModal(e){\n  if(!e||e.target===document.getElementById('logs-modal-mask'))\n    document.getElementById('logs-modal-mask').classList.remove('show');\n}\nfunction copyLogs(){\n  var txt=logs.map(function(l){return l.time+' ['+l.type+'] '+l.msg;}).join('\\n');\n  try{ Android.copyText(txt); }catch(e){ navigator.clipboard&&navigator.clipboard.writeText(txt); }\n  showToast('Logs copiados','ok');\n}\nfunction clearLogs(){\n  logs=[];\n  var c=document.getElementById('log-container');\n  if(c) c.innerHTML='';\n}\n\nfunction addLog(msg, type){\n  type=type||'INFO';\n  var now=new Date();\n  var time=pad(now.getHours())+':'+pad(now.getMinutes())+':'+pad(now.getSeconds());\n  logs.push({time:time,msg:msg,type:type});\n  var c=document.getElementById('log-container');\n  if(c){\n    var e=document.createElement('div');\n    e.className='log-entry '+type;\n    e.innerHTML='<span class=\"log-time\">'+time+'<\/span><span class=\"log-msg\">'+escHtml(msg)+'<\/span>';\n    c.appendChild(e);\n    c.scrollTop=c.scrollHeight;\n  }\n}\n\n\/\/ ─── SERVER LIST ──────────────────────────────────────────────────────────────\nfunction renderServerList(srvs){\n  var list=document.getElementById('server-list');\n  if(!list) return;\n  if(!srvs||!srvs.length){\n    list.innerHTML='<div style=\"text-align:center;padding:40px 0;color:var(--muted);font-size:13px;\">Nenhum servidor disponível<\/div>';\n    return;\n  }\n  list.innerHTML=srvs.map(function(s,i){\n    return '<div class=\"list-item'+(i===0?' selected':'')+'\" onclick=\"selectServerFromList(\\''+escAttr(s.name)+'\\',\\''+escAttr(s.icon||s.flag||'🏍️')+'\\',\\''+escAttr(s.id||String(i))+'\\',this)\">'\n      +'<div class=\"li-icon\">'+(s.icon||s.flag||'🏍️')+'<\/div>'\n      +'<div class=\"li-main\"><div class=\"li-title\">'+escHtml(s.name)+'<\/div>'\n      +'<div class=\"li-sub\">'+(s.type||'V2Ray')+(s.ping?' · '+s.ping+' ms':'')+'<\/div><\/div>'\n      +'<span class=\"li-check\">✓<\/span>'\n      +'<\/div>';\n  }).join('');\n}\nfunction selectServerFromList(name,icon,id,el){\n  document.querySelectorAll('#server-list .list-item').forEach(function(x){x.classList.remove('selected');});\n  el.classList.add('selected');\n  var sm=currentMethod||{};\n  sm.serverName=name; sm.serverId=id;\n  currentMethod=sm;\n  setEl('sc-title',name);\n  setEl('sc-icon',icon);\n  showPage('home',document.getElementById('nav-home'));\n  addLog('Servidor selecionado: '+name,'INFO');\n  if(vpnState==='connected'){disconnect();setTimeout(startConnect,600);}\n}\n\n\/\/ ─── TOOLS ────────────────────────────────────────────────────────────────────\nfunction toolPing(){\n  showToast('Verificando ping...','');\n  addLog('Iniciando teste de ping','DEBUG');\n  try{ Android.checkPing(); }catch(e){ addLog('Ping não disponível','WARNING'); }\n}\nfunction toolDNS(){\n  showToast('Consultando DNS...','');\n  addLog('Iniciando consulta DNS','DEBUG');\n  try{ Android.checkDNS(); }catch(e){ addLog('DNS não disponível','WARNING'); }\n}\nfunction toolPort(){\n  showToast('Verificando porta...','');\n  addLog('Iniciando verificação de porta','DEBUG');\n  try{ Android.checkPort(); }catch(e){ addLog('Verificação não disponível','WARNING'); }\n}\n\n\/\/ ─── UPDATE ────────────────────────────────────────────────────────────────────\nfunction installUpdate(){\n  addLog('Solicitando instalação de atualização','INFO');\n  try{ Android.installUpdate(); }catch(e){ addLog('Erro ao instalar: '+e,'ERROR'); }\n}\n\n\/\/ ─── AD ────────────────────────────────────────────────────────────────────────\nfunction watchAd(){\n  var btn=document.getElementById('watch-ad-btn');\n  if(btn){ btn.disabled=true; btn.textContent='Carregando...'; }\n  addLog('Carregando anúncio','DEBUG');\n  try{\n    Android.showAd();\n  }catch(e){\n    if(btn){ btn.disabled=false; btn.textContent='▶ ASSISTIR ANÚNCIO (+30 MIN)'; }\n    addLog('Erro ao carregar anúncio','ERROR');\n  }\n}\nfunction onAdComplete(){\n  var btn=document.getElementById('watch-ad-btn');\n  if(btn){ btn.disabled=false; btn.textContent='▶ ASSISTIR ANÚNCIO (+30 MIN)'; }\n  showToast('+30 minutos adicionados','ok');\n  addLog('Anúncio concluído, tempo adicionado','INFO');\n}\n\n\/\/ ─── COPY CONFIG ───────────────────────────────────────────────────────────────\nfunction copyConfig(){\n  var cfg=JSON.stringify({method:currentMethod,user:document.getElementById('creds-user-input')&&document.getElementById('creds-user-input').value||''},null,2);\n  try{ Android.copyText(cfg); }catch(e){ navigator.clipboard&&navigator.clipboard.writeText(cfg); }\n  showToast('Configuração copiada','ok');\n}\n\n\/\/ ─── NAV ───────────────────────────────────────────────────────────────────────\nfunction showPage(name, btn){\n  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});\n  document.querySelectorAll('.nav-btn').forEach(function(b){b.classList.remove('active');});\n  var p=document.getElementById('page-'+name);\n  if(p) p.classList.add('active');\n  if(btn) btn.classList.add('active');\n}\n\n\/\/ ─── TOAST ─────────────────────────────────────────────────────────────────────\nfunction showToast(msg, type){\n  var t=document.getElementById('toast');\n  t.textContent=msg;\n  t.className='toast show'+(type?' '+type:'');\n  setTimeout(function(){t.className='toast';},2600);\n}\n\n\/\/ ─── HELPERS ───────────────────────────────────────────────────────────────────\nfunction setEl(id,val){ var e=document.getElementById(id); if(e) e.textContent=val; }\nfunction show(id){ var e=document.getElementById(id); if(e) e.style.display=''; }\nfunction hide(id){ var e=document.getElementById(id); if(e) e.style.display='none'; }\nfunction showClass(id,cls){ var e=document.getElementById(id); if(e) e.classList.add(cls); }\nfunction hideClass(id,cls){ var e=document.getElementById(id); if(e) e.classList.remove(cls); }\nfunction pad(n){ return n<10?'0'+n:String(n); }\nfunction fmtBytes(mb){\n  if(mb>=1024) return (mb\/1024).toFixed(1)+' GB';\n  return mb.toFixed(0)+' MB';\n}\nfunction escHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\nfunction escAttr(s){ return String(s).replace(/'/g,\"\\\\'\").replace(/\"/g,'&quot;'); }\n\n\/\/ ─── INIT ──────────────────────────────────────────────────────────────────────\ndocument.addEventListener('DOMContentLoaded', function(){\n  addLog('MOTO GARAGE VPN iniciado','INFO');\n  renderMethodList();\n\n  \/\/ Try loading servers\n  try{\n    var raw=Android.getMethods();\n    if(raw&&raw!=='[]') onLoadMethods(raw);\n  }catch(e){}\n  try{\n    var srvRaw=Android.getServers();\n    if(srvRaw&&srvRaw!=='[]') onLoadServers(srvRaw);\n  }catch(e){}\n\n  \/\/ Set default method display\n  var def=DEFAULT_METHODS[0];\n  setEl('sc-title', def.name);\n  setEl('sc-icon', def.icon);\n  currentMethod=def;\n});\n<\/script>\n<\/body>\n<\/html>@"
