ection: column; align-items: center; }\n.speedtest-panel.show { display: flex; }\n.gauge-wrap { position: relative; width: 150px; height: 84px; }\n.gauge-bg, .gauge-fill { position: absolute; top: 0; left: 0; width: 150px; height: 75px; border-radius: 150px 150px 0 0; }\n.gauge-bg { background: conic-gradient(from 270deg at 50% 100%, var(--red) 0deg, var(--yellow) 90deg, var(--green) 180deg); clip-path: polygon(0 100%, 0 30%, 4% 16%, 10% 8%, 50% 0%, 90% 8%, 96% 16%, 100% 30%, 100% 100%, 88% 100%, 88% 35%, 50% 14%, 12% 35%, 12% 100%); opacity: .25; }\n.gauge-needle { position: absolute; left: 50%; bottom: 0; width: 2px; height: 64px; background: var(--accent); transform-origin: bottom center; transform: rotate(-90deg); transition: transform .6s cubic-bezier(.34,1.56,.64,1); box-shadow: 0 0 8px rgba(0,232,255,.7); }\n.gauge-needle::after { content: ''; position: absolute; bottom: -5px; left: -4px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }\n.gauge-val { margin-top: 8px; font-family: var(--mono); font-size: 24px; font-weight: 800; color: var(--accent); }\n.gauge-unit { font-size: 11px; color: var(--muted2); letter-spacing: .08em; text-transform: uppercase; }\n.gauge-close { margin-top: 10px; font-size: 10px; color: var(--muted2); cursor: pointer; letter-spacing: .06em; text-transform: uppercase; }\n\n\n/* \u2500\u2500 PAINEL DE VELOCIDADE EM TEMPO REAL \u2500\u2500 */\n.speed-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.speed-card { padding: 12px 14px; }\n.speed-label { font-size: 9px; font-weight: 700; color: var(--muted2); text-transform: uppercase; letter-spacing: .12em; font-family: var(--mono); }\n.speed-val { font-size: 19px; font-weight: 800; margin-top: 5px; color: var(--text); font-family: var(--mono); }\n\n\n/* \u2500\u2500 CARDS \u2500\u2500 */\n.mode-row { display: flex; gap: 6px; padding: 6px; }\n.mode-btn { flex: 1; padding: 11px 8px; border: 1px solid transparent; font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted2); background: transparent; cursor: pointer; transition: all .25s; font-family: var(--sans); clip-path: polygon(6px 0, 100% 0, 100% 100%, calc(100% - 6px) 100%, 0 100%, 0 6px); }\n.mode-btn.active { background: rgba(0,232,255,.08); border-color: rgba(0,232,255,.35); color: var(--accent); }\n.mode-btn:active { opacity: .7; }\n\n.server-card { padding: 14px 16px 16px; display: flex; align-items: center; gap: 13px; cursor: pointer; transition: background .2s; }\n.server-card:active { background: rgba(255,255,255,.02); }\n.server-icon { width: 42px; height: 42px; background: rgba(0,232,255,.07); border: 1px solid var(--panel-border); display: grid; place-items: center; font-size: 19px; flex: 0 0 42px; position: relative; clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px)); }\n.server-icon .flag { display: block; width: 32px; height: 24px; object-fit: cover; border-radius: 2px; border: 1px solid rgba(255,255,255,.08); background: rgba(0,0,0,.2); }\n.server-meta { flex: 1; min-width: 0; }\n.server-label { font-size: 9px; font-weight: 800; color: var(--accent); letter-spacing: .14em; text-transform: uppercase; font-family: var(--mono); }\n.server-name { font-size: 15px; font-weight: 700; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.server-sub { font-size: 10.5px; color: var(--muted2); margin-top: 2px; text-transform: uppercase; letter-spacing: .06em; }\n.server-chev { color: var(--muted); font-size: 18px; flex: 0 0 auto; }\n\n.cred-label { font-size: 10.5px; font-weight: 700; color: var(--muted2); text-transform: uppercase; letter-spacing: .07em; margin: 10px 0 6px; }\n.cred-label:first-child { margin-top: 0; }\n.cred-input { width: 100%; background: rgba(0,0,0,.3); border: 1px solid var(--panel-border); padding: 11px 13px; color: var(--text); font-size: 13px; outline: none; font-family: var(--sans); }\n.cred-input::placehold