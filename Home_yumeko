nt); background: rgba(255,255,255,.03); animation: palette-pop .3s ease; }\n@keyframes palette-pop { 0% { transform: scale(1); } 40% { transform: scale(1.08); } 100% { transform: scale(1); } }\n.palette-circle { width: 40px; height: 40px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.15); position: relative; transition: box-shadow .2s; }\n.palette-item.selected .palette-circle { box-shadow: 0 0 0 3px rgba(255,255,255,.08), 0 0 16px rgba(0,232,255,.25); }\n.palette-circle .check { position: absolute; top: -4px; right: -4px; width: 15px; height: 15px; border-radius: 50%; background: var(--accent); color: #021015; font-size: 9px; display: flex; align-items: center; justify-content: center; opacity: 0; }\n.palette-item.selected .check { opacity: 1; }\n.palette-label { font-size: 10px; font-weight: 700; color: var(--muted2); }\n.palette-item.selected .palette-label { color: var(--text); }\n\n.bg-color-row { display: flex; align-items: center; gap: 10px; background: var(--panel); border: 1px solid var(--panel-border); padding: 12px 14px; }\n#bg-color-input { width: 42px; height: 42px; border: none; border-radius: 50%; padding: 0; background: none; cursor: pointer; box-shadow: 0 0 0 2px var(--accent), 0 0 14px rgba(0,232,255,.35); transition: box-shadow .2s; }\n#bg-color-input:active { box-shadow: 0 0 0 3px var(--accent), 0 0 20px rgba(0,232,255,.55); }\n#bg-color-input::-webkit-color-swatch-wrapper { padding: 2px; border-radius: 50%; }\n#bg-color-input::-webkit-color-swatch { border-radius: 50%; border: 2px solid rgba(255,255,255,0.35); }\n.bg-color-reset { background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); color: var(--muted2); font-size: 10.5px; font-weight: 700; padding: 8px 12px; cursor: pointer; }\n\n.diag-box { background: #020308; border: 1px solid var(--panel-border); padding: 12px 14px; font-family: var(--mono); font-size: 10px; color: var(--muted2); line-height: 1.6; white-space: pre-wrap; word-break: break-all; max-height: 220p