px; height: 36px; border-radius: 10px; background: var(--card2); border: 1px solid var(--border); display: grid; place-items: center; cursor: pointer; flex: 0 0 auto; }\n.header-refresh svg { width: 15px; height: 15px; color: var(--muted2); }\n.header-refresh.spinning svg { animation: spin 1s linear infinite; }\n@keyframes spin { to { transform: rotate(360deg); } }\n\n/* ── BODY ── */\n.body { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 14px 16px 10px; display: flex; flex-direction: column; gap: 11px; -webkit-overflow-scrolling: touch; }\n\n/* ── CARD BASE ── */\n.card { background: var(--card); border-radius: var(--r); border: 1px solid var(--border); }\n\n/* ── AVISO ── */\n.notice-card { display: none; padding: 14px 16px; flex-direction: row; align-items: flex-start; gap: 12px; border-color: rgba(245,158,11,.25); background: rgba(245,158,11,.07); }\n.notice-card.show { display: flex; }\n.notice-icon { font-size: 22px; }\n.notice-title { font-size: 11px; font-weight: 800; color: var(--yellow); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 3px; }\n.notice-msg { font-size: 12.5px; color: var(--text); opacity: .88; line-height: 1.5; }\n\n/* ── IP ── */\n.ip-card { padding: 14px 16px; display: flex; align-items: center; gap: 12px; }\n.ip-led { width: 8px; height: 8px; border-radius: 50%; background: var(--red); flex: 0 0 8px; }\nbody.connected .ip-led { background: var(--green); box-shadow: 0 0 8px rgba(34,197,94,.8); }\n.ip-info { flex: 1; min-width: 0; }\n.ip-value { font-size: 15px; font-weight: 700; color: var(--text); font-family: var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\nbody.connected .ip-value { color: var(--green); }\n.ip-sub { font-size: 10.5px; color: var(--muted2); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.ip-refresh-btn { font-size: 10px; color: var(--accent); font-weight: 700; cursor: pointer; flex: 0 0 auto; }\n\n/* ── HERO (orb