{"version": "158", "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<title>VB INJECTOR // SLATE</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root {\n  /* ── TEMA \"SLATE COPPER\" — tom único (cobre), fundo quente e vivo, sem misturar matizes diferentes ── */\n  --bg: #241c16;\n  --bg-soft: #2f251d;\n  --panel: rgba(255,255,255,.05);\n  --panel-border: rgba(255,255,255,.1);\n  --panel-border-strong: rgba(255,255,255,.17);\n  --accent: #cf8a4a;\n  --accent2: #8f5a26;\n  --green: #4ade80;\n  --yellow: #f5c451;\n  --red: #f2685e;\n  --text: #f3ece2;\n  --muted: #8c7a68;\n  --muted2: #bda98e;\n  --mono: 'IBM Plex Mono', monospace;\n  --sans: 'Outfit', sans-serif;\n}\n* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\nhtml, body { height: 100%; background: var(--bg); overflow: hidden; }\nbody { font-family: var(--sans); color: var(--text); }\n\n\n/* ── FUNDO: gradiente quente em tons de cobre sobre base grafite — mais vivo, sem sair do tom único ── */\n.mesh-bg {\n  position: fixed; inset: 0; z-index: 0; overflow: hidden;\n  background:\n    radial-gradient(115% 55% at 12% -8%, rgba(207,138,74,.4), transparent 62%),\n    radial-gradient(95% 65% at 100% 4%, rgba(143,90,38,.32), transparent 68%),\n    radial-gradient(130% 85% at 50% 118%, rgba(207,138,74,.22), transparent 72%),\n    linear-gradient(165deg, #2f241b 0%, #241b15 45%, #16110d 100%);\n}\n.mesh-bg::before {\n  content: ''; position: absolute; inset: 0; pointer-events: none;\n  background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px);\n  background-size: 22px 22px;\n  mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 20%, transparent 75%);\n}\n.rail { position: absolute; t