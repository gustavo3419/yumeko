{"version": "21", "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<title>VB INJECTOR</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Space+Grotesk:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n:root {\n  --bg: #0a0913;\n  --bg2: #0e0d1a;\n  --panel: #14121f;\n  --panel-border: rgba(255,255,255,.06);\n  --panel-border-strong: rgba(255,255,255,.1);\n  --accent: #8b6bff;\n  --accent2: #4fd1ff;\n  --green: #34d399;\n  --yellow: #fbbf24;\n  --red: #fb7185;\n  --text: #f3f1fb;\n  --muted: #55516e;\n  --muted2: #918caf;\n  --mono: 'JetBrains Mono', monospace;\n  --sans: 'Space Grotesk', sans-serif;\n  --display: 'Baloo 2', var(--sans);\n}\n* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\nhtml, body { height: 100%; background: var(--bg); overflow: hidden; }\nbody { font-family: var(--sans); color: var(--text); }\n\n\n/* ── FUNDO: LISO, SEM GRADE/SCANLINE — só um glow bem sutil ── */\n.mesh-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: var(--bg); }\n.mesh-bg::before {\n  content: ''; position: absolute; inset: 0; pointer-events: none;\n  background: radial-gradient(ellipse 60% 40% at 82% 8%, rgba(139,107,255,.16), transparent 60%),\n              radial-gradient(ellipse 55% 45% at 8% 95%, rgba(79,209,255,.09), transparent 60%);\n}\n.scanline { display: none; }\n.blob { position: absolute; border-radius: 50%; filter: blur(110px); will-change: transform; opacity: .22; }\n.blob1 { width: 280px; height: 280px; background: var(--accent); top: -90px; left: -80px; animation: drift1 24s ease-in-out infinite; }\n.blob2 { width: 260px; height: 260px; background: var(--accent2); bottom: -100px; right: -90px; opacity: .16; animation: drift2 28s ease-in-out infinite; }\n.blob3 { display: none; }\nbody.connected .blob2 { background: var(--green); opacity: .18; }\n@keyframes drift1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(24px,30px); } }\n@keyframes drift2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-26px,20px); } }\n\n.shell { position: relative; z-index: 1; width: 100%; max-width: 480px; margin: 0 auto; height: 100vh; display: flex; flex-direction: column; padding-top: var(--vb-inset-top, env(safe-area-inset-top)); padding-bottom: var(--vb-inset-bottom, env(safe-area-inset-bottom)); }\n\n\n/* ── PAINEL BASE: card sólido, discreto, sem blur ── */\n.panel {\n  background: var(--panel);\n  border: 1px solid var(--panel-border);\n  border-radius: 20px;\n  position: relative;\n}\n\n\n/* ── HEADER ── */\n.header { margin: 14px 14px 6px; padding: 0; display: flex; align-items: center; justify-content: space-between; gap: 10px; background: none; border: none; }\n.header-icon { width: 82px; height: 82px; flex: 0 0 82px; border-radius: 17px; background: none; display: grid; place-items: center; overflow: hidden; }\n.header-icon svg { width: 22px; height: 22px; color: #fff; }\n.header-left { min-width: 0; flex: 1; display: flex; align-items: center; gap: 11px; }\n.header-brand { font-size: 19px; font-weight: 700; font-family: var(--display); color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: .01em; }\n.header-meta { display: flex; align-items: center; gap: 6px; margin-top: 2px; flex-wrap: wrap; }\n.header-ver { font-size: 9px; color: var(--muted2); font-family: var(--mono); letter-spacing: .02em; }\n.net-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 9px; font-weight: 700; font-family: var(--mono); letter-spacing: .03em; color: var(--muted2); padding: 2px 7px; background: rgba(255,255,255,.04); border: 1px solid var(--panel-border); border-radius: 999px; }\n.net-badge .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--muted); }\n.net-badge.online .dot { background: var(--green); box-shadow: 0 0 6px rgba(52,211,153,.9); }\n.header-right { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }\n.btn-icon { width: 34px; height: 34px; background: var(--panel); border: 1px solid var(--panel-border); border-radius: 50%; display: grid; place-items: center; cursor: pointer; transition: all .2s; }\n.btn-icon:active { opacity: .6; transform: scale(.92); }\n.btn-icon svg { width: 15px; height: 15px; color: var(--muted2); }\n.btn-icon.spinning svg { animation: spin-slow 1s linear infinite; }\n\n\n/* ── BODY ── */\n.body { flex: 0 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 4px 10px 6px; display: flex; flex-direction: column; gap: 8px; -webkit-overflow-scrolling: touch; }\n\n\n/* ── AVISO ── */\n.notice-card { display: none; padding: 15px 16px; gap: 13px; align-items: flex-start; background: var(--panel); border-color: var(--panel-border); border-left: 3px solid var(--yellow); }\n.notice-card.show { display: flex; }\n.notice-icon { font-size: 24px; line-height: 1; }\n.notice-content { flex: 1; min-width: 0; }\n.notice-title { color: var(--text); font-weight: 800; font-size: 11px; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 5px; font-family: var(--mono); }\n.notice-msg { font-size: 12.5px; line-height: 1.5; color: var(--text); opacity: .9; }\n\n\n/* ── PAINEL DE IP (terminal) ── */\n.ip-panel { padding: 14px 16px; font-family: var(--mono); }\n.ip-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }\n.ip-panel-title { font-size: 9.5px; font-weight: 800; color: var(--muted2); letter-spacing: .14em; text-transform: uppercase; display: flex; align-items: center; gap: 6px; }\n.ip-panel-title .led { width: 6px; height: 6px; border-radius: 50%; background: var(--red); }\nbody.connected .ip-panel-title .led { background: var(--green); box-shadow: 0 0 6px rgba(57,255,136,.9); }\n.ip-refresh-btn { font-size: 9px; color: var(--text); cursor: pointer; letter-spacing: .06em; opacity: .8; }\n.ip-row { display: flex; align-items: baseline; gap: 8px; }\n.ip-value { font-size: 19px; font-weight: 700; color: var(--text); letter-spacing: .01em; transition: color .3s; }\nbody.connected .ip-value { color: var(--green); }\n.ip-loc { font-size: 11px; color: var(--muted2); }\n.ip-status-line { font-size: 9.5px; color: var(--muted); margin-top: 4px; letter-spacing: .04em; }\nbody.connected .ip-status-line { color: var(--green); }\n\n\n/* ── HERO DE CONEXÃO (compacto: sem círculo, status em texto no centro) ──\n   O círculo foi removido de propósito: já existe o botão grande\n   \"Conectar/Desconectar\" lá embaixo (#connect-btn) que faz exatamente a\n   mesma função, então o círculo era um controle duplicado e só ocupava\n   espaço. */\n.hero { padding: 22px 20px 18px; display: flex; flex-direction: column; align-items: center; position: relative; overflow: hidden; }\n\n.hero-icon { position: absolute; top: 14px; right: 16px; width: 46px; height: 46px; display: grid; place-items: center; opacity: .85; }\n.hero-icon svg { width: 40px; height: 40px; color: var(--muted); filter: drop-shadow(0 0 10px rgba(255,255,255,.05)); transition: all .4s; }\nbody.connected .hero-icon svg { color: var(--green); filter: drop-shadow(0 0 14px rgba(52,211,153,.55)); }\nbody.connecting .hero-icon svg { color: var(--yellow); filter: drop-shadow(0 0 14px rgba(251,191,36,.5)); }\n\n.hero-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; }\n.hero-speed { flex: 0 0 auto; width: 84px; display: flex; flex-direction: column; align-items: center; gap: 3px; min-width: 0; opacity: .4; transition: opacity .3s; }\nbody.connected .hero-speed { opacity: 1; }\n.hero-speed-label { font-size: 8.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted2); font-family: var(--mono); white-space: nowrap; }\n/* Download e upload ficam neutros de propósito - só o status central usa\n   cor de destaque, pra não competir visualmente. */\n.hero-speed-val { font-size: 13px; font-weight: 700; color: var(--muted2); font-family: var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; transition: color .3s; }\nbody.connected .hero-speed-val { color: var(--text); }\n\n.hero-status { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding-right: 30px; }\n.radar-label { font-size: 22px; font-weight: 700; font-family: var(--display); color: var(--text); transition: color .3s; }\nbody.connected .radar-label { color: var(--green); }\nbody.connecting .radar-label { color: var(--yellow); }\n.radar-sub { margin-top: 4px; font-size: 12px; color: var(--muted2); text-align: center; min-height: 14px; }\n\n/* Sempre visível (com placeholder \"--:--:--\" enquanto desconectado) pra\n   não mudar a altura do card ao conectar. */\n.timer { display: flex; align-items: baseline; gap: 7px; margin-top: 12px; background: rgba(255,255,255,.03); border: 1px solid var(--panel-border); padding: 6px 14px; border-radius: 100px; opacity: .55; transition: all .3s; }\nbody.connected .timer { background: rgba(52,211,153,.09); border-color: rgba(52,211,153,.25); opacity: 1; }\nbody.connected .action-chips { margin-top: 12px; }\n.timer-val { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--muted2); letter-spacing: .04em; transition: color .3s; }\nbody.connected .timer-val { color: var(--green); }\n.timer-label { font-size: 9px; color: var(--muted2); text-transform: uppercase; letter-spacing: .08em; }\n\n\n/* ── CHIPS DE AÇÃO (ping + velocidade) ── */\n.action-chips { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; justify-content: center; }\n.chip { display: inline-flex; align-items: center; gap: 7px; background: rgba(255,255,255,.03); border: 1px solid var(--panel-border); padding: 7px 13px; font-size: 10.5px; font-family: var(--mono); color: var(--muted2); cursor: pointer; transition: all .2s; border-radius: 999px; }\n.chip:active { opacity: .7; transform: scale(.97); }\n.chip .chip-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); flex: 0 0 6px; }\n.chip.ok .chip-dot { background: var(--green); box-shadow: 0 0 6px rgba(57,255,136,.8); }\n.chip.bad .chip-dot { background: var(--red); }\n.chip.loading .chip-dot { background: var(--yellow); animation: blink 1s ease-in-out infinite; }\n@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: .3; } }\n.chip .chip-val { color: var(--text); font-weight: 700; }\n.signal-bars { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; }\n.signal-bars i { display: block; width: 3px; border-radius: 1px; background: var(--muted); }\n.signal-bars i:nth-child(1) { height: 4px; } .signal-bars i:nth-child(2) { height: 7px; } .signal-bars i:nth-child(3) { height: 10px; } .signal-bars i:nth-child(4) { height: 13px; }\n.signal-bars.lit-1 i:nth-child(1) { background: var(--red); }\n.signal-bars.lit-2 i:nth-child(1), .signal-bars.lit-2 i:nth-child(2) { background: var(--yellow); }\n.signal-bars.lit-3 i:nth-child(1), .signal-bars.lit-3 i:nth-child(2), .signal-bars.lit-3 i:nth-child(3) { background: #a3e635; }\n.signal-bars.lit-4 i { background: var(--green); }\n\n\n/* ── GAUGE DE VELOCIDADE ── */\n.speedtest-panel { padding: 16px; display: none; flex-direction: column; align-items: center; }\n.speedtest-panel.show { display: flex; }\n.gauge-wrap { position: relative; width: 150px; height: 84px; }\n.gauge-bg, .gauge-fill { position: absolute; top: 0; left: 0; width: 150px; height: 75px; border-radius: 150px 150px 0 0; }\n.gauge-bg { background: conic-gradient(from 270deg at 50% 100%, var(--accent) 0deg, var(--accent2) 90deg, var(--green) 180deg); clip-path: polygon(0 100%, 0 30%, 4% 16%, 10% 8%, 50% 0%, 90% 8%, 96% 16%, 100% 30%, 100% 100%, 88% 100%, 88% 35%, 50% 14%, 12% 35%, 12% 100%); opacity: .3; }\n.gauge-needle { position: absolute; left: 50%; bottom: 0; width: 2px; height: 64px; background: var(--accent); transform-origin: bottom center; transform: rotate(-90deg); transition: transform .6s cubic-bezier(.34,1.56,.64,1); box-shadow: 0 0 8px rgba(169,112,255,.7); }\n.gauge-needle::after { content: ''; position: absolute; bottom: -5px; left: -4px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }\n.gauge-val { margin-top: 8px; font-family: var(--mono); font-size: 24px; font-weight: 800; color: var(--accent); }\n.gauge-unit { font-size: 11px; color: var(--muted2); letter-spacing: .08em; text-transform: uppercase; }\n.gauge-close { margin-top: 10px; font-size: 10px; color: var(--muted2); cursor: pointer; letter-spacing: .06em; text-transform: uppercase; }\n\n\n\n\n\n/* ── CARDS ── */\n.mode-row { display: flex; gap: 4px; padding: 5px; background: rgba(0,0,0,.18); border-radius: 14px; margin: 6px; }\n.mode-btn { flex: 1; padding: 10px 8px; border: none; font-size: 12px; font-weight: 700; letter-spacing: .04em; color: var(--muted2); background: transparent; cursor: pointer; transition: all .25s; font-family: var(--sans); border-radius: 10px; }\n.mode-btn.active { background: linear-gradient(115deg, var(--accent), var(--accent2)); color: #14102b; font-weight: 800; box-shadow: 0 4px 14px -4px rgba(139,107,255,.5); }\n.mode-btn:active { opacity: .8; }\n\n.server-card { padding: 14px 16px 16px; display: flex; align-items: center; gap: 13px; cursor: pointer; transition: background .2s; }\n.server-card:active { background: rgba(255,255,255,.02); }\n.server-icon { width: 42px; height: 42px; background: rgba(169,112,255,.07); border: 1px solid var(--panel-border); display: grid; place-items: center; font-size: 19px; flex: 0 0 42px; position: relative; border-radius: 12px; }\n.server-icon .flag { display: block; width: 32px; height: 24px; object-fit: cover; border-radius: 2px; border: 1px solid rgba(255,255,255,.08); background: rgba(0,0,0,.2); }\n.server-meta { flex: 1; min-width: 0; }\n.server-label { font-size: 9px; font-weight: 800; color: var(--text); letter-spacing: .14em; text-transform: uppercase; font-family: var(--mono); }\n.server-name { font-size: 15px; font-weight: 700; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.server-sub { font-size: 10.5px; color: var(--muted2); margin-top: 2px; text-transform: uppercase; letter-spacing: .06em; }\n.server-chev { color: var(--muted); font-size: 18px; flex: 0 0 auto; }\n\n.cred-label { font-size: 10.5px; font-weight: 700; color: var(--muted2); text-transform: uppercase; letter-spacing: .07em; margin: 10px 0 6px; }\n.cred-label:first-child { margin-top: 0; }\n.cred-input { width: 100%; background: rgba(0,0,0,.22); border: 1px solid var(--panel-border); padding: 13px 15px; color: var(--text); font-size: 13.5px; outline: none; font-family: var(--sans); border-radius: 14px; }\n.cred-input::placeholder { color: var(--muted); }\n\n.msg-card { padding: 12px 16px; display: flex; align-items: flex-start; gap: 10px; }\n.msg-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: 0 0 6px; margin-top: 5px; }\n.msg-text { font-size: 12px; color: var(--muted2); line-height: 1.5; }\n\n\n/* ── BOTÃO CONECTAR ── */\n.connect-btn { width: 100%; padding: 16px; border: none; background: linear-gradient(115deg, var(--accent), var(--accent2)); font-size: 15px; font-weight: 700; letter-spacing: .01em; color: #14102b; cursor: pointer; font-family: var(--sans); transition: all .2s; box-shadow: 0 10px 24px -8px rgba(139,107,255,.55); border-radius: 16px; }\n.connect-btn:active { transform: scale(.98); }\nbody.connected .connect-btn { background: linear-gradient(115deg, var(--green), #22b892); box-shadow: 0 10px 24px -8px rgba(52,211,153,.45); }\nbody.connecting .connect-btn { background: linear-gradient(115deg, var(--yellow), #f0a94e); box-shadow: 0 10px 24px -8px rgba(251,191,36,.45); }\n\n\n/* ── NAV ── */\n.bottom-nav { display: flex; margin: 4px 14px 12px; padding: 6px; gap: 2px; }\n.nav-btn { flex: 1; padding: 9px 6px; display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; border: none; background: none; transition: all .2s; border-radius: 13px; }\n.nav-btn:active { opacity: .6; }\n.nav-btn svg { width: 19px; height: 19px; color: var(--muted); transition: color .2s; }\n.nav-btn span { font-size: 9px; font-weight: 600; color: var(--muted); letter-spacing: .01em; transition: color .2s; }\n.nav-btn.active { background: rgba(139,107,255,.14); }\n.nav-btn.active svg, .nav-btn.active span { color: var(--accent2); }\n\n\n/* ── OVERLAY / MODAL ── */\n.overlay { position: fixed; inset: 0; z-index: 100; background: rgba(2,3,7,.78); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); display: none; align-items: center; padding: calc(20px + var(--vb-inset-top, 0px)) 20px calc(20px + var(--vb-inset-bottom, 0px)); }\n.overlay.show { display: flex; }\n.modal { width: 100%; max-width: 360px; margin: 0 auto; background: #070a12; border: 1px solid var(--panel-border-strong); max-height: 76vh; overflow-y: auto; box-shadow: 0 24px 70px rgba(0,0,0,.6); border-radius: 20px; }\n.modal-pad { padding: 22px 20px; }\n.modal-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(169,112,255,.1); border: 1px solid rgba(169,112,255,.3); color: var(--text); font-size: 10.5px; font-weight: 700; letter-spacing: .06em; padding: 6px 13px; margin-bottom: 15px; font-family: var(--mono); }\n.modal-title { font-size: 19px; font-weight: 800; margin-bottom: 7px; }\n.modal-sub { font-size: 12.5px; color: var(--muted2); margin-bottom: 18px; }\n.modal-btn { width: 100%; padding: 14px; border: none; font-size: 12.5px; font-weight: 800; cursor: pointer; margin-bottom: 9px; display: flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--sans); letter-spacing: .02em; border-radius: 10px; }\n.modal-btn:last-child { margin-bottom: 0; }\n.modal-btn:active { opacity: .85; }\n.modal-btn-minimize { background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); color: var(--text); }\n.modal-btn-exit { background: linear-gradient(115deg, var(--red), #c4123f); color: #1a0408; }\n.modal-btn-cancel { background: linear-gradient(115deg, var(--accent2), #8a1440); color: #1a0510; }\n.modal-btn-save { background: linear-gradient(115deg, var(--accent), #a3102b); color: #1a0509; }\n\n/* ── SHEETS DE SELEÇÃO (servidor/payload/xray): página cheia, com\n   cabeçalho/abas/busca FIXOS e só a lista rolando dentro de um espaço\n   limitado - corrige o card que ficava \"esticando\" enorme na tela. ── */\n.sheet-page { position: fixed; inset: 0; z-index: 95; background: var(--bg); display: none; flex-direction: column; padding-top: var(--vb-inset-top, 0px); padding-bottom: var(--vb-inset-bottom, 0px); }\n.sheet-page.show { display: flex; }\n.sheet-page-header { padding: 16px 16px 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; border-bottom: 1px solid var(--panel-border); flex: 0 0 auto; }\n.sheet-page-title { display: flex; align-items: center; gap: 10px; min-width: 0; }\n.sheet-page-icon { font-size: 19px; flex: 0 0 auto; filter: drop-shadow(0 0 8px rgba(139,107,255,.4)); }\n.sheet-title-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }\n.sheet-title-text > span:first-child { font-size: 15px; font-weight: 800; color: var(--text); letter-spacing: .01em; font-family: var(--display); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.sheet-hint { color: var(--muted); font-size: 9px; letter-spacing: .04em; text-transform: none; font-family: var(--mono); }\n.sheet-close { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--panel-border); background: rgba(255,255,255,.05); color: var(--muted2); display: grid; place-items: center; cursor: pointer; flex: 0 0 30px; font-size: 13px; transition: all .15s; }\n.sheet-close:active { opacity: .6; transform: scale(.92); }\n\n.sheet-tabs { display: flex; gap: 22px; padding: 12px 16px 0; border-bottom: 1px solid var(--panel-border); flex: 0 0 auto; }\n.sheet-tab { flex: 0 0 auto; padding: 4px 2px 12px; background: none; border: none; font-size: 12.5px; font-weight: 700; color: var(--muted2); font-family: var(--sans); cursor: pointer; position: relative; letter-spacing: .01em; }\n.sheet-tab.active { color: var(--text); }\n.sheet-tab.active::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: linear-gradient(115deg, var(--accent), var(--accent2)); border-radius: 2px; }\n.sheet-tab:active { opacity: .7; }\n\n.sheet-search-wrap { display: flex; align-items: center; gap: 9px; margin: 12px 16px; padding: 11px 14px; background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); border-radius: 12px; flex: 0 0 auto; }\n.sheet-search-icon { font-size: 13px; opacity: .55; flex: 0 0 auto; }\n.sheet-search-input { flex: 1; min-width: 0; background: none; border: none; outline: none; color: var(--text); font-size: 13px; font-family: var(--sans); }\n.sheet-search-input::placeholder { color: var(--muted); }\n\n/* Lista: cada servidor/payload é um mini-card arredondado com respiro entre\n   eles, em vez de linhas separadas só por uma borda - fica muito mais\n   limpo e fácil de escanear visualmente. Fica dentro de um flex:1 com\n   overflow-y:auto, então só ELA rola - o cabeçalho/abas/busca não saem\n   de lugar nem \"empurram\" a tela pra baixo conforme a lista cresce. */\n.sheet-list { flex: 1; min-height: 0; overflow-y: auto; padding: 4px 12px 20px; display: flex; flex-direction: column; gap: 8px; -webkit-overflow-scrolling: touch; }\n.sheet-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; cursor: pointer; transition: background .15s, border-color .15s; border: 1px solid var(--panel-border); border-radius: 14px; background: rgba(255,255,255,.015); }\n.sheet-item:active { background: rgba(255,255,255,.035); }\n.sheet-item-icon { width: 40px; height: 40px; background: rgba(139,107,255,.08); border: 1px solid var(--panel-border); display: grid; place-items: center; font-size: 17px; flex: 0 0 40px; border-radius: 12px; }\n.sheet-item-icon .flag { display: block; width: 34px; height: 24px; object-fit: cover; border-radius: 2px; border: 1px solid rgba(255,255,255,.08); background: rgba(0,0,0,.2); }\n.sheet-item-meta { flex: 1; min-width: 0; }\n.sheet-item-name { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.sheet-item-sub { font-size: 9.5px; color: var(--muted2); margin-top: 2px; text-transform: uppercase; letter-spacing: .06em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.sheet-item.selected { background: rgba(52,211,153,.08); border-color: transparent; box-shadow: 0 0 0 1.5px rgba(52,211,153,.3) inset; }\n.status-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 9px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; padding: 6px 11px; border-radius: 999px; white-space: nowrap; flex: 0 0 auto; font-family: var(--mono); }\n.status-badge.neutral { background: rgba(255,255,255,.06); border: 1px solid var(--panel-border); color: var(--muted2); }\n.status-badge.selected { background: rgba(52,211,153,.16); border: none; color: var(--green); }\n.fav-star { font-size: 16px; flex: 0 0 auto; padding: 4px; opacity: .3; transition: all .15s; cursor: pointer; }\n.fav-star.active { opacity: 1; color: var(--yellow); filter: drop-shadow(0 0 5px rgba(251,191,36,.6)); }\n.fav-star:active { transform: scale(1.3); }\n\n\n/* ── LOGS ── */\n.logs-page { position: fixed; inset: 0; z-index: 90; background: var(--bg); display: none; flex-direction: column; padding-top: var(--vb-inset-top, 0px); padding-bottom: var(--vb-inset-bottom, 0px); }\n.logs-page.show { display: flex; }\n.logs-header { padding: 18px 18px 14px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--panel-border); }\n.logs-title { font-size: 19px; font-weight: 700; color: var(--text); font-family: var(--display); }\n.logs-actions { display: flex; gap: 8px; }\n.logs-btn { padding: 7px 12px; font-size: 9.5px; font-weight: 700; background: rgba(255,255,255,.04); border: 1px solid var(--panel-border); color: var(--text); cursor: pointer; font-family: var(--sans); letter-spacing: .06em; text-transform: uppercase; border-radius: 8px; }\n.logs-btn:active { opacity: .7; }\n.logs-body { flex: 1; overflow-y: auto; padding: 8px 0; font-family: var(--mono); font-size: 11px; background: #020308; }\n.log-line { display: flex; align-items: flex-start; gap: 8px; padding: 4px 14px; border-bottom: 1px solid rgba(255,255,255,.02); line-height: 1.5; word-break: break-all; }\n.log-line .log-time { flex: 0 0 auto; color: #232c3d; font-size: 9.5px; padding-top: 1px; white-space: nowrap; }\n.log-line .log-msg { flex: 1; }\n.log-line.info .log-msg { color: #647289; }\n.log-line.ok { background: rgba(57,255,136,.04); } .log-line.ok .log-msg { color: #5ef99a; font-weight: 600; }\n.log-line.warn .log-msg { color: var(--yellow); }\n.log-line.err { background: rgba(255,56,96,.05); } .log-line.err .log-msg { color: var(--red); }\n.log-line.sep .log-msg { color: #232c3d; letter-spacing: .1em; font-size: 9.5px; text-align: center; width: 100%; }\n.logs-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 200px; gap: 10px; color: var(--muted); font-size: 12px; }\n.logs-footer { padding: 10px 16px; border-top: 1px solid var(--panel-border); display: flex; align-items: center; justify-content: space-between; }\n/* Linha de tráfego e de ping ficam fixas (1 elemento só, atualizado no\n   lugar) em vez de empilhar uma linha nova a cada atualização - é isso\n   que evitava o \"listão\" crescendo sem parar nos logs. */\n.log-line.traffic-live .log-msg { color: var(--accent2); }\n.log-line.ping-live .log-msg { color: var(--yellow); }\n.log-xray-header { padding: 8px 14px 4px; font-size: 9.5px; color: var(--accent2);\n  font-family: var(--mono); letter-spacing: .08em; border-bottom: 1px solid rgba(79,209,255,.15); }\n.autoscroll-toggle { display: flex; align-items: center; gap: 8px; font-size: 10.5px; color: var(--muted2); }\n\n\n/* ── CONFIG ── */\n.settings-page { position: fixed; inset: 0; z-index: 90; background: var(--bg); display: none; flex-direction: column; padding-top: var(--vb-inset-top, 0px); padding-bottom: var(--vb-inset-bottom, 0px); }\n.settings-page.show { display: flex; }\n.settings-body { flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; }\n.settings-section-title { font-size: 11px; font-weight: 700; letter-spacing: .04em; color: var(--muted2); text-transform: uppercase; margin-top: 14px; margin-bottom: 4px; font-family: var(--sans); }\n.settings-section-title:first-child { margin-top: 0; }\n.setting-item { background: var(--panel); border: 1px solid var(--panel-border); padding: 14px 16px; display: flex; align-items: center; gap: 12px; cursor: pointer; border-radius: 14px; }\n.setting-item:active { background: rgba(255,255,255,.03); }\n.setting-item svg { width: 19px; height: 19px; color: var(--accent); flex: 0 0 19px; }\n.setting-item-meta { flex: 1; min-width: 0; }\n.setting-item-title { font-size: 13.5px; font-weight: 700; }\n.setting-item-sub { font-size: 10.5px; color: var(--muted2); margin-top: 2px; }\n.setting-item-chev { color: var(--muted); flex: 0 0 auto; }\n\n.switch { width: 46px; height: 27px; border-radius: 999px; background: rgba(255,255,255,.06); border: none; position: relative; flex: 0 0 auto; transition: background .2s; cursor: pointer; }\n.switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 21px; height: 21px; border-radius: 50%; background: var(--muted2); transition: all .2s; }\n.switch.on { background: linear-gradient(115deg, var(--accent), var(--accent2)); }\n.switch.on::after { left: 22px; background: #fff; }\n\n\n/* ── APARÊNCIA: prévia ao vivo + tema atual ── */\n.theme-current-label { font-size: 11.5px; color: var(--muted2); margin-bottom: 8px; }\n.theme-current-label span { color: var(--text); font-weight: 700; }\n\n.theme-update-btn { width: 100%; padding: 15px; border: none; margin-top: 4px; background: linear-gradient(115deg, var(--accent), var(--accent2)); color: #14102b; font-size: 13.5px; font-weight: 700; cursor: pointer; font-family: var(--sans); border-radius: 999px; box-shadow: 0 10px 22px -8px rgba(139,107,255,.5); }\n.theme-update-btn:active { transform: scale(.98); }\n\n.palette-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 9px; }\n.palette-item { display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; padding: 8px 4px; border: 2px solid transparent; transition: transform .15s, border-color .2s; }\n.palette-item:active { transform: scale(.92); }\n.palette-item.selected { border-color: var(--accent); background: rgba(255,255,255,.03); animation: palette-pop .3s ease; }\n@keyframes palette-pop { 0% { transform: scale(1); } 40% { transform: scale(1.08); } 100% { transform: scale(1); } }\n.palette-circle { width: 40px; height: 40px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.15); position: relative; transition: box-shadow .2s; }\n.palette-item.selected .palette-circle { box-shadow: 0 0 0 3px rgba(255,255,255,.08), 0 0 16px rgba(169,112,255,.25); }\n.palette-circle .check { position: absolute; top: -4px; right: -4px; width: 15px; height: 15px; border-radius: 50%; background: var(--accent); color: #1a0509; font-size: 9px; display: flex; align-items: center; justify-content: center; opacity: 0; }\n.palette-item.selected .check { opacity: 1; }\n.palette-label { font-size: 10px; font-weight: 700; color: var(--muted2); }\n.palette-item.selected .palette-label { color: var(--text); }\n\n.bg-color-row { display: flex; align-items: center; gap: 10px; background: var(--panel); border: 1px solid var(--panel-border); padding: 12px 14px; }\n#bg-color-input { width: 42px; height: 42px; border: none; border-radius: 50%; padding: 0; background: none; cursor: pointer; box-shadow: 0 0 0 2px var(--accent), 0 0 14px rgba(169,112,255,.35); transition: box-shadow .2s; }\n#bg-color-input:active { box-shadow: 0 0 0 3px var(--accent), 0 0 20px rgba(169,112,255,.55); }\n#bg-color-input::-webkit-color-swatch-wrapper { padding: 2px; border-radius: 50%; }\n#bg-color-input::-webkit-color-swatch { border-radius: 50%; border: 2px solid rgba(255,255,255,0.35); }\n.bg-color-reset { background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); color: var(--muted2); font-size: 10.5px; font-weight: 700; padding: 8px 12px; cursor: pointer; }\n\n.diag-box { background: #020308; border: 1px solid var(--panel-border); padding: 12px 14px; font-family: var(--mono); font-size: 10px; color: var(--muted2); line-height: 1.6; white-space: pre-wrap; word-break: break-all; max-height: 220px; overflow-y: auto; }\n\n.toast { position: fixed; bottom: calc(96px + var(--vb-inset-bottom, 0px)); left: 50%; transform: translateX(-50%) translateY(20px); background: rgba(8,12,20,.94); border: 1px solid var(--panel-border-strong); padding: 10px 18px; font-size: 11.5px; font-weight: 600; color: var(--text); z-index: 200; opacity: 0; transition: all .25s; white-space: nowrap; pointer-events: none; font-family: var(--mono); max-width: 90vw; overflow: hidden; text-overflow: ellipsis; }\n.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n\n@media (max-width: 340px) {\n  .header { margin: 8px 8px 4px; padding: 10px 12px; }\n  .body { padding: 6px 8px 8px; gap: 8px; }\n  .bottom-nav { margin: 0 8px 8px; }\n  .hero { padding: 12px 10px 12px; }\n  .server-card { padding: 12px 13px 14px; gap: 10px; }\n}\n</style>\n</head>\n<body>\n<div class=\"mesh-bg\"><div class=\"scanline\"></div><div class=\"blob blob1\"></div><div class=\"blob blob2\"></div><div class=\"blob blob3\"></div></div>\n<div class=\"shell\">\n\n  <header class=\"header\">\n    <div class=\"header-left\">\n      <div class=\"header-icon\"><img src=\"https://i.ibb.co/jvmF6Z90/1784198776208.png\" alt=\"logo\" style=\"width:100%;height:100%;object-fit:cover;border-radius:13px;\"></div>\n      <div style=\"min-width:0; flex:1;\">\n        <div class=\"header-brand\" id=\"app-name\">VB INJECTOR</div>\n        <div class=\"header-meta\">\n          <span class=\"header-ver\" id=\"config-ver\">v--</span>\n          <span class=\"header-ver\" id=\"html-ver\">h--</span>\n          <span class=\"net-badge\" id=\"net-badge\"><span class=\"dot\"></span><span id=\"net-badge-text\">--</span></span>\n        </div>\n      </div>\n    </div>\n    <div class=\"header-right\">\n      <button class=\"btn-icon\" id=\"refresh-btn\" onclick=\"doUpdate()\" title=\"Atualizar\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      </button>\n    </div>\n  </header>\n\n  <div class=\"body\" id=\"main-body\">\n\n    <div class=\"panel notice-card\" id=\"notice-bar\">\n      <div class=\"notice-icon\">📣</div>\n      <div class=\"notice-content\">\n        <div class=\"notice-title\" id=\"notice-title\">Aviso</div>\n        <div class=\"notice-msg\" id=\"notice-msg\"></div>\n      </div>\n    </div>\n\n    <!-- PAINEL DE IP -->\n    <div class=\"panel ip-panel\">\n      <div class=\"ip-panel-head\">\n        <div class=\"ip-panel-title\"><span class=\"led\"></span> IP / LOCALIZAÇÃO</div>\n        <div class=\"ip-refresh-btn\" onclick=\"refreshIpInfo()\">↻ ATUALIZAR</div>\n      </div>\n      <div class=\"ip-row\">\n        <span class=\"ip-value\" id=\"ip-value\">•••.•••.•••.•••</span>\n        <span class=\"ip-loc\" id=\"ip-loc\"></span>\n      </div>\n      <div class=\"ip-status-line\" id=\"ip-status-line\">Toque em atualizar pra ver seu IP real</div>\n    </div>\n\n    <!-- STATUS DE CONEXÃO (sem círculo - o botão grande lá embaixo já conecta/desconecta) -->\n    <div class=\"panel hero\">\n      <div class=\"hero-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2l8 4v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-4z\"/></svg></div>\n      <div class=\"hero-row\">\n        <div class=\"hero-speed\" id=\"hero-dl\">\n          <span class=\"hero-speed-label\">↓ DOWNLOAD</span>\n          <span class=\"hero-speed-val\" id=\"speed-dl\">—</span>\n        </div>\n        <div class=\"hero-status\">\n          <div class=\"radar-label\" id=\"orb-label\">DESCONECTADO</div>\n          <div class=\"radar-sub\" id=\"orb-sub\">Toque para conectar</div>\n          <div class=\"timer\" id=\"timer\">\n            <span class=\"timer-label\">Tempo</span>\n            <span class=\"timer-val\" id=\"timer-val\">--:--:--</span>\n          </div>\n        </div>\n        <div class=\"hero-speed\" id=\"hero-ul\">\n          <span class=\"hero-speed-label\">↑ UPLOAD</span>\n          <span class=\"hero-speed-val\" id=\"speed-ul\">—</span>\n        </div>\n      </div>\n      <div class=\"action-chips\">\n        <div class=\"chip\" id=\"ping-chip\" onclick=\"testPing()\">\n          <span class=\"chip-dot\"></span>\n          <span id=\"ping-label\">Latência</span>\n        </div>\n        <div class=\"chip\" id=\"speedtest-chip\" onclick=\"runSpeedTest()\">\n          <span class=\"chip-dot\"></span>\n          <span id=\"speedtest-label\">Velocidade</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- GAUGE DE VELOCIDADE -->\n    <div class=\"panel speedtest-panel\" id=\"speedtest-panel\">\n      <div class=\"gauge-wrap\">\n        <div class=\"gauge-bg\"></div>\n        <div class=\"gauge-needle\" id=\"gauge-needle\"></div>\n      </div>\n      <div class=\"gauge-val\" id=\"gauge-val\">0.0</div>\n      <div class=\"gauge-unit\">Mbps de download</div>\n      <div class=\"gauge-close\" onclick=\"closeSpeedTest()\">Fechar</div>\n    </div>\n\n    <div class=\"panel\">\n      <div class=\"mode-row\">\n        <button class=\"mode-btn\" id=\"mode-ssh\" onclick=\"setMode('SSH')\">SSH</button>\n        <button class=\"mode-btn\" id=\"mode-xray\" onclick=\"setMode('XRAY')\">XRAY</button>\n      </div>\n    </div>\n\n    <div class=\"mode-switch\" id=\"plan-switch-ssh\" style=\"display:none\">\n      <button class=\"mode-btn active\" id=\"planbtn-ssh-free\" onclick=\"setPlan('free')\">Grátis</button>\n      <button class=\"mode-btn\" id=\"planbtn-ssh-vip\" onclick=\"setPlan('vip')\">Premium</button>\n    </div>\n    <div class=\"panel\" id=\"card-payload\" onclick=\"openSheet('payload')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\" id=\"payload-icon\">\n          <img class=\"flag\" id=\"payload-flag\" src=\"\" alt=\"flag\" style=\"display:none;\">\n          <span id=\"payload-emoji\">📦</span>\n        </div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Conexão</div>\n          <div class=\"server-name\" id=\"payload-name\">Selecionar conexão</div>\n          <div class=\"server-sub\" id=\"payload-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n\n    <div class=\"panel\" id=\"card-xray\" style=\"display:none\" onclick=\"openSheetPlan('xray', currentPlan)\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\" id=\"xray-icon\">\n          <img class=\"flag\" id=\"xray-flag\" src=\"\" alt=\"flag\" style=\"display:none;\">\n          <span id=\"xray-emoji\">⚡</span>\n        </div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\" id=\"xray-label\">Perfis Grátis</div>\n          <div class=\"server-name\" id=\"xray-name\">Selecionar perfil</div>\n          <div class=\"server-sub\" id=\"xray-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <button class=\"connect-btn\" id=\"connect-btn\" onclick=\"doConnect()\">Conectar SSH</button>\n\n    <div class=\"panel msg-card\" id=\"msg-card\" style=\"display:none\">\n      <div class=\"msg-dot\"></div>\n      <div class=\"msg-text\" id=\"msg-text\"></div>\n    </div>\n\n  </div>\n\n  <nav class=\"bottom-nav panel\">\n    <button class=\"nav-btn active\" onclick=\"showMain()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>\n      <span>Início</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showLogs()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6M16 13H8\"/></svg>\n      <span>Logs</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"VBBridge && VBBridge.openConverter && VBBridge.openConverter()\">\n      <span style=\"font-size:19px;line-height:1;\">🧩</span>\n      <span>Converter</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showSettings()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.