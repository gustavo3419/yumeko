2 {\n    background: rgba(0, 242, 255, 0.05);\n    border: 1px solid rgba(0, 255, 255, 0.15);\n    color: #00f2ff;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 11px;\n    padding: 12px;\n    width: 100%;\n    border-radius: 6px;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    transition: all 0.3s;\n}\n\n.tech-logs-panel-v2 {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    height: 70vh;\n    background: #05050a;\n    border-top: 1px solid rgba(0, 255, 255, 0.4);\n    z-index: 1000;\n    transform: translateY(100%);\n    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n    display: flex;\n    flex-direction: column;\n}\n\n.tech-logs-panel-v2.open { transform: translateY(0); }\n\n.panel-header-v2 {\n    padding: 12px 20px;\n    background: rgba(255, 255, 255, 0.03);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.logs-container-v2 {\n    flex: 1;\n    overflow-y: auto;\n    padding: 15px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    color: #8899aa;\n}\n\n.log-row-v2 {\n    margin-bottom: 4px;\n    display: flex;\n    gap: 8px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.02);\n}\n\n.log-time-v2 { color: #445566; }\n.log-error-v2 { color: #ff3131; }\n.log-warn-v2 { color: #ffea00; }\n.log-info-v2 { color: #00f2ff; }\n\n</style>\n</head>\n<body>\n<div class=\"mesh-bg\"><div class=\"scanline\"></div><div class=\"blob blob1\"></div><div class=\"blob blob2\"></div></div>\n<div class=\"shell\">\n\n  <header class=\"header panel\">\n    <div class=\"header-left\">\n      <div class=\"header-brand\" id=\"app-name\">VB INJECTOR</div>\n      <div class=\"header-meta\">\n        <span class=\"header-ver\" id=\"config-ver\">v--</span>\n        <span class=\"header-ver\" id=\"html-ver\">h--</span>\n        <span class=\"net-badge\" id=\"net-badge\"><span class=\"dot\"></span><span id=\"net-badge-text\">--</span></span>\n      </div>\n    </div>\n    <div class=\"header-right\">\n      <button class=\"btn-icon\" id=\"refresh-btn\" onclick=\"doUpdate()\" title=\"Atualizar\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      </button>\n    </div>\n  </header>\n\n  <div class=\"body\" id=\"main-body\">\n\n    <div class=\"panel notice-card\" id=\"notice-bar\">\n      <div class=\"notice-icon\">\ud83d\udce3</div>\n      <div class=\"notice-content\">\n        <div class=\"notice-title\" id=\"notice-title\">Aviso</div>\n        <div class=\"notice-msg\" id=\"notice-msg\"></div>\n      </div>\n    </div>\n\n    <!-- PAINEL DE IP -->\n    <div class=\"panel ip-panel\">\n      <div class=\"ip-panel-head\">\n        <div class=\"ip-panel-title\"><span class=\"led\"></span> IP / LOCALIZA\u00c7\u00c3O</div>\n        <div class=\"ip-refresh-btn\" onclick=\"refreshIpInfo()\">\u21bb ATUALIZAR</div>\n      </div>\n      <div class=\"ip-row\">\n        <span class=\"ip-value\" id=\"ip-value\">\u2022\u2022\u2022.\u2022\u2022\u2022.\u2022\u2022\u2022.\u2022\u2022\u2022</span>\n        <span class=\"ip-loc\" id=\"ip-loc\"></span>\n      </div>\n      <div class=\"ip-status-line\" id=\"ip-status-line\">Toque em atualizar pra ver seu IP real</div>\n    </div>\n\n    <!-- RADAR / CONEX\u00c3O -->\n    <div class=\"panel hero\">\n      <div class=\"radar-wrap\">\n        <div class=\"radar-ring r3\"></div>\n        <div class=\"radar-ring r2\"></div>\n        <div class=\"radar-ring\"></div>\n        <div class=\"radar-sweep\"></div>\n        <div class=\"radar-btn\" onclick=\"doConnect()\" id=\"orb-btn\">\n          <div class=\"radar-icon\"></div>\n        </div>      </div>\n      <div class=\"radar-label\" id=\"orb-label\">DESCONECTADO</div>\n      <div class=\"radar-sub\" id=\"orb-sub\">Toque para conectar</div>\n      <div class=\"timer\" id=\"timer\">\n        <span class=\"timer-label\">Tempo</span>\n        <span class=\"timer-val\" id=\"timer-val\">00:00:00</span>\n      </div>\n      <div class=\"action-chips\">\n        <div class=\"chip\" id=\"ping-chip\" onclick=\"testPing()\">\n          <span class=\"chip-dot\"></span>\n          <span id=\"ping-label\">Lat\u00eancia</span>\n        </div>\n        <div class=\"chip\" id=\"speedtest-chip\" onclick=\"runSpeedTest()\">\n          <span class=\"chip-dot\"></span>\n          <span id=\"speedtest-label\">Velocidade</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- GAUGE DE VELOCIDADE -->\n    <div class=\"panel speedtest-panel\" id=\"speedtest-panel\">\n      <div class=\"gauge-wrap\">\n        <div class=\"gauge-bg\"></div>\n        <div class=\"gauge-needle\" id=\"gauge-needle\"></div>\n      </div>\n      <div class=\"gauge-val\" id=\"gauge-val\">0.0</div>\n      <div class=\"gauge-unit\">Mbps de download</div>\n      <div class=\"gauge-close\" onclick=\"closeSpeedTest()\">Fechar</div>\n    </div>\n\n    <!-- VELOCIDADE EM TEMPO REAL -->\n    <div class=\"speed-row\" id=\"speed-row\" style=\"display:none\">\n      <div class=\"panel speed-card\">\n        <div class=\"speed-label\">\u2193 DOWNLOAD</div>\n        <div class=\"speed-val\" id=\"speed-dl\">0 B/s</div>\n      </div>\n      <div class=\"panel speed-card\">\n        <div class=\"speed-label\">\u2191 UPLOAD</div>\n        <div class=\"speed-val\" id=\"speed-ul\">0 B/s</div>\n      </div>\n    </div>\n\n    <div class=\"panel\">\n      <div class=\"mode-row\">\n        <button class=\"mode-btn\" id=\"mode-ssh\" onclick=\"setMode('SSH')\">SSH</button>\n        <button class=\"mode-btn\" id=\"mode-xray\" onclick=\"setMode('XRAY')\">XRAY</button>\n      </div>\n    </div>\n\n    <div class=\"panel\" id=\"card-ssh\" onclick=\"openSheet('ssh')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\" id=\"ssh-icon\">\n          <img class=\"flag\" id=\"ssh-flag\" src=\"\" alt=\"flag\" style=\"display:none;\">\n          <span id=\"ssh-emoji\">\ud83d\udda5\ufe0f</span>\n        </div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Servidor SSH</div>\n          <div class=\"server-name\" id=\"ssh-name\">Selecionar servidor</div>\n          <div class=\"server-sub\" id=\"ssh-sub\">\u2014</div>\n        </div>\n        <div class=\"server-chev\">\u203a</div>\n      </div>\n    </div>\n\n    <div class=\"panel\" id=\"card-payload\" onclick=\"openSheet('payload')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\" id=\"payload-icon\">\n          <img class=\"flag\" id=\"payload-flag\" src=\"\" alt=\"flag\" style=\"display:none;\">\n          <span id=\"payload-emoji\">\ud83d\udce6</span>\n        </div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Payload</div>\n          <div class=\"server-name\" id=\"payload-name\">Selecionar payload</div>\n          <div class=\"server-sub\" id=\"payload-sub\">\u2014</div>\n        </div>\n        <div class=\"server-chev\">\u203a</div>\n      </div>\n    </div>\n\n    <div class=\"panel\" id=\"card-xray\" style=\"display:none\" onclick=\"openSheet('xray')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\" id=\"xray-icon\">\n          <img class=\"flag\" id=\"xray-flag\" src=\"\" alt=\"flag\" style=\"display:none;\">\n          <span id=\"xray-emoji\">\u26a1</span>\n        </div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Perfil XRAY</div>\n          <div class=\"server-name\" id=\"xray-name\">Selecionar perfil</div>\n          <div class=\"server-sub\" id=\"xray-sub\">\u2014</div>\n        </div>\n        <div class=\"server-chev\">\u203a</div>\n      </div>\n    </div>\n\n    <button class=\"connect-btn\" id=\"connect-btn\" onclick=\"doConnect()\">Conectar