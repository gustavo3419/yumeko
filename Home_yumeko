n      Servidores\r\n    <\/button>\r\n    <button class=\"nav-btn\" id=\"nav-speed\" onclick=\"showPage('speed',this)\">\r\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"\/><\/svg>\r\n      Velocidade\r\n    <\/button>\r\n    <button class=\"nav-btn\" id=\"nav-tools\" onclick=\"showPage('tools',this)\">\r\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"\/><path d=\"M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14\"\/><\/svg>\r\n      Ferramentas\r\n    <\/button>\r\n  <\/nav>\r\n<\/div><!-- \/app-shell -->\r\n\r\n<!-- \u2550\u2550 METHOD MODAL \u2550\u2550 -->\r\n<div class=\"modal-mask\" id=\"method-modal-mask\" onclick=\"closeMethodModal(event)\">\r\n  <div class=\"modal-box active method-modal-box\">\r\n    <div class=\"method-modal-head\">\r\n      <span class=\"method-modal-title\">M\u00E9todo VPN<\/span>\r\n      <button class=\"method-close-btn\" onclick=\"closeMethodModal()\">FECHAR<\/button>\r\n    <\/div>\r\n    <div class=\"method-modal-sub\">Selecione o protocolo de conex\u00E3o<\/div>\r\n    <div class=\"method-list\" id=\"method-list\">\r\n      <!-- populated by JS -->\r\n    <\/div>\r\n  <\/div>\r\n<\/div>\r\n\r\n<!-- \u2550\u2550 CREDS MODAL \u2550\u2550 -->\r\n<div class=\"modal-mask\" id=\"creds-modal-mask\" onclick=\"closeCredsModal(event)\">\r\n  <div class=\"modal-box active creds-modal-box\">\r\n    <div class=\"creds-modal-head\">\r\n      <span class=\"creds-modal-title\">Credenciais<\/span>\r\n      <button class=\"icon-btn\" onclick=\"closeCredsModal()\">\u2715<\/button>\r\n    <\/div>\r\n    <div class=\"creds-modal-sub\">Configure usu\u00E1rio e senha para autentica\u00E7\u00E3o<\/div>\r\n    <div class=\"creds-modal-body\">\r\n      <div class=\"creds-section-title\">Usu\u00E1rio<\/div>\r\n      <div class=\"creds-input-wrap\">\r\n        <span class=\"ci-icon\">\uD83D\uDC64<\/span>\r\n        <input id=\"creds-user-input\" placeholder=\"Digite o usu\u00E1rio\" type=\"text\" autocomplete=\"username\">\r\n      <\/div>\r\n      <div class=\"creds-section-title\">Senha<\/div>\r\n      <div class=\"creds-input-wrap\">\r\n        <span class=\"ci-icon\">\uD83D\uDD11<\/span>\r\n        <input id=\"creds-pass-input\" placeholder=\"Digite a senha\" type=\"password\" autocomplete=\"current-password\">\r\n        <button class=\"ci-eye\" onclick=\"togglePassVis()\">\uD83D\uDC41<\/button>\r\n      <\/div>\r\n      <div class=\"creds-section-title\">UUID \/ Chave<\/div>\r\n      <div class=\"creds-input-wrap\">\r\n        <span class=\"ci-icon\">\uD83D\uDD10<\/span>\r\n        <input id=\"creds-uuid-input\" placeholder=\"UUID opcional\" type=\"text\">\r\n      <\/div>\r\n    <\/div>\r\n    <div class=\"creds-modal-footer\">\r\n      <button class=\"creds-cancel-btn\" onclick=\"closeCredsModal()\">Cancelar<\/button>\r\n      <button class=\"creds-save-btn\" onclick=\"saveCreds()\">Salvar<\/button>\r\n    <\/div>\r\n  <\/div>\r\n<\/div>\r\n\r\n<!-- \u2550\u2550 LOGS MODAL \u2550\u2550 -->\r\n<div class=\"modal-mask\" id=\"logs-modal-mask\" onclick=\"closeLogsModal(event)\">\r\n  <div class=\"modal-box active\" style=\"background:#08000f;border-color:rgba(130,0,255,.3);max-height:85vh;\">\r\n    <div class=\"modal-head\">\r\n      <span class=\"modal-title\">Logs do Sistema<\/span>\r\n      <button class=\"icon-btn\" onclick=\"closeLogsModal()\">\u2715<\/button>\r\n    <\/div>\r\n    <div class=\"modal-body\">\r\n      <div class=\"logs-toolbar\">\r\n        <button class=\"log-action-btn\" onclick=\"copyLogs()\">Copiar<\/button>\r\n        <button class=\"log-action-btn danger\" onclick=\"clearLogs()\">Limpar<\/button>\r\n      <\/div>\r\n      <div id=\"log-container\"><\/div>\r\n    <\/div>\r\n  <\/div>\r\n<\/div>\r\n\r\n<!-- Toast -->\r\n<div class=\"toast-box\"><div class=\"toast\" id=\"toast\"><\/div><\/div>\r\n\r\n<script>\r\n\/\/ \u2500\u2500\u2500 STATE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nvar vpnState = 'disconnected';\r\nvar currentMethod = null;\r\nvar connectionTimer = null;\r\nvar connectionSeconds = 0;\r\nvar totalDL = 0, totalUL = 0;\r\nvar logs = [];\r\nvar userData = {};\r\nvar methods = [];\r\n\r\nvar DEFAULT_METHODS = [\r\n  {id:'v2ray',  name:'V2Ray',   sub:'VMess \/ VLESS',   icon:'\uD83D\uDE80'},\r\n  {id:'ssh',    name:'SSH',     sub:'Secure Shell',     icon:'\uD83D\uDDA5\uFE0F'},\r\n  {id:'trojan', name:'Trojan',  sub:'TLS Obfuscation',  icon:'\uD83D\uDEE1\uFE0F'},\r\n  {id:'sstp',   name:'SSTP',    sub:'SSL\/HTTPS',        icon:'\uD83D\uDD12'},\r\n  {id:'socks5', name:'SOCKS5',  sub:'Proxy tunnel',     icon:'\uD83D\uDD17'}\r\n];\r\n\r\n\/\/ \u2500\u2500\u2500 ANDROID BRIDGE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nvar Android = (function(){\r\n  var w = window;\r\n  return w.Android || w.vpnBridge || w.AndroidBridge || {\r\n    connect:      function(d){ addLog('Conectando: '+d,'DEBUG'); },\r\n    disconnect:   function(){ addLog('Desconectando','DEBUG'); },\r\n    getServers:   function(){ return '[]'; },\r\n    getMethods:   function(){ return '[]'; },\r\n    installUpdate:function(){ addLog('Instalando atualiza\u00E7\u00E3o','INFO'); },\r\n    openUrl:      function(u){ try{window.open(u);}catch(e){} },\r\n    copyText:     function(t){ try{navigator.clipboard.writeText(t);}catch(e){} },\r\n    showAd:       function(){ addLog('Exibindo an\u00FAncio','INFO'); },\r\n    getCredentials: function(){ return '{}'; },\r\n    saveCredentials:function(d){ addLog('Credenciais salvas','INFO'); },\r\n    checkPing:    function(){ addLog('Verificando ping','DEBUG'); },\r\n    checkDNS:     function(){ addLog('Consultando DNS','DEBUG'); },\r\n    checkPort:    function(){ addLog('Verificando porta','DEBUG'); }\r\n  };\r\n})();\r\n\r\n\/\/ \u2500\u2500\u2500 CALLBACKS FROM ANDROID \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction onVpnStatus(status){\r\n  var s = (status||'').toLowerCase();\r\n  if(s==='connected'||s==='conectado')     setVpnState('connected');\r\n  else if(s==='connecting'||s==='conectando') setVpnState('connecting');\r\n  else if(s==='disconnected'||s==='desconectado') setVpnState('disconnected');\r\n  else if(s==='error'||s==='erro')         setVpnState('error');\r\n}\r\n\r\nfunction onSpeedUpdate(dl, ul){\r\n  var d=parseFloat(dl)||0, u=parseFloat(ul)||0;\r\n  totalDL+=d\/10; totalUL+=u\/10;\r\n  setEl('speed-dl',    d.toFixed(2));\r\n  setEl('speed-ul',    u.toFixed(2));\r\n  setEl('speed-big-dl',d.toFixed(2));\r\n  setEl('speed-big-ul',u.toFixed(2));\r\n  setEl('speed-total-dl', fmtBytes(totalDL));\r\n  setEl('speed-total-ul', fmtBytes(totalUL));\r\n}\r\n\r\nfunction onUserData(jsonStr){\r\n  try{\r\n    userData = JSON.parse(jsonStr);\r\n    updateUserCard();\r\n  }catch(e){ addLog('Erro ao processar dados do usu\u00E1rio: '+e,'ERROR'); }\r\n}\r\n\r\nfunction onPingResult(ping, jitter){\r\n  setEl('speed-ping', (parseInt(ping)||0)+' ms');\r\n  setEl('speed-jitter',(parseInt(jitter)||0)+' ms');\r\n}\r\n\r\nfunction onVersionInfo(current, newVer, hasUpdate){\r\n  if(current){ setEl('lbl-version-current','V. '+current); }\r\n  if(hasUpdate && newVer){\r\n    setEl('lbl-version-new','V. '+newVer);\r\n    show('btn-new-version');\r\n    showClass('btn-install-update','show');\r\n  }\r\n}\r\n\r\nfunction onMessage(text){\r\n  if(!text) return;\r\n  setEl('msg-text', text);\r\n  showClass('message-card','show');\r\n}\r\n\r\nfunction onLoadServers(jsonStr){\r\n  try{\r\n    var srvs = JSON.parse(jsonStr);\r\n    renderServerList(srvs);\r\n  }catch(e){ addLog('Erro ao carregar servidores: '+e,'ERROR'); }\r\n}\r\n\r\nfunction onLoadMethods(jsonStr){\r\n  try{\r\n    methods = JSON.parse(jsonStr);\r\n    if(!methods||!methods.length) methods = DEFAULT_METHODS;\r\n    renderMethodList();\r\n  }catch(e){ methods = DEFAULT_METHODS; renderMethodList(); }\r\n}\r\n\r\nfunction onTimeUpdate(seconds, maxSeconds){\r\n  var s=parseInt(seconds)||0, m=parseInt(maxSeconds)||1800;\r\n  var mm=Math.floor(s\/60), ss=s%60;\r\n  setEl('time-remaining', pad(mm)+':'+pad(ss));\r\n  var pct=Math.max(0,Math.min(100,(s\/m)*100));\r\n  var el=document.getElementById('time-bar-fill');\r\n  if(el) el.style.width=pct+'%';\r\n  showClass('time-card','show');\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 VPN CONTROL \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction toggleVPN(){\r\n  if(vpnState==='disconnected'||vpnState==='error') startConnect();\r\n  else if(vpnState==='connected') disconnect();\r\n}\r\n\r\nfunction startConnect(){\r\n  setVpnState('connecting');\r\n  addLog('Iniciando conex\u00E3o...','INFO');\r\n  try{ Android.connect(JSON.stringify({method:currentMethod})); }catch(e){ addLog('Erro ao conectar: '+e,'ERROR'); }\r\n}\r\n\r\nfunction disconnect(){\r\n  setVpnState('disconnected');\r\n  addLog('Conex\u00E3o encerrada pelo usu\u00E1rio','INFO');\r\n  try{ Android.disconnect(); }catch(e){}\r\n}\r\n\r\nfunction setVpnState(state){\r\n  vpnState = state;\r\n  document.body.className = '';\r\n  var title = document.getElementById('status-title');\r\n  var speedRow = document.getElementById('speed-row');\r\n\r\n  if(state==='connected'){\r\n    document.body.classList.add('st-conectado');\r\n    title.textContent = 'CONEX\u00C3O ESTABELECIDA';\r\n    startTimer();\r\n    if(speedRow) speedRow.style.display='grid';\r\n    showClass('timer-bar','show');\r\n    addLog('VPN conectada com sucesso','INFO');\r\n  } else if(state==='connecting'){\r\n    document.body.classList.add('st-conectando');\r\n    title.textContent = 'CONECTANDO...';\r\n    stopTimer();\r\n    if(speedRow) speedRow.style.display='none';\r\n  } else if(state==='error'){\r\n    document.body.classList.add('st-erro');\r\n    title.textContent = 'ERRO DE CONEX\u00C3O';\r\n    stopTimer();\r\n    if(speedRow) speedRow.style.display='none';\r\n    hideClass('timer-bar','show');\r\n    addLog('Erro na conex\u00E3o VPN','ERROR');\r\n    showToast('Falha ao conectar','err');\r\n  } else {\r\n    title.textContent = 'DESCONECTADO';\r\n    stopTimer();\r\n    if(speedRow) speedRow.style.display='none';\r\n    hideClass('timer-bar','show');\r\n    totalDL=0;totalUL=0;\r\n    setEl('speed-dl','0.00');setEl('speed-ul','0.00');\r\n    setEl('speed-big-dl','0.00');setEl('speed-big-ul','0.00');\r\n  }\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 TIMER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction startTimer(){\r\n  stopTimer();\r\n  connectionSeconds=0;\r\n  connectionTimer=setInterval(function(){\r\n    connectionSeconds++;\r\n    var h=Math.floor(connectionSeconds\/3600);\r\n    var m=Math.floor((connectionSeconds%3600)\/60);\r\n    var s=connectionSeconds%60;\r\n    setEl('timer-val',pad(h)+':'+pad(m)+':'+pad(s));\r\n  },1000);\r\n}\r\nfunction stopTimer(){\r\n  if(connectionTimer){clearInterval(connectionTimer);connectionTimer=null;}\r\n  setEl('timer-val','00:00:00');\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 USER DATA CARD \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction updateUserCard(){\r\n  var d=userData;\r\n  if(!d||Object.keys(d).length===0) return;\r\n  setEl('cu-expiry', d.expiry||d.vencimento||'\u2014');\r\n  setEl('cu-days',   d.days||d.dias||'\u2014');\r\n  setEl('cu-limit',  d.limit||d.limite||'\u2014');\r\n  setEl('cu-key',    d.key||d.chave||'\u2014');\r\n  setEl('cu-adblock',d.adblock||d.bloqueio||'\u2014');\r\n  showClass('checkuser-card','show');\r\n\r\n  var credUser=d.user||d.usuario||'';\r\n  var credPass=d.pass||d.senha||'';\r\n  if(credUser){\r\n    var u=document.getElementById('creds-user-display');\r\n    var p=document.getElementById('creds-pass-display');\r\n    if(u) u.value=credUser;\r\n    if(p) p.value=credPass;\r\n    show('creds-block');\r\n  }\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 METHOD MODAL \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction renderMethodList(){\r\n  var list=document.getElementById('method-list');\r\n  if(!list) return;\r\n  list.innerHTML='';\r\n  (methods.length?methods:DEFAULT_METHODS).forEach(function(m){\r\n    var active=(currentMethod&&currentMethod.id===m.id)||(!currentMethod&&m.id==='v2ray');\r\n    var el=document.createElement('div');\r\n    el.className='method-item'+(active?' active-method':'');\r\n    el.innerHTML='<div><div class=\"mi-title\">'+m.icon+' '+m.name+'<\/div><div class=\"mi-sub\">'+m.sub+'<\/div><\/div><span class=\"mi-badge\">ATIVO<\/span>';\r\n    el.onclick=function(){selectMethod(m);};\r\n    list.appendChild(el);\r\n  });\r\n}\r\n\r\nfunction selectMethod(m){\r\n  currentMethod=m;\r\n  var sc=document.getElementById('sc-title');\r\n  var si=document.getElementById('sc-icon');\r\n  if(sc) sc.textContent=m.name+(m.country?' - '+m.country:'');\r\n  if(si) si.textContent=m.icon||'\uD83C\uDF10';\r\n  renderMethodList();\r\n  closeMethodModal();\r\n  addLog('M\u00E9todo selecionado: '+m.name,'INFO');\r\n  if(vpnState==='connected'){disconnect();setTimeout(startConnect,600);}\r\n}\r\n\r\nfunction openMethodModal(){\r\n  renderMethodList();\r\n  document.getElementById('method-modal-mask').classList.add('show');\r\n}\r\nfunction closeMethodModal(e){\r\n  if(!e||e.target===document.getElementById('method-modal-mask'))\r\n    document.getElementById('method-modal-mask').classList.remove('show');\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 CREDS MODAL \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction openCredsModal(){\r\n  try{\r\n    var d=JSON.parse(Android.getCredentials()||'{}');\r\n    var u=document.getElementById('creds-user-input');\r\n    var p=document.getElementById('creds-pass-input');\r\n    var uid=document.getElementById('creds-uuid-input');\r\n    if(u) u.value=d.user||d.usuario||'';\r\n    if(p) p.value=d.pass||d.senha||'';\r\n    if(uid) uid.value=d.uuid||d.key||'';\r\n  }catch(e){}\r\n  document.getElementById('creds-modal-mask').classList.add('show');\r\n}\r\nfunction closeCredsModal(e){\r\n  if(!e||e.target===document.getElementById('creds-modal-mask'))\r\n    document.getElementById('creds-modal-mask').classList.remove('show');\r\n}\r\nfunction saveCreds(){\r\n  var u=document.getElementById('creds-user-input').value.trim();\r\n  var p=document.getElementById('creds-pass-input').value;\r\n  var uuid=document.getElementById('creds-uuid-input').value.trim();\r\n  try{ Android.saveCredentials(JSON.stringify({user:u,pass:p,uuid:uuid})); }catch(e){}\r\n  var du=document.getElementById('creds-user-display');\r\n  var dp=document.getElementById('creds-pass-display');\r\n  if(du) du.value=u;\r\n  if(dp) dp.value=p;\r\n  if(u) show('creds-block');\r\n  closeCredsModal();\r\n  showToast('Credenciais salvas','ok');\r\n  addLog('Credenciais atualizadas','INFO');\r\n}\r\nfunction togglePassVis(){\r\n  var p=document.getElementById('creds-pass-input');\r\n  if(p) p.type=p.type==='password'?'text':'password';\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 LOGS MODAL \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction showLogs(){\r\n  document.getElementById('logs-modal-mask').classList.add('show');\r\n}\r\nfunction closeLogsModal(e){\r\n  if(!e||e.target===document.getElementById('logs-modal-mask'))\r\n    document.getElementById('logs-modal-mask').classList.remove('show');\r\n}\r\nfunction copyLogs(){\r\n  var txt=logs.map(function(l){return l.time+' ['+l.type+'] '+l.msg;}).join('\\n');\r\n  try{ Android.copyText(txt); }catch(e){ navigator.clipboard&&navigator.clipboard.writeText(txt); }\r\n  showToast('Logs copiados','ok');\r\n}\r\nfunction clearLogs(){\r\n  logs=[];\r\n  var c=document.getElementById('log-container');\r\n  if(c) c.innerHTML='';\r\n}\r\n\r\nfunction addLog(msg, type){\r\n  type=type||'INFO';\r\n  var now=new Date();\r\n  var time=pad(now.getHours())+':'+pad(now.getMinutes())+':'+pad(now.getSeconds());\r\n  logs.push({time:time,msg:msg,type:type});\r\n  var c=document.getElementById('log-container');\r\n  if(c){\r\n    var e=document.createElement('div');\r\n    e.className='log-entry '+type;\r\n    e.innerHTML='<span class=\"log-time\">'+time+'<\/span><span class=\"log-msg\">'+escHtml(msg)+'<\/span>';\r\n    c.appendChild(e);\r\n    c.scrollTop=c.scrollHeight;\r\n  }\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 SERVER LIST \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction renderServerList(srvs){\r\n  var list=document.getElementById('server-list');\r\n  if(!list) return;\r\n  if(!srvs||!srvs.length){\r\n    list.innerHTML='<div style=\"text-align:center;padding:40px 0;color:var(--muted);font-size:13px;\">Nenhum servidor dispon\u00EDvel<\/div>';\r\n    return;\r\n  }\r\n  list.innerHTML=srvs.map(function(s,i){\r\n    return '<div class=\"list-item'+(i===0?' selected':'')+'\" onclick=\"selectServerFromList(\\''+escAttr(s.name)+'\\',\\''+escAttr(s.icon||s.flag||'\uD83C\uDF10')+'\\',\\''+escAttr(s.id||String(i))+'\\',this)\">'\r\n      +'<div class=\"li-icon\">'+(s.icon||s.flag||'\uD83C\uDF10')+'<\/div>'\r\n      +'<div class=\"li-main\"><div class=\"li-title\">'+escHtml(s.name)+'<\/div>'\r\n      +'<div class=\"li-sub\">'+(s.type||'V2Ray')+(s.ping?' \u00B7 '+s.ping+' ms':'')+'<\/div><\/div>'\r\n      +'<span class=\"li-check\">\u2713<\/span>'\r\n      +'<\/div>';\r\n  }).join('');\r\n}\r\nfunction selectServerFromList(name,icon,id,el){\r\n  document.querySelectorAll('#server-list .list-item').forEach(function(x){x.classList.remove('selected');});\r\n  el.classList.add('selected');\r\n  var sm=currentMethod||{};\r\n  sm.serverName=name; sm.serverId=id;\r\n  currentMethod=sm;\r\n  setEl('sc-title',name);\r\n  setEl('sc-icon',icon);\r\n  showPage('home',document.getElementById('nav-home'));\r\n  addLog('Servidor selecionado: '+name,'INFO');\r\n  if(vpnState==='connected'){disconnect();setTimeout(startConnect,600);}\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 TOOLS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction toolPing(){\r\n  showToast('Verificando ping...','');\r\n  addLog('Iniciando teste de ping','DEBUG');\r\n  try{ Android.checkPing(); }catch(e){ addLog('Ping n\u00E3o dispon\u00EDvel','WARNING'); }\r\n}\r\nfunction toolDNS(){\r\n  showToast('Consultando DNS...','');\r\n  addLog('Iniciando consulta DNS','DEBUG');\r\n  try{ Android.checkDNS(); }catch(e){ addLog('DNS n\u00E3o dispon\u00EDvel','WARNING'); }\r\n}\r\nfunction toolPort(){\r\n  showToast('Verificando porta...','');\r\n  addLog('Iniciando verifica\u00E7\u00E3o de porta','DEBUG');\r\n  try{ Android.checkPort(); }catch(e){ addLog('Verifica\u00E7\u00E3o n\u00E3o dispon\u00EDvel','WARNING'); }\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 UPDATE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction installUpdate(){\r\n  addLog('Solicitando instala\u00E7\u00E3o de atualiza\u00E7\u00E3o','INFO');\r\n  try{ Android.installUpdate(); }catch(e){ addLog('Erro ao instalar: '+e,'ERROR'); }\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 AD \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction watchAd(){\r\n  var btn=document.getElementById('watch-ad-btn');\r\n  if(btn){ btn.disabled=true; btn.textContent='Carregando...'; }\r\n  addLog('Carregando an\u00FAncio','DEBUG');\r\n  try{\r\n    Android.showAd();\r\n  }catch(e){\r\n    if(btn){ btn.disabled=false; btn.textContent='\u25B6 ASSISTIR AN\u00DANCIO (+30 MIN)'; }\r\n    addLog('Erro ao carregar an\u00FAncio','ERROR');\r\n  }\r\n}\r\nfunction onAdComplete(){\r\n  var btn=document.getElementById('watch-ad-btn');\r\n  if(btn){ btn.disabled=false; btn.textContent='\u25B6 ASSISTIR AN\u00DANCIO (+30 MIN)'; }\r\n  showToast('+30 minutos adicionados','ok');\r\n  addLog('An\u00FAncio conclu\u00EDdo, tempo adicionado','INFO');\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 COPY CONFIG \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction copyConfig(){\r\n  var cfg=JSON.stringify({method:currentMethod,user:document.getElementById('creds-user-input')&&document.getElementById('creds-user-input').value||''},null,2);\r\n  try{ Android.copyText(cfg); }catch(e){ navigator.clipboard&&navigator.clipboard.writeText(cfg); }\r\n  showToast('Configura\u00E7\u00E3o copiada','ok');\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 NAV \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction showPage(name, btn){\r\n  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});\r\n  document.querySelectorAll('.nav-btn').forEach(function(b){b.classList.remove('active');});\r\n  var p=document.getElementById('page-'+name);\r\n  if(p) p.classList.add('active');\r\n  if(btn) btn.classList.add('active');\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 TOAST \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction showToast(msg, type){\r\n  var t=document.getElementById('toast');\r\n  t.textContent=msg;\r\n  t.className='toast show'+(type?' '+type:'');\r\n  setTimeout(function(){t.className='toast';},2600);\r\n}\r\n\r\n\/\/ \u2500\u2500\u2500 HELPERS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\nfunction setEl(id,val){ var e=document.getElementById(id); if(e) e.textContent=val; }\r\nfunction show(id){ var e=document.getElementById(id); if(e) e.style.display=''; }\r\nfunction hide(id){ var e=document.getElementById(id); if(e) e.style.display='none'; }\r\nfunction showClass(id,cls){ var e=document.getElementById(id); if(e) e.classList.add(cls); }\r\nfunction hideClass(id,cls){ var e=document.getElementById(id); if(e) e.classList.remove(cls); }\r\nfunction pad(n){ return n<10?'0'+n:String(n); }\r\nfunction fmtBytes(mb){\r\n  if(mb>=1024) return (mb\/1024).toFixed(1)+' GB';\r\n  return mb.toFixed(0)+' MB';\r\n}\r\nfunction escHtml(s){ return String(s).replace(\/&\/g,'&amp;').replace(\/<\/g,'&lt;').replace(\/>\/g,'&gt;'); }\r\nfunction escAttr(s){ return String(s).replace(\/'\/g,\"\\\\'\").replace(\/\"\/g,'&quot;'); }\r\n\r\n\/\/ \u2500\u2500\u2500 INIT \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\ndocument.addEventListener('DOMContentLoaded', function(){\r\n  addLog('YUMEKO VPN iniciado','INFO');\r\n  renderMethodList();\r\n\r\n  \/\/ Try loading servers\r\n  try{\r\n    var raw=Android.getMethods();\r\n    if(raw&&raw!=='[]') onLoadMethods(raw);\r\n  }catch(e){}\r\n  try{\r\n    var srvRaw=Android.getServers();\r\n    if(srvRaw&&srvRaw!=='[]') onLoadServers(srvRaw);\r\n  }catch(e){}\r\n\r\n  \/\/ Set default method display\r\n  var def=DEFAULT_METHODS[0];\r\n  setEl('sc-title', def.name);\r\n  setEl('sc-icon', def.icon);\r\n  currentMethod=def;\r\n});\r\n<\/script>\r\n<\/body>\r\n<\/html>\n@"
    }
