  document.getElementById("s_SSLPort").value = s.SSLPort||"443";
  document.getElementById("s_ProxyHost").value = s.ProxyHost||"";
  document.getElementById("s_ProxyPort").value = s.ProxyPort||"80";
  document.getElementById("s_USER").value = s.USER||"";
  document.getElementById("s_PASS").value = s.PASS||"";
  document.getElementById("s_Payload").value = s.Payload||"";
  document.getElementById("s_Sni").value = s.Sni||"";
