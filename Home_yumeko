{"version": "85", "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<title>VB INJECTOR // NEXUS</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root {\n  --bg: #04060a;\n  --bg2: #070b10;\n  --panel: rgba(13,18,24,.86);\n  --panel-border: rgba(204,255,0,.14);\n  --panel-border-strong: rgba(0,255,242,.26);\n  --accent: #ccff00;\n  --accent2: #00fff2;\n  --green: #39ff88;\n  --yellow: #ffd23f;\n  --red: #ff4d6d;\n  --text: #eef5f2;\n  --muted: #34403f;\n  --muted2: #7c8d8a;\n  --mono: 'IBM Plex Mono', monospace;\n  --sans: 'Sora', sans-serif;\n}\n* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\nhtml, body { height: 100%; background: var(--bg); overflow: hidden; }\nbody { font-family: var(--sans); color: var(--text); }\n\n.mesh-bg { position: fixed; inset: 0; z-index: 0; background: radial-gradient(ellipse 100% 60% at 80% 0%, rgba(0,255,242,.08), transparent 60%), radial-gradient(ellipse 90% 50% at 10% 100%, rgba(204,255,0,.06), transparent 60%), var(--bg); }\n.mesh-bg::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px); background-size: 100% 34px; pointer-events: none; }\n\n.app-shell { position: relative; z-index: 1; width: 100%; max-width: 480px; margin: 0 auto; height: 100vh; display: flex; flex-direction: row; padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom); }\n\n/* ── PAINEL: corte de canto único (estilo ticket) ── */\n.panel {\n  background: var(--panel);\n  border: 1px solid var(--panel-border);\n  clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);\n  position: relative;\n}\n.panel::after { content: ''; position: absolute; top: 0; right: 0; width: 20px; height: 20px; background: linear-gradient(135deg, transparent 49%, var(--panel-border) 50%, transparent 51%); pointer-events: none; }\n\n/* ══════════ DOCK LATERAL (substitui nav inferior) ══════════ */\n.dock { width: 62px; flex: 0 0 62px; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 16px 0 18px; border-right: 1px solid var(--panel-border); background: rgba(8,11,15,.6); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }\n.dock-mark { width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(155deg, var(--accent), var(--accent2)); display: grid; place-items: center; font-weight: 800; font-size: 13px; color: #03100a; }\n.dock-nav { display: flex; flex-direction: column; gap: 6px; align-items: center; }\n.dock-btn { width: 44px; height: 44px; border-radius: 13px; border: none; background: transparent; display: grid; place-items: center; cursor: pointer; position: relative; transition: background .2s; }\n.dock-btn svg { width: 19px; height: 19px; color: var(--muted2); transition: color .2s; }\n.dock-btn.active { background: rgba(204,255,0,.1); }\n.dock-btn.active svg { color: var(--accent); }\n.dock-btn.active::before { content: ''; position: absolute; left: -10px; top: 50%; transform: translateY(-50%); width: 3px; height: 18px; background: var(--accent); border-radius: 4px; box-shadow: 0 0 8px var(--accent); }\n.dock-btn:active { transform: scale(.9); }\n.dock-net { width: 10px; height: 10px; border-radius: 50%; background: var(--red); }\n.dock-net.online { background: var(--green); box-shadow: 0 0 10px rgba(57,255,136,.9); }\n\n/* ══════════ STAGE (área de conteúdo) ══════════ */\n.stage { flex: 1; min-width: 0; display: flex; flex-direction: column; height: 100%; }\n\n/* ── TICKER (substitui o header tradicional) ── */\n.ticker { padding: 11px 16px 9px; border-bottom: 1px solid var(--panel-border); display: flex; align-items: center; justify-content: space-between; gap: 10px; flex: 0 0 auto; }\n.ticker-info { min-width: 0; flex: 1; overflow: hidden; }\n.ticker-brand { font-size: 12.5px; font-weight: 800; letter-spacing: .03em; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.ticker-sub { display: flex; align-items: center; gap: 7px; margin-top: 3px; }\n.ticker-ver { font-size: 9px; color: var(--muted2); font-family: var(--mono); }\n.ticker-net { display: inline-flex; align-items: center; gap: 4px; font-size: 8.5px; font-weight: 700; color: var(--muted2); font-family: var(--mono); }\n.ticker-net .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--muted); }\n.ticker-net.online .dot { background: var(--green); box-shadow: 0 0 6px rgba(57,255,136,.9); }\n.ticker-refresh { width: 32px; height: 32px; border-radius: 9px; background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); display: grid; place-items: center; cursor: pointer; flex: 0 0 auto; }\n.ticker-refresh svg { width: 14px; height: 14px; color: var(--accent2); }\n.ticker-refresh.spinning svg { animation: spin-slow 1s linear infinite; }\n@keyframes spin-slow { to { transform: rotate(360deg); } }\n\n.stage-body { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 10px 14px 12px; display: flex; flex-direction: column; gap: 10px; -webkit-overflow-scrolling: touch; }\n\n/* ── AVISO ── */\n.notice-card { display: none; padding: 13px 15px; gap: 11px; align-items: flex-start; background: linear-gradient(110deg, rgba(255,210,63,.08), var(--panel) 60%); border-color: rgba(255,210,63,.3); }\n.notice-card.show { display: flex; }\n.notice-icon { font-size: 21px; line-height: 1; }\n.notice-content { flex: 1; min-width: 0; }\n.notice-title { color: var(--yellow); font-weight: 800; font-size: 10.5px; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 4px; }\n.notice-msg { font-size: 12px; line-height: 1.5; color: var(--text); opacity: .9; }\n\n/* ── IP TICKER (