chip { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.04); border: 1px solid var(--panel-border); padding: 6px 11px; font-size: 10px; font-family: var(--mono); color: var(--muted2); cursor: pointer; transition: all .2s; border-radius: 8px; }\n.chip:active { opacity: .7; transform: scale(.96); }\n.chip .chip-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--muted); flex: 0 0 5px; }\n.chip.ok .chip-dot { background: var(--green); box-shadow: 0 0 6px rgba(57,255,136,.8); }\n.chip.bad .chip-dot { background: var(--red); }\n.chip.loading .chip-dot { background: var(--yellow); animation: blink 1s ease-in-out infinite; }\n@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: .3; } }\n.chip .chip-val { color: var(--text); font-weight: 700; }\n.signal-bars { display: inline-flex; align-items: flex-end; gap: 2px; height: 10px; }\n.signal-bars i { display: block; width: 2.5px; border-radius: 1px; background: var(--muted); }\n.signal-bars i:nth-child(1) { height: 4px; } .signal-bars i:nth-child(2) { height: 6.5px; } .signal-bars i:nth-child(3) { height: 9px; } .signal-bars i:nth-child(4) { height: 12px; }\n.signal-bars.lit-1 i:nth-child(1) { background: var(--red); }\n.signal-bars.lit-2 i:nth-child(1), .signal-bars.lit-2 i:nth-child(2) { background: var(--yellow); }\n.signal-bars.lit-3 i:nth-child(1), .signal-bars.lit-3 i:nth-child(2), .signal-bars.lit-3 i:nth-child(3) { background: #a3e635; }\n.signal-bars.lit-4 i { background: var(--green); }\n\n/* ── VINIL GIRATÓRIO ── */\n.vinyl-wrap { position: relative; width: 116px; height: 116px; flex: 0 0 116px; }\n.vinyl-arm { position: absolute; top: -8px; right: -2px; width: 5px; height: 52px; background: linear-gradient(var(--muted2), var(--muted)); border-radius: 4px; transform-origin: top center; transform: rotate(-38deg); transition: transform .5s cubic-bezier(.34,1.4,.64,1); z-index: 3; }\n.vinyl-arm::after { content: ''; position: absolute; bottom: -3px; left: 50%; transform: translateX(-50%); width: 9px; height: 9px; border-radius: 50%; background: var(--accent2); box-shadow: 0 0 8px var(--accent2); }\nbody.connecting .vinyl-arm, body.connected .vinyl-arm { transform: rotate(8deg); }\n.vinyl-disc {\n  position: absolute; inset: 0; border-radius: 50%; cursor: pointer;\n  background: radial-gradient(circle at 50% 50%, #0c1310 0%, #050907 55%, #020403 100%);\n  box-shadow:\n    0 0 0 3px rgba(255,255,255,.045), 0 0 0 8px rgba(255,255,255,.035),\n    0 0 0 13px rgba(255,255,255,.045), 0 0 0 18px rgba(255,255,255,.03),\n    0 0 0 23px rgba(255,255,255,.04), 0 0 0 28px rgba(255,255,255,.025),\n    0 10px 30px rgba(0,0,0,.5);\n  transition: box-shadow .3s;\n}\n.vinyl-disc.spin { animation: vinyl-spin 3.2s linear infinite; }\nbody.connected .vinyl-disc { animation-duration: 4s; }\n@keyframes vinyl-spin { to { transform: rotate(360deg); } }\n.vinyl-label {\n  position: absolute; inset: 34px; border-radius: 50%;\n  background: linear-gradient(155deg, var(--accent), var(--accent2));\n  display: grid; place-items: center; color: #03100a;\n  box-shadow: 0 0 0 2px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.3);\n}\nbody.connecting .vinyl-label { background: linear-gradient(155deg, var(--yellow), var(--accent2)); }\n.vinyl-label svg { width: 26px; height: 26px; }\n.vinyl-hole { position: absolute; inset: 50%; width: 6px; height: 6px; margin: -3px; border-radius: 50%; background: #04060a; box-shadow: 0 0 0 2px rgba(0,0,0,.5); z-index: 2; }\n.vinyl-pulse { position: absolute; inset: -10px; border-radius: 50%; border: 1.5px solid rgba(0,255,242,.25); opacity: 0; }\nbody.connected .vinyl-pulse { animation: vinyl-pulse 2.4s ease-out infinite; }\n@keyframes vinyl-pulse { 0% { opacity: .8; transform: scale(.85); } 100% { opacity: 0; transform: scale(1.25); } }\n\n.connect-pill { margin-top: 2px; align-self: flex-start; padding: 9px 22px; border: none; background: linear-gradient(110deg, var(--accent), var(--accent2)); font-size: 11.5px; font-weight: 800; letter-spacing: .03em; color: #03100a; cursor: pointer; border-radius: 9px; transition: all .2s; box-shadow: 0 6px 18px rgba(204,255,0,.22); }\n.connect-pill:active { transform: scale(.95); }\nbody.connected .connect-pill { background: linear-gradient(110deg, var(--red), #c4123f); color: #fff; box-shadow: 0 6px 18px rgba(255,77,109,.25); }\nbody.connecting .connect-pill { background: linear-gradient(110deg, var(--yellow), var(--accent2)); color: #1d1505; }\n\n/* ── GAUGE DE VELOCIDADE ── */\n.speedtest-panel { padding: 16px; display: none; flex-direction: column; align-items: center; }\n.speedtest-panel.show { display: flex; }\n.gauge-wrap { position: relative; width: 150px; height: 84px; }\n.gauge-bg { position: absolute; top: 0; left: 0; width: 150px; height: 75px; border-radius: 150px 150px 0 0; background: conic-gradient(from 270deg at 50% 100%, var(--red) 0deg, var(--yellow) 90deg, var(--green) 180deg); clip-path: polygon(0 100%, 0 30%, 4% 16%, 10% 8%, 50% 0%, 90% 8%, 96% 16%, 100% 30%, 100% 100%, 88% 100%, 88% 35%, 50% 14%, 12% 35%, 12% 100%); opacity: .28; }\n.gauge-needle { position: absolute; left: 50%; bottom: 0; width: 2.5px; height: 64px; background: var(--accent2); transform-origin: bottom center; transform: rotate(-90deg); transition: transform .6s cubic-bezier(.34,1.56,.64,1); box-shadow: 0 0 9px rgba(0,255,242,.7); }\n.gauge-needle::after { content: ''; position: absolute; bottom: -5px; left: -4px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent2); }\n.gauge-val { margin-top: 9px; font-family: var(--mono); font-size: 24px; font-weight: 800; color: var(--accent2); }\n.gauge-unit { font-size: 10.5px; color: var(--muted2); }\n.gauge-close { margin-top: 10px; font-size: 10px; color: var(--muted2); cursor: pointer; font-weight: 600; }\n\n.speed-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.speed-card { padding: 11px 14px; }\n.speed-label { font-size: 8.5px; font-weight: 700; color: var(--muted2); letter-spacing: .08em; }\n.speed-val { font-size: 17px; font-weight: 800; margin-top: 5px; color: var(--text); font-family: var(--mono); }\n\n/* ══════════ CARROSSEL HORIZONTAL DE SELEÇÃO ══════════ */\n.mode-tabs { display: flex; gap: 7px; padding: 0 2px; }\n.mode-tab { padding: 9px 18px; border: 1px solid var(--panel-border); background: rgba(255,255,255,.03); font-size: 11.5px; font-weight: 700; letter-spacing: .02em; color: var(--muted2); cursor: pointer; border-radius: 9px; transition: all .2s; font-family: var(--sans); }\n.mode-tab.active { background: rgba(204,255,0,.12); border-color: rgba(204,255,0,.4); color: var(--accent); }\n\n.carousel { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 2px 2px 6px; -webkit-overflow-scrolling: touch; }\n.carousel::-webkit-scrollbar { display: none; }\n.carousel-card { flex: 0 0 82%; scroll-snap-align: start; padding: 15px 16px; display: flex; align-items: center; gap: 12px; cursor: pointer; }\n.carousel-icon { width: 40px; height: 40px; background: linear-gradient(150deg, rgba(204,255,0,.16), rgba(0,255,242,.1)); border: 1px solid var(--panel-border); display: grid; place-items: center; font-size: 18px; flex: 0 0 40px; border-radius: 11px; position: relative; }\n.carousel-meta { flex: 1; min-width: 0; }\n.carousel-label { font-size: 8.5px; font-weight: 800; color: var(--accent2); letter-spacing: .1em; text-transform: uppercase; font-family: var(--mono); }\n.carousel-name { font-size: 14px; font-weight: 700; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.carousel-sub { font-size: 10px; color: var(--muted2); margin-top: 2px; }\n.carousel-chev { color: var(--muted); font-size: 16px; flex: 0 0 auto; }\n\n.cred-label { font-size: 10.5px; font-weight: 700; color: var(--muted2); margin: 11px 0 6px; }\n.cred-label:first-child { margin-top: 0; }\n.cred-input { width: 100%; background: rgba(255,255,255,.04); border: 1px solid var(--panel-border); padding: 12px 14px; color: var(--text); font-size: 13.5px; outline: none; font-family: var(--sans); border-radius: 9px; }\n.cred-input::placeholder { color: var(--muted); }\n.cred-input:focus { border-color: var(--accent2); }\n\n.msg-card { padding: 12px 15px; display: flex; align-items: flex-start; gap: 10px; }\n.msg-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent2); flex: 0 0 6px; margin-top: 5px; }\n.msg-text { font-size: 11.5px; color: var(--muted2); line-height: 1.5; }\n\n/* ── OVERLAY / MODAL ── */\n.overlay { position: fixed; inset: 0; z-index: 100; background: rgba(2,3,5,.8); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); display: none; align-items: center; padding: 20px; }\n.overlay.show { display: flex; }\n.modal { width: 100%; max-width: 360px; margin: 0 auto; background: #060a0d; border: 1px solid var(--panel-border-strong); max-height: 76vh; overflow-y: auto; box-shadow: 0 24px 70px rgba(0,0,0,.6); border-radius: 4px 22px 4px 4px; }\n.modal-pad { padding: 22px 20px; }\n.modal-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(0,255,242,.1); border: 1px solid rgba(0,255,242,.3); color: var(--accent2); font-size: 10px; font-weight: 700; letter-spacing: .04em; padding: 6px 13px; margin-bottom: 15px; border-radius: 8px; font-family: var(--mono); }\n.modal-title { font-size: 18px; font-weight: 800; margin-bottom: 7px; }\n.modal-sub { font-size: 12.5px; color: var(--muted2); margin-bottom: 18px; line-height: 1.5; }\n.modal-btn { width: 100%; padding: 13px; border: none; font-size: 12.5px; font-weight: 800; cursor: pointer; margin-bottom: 9px; display: flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--sans); border-radius: 9px; }\n.modal-btn:last-child { margin-bottom: 0; }\n.modal-btn:active { opacity: .85; }\n.modal-btn-minimize { background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); color: var(--text); }\n.modal-btn-exit { background: linear-gradient(110deg, var(--red), #c4123f); color: #fff; }\n.modal-btn-cancel { background: rgba(255,255,255,.04); border: 1px solid var(--panel-border); color: var(--muted2); }\n.modal-btn-save { background: linear-gradient(110deg, var(--accent), var(--accent2)); color: #03100a; }\n\n.sheet-title { font-size: 10.5px; font-weight: 800; color: var(--text); letter-spacing: .06em; text-transform: uppercase; padding: 18px 18px 13px; border-bottom: 1px solid var(--panel-border); display: flex; align-items: center; justify-content: space-between; }\n.sheet-hint { color: var(--muted); font-size: 9px; text-transform: none; }\n.sheet-item { display: flex; align-items: center; gap: 12px; padding: 13px 18px; cursor: pointer; transition: background .15s; border-bottom: 1px solid rgba(255,255,255,.03); }\n.sheet-item:active { background: rgba(255,255,255,.02); }\n.sheet-item-icon { width: 40px; height: 40px; background: linear-gradient(150deg, rgba(204,255,0,.16), rgba(0,255,242,.1)); border: 1px solid var(--panel-border); border-radius: 11px; display: grid; place-items: center; font-size: 17px; flex: 0 0 40px; }\n.sheet-item-meta { flex: 1; min-width: 0; }\n.sheet-item-name { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.sheet-item-sub { font-size: 9.5px; color: var(--muted2); margin-top: 2px; text-transform: uppercase; letter-spacing: .06em; }\n.sheet-item-check { color: var(--green); display: none; flex: 0 0 auto; }\n.sheet-item.selected .sheet-item-check { display: block; }\n.sheet-item.selected { background: rgba(57,255,136,.04); }\n.fav-star { font-size: 16px; flex: 0 0 auto; padding: 4px; opacity: .3; transition: all .15s; cursor: pointer; }\n.fav-star.active { opacity: 1; color: var(--yellow); filter: drop-shadow(0 0 5px rgba(255,210,63,.6)); }\n.fav-star:active { transform: scale(1.3); }\n\n/* ── LOGS ── */\n.logs-page { position: fixed; inset: 0; z-index: 90; background: var(--bg); display: none; flex-direction: column; }\n.logs-page.show { display: flex; }\n.logs-header { padding: 16px 16px 12px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--panel-border); }\n.logs-title { font-size: 10.5px; font-weight: 800; color: var(--text); letter-spacing: .06em; text-transform: uppercase; }\n.logs-actions { display: flex; gap: 8px; }\n.logs-btn { padding: 7px 12px; font-size: 9.5px; font-weight: 700; background: rgba(255,255,255,.04); border: 1px solid var(--panel-border); color: var(--text); cursor: pointer; font-family: var(--sans); border-radius: 7px; text-transform: uppercase; }\n.logs-btn:active { opacity: .7; }\n.logs-body { flex: 1; overflow-y: auto; padding: 8px 0; font-family: var(--mono); font-size: 11px; background: rgba(0,0,0,.25); }\n.log-line { display: flex; align-items: flex-start; gap: 8px; padding: 4px 14px; border-bottom: 1px solid rgba(255,255,255,.02); line-height: 1.5; word-break: break-all; }\n.log-line .log-time { flex: 0 0 auto; color: #1e2925; font-size: 9.5px; padding-top: 1px; white-space: nowrap; }\n.log-line .log-msg { flex: 1; }\n.log-line.info .log-msg { color: #5d6f6c; }\n.log-line.ok { background: rgba(57,255,136,.04); } .log-line.ok .log-msg { color: #5ef99a; font-weight: 600; }\n.log-line.warn .log-msg { color: var(--yellow); }\n.log-line.err { background: rgba(255,77,109,.05); } .log-line.err .log-msg { color: var(--red); }\n.log-line.sep .log-msg { color: #1e2925; letter-spacing: .1em; font-size: 9.5px; text-align: center; width: 100%; }\n.logs-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 200px; gap: 10px; color: var(--muted); font-size: 12px; }\n.logs-footer { padding: 10px 16px; border-top: 1px solid var(--panel-border); display: flex; align-items: center; justify-content: space-between; }\n.autoscroll-toggle { display: flex; align-items: center; gap: 8px; font-size: 10.5px; color: var(--muted2); }\n\n/* ── CONFIG ── */\n.settings-page { position: fixed; inset: 0; z-index: 90; background: var(--bg); display: none; flex-direction: column; }\n.settings-page.show { display: flex; }\n.settings-body { flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; }\n.settings-section-title { font-size: 10.5px; font-weight: 800; letter-spacing: .06em; color: var(--accent2); text-transform: uppercase; margin-top: 10px; margin-bottom: 2px; }\n.settings-section-title:first-child { margin-top: 0; }\n.setting-item { background: var(--panel); border: 1px solid var(--panel-border); border-radius: 12px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; cursor: pointer; }\n.setting-item:active { background: rgba(255,255,255,.03); }\n.setting-item svg { width: 19px; height: 19px; color: var(--accent2); flex: 0 0 19px; }\n.setting-item-meta { flex: 1; min-width: 0; }\n.setting-item-title { font-size: 13.5px; font-weight: 700; }\n.setting-item-sub { font-size: 10.5px; color: var(--muted2); margin-top: 2px; }\n.setting-item-chev { color: var(--muted); flex: 0 0 auto; }\n\n.switch { width: 44px; height: 26px; background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); border-radius: 7px; position: relative; flex: 0 0 auto; transition: background .2s; cursor: pointer; }\n.switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 5px; background: var(--muted2); transition: all .2s; }\n.switch.on { background: rgba(57,255,136,.16); border-color: rgba(57,255,136,.4); }\n.switch.on::after { left: 22px; background: var(--green); }\n\n/* ── APARÊNCIA: prévia + grade ── */\n.theme-current-label { font-size: 11px; color: var(--muted2); margin-bottom: 7px; }\n.theme-current-label span { color: var(--accent2); font-weight: 800; }\n\n.theme-preview-card { padding: 15px 16px; margin-bottom: 4px; }\n.theme-preview-title { font-size: 9px; font-weight: 800; color: var(--muted2); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 12px; }\n.theme-preview-row { display: flex; align-items: center; gap: 14px; }\n.theme-preview-disc { width: 50px; height: 50px; flex: 0 0 50px; border-radius: 50%; background: radial-gradient(circle, #0c1310, #050907 60%); box-shadow: 0 0 0 2px rgba(255,255,255,.05), 0 0 0 6px rgba(255,255,255,.04), 0 0 0 10px rgba(255,255,255,.03); display: grid; place-items: center; animation: vinyl-spin 4s linear infinite; }\n.theme-preview-disc-label { width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(155deg, var(--accent), var(--accent2)); display: grid; place-items: center; color: #03100a; }\n.theme-preview-meta { flex: 1; min-width: 0; }\n.theme-preview-status { font-size: 9.5px; font-weight: 800; letter-spacing: .06em; color: var(--text); margin-bottom: 9px; text-transform: uppercase; }\n.theme-preview-btn { padding: 8px 16px; border: none; background: linear-gradient(110deg, var(--accent), var(--accent2)); color: #03100a; font-size: 10.5px; font-weight: 800; cursor: default; font-family: var(--sans); border-radius: 8px; }\n\n.palette-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 9px; }\n.palette-item { display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; padding: 8px 4px; border-radius: 12px; transition: transform .15s, background .2s; }\n.palette-item:active { transform: scale(.92); }\n.palette-item.selected { background: rgba(255,255,255,.04); animation: palette-pop .3s ease; }\n@keyframes palette-pop { 0% { transform: scale(1); } 40% { transform: scale(1.08); } 100% { transform: scale(1); } }\n.palette-circle { width: 40px; height: 40px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.15); position: relative; transition: box-shadow .2s; }\n.palette-item.selected .palette-circle { box-shadow: 0 0 0 3px rgba(255,255,255,.08), 0 0 16px rgba(0,255,242,.3); }\n.palette-circle .check { position: absolute; top: -4px; right: -4px; width: 15px; height: 15px; border-radius: 50%; background: var(--accent2); color: #03100a; font-size: 9px; display: flex; align-items: center; justify-content: center; opacity: 0; }\n.palette-item.selected .check { opacity: 1; }\n.palette-label { font-size: 10px; font-weight: 700; color: var(--muted2); }\n.palette-item.selected .palette-label { color: var(--text); }\n\n.bg-color-row { display: flex; align-items: center; gap: 10px; background: var(--panel); border: 1px solid var(--panel-border); padding: 12px 14px; border-radius: 12px; }\n#bg-color-input { width: 40px; height: 40px; border: none; border-radius: 50%; padding: 0; background: none; cursor: pointer; box-shadow: 0 0 0 2px var(--accent2), 0 0 14px rgba(0,255,242,.4); transition: box-shadow .2s; }\n#bg-color-input:active { box-shadow: 0 0 0 3px var(--accent2), 0 0 20px rgba(0,255,242,.6); }\n#bg-color-input::-webkit-color-swatch-wrapper { padding: 2px; border-radius: 50%; }\n#bg-color-input::-webkit-color-swatch { border-radius: 50%; border: 2px solid rgba(255,255,255,0.3); }\n.bg-color-reset { background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); color: var(--muted2); font-size: 10.5px; font-weight: 700; padding: 8px 12px; cursor: pointer; border-radius: 8px; }\n\n.diag-box { background: rgba(0,0,0,.3); border: 1px solid var(--panel-border); padding: 12px 14px; font-family: var(--mono); font-size: 10px; color: var(--muted2); line-height: 1.6; white-space: pre-wrap; word-break: break-all; max-height: 220px; overflow-y: auto; border-radius: 9px; }\n\n.toast { position: fixed; bottom: 28px; left: calc(50% + 31px); transform: translateX(-50%) translateY(20px); background: rgba(6,10,13,.95); border: 1px solid var(--panel-border-strong); padding: 10px 18px; font-size: 11.5px; font-weight: 600; color: var(--text); z-index: 200; opacity: 0; transition: all .25s; white-space: nowrap; pointer-events: none; max-width: 80vw; overflow: hidden; text-overflow: ellipsis; border-radius: 9px; box-shadow: 0 12px 30px rgba(0,0,0,.4); }\n.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n\n@media (max-width: 340px) {\n  .dock { width: 54px; flex: 0 0 54px; }\n  .ticker { padding: 9px 12px 8px; }\n  .stage-body { padding: 8px 10px 10px; gap: 8px; }\n  .hero { padding: 14px 10px; gap: 10px; }\n  .vinyl-wrap { width: 96px; height: 96px; flex: 0 0 96px; }\n}\n</style>\n</head>\n<body>\n<div class=\"mesh-bg\"></div>\n<div class=\"app-shell\">\n\n  <!-- DOCK LATERAL -->\n  <nav class=\"dock\">\n    <div class=\"dock-mark\">VB</div>\n    <div class=\"dock-nav\">\n      <button class=\"dock-btn active\" onclick=\"showMain()\" title=\"Início\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>\n      </button>\n      <button class=\"dock-btn\" onclick=\"showLogs()\" title=\"Logs\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6M16 13H8\"/></svg>\n      </button>\n      <button class=\"dock-btn\" onclick=\"openSheet(app.mode === 'XRAY' ? 'xray' : 'ssh')\" title=\"Servidores\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/></svg>\n      </button>\n      <button class=\"dock-btn\" onclick=\"showSettings()\" title=\"Config\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      </button>\n    </div>\n    <div class=\"dock-net\" id=\"dock-net\"></div>\n  </nav>\n\n  <!-- STAGE -->\n  <div class=\"stage\">\n\n    <div class=\"ticker\">\n      <div class=\"ticker-info\">\n        <div class=\"ticker-brand\" id=\"app-name\">VB INJECTOR</div>\n        <div class=\"ticker-sub\">\n          <span class=\"ticker-ver\" id=\"config-ver\">v--</span>\n          <span class=\"ticker-ver\" id=\"html-ver\">h--</span>\n          <span class=\"ticker-net\" id=\"net-badge\"><span class=\"dot\"></span><span id=\"net-badge-text\">--</span></span>\n        </div>\n      </div>\n      <button class=\"ticker-refresh\" id=\"refresh-btn\" onclick=\"doUpdate()\" title=\"Atualizar\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      </button>\n    </div>\n\n    <div class=\"stage-body\" id=\"main-body\">\n\n      <div class=\"panel notice-card\" id=\"notice-bar\">\n        <div class=\"notice-icon\">📣</div>\n        <div class=\"notice-content\">\n          <div class=\"notice-title\" id=\"notice-title\">Aviso</div>\n          <div class=\"notice-msg\" id=\"notice-msg\"></div>\n        </div>\n      </div>\n\n      <div class=\"panel ip-strip\">\n        <div class=\"ip-led\"></div>\n        <div class=\"ip-strip-text\">\n          <span class=\"ip-value\" id=\"ip-value\">•••.•••.•••.•••</span>\n          <div class=\"ip-loc-line\" id=\"ip-status-line\">Toque em atualizar pra ver seu IP real</div>\n        </div>\n        <div class=\"ip-refresh-mini\" id=\"ip-loc\" onclick=\"refreshIpInfo()\">↻</div>\n      </div>\n\n      <div class=\"panel hero\">\n        <div class=\"hero-info\">\n          <div class=\"hero-status\" id=\"orb-label\">DESCONECTADO</div>\n          <div class=\"hero-sub\" id=\"orb-sub\">Toque no disco para conectar</div>\n          <div class=\"hero-timer\" id=\"timer\">\n            <span class=\"hero-timer-val\" id=\"timer-val\">00:00:00</span>\n            <span class=\"hero-timer-label\">tempo ativo</span>\n          </div>\n          <div class=\"hero-chips\">\n            <div class=\"chip\" id=\"ping-chip\" onclick=\"testPing()\">\n              <span class=\"chip-dot\"></span>\n              <span id=\"ping-label\">Latência</span>\n            </div>\n            <div class=\"chip\" id=\"speedtest-chip\" onclick=\"runSpeedTest()\">\n              <span class=\"chip-dot\"></span>\n              <span id=\"speedtest-label\">Velocidade</span>\n            </div>\n          </div>\n          <button class=\"connect-pill\" id=\"connect-btn\" onclick=\"doConnect()\">Conectar SSH</button>\n        </div>\n        <div class=\"vinyl-wrap\">\n          <div class=\"vinyl-pulse\"></div>\n          <div class=\"vinyl-arm\"></div>\n          <div class=\"vinyl-disc\" id=\"orb-btn\" onclick=\"doConnect()\">\n            <div class=\"vinyl-hole\"></div>\n          </div>\n          <div class=\"vinyl-label\" id=\"vinyl-label\" onclick=\"doConnect()\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n              <path id=\"orb-svg-path\" d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\"/>\n            </svg>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"panel speedtest-panel\" id=\"speedtest-panel\">\n        <div class=\"gauge-wrap\">\n          <div class=\"gauge-bg\"></div>\n          <div class=\"gauge-needle\" id=\"gauge-needle\"></div>\n        </div>\n        <div class=\"gauge-val\" id=\"gauge-val\">0.0</div>\n        <div class=\"gauge-unit\">Mbps de download</div>\n        <div class=\"gauge-close\" onclick=\"closeSpeedTest()\">Fechar</div>\n      </div>\n\n      <div class=\"speed-row\" id=\"speed-row\" style=\"display:none\">\n        <div class=\"panel speed-card\">\n          <div class=\"speed-label\">↓ DOWNLOAD</div>\n          <div class=\"speed-val\" id=\"speed-dl\">0 B/s</div>\n        </div>\n        <div class=\"panel speed-card\">\n          <div class=\"speed-label\">↑ UPLOAD</div>\n          <div class=\"speed-val\" id=\"speed-ul\">0 B/s</div>\n        </div>\n      </div>\n\n      <div class=\"mode-tabs\">\n        <button class=\"mode-tab\" id=\"mode-ssh\" onclick=\"setMode('SSH')\">SSH</button>\n        <button class=\"mode-tab\" id=\"mode-xray\" onclick=\"setMode('XRAY')\">XRAY</button>\n      </div>\n\n      <div class=\"carousel\">\n        <div class=\"panel carousel-card\" id=\"card-ssh\" onclick=\"openSheet('ssh')\">\n          <div class=\"carousel-icon\">🖥️</div>\n          <div class=\"carousel-meta\">\n            <div class=\"carousel-label\">Servidor SSH</div>\n            <div class=\"carousel-name\" id=\"ssh-name\">Selecionar servidor</div>\n            <div class=\"carousel-sub\" id=\"ssh-sub\">—</div>\n          </div>\n          <div class=\"carousel-chev\">›</div>\n        </div>\n\n        <div class=\"panel carousel-card\" id=\"card-payload\" onclick=\"openSheet('payload')\">\n          <div class=\"carousel-icon\">📦</div>\n          <div class=\"carousel-meta\">\n            <div class=\"carousel-label\">Payload</div>\n            <div class=\"carousel-name\" id=\"payload-name\">Selecionar payload</div>\n            <div class=\"carousel-sub\" id=\"payload-sub\">—</div>\n          </div>\n          <div class=\"carousel-chev\">›</div>\n        </div>\n\n        <div class=\"panel carousel-card\" id=\"card-xray\" style=\"display:none\" onclick=\"openSheet('xray')\">\n          <div class=\"carousel-icon\">⚡</div>\n          <div class=\"carousel-meta\">\n            <div class=\"carousel-label\">Perfil XRAY</div>\n            <div class=\"carousel-name\" id=\"xray-name\">Selecionar perfil</div>\n            <div class=\"carousel-sub\" id=\"xray-sub\">—</div>\n          </div>\n          <div class=\"carousel-chev\">›</div>\n        </div>\n      </div>\n\n      <div class=\"panel msg-card\" id=\"msg-card\" style=\"display:none\">\n        <div class=\"msg-dot\"></div>\n        <div class=\"msg-text\" id=\"msg-text\"></div>\n      </div>\n\n    </div>\n  </div>\n\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<div class=\"overlay\" id=\"exit-modal\" onclick=\"closeExitModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">👋 Até logo</div>\n    <div class=\"modal-title\">Sair do <span id=\"exit-modal-appname\">app</span></div>\n    <div class=\"modal-sub\">O que você deseja fazer?</div>\n    <button class=\"modal-btn modal-btn-minimize\" id=\"exit-modal-minimize\" onclick=\"exitModalMinimize()\">📱 Minimizar (segundo plano)</button>\n    <button class=\"modal-btn modal-btn-exit\" onclick=\"exitModalExit()\">🚪 Sair completamente</button>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"closeExitModal()\">↩️ Cancelar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"cred-modal\" onclick=\"closeCredModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">🔐 Login necessário</div>\n    <div class=\"modal-title\">Credenciais SSH</div>\n    <div class=\"modal-sub\">Esse servidor pede usuário e senha pra conectar.</div>\n    <div class=\"cred-label\">👤 Usuário</div>\n    <input type=\"text\" id=\"cred-user\" class=\"cred-input\" placeholder=\"Digite o usuário\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <div class=\"cred-label\">🔒 Senha</div>\n    <div style=\"position:relative;\">\n      <input type=\"password\" id=\"cred-pass\" class=\"cred-input\" placeholder=\"Digite a senha\" style=\"padding-right:42px;\">\n      <span id=\"cred-pass-toggle\" style=\"position:absolute; right:12px; top:50%; transform:translateY(-50%); cursor:pointer; font-size:15px; user-select:none;\">👁️</span>\n    </div>\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:16px;\" onclick=\"saveCredField(); closeCredModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"uuid-modal\" onclick=\"closeUuidModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">🔑 Ativação necessária</div>\n    <div class=\"modal-title\">UUID / Chave</div>\n    <div class=\"modal-sub\">Esse perfil é premium e precisa da chave de ativação.</div>\n    <div class=\"cred-label\">🔑 UUID</div>\n    <input type=\"text\" id=\"xray-uuid-input\" class=\"cred-input\" placeholder=\"Cole o UUID aqui\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:16px;\" onclick=\"saveUuidField(); closeUuidModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"autherror-modal\" onclick=\"closeAuthErrorModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\" style=\"background:rgba(255,77,109,.14); border-color:rgba(255,77,109,.4); color:var(--red);\">⚠️ Falha no login</div>\n    <div class=\"modal-title\" id=\"autherror-title\">Usuário ou senha incorretos</div>\n    <div class=\"modal-sub\" id=\"autherror-sub\">Não foi possível autenticar nesse servidor com as credenciais informadas. Confira e tente de novo.</div>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"fixCredsAfterAuthError()\">Corrigir credenciais</button>\n    <button class=\"modal-btn modal-btn-minimize\" onclick=\"closeAuthErrorModal()\">Fechar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"sheet-ssh\" onclick=\"closeSheet('ssh')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">    <div class=\"sheet-title\">Servidores SSH <span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n    <div id=\"ssh-list\"></div>\n  </div>\n</div>\n<div class=\"overlay\" id=\"sheet-payload\" onclick=\"closeSheet('payload')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-title\">Payloads</div>\n    <div id=\"payload-list\"></div>\n  </div>\n</div>\n<div class=\"overlay\" id=\"sheet-xray\" onclick=\"closeSheet('xray')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-title\">Perfis XRAY <span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n    <div id=\"xray-list\"></div>\n  </div>\n</div>\n\n<div class=\"logs-page\" id=\"logs-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">Logs de Conexão</div>\n    <div class=\"logs-actions\">\n      <button class=\"logs-btn\" onclick=\"copyLogs()\">Copiar</button>\n      <button class=\"logs-btn\" onclick=\"clearLogs()\" style=\"color:var(--red);border-color:rgba(255,77,109,.35)\">Limpar</button>\n      <button class=\"logs-btn\" onclick=\"hideLogs()\">✕</button>\n    </div>\n  </div>\n  <div class=\"logs-body\" id=\"logs-body\">\n    <div class=\"logs-empty\"><span style=\"font-size:28px\">📋</span><span>Aguardando logs...</span></div>\n  </div>\n  <div class=\"logs-footer\">\n    <div class=\"autoscroll-toggle\">\n      <div class=\"switch on\" id=\"autoscroll-switch\" onclick=\"toggleAutoscroll()\"></div>\n      <span>Rolagem automática</span>\n    </div>\n  </div>\n</div>\n\n<div class=\"settings-page\" id=\"settings-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">Configurações</div>\n    <div class=\"logs-actions\"><button class=\"logs-btn\" onclick=\"hideSettings()\">Fechar</button></div>\n  </div>\n  <div class=\"settings-body\">\n\n    <div class=\"settings-section-title\">🎨 Aparência</div>\n    <div class=\"theme-current-label\">Tema atual: <span id=\"theme-current-name\">Cyber</span></div>\n    <div class=\"panel theme-preview-card\" id=\"theme-preview-card\">\n      <div class=\"theme-preview-title\">Prévia ao vivo</div>\n      <div class=\"theme-preview-row\">\n        <div class=\"theme-preview-disc\">\n          <div class=\"theme-preview-disc-label\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" width=\"14\" height=\"14\"><path d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\"/></svg>\n          </div>\n        </div>\n        <div class=\"theme-preview-meta\">\n          <div class=\"theme-preview-status\">Conectado</div>\n          <button class=\"theme-preview-btn\">Conectar</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"palette-grid\" id=\"palette-grid\"></div>\n    <div class=\"bg-color-row\">\n      <div style=\"flex:1\">\n        <div class=\"setting-item-title\">Cor de fundo</div>\n        <div class=\"setting-item-sub\">Toque no círculo pra escolher</div>\n      </div>\n      <input type=\"color\" id=\"bg-color-input\" value=\"#04060a\">\n      <button class=\"bg-color-reset\" onclick=\"resetBgColor()\">Padrão</button>\n    </div>\n\n    <div class=\"settings-section-title\">⚙️ Conexão</div>\n    <div class=\"setting-item\" onclick=\"toggleAutoConnect()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Conectar ao abrir o app</div>\n        <div class=\"setting-item-sub\">Usa o último servidor/perfil selecionado</div>\n      </div>\n      <div class=\"switch\" id=\"autoconnect-switch\"></div>\n    </div>\n    <div class=\"setting-item\" id=\"uuid-item\" onclick=\"promptUuid()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">UUID / Chave</div>\n        <div class=\"setting-item-sub\" id=\"uuid-sub\">Não configurado</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"toast('Puxe a barra de notificação e segure num ícone pra adicionar o atalho de Ajustes Rápidos do VB Injector 💡')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2L2 7l10 5 10-5-10-5z\"/><path d=\"M2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atalho rápido</div>\n        <div class=\"setting-item-sub\">Conectar sem abrir o app (Ajustes Rápidos)</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n\n    <div class=\"settings-section-title\">🛠️ Avançado</div>\n    <div class=\"setting-item\" onclick=\"doUpdate()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atualizar Configuração</div>\n        <div class=\"setting-item-sub\">Buscar dados do servidor agora</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"if (B && B.openSettings) { B.openSettings(); } else { toast('Disponível só no app.'); }\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Configurações Avançadas</div>\n        <div class=\"setting-item-sub\">DNS, UDP, SSH, Sistema...</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"toggleDiagBox()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Diagnóstico</div>\n        <div class=\"setting-item-sub\">Gerar relatório pra suporte</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div id=\"diag-wrap\" style=\"display:none\">\n      <div class=\"diag-box\" id=\"diag-box\"></div>\n      <button class=\"logs-btn\" style=\"width:100%;margin-top:8px;padding:10px;\" onclick=\"copyDiag()\">Copiar diagnóstico</button>\n    </div>\n\n  </div>\n</div>\n\n<script>\nvar B = window.VBBridge;\nvar app = {\n  mode: 'SSH', connected: false, connectTime: 0, timerInt: null, pollInt: null,\n  favorites: [], autoscroll: true\n};\n\nfunction bp(raw, fb) { try { return JSON.parse(raw) || fb; } catch(e) { return fb; } }\n\nfunction forceRepaint(el) {\n  if (!el) return;\n  requestAnimationFrame(function () {\n    requestAnimationFrame(function () {\n      el.style.transform = 'translateZ(0)';\n      void el.offsetHeight;\n      el.style.transform = '';\n    });\n  });\n}\n\nfunction init() {\n  if (!B) { showMsg('Bridge não encontrado. Modo de preview.'); return; }\n  if (B.isTamperDetected && B.isTamperDetected()) showTamperWarning();\n\n  var cfg = bp(B.getConfig(), {});\n  if (cfg.appName) document.getElementById('app-name').textContent = cfg.appName;\n  if (cfg.configVersion) document.getElementById('config-ver').textContent = 'v' + cfg.configVersion;\n  if (B.getHtmlVersion) document.getElementById('html-ver').textContent = 'h' + (B.getHtmlVersion() || '--');\n  if (cfg.notice && cfg.notice.enabled) showNoticeBar(cfg.notice.title || 'Aviso', cfg.notice.message || '');\n\n  var uuid = B.getUuid ? B.getUuid() : '';\n  if (uuid) document.getElementById('uuid-sub').textContent = uuid.substring(0,8) + '...';\n\n  initPalette();\n  initAutoConnectSwitch();\n  setupCredModal();\n  setupUuidModal();\n\n  var savedMode = B.getMode ? B.getMode() : 'SSH';\n  setMode(savedMode === 'XRAY' ? 'XRAY' : 'SSH', true);\n\n  refreshFavorites();\n  refreshSelected();\n  updateNetBadge();\n  refreshIpInfo();\n\n  app.pollInt = setInterval(pollStatus, 700);\n  setInterval(updateNetBadge, 5000);\n  pollStatus();\n  maybeAutoConnect();\n}\n\nfunction maybeAutoConnect() {\n  if (!B || !B.getAutoConnect || !B.getAutoConnect()) return;\n  if (app.connected) return;\n  var st = bp(B.getStatus(), {});\n  if (st.connected) return;\n  setTimeout(function () { doConnect(); }, 600);\n}\n\nfunction updateNetBadge() {\n  if (!B || !B.getNetworkInfo) return;\n  try {\n    var info = bp(B.getNetworkInfo(), {});\n    document.getElementById('net-badge-text').textContent = info.type || '--';\n    document.getElementById('net-badge').classList.toggle('online', !!info.online);\n    var dn = document.getElementById('dock-net');\n    if (dn) dn.classList.toggle('online', !!info.online);\n  } catch(e) {}\n}\n\n/* ── IP / LOCALIZAÇÃO ── */\nfunction refreshIpInfo() {\n  if (!B || !B.requestIpInfo) {\n    setTimeout(refreshIpInfo, 500);\n    return;\n  }\n  document.getElementById('ip-status-line').textContent = 'Consultando...';\n  var timeoutId = setTimeout(function() {\n    document.getElementById('ip-status-line').textContent = 'Timeout na consulta';\n    document.getElementById('ip-value').textContent = '—';\n  }, 15000);\n  var oldOnVBIpInfo = window.onVBIpInfo;\n  window.onVBIpInfo = function(info) {\n    clearTimeout(timeoutId);\n    if (oldOnVBIpInfo) oldOnVBIpInfo(info);\n  };\n  B.requestIpInfo();\n}\nwindow.onVBIpInfo = function(info) {\n  var line = document.getElementById('ip-status-line');\n  if (!info || !info.ip || info.success === false) {\n    document.getElementById('ip-value').textContent = '—';\n    line.textContent = 'Não foi possível consultar agora';\n    return;\n  }\n  document.getElementById('ip-value').textContent = info.ip;\n  var country = info.country_name || info.country || '';\n  var loc = [info.city, info.region, country].filter(Boolean).join(', ');\n  line.textContent = (app.connected ? 'IP mascarado pelo túnel ✓ · ' : 'IP real (sem túnel) · ') + loc;\n};\n\n/* ── PING ── */\nfunction testPing() {\n  if (!B || !B.requestPing) return;\n  var target = currentTarget();\n  if (!target) { toast('Escolha um servidor primeiro'); return; }\n  var chip = document.getElementById('ping-chip');\n  chip.className = 'chip loading';\n  document.getElementById('ping-label').textContent = 'Testando...';\n  B.requestPing(target.host, target.port);\n}\nfunction currentTarget() {\n  try {\n    if (app.mode === 'XRAY') {\n      var x = bp(B.getSelectedXray(), {});\n      if (x.host && x.port) return { host: x.host, port: x.port };\n    } else {\n      var s = bp(B.getSelectedServer(), {});\n      if (s.host && s.port) return { host: s.host, port: s.port };\n    }\n  } catch(e) {}\n  return null;\n}\nwindow.onVBPingResult = function(result) {\n  var chip = document.getElementById('ping-chip');\n  var label = document.getElementById('ping-label');\n  if (result && result.ok) {\n    var ms = result.ms;\n    var quality = ms < 150 ? 'ok' : (ms < 400 ? '' : 'bad');\n    var bars = ms < 100 ? 4 : (ms < 200 ? 3 : (ms < 450 ? 2 : 1));\n    chip.className = 'chip ' + quality;\n    label.innerHTML = '<span class=\"signal-bars lit-' + bars + '\"><i></i><i></i><i></i><i></i></span><span class=\"chip-val\">' + ms + 'ms</span>';\n  } else {\n    chip.className = 'chip bad';\n    label.textContent = 'Falhou';\n  }\n};\n\n/* ── TESTE DE VELOCIDADE ── */\nfunction runSpeedTest() {\n  if (!B || !B.requestSpeedTest) return;\n  var chip = document.getElementById('speedtest-chip');\n  chip.className = 'chip loading';\n  document.getElementById('speedtest-label').textContent = 'Medindo...';\n  document.getElementById('speedtest-panel').classList.add('show');\n  document.getElementById('gauge-needle').style.transform = 'rotate(-90deg)';\n  document.getElementById('gauge-val').textContent = '...';\n  B.requestSpeedTest();\n}\nfunction closeSpeedTest() {\n  document.getElementById('speedtest-panel').classList.remove('show');\n}\nwindow.onVBSpeedTestResult = function(result) {\n  var chip = document.getElementById('speedtest-chip');\n  var label = document.getElementById('speedtest-label');\n  if (result && result.ok) {\n    var mbps = result.mbps;\n    chip.className = 'chip ' + (mbps > 15 ? 'ok' : (mbps > 4 ? '' : 'bad'));\n    label.innerHTML = '<span class=\"chip-val\">' + mbps.toFixed(1) + '</span> Mbps';\n    document.getElementById('gauge-val').textContent = mbps.toFixed(1);\n    var pct = Math.min(mbps / 60, 1);\n    var deg = -90 + (pct * 180);\n    document.getElementById('gauge-needle').style.transform = 'rotate(' + deg + 'deg)';\n  } else {\n    chip.className = 'chip bad';\n    label.textContent = 'Falhou';\n    document.getElementById('gauge-val').textContent = '--';\n  }\n};\n\n/* ── FAVORITOS ── */\nfunction refreshFavorites() {\n  if (!B || !B.getFavorites) return;\n  app.favorites = bp(B.getFavorites(), []);\n}\nfunction isFavorite(id) { return app.favorites.indexOf(id) !== -1; }\nfunction toggleFavoriteItem(id, evt) {\n  if (evt) evt.stopPropagation();\n  if (!B || !B.toggleFavorite) return;\n  B.toggleFavorite(id);\n  refreshFavorites();\n  if (currentOpenSheet) openSheet(currentOpenSheet);\n}\n\n/* ── STATUS ── */\nfunction pollStatus() {\n  if (!B) return;\n  try {\n    var st = bp(B.getStatus(), {});\n    var connected = !!st.connected;\n    if (connected !== app.connected) {\n      app.connected = connected;\n      applyConnected(connected, st.mode || app.mode, st.connectedAt);\n    }\n  } catch(e) {}\n}\n\nfunction applyConnected(on, mode, connectedAt) {\n  document.body.classList.toggle('connected', on);\n  document.body.classList.remove('connecting');\n  var label = document.getElementById('orb-label');\n  var sub = document.getElementById('orb-sub');\n  var btn = document.getElementById('connect-btn');\n  var timer = document.getElementById('timer');\n  var speed = document.getElementById('speed-row');\n  var disc = document.getElementById('orb-btn');\n\n  if (on) {\n    label.textContent = 'CONECTADO';\n    sub.textContent = (mode || app.mode) + ' ativo';\n    btn.textContent = 'Desconectar';\n    timer.classList.add('show');\n    speed.style.display = 'grid';\n    disc.classList.add('spin');\n    app.connectTime = (connectedAt && connectedAt > 0) ? connectedAt : Date.now();\n    updateTimer();\n    if (app.timerInt) clearInterval(app.timerInt);\n    app.timerInt = setInterval(updateTimer, 1000);\n    setTimeout(refreshIpInfo, 1200);\n  } else {\n    label.textContent = 'DESCONECTADO';\n    sub.textContent = 'Toque no disco para conectar';\n    btn.textContent = 'Conectar ' + app.mode;\n    timer.classList.remove('show');\n    speed.style.display = 'none';\n    disc.classList.remove('spin');\n    document.getElementById('speed-dl').textContent = '0 B/s';\n    document.getElementById('speed-ul').textContent = '0 B/s';\n    if (app.timerInt) clearInterval(app.timerInt);\n    refreshIpInfo();\n  }\n  forceRepaint(document.getElementById('main-body'));\n}\n\nfunction updateTimer() {\n  var s = Math.floor((Date.now() - app.connectTime) / 1000);\n  var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;\n  document.getElementById('timer-val').textContent = pad(h) + ':' + pad(m) + ':' + pad(sec);\n}\nfunction pad(n) { return n < 10 ? '0' + n : '' + n; }\n\nfunction doConnect() {\n  if (!B) { toast('Bridge não disponível'); return; }\n  if (app.mode === 'SSH') {\n    var srv = bp(B.getSelectedServer(), {});\n    var userVal = (document.getElementById('cred-user').value || '').trim();\n    var passVal = (document.getElementById('cred-pass').value || '').trim();\n    if (srv.name && !srv.hasCredentials && !userVal && !passVal) {\n      showCredModal(); toast('Preenche usuário e senha pra conectar'); return;\n    }\n  } else if (app.mode === 'XRAY') {\n    var xr = bp(B.getSelectedXray(), {});\n    var uuidVal = (document.getElementById('xray-uuid-input').value || '').trim();\n    if (xr.name && xr.uuidRequired && !xr.hasUuid && !uuidVal) {\n      showUuidModal(); toast('Cole o UUID pra conectar'); return;\n    }\n  }\n  document.body.classList.add('connecting');\n  document.getElementById('orb-label').textContent = 'CONECTANDO...';\n  document.getElementById('orb-sub').textContent = 'Aguarde...';\n  document.getElementById('connect-btn').textContent = 'Aguarde...';\n  if (B.consumeLastError) B.consumeLastError();\n  if (app.mode === 'XRAY') saveUuidField();\n  B.connect();\n  watchForConnectError();\n}\n\nfunction watchForConnectError() {\n  var checks = 0;\n  var maxChecks = 65;\n  var interval = setInterval(function() {\n    checks++;\n    if (!B || !B.consumeLastError) { clearInterval(interval); return; }\n    var err = B.consumeLastError();\n    if (err === 'AUTH_FAILED' || err === 'XRAY_NO_TRAFFIC') {\n      clearInterval(interval);\n      document.body.classList.remove('con