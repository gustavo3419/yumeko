    SSLPort: document.getElementById("s_SSLPort").value,
    ProxyHost: document.getElementById("s_ProxyHost").value,
    ProxyPort: document.getElementById("s_ProxyPort").value,
    USER: document.getElementById("s_USER").value,
    PASS: document.getElementById("s_PASS").value,
    Payload: document.getElementById("s_Payload").value,
