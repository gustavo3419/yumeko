ms: center; justify-content: space-between; }\n.autoscroll-toggle { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--muted2); }\n\n/* ── CONFIG ── */\n.settings-page { position: fixed; inset: 0; z-index: 90; background: var(--bg); display: none; flex-direction: column; }\n.settings-page.show { display: flex; }\n.settings-body { flex: 1; overflow-y: auto; padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; }\n.settings-section-title { font-size: 11px; font-weight: 800; letter-spacing: .04em; color: var(--text); text-transform: uppercase; margin-top: 12px; margin-bottom: 3px; opacity: .85; }\n.settings-section-title:first-child { margin-top: 0; }\n.setting-item { background: var(--panel); border: 1px solid var(--panel-border); border-radius: var(--r-md); padding: 16px 18px; display: flex; align-items: center; gap: 13px; cursor: pointer; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }\n.setting-item:active { background: rgba(255,255,255,.04); }\n.setting-item svg { width: 19px; height: 19px; color: var(--accent); flex: 0 0 19px; }\n.setting-item-meta { flex: 1; min-width: 0; }\n.setting-item-title { font-size: 14px; font-weight: 700; }\n.setting-item-sub { font-size: 11px; color: var(--muted2); margin-top: 3px; }\n.setting-item-chev { color: var(--muted); flex: 0 0 auto; }\n\n.switch { width: 46px; height: 27px; background: rgba(255,255,255,.07); border: 1px solid var(--panel-border); border-radius: 100px; position: relative; flex: 0 0 auto; transition: background .2s; cursor: pointer; }\n.switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 21px; height: 21px; border-radius: 50%; background: var(--muted2); transition: all .25s cubic-bezier(.34,1.56,.64,1); }\n.switch.on { background: linear-gradient(110deg, var(--accent), var(--accent2)); border-color: transparent; }\n.switch.on::after { left: 21px; background: #fff; box-shadow: 0 0 8px rgba(255,255,255,.5); }\n\n/* ── APARÊNCIA: prévia + grade de temas ── */\n.theme-current-label { font-size: 11.5px; color: var(--muted2); margin-bottom: 8px; }\n.theme-current-label span { color: var(--text); font-weight: 800; background: linear-gradient(110deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }\n\n.theme-preview-card { padding: 18px; margin-bottom: 4px; }\n.theme-preview-title { font-size: 9.5px; font-weight: 800; color: var(--muted2); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 14px; }\n.theme-preview-row { display: flex; align-items: center; gap: 16px; }\n.theme-preview-orb { position: relative; width: 54px; height: 54px; flex: 0 0 54px; }\n.theme-preview-orb-ring { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, var(--accent), var(--accent2), var(--accent)); filter: blur(8px); opacity: .6; animation: spin-slow 6s linear infinite; }\n.theme-preview-orb-core { position: absolute; inset: 7px; border-radius: 50%; background: linear-gradient(160deg, rgba(255,255,255,.12), rgba(255,255,255,.02)); border: 1.5px solid rgba(255,255,255,.18); display: grid; place-items: center; color: var(--accent); box-shadow: 0 0 16px var(--accent); animation: breathe-orb 3.6s ease-in-out infinite; }\n.theme-preview-meta { flex: 1; min-width: 0; }\n.theme-preview-status { font-size: 10px; font-weight: 800; letter-spacing: .06em; color: var(--text); margin-bottom: 10px; text-transform: uppercase; }\n.theme-preview-btn { width: 100%; padding: 10px; border: none; background: linear-gradient(110deg, var(--accent), var(--accent2)); color: #fff; font-size: 11.5px; font-weight: 800; letter-spacing: .02em; cursor: default; font-family: var(--sans); border-radius: 100px; }\n\n.palette-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 11px; }\n.palette-item { display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; padding: 9px 4px; border-radius: 18px; transition: transform .15s, background .2s; }\n.palette-item:active { transform: scale(.92); }\n.palette-item.selected { background: rgba(255,255,255,.05); animation: palette-pop .35s ease; }\n@keyframes palette-pop { 0% { transform: scale(1); } 45% { transform: scale(1.1); } 100% { transform: scale(1); } }\n.palette-circle { width: 42px; height: 42px; border-radius: 50%; border: 2px solid rgba(255,255,255,.12); position: relative; transition: box-shadow .25s; }\n.palette-item.selected .palette-circle { box-shadow: 0 0 0 3px rgba(255,255,255,.1), 0 0 20px rgba(139,107,255,.4); }\n.palette-circle .check { position: absolute; top: -4px; right: -4px; width: 16px; height: 16px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 9px; display: flex; align-items: center; justify-content: center; opacity: 0; box-shadow: 0 0 6px rgba(139,107,255,.7); }\n.palette-item.selected .check { opacity: 1; }\n.palette-label { font-size: 10px; font-weight: 700; color: var(--muted2); }\n.palette-item.selected .palette-label { color: var(--text); }\n\n.bg-color-row { display: flex; align-items: center; gap: 12px; background: var(--panel); border: 1px solid var(--panel-border); padding: 14px 16px; border-radius: var(--r-md); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }\n#bg-color-input { width: 40px; height: 40px; border: none; border-radius: 50%; padding: 0; background: none; cursor: pointer; box-shadow: 0 0 0 2px var(--accent), 0 0 16px rgba(139,107,255,.4); transition: box-shadow .2s; }\n#bg-color-input:active { box-shadow: 0 0 0 3px var(--accent), 0 0 22px rgba(139,107,255,.6); }\n#bg-color-input::-webkit-color-swatch-wrapper { padding: 2px; border-radius: 50%; }\n#bg-color-input::-webkit-color-swatch { border-radius: 50%; border: 2px solid rgba(255,255,255,0.3); }\n.bg-color-reset { background: rgba(255,255,255,.06); border: 1px solid var(--panel-border); color: var(--muted2); font-size: 11px; font-weight: 700; padding: 9px 14px; cursor: pointer; border-radius: 100px; }\n\n.diag-box { background: rgba(0,0,0,.25); border: 1px solid var(--panel-border); padding: 14px 16px; font-family: var(--mono); font-size: 10px; color: var(--muted2); line-height: 1.65; white-space: pre-wrap; word-break: break-all; max-height: 220px; overflow-y: auto; border-radius: var(--r-sm); }\n\n.toast { position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%) translateY(20px); background: rgba(22,17,42,.92); border: 1px solid var(--panel-border-strong); padding: 11px 20px; font-size: 12px; font-weight: 600; color: var(--text); z-index: 200; opacity: 0; transition: all .25s; white-space: nowrap; pointer-events: none; max-width: 90vw; overflow: hidden; text-overflow: ellipsis; border-radius: 100px; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 12px 32px rgba(0,0,0,.3); }\n.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n\n@media (max-width: 340px) {\n  .header { margin: 10px 8px 4px; padding: 11px 14px; }\n  .body { padding: 6px 8px 8px; gap: 9px; }\n  .bottom-nav { margin: 0 10px 12px; }\n  .hero { padding: 20px 10px 18px; }\n  .server-card { padding: 13px 14px 15px; gap: 11px; }\n}\n</style>\n</head>\n<body>\n<div class=\"mesh-bg\"><div class=\"blob blob1\"></div><div class=\"blob blob2\"></div><div class=\"blob blob3\"></div><div class=\"grain\"></div></div>\n<div class=\"shell\">\n\n  <header class=\"header panel\">\n    <div class=\"header-left\">\n      <div class=\"header-brand\" id=\"app-name\">VB INJECTOR</div>\n      <div class=\"header-meta\">\n        <span class=\"header-ver\" id=\"config-ver\">v--</span>\n        <span class=\"header-ver\" id=\"html-ver\">h--</span>\n        <span class=\"net-badge\" id=\"net-badge\"><span class=\"dot\"></span><span id=\"net-badge-text\">--</span></span>\n      </div>\n    </div>\n    <div class=\"header-right\">\n      <button class=\"btn-icon\" id=\"refresh-btn\" onclick=\"doUpdate()\" title=\"Atualizar\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      </button>\n    </div>\n  </header>\n\n  <div class=\"body\" id=\"main-body\">\n\n    <div class=\"panel notice-card\" id=\"notice-bar\">\n      <div class=\"notice-icon\">📣</div>\n      <div class=\"notice-content\">\n        <div class=\"notice-title\" id=\"notice-title\">Aviso</div>\n        <div class=\"notice-msg\" id=\"notice-msg\"></div>\n      </div>\n    </div>\n\n    <div class=\"panel ip-panel\">\n      <div class=\"ip-panel-head\">\n        <div class=\"ip-panel-title\"><span class=\"led\"></span> IP / LOCALIZAÇÃO</div>\n        <div class=\"ip-refresh-btn\" onclick=\"refreshIpInfo()\">↻ Atualizar</div>\n      </div>\n      <div class=\"ip-row\">\n        <span class=\"ip-value\" id=\"ip-value\">•••.•••.•••.•••</span>\n        <span class=\"ip-loc\" id=\"ip-loc\"></span>\n      </div>\n      <div class=\"ip-status-line\" id=\"ip-status-line\">Toque em atualizar pra ver seu IP real</div>\n    </div>\n\n    <div class=\"panel hero\">\n      <div class=\"radar-wrap\">\n        <div class=\"radar-ring r3\"></div>\n        <div class=\"radar-ring r2\"></div>\n        <div class=\"radar-ring\"></div>\n        <div class=\"radar-sweep\"></div>\n        <div class=\"radar-btn\" onclick=\"doConnect()\" id=\"orb-btn\">\n          <div class=\"radar-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n              <path id=\"orb-svg-path\" d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\" stroke=\"rgba(243,240,255,.85)\"/>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"radar-label\" id=\"orb-label\">DESCONECTADO</div>\n      <div class=\"radar-sub\" id=\"orb-sub\">Toque para conectar</div>\n      <div class=\"timer\" id=\"timer\">\n        <span class=\"timer-label\">Tempo</span>\n        <span class=\"timer-val\" id=\"timer-val\">00:00:00</span>\n      </div>\n      <div class=\"action-chips\">\n        <div class=\"chip\" id=\"ping-chip\" onclick=\"testPing()\">\n          <span class=\"chip-dot\"></span>\n          <span id=\"ping-label\">Latência</span>\n        </div>\n        <div class=\"chip\" id=\"speedtest-chip\" onclick=\"runSpeedTest()\">\n          <span class=\"chip-dot\"></span>\n          <span id=\"speedtest-label\">Velocidade</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"panel speedtest-panel\" id=\"speedtest-panel\">\n      <div class=\"gauge-wrap\">\n        <div class=\"gauge-bg\"></div>\n        <div class=\"gauge-needle\" id=\"gauge-needle\"></div>\n      </div>\n      <div class=\"gauge-val\" id=\"gauge-val\">0.0</div>\n      <div class=\"gauge-unit\">Mbps de download</div>\n      <div class=\"gauge-close\" onclick=\"closeSpeedTest()\">Fechar</div>\n    </div>\n\n    <div class=\"speed-row\" id=\"speed-row\" style=\"display:none\">\n      <div class=\"panel speed-card\">\n        <div class=\"speed-label\">↓ DOWNLOAD</div>\n        <div class=\"speed-val\" id=\"speed-dl\">0 B/s</div>\n      </div>\n      <div class=\"panel speed-card\">\n        <div class=\"speed-label\">↑ UPLOAD</div>\n        <div class=\"speed-val\" id=\"speed-ul\">0 B/s</div>\n      </div>\n    </div>\n\n    <div class=\"panel\">\n      <div class=\"mode-row\">\n        <button class=\"mode-btn\" id=\"mode-ssh\" onclick=\"setMode('SSH')\">SSH</button>\n        <button class=\"mode-btn\" id=\"mode-xray\" onclick=\"setMode('XRAY')\">XRAY</button>\n      </div>\n    </div>\n\n    <div class=\"panel\" id=\"card-ssh\" onclick=\"openSheet('ssh')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\">🖥️</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Servidor SSH</div>\n          <div class=\"server-name\" id=\"ssh-name\">Selecionar servidor</div>\n          <div class=\"server-sub\" id=\"ssh-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <div class=\"panel\" id=\"card-payload\" onclick=\"openSheet('payload')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\">📦</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Payload</div>\n          <div class=\"server-name\" id=\"payload-name\">Selecionar payload</div>\n          <div class=\"server-sub\" id=\"payload-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <div class=\"panel\" id=\"card-xray\" style=\"display:none\" onclick=\"openSheet('xray')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\">⚡</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Perfil XRAY</div>\n          <div class=\"server-name\" id=\"xray-name\">Selecionar perfil</div>\n          <div class=\"server-sub\" id=\"xray-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <button class=\"connect-btn\" id=\"connect-btn\" onclick=\"doConnect()\">Conectar SSH</button>\n\n    <div class=\"panel msg-card\" id=\"msg-card\" style=\"display:none\">\n      <div class=\"msg-dot\"></div>\n      <div class=\"msg-text\" id=\"msg-text\"></div>\n    </div>\n\n  </div>\n\n  <nav class=\"bottom-nav panel\">\n    <button class=\"nav-btn active\" onclick=\"showMain()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>\n      <span>Início</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showLogs()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6M16 13H8\"/></svg>\n      <span>Logs</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"openSheet(app.mode === 'XRAY' ? 'xray' : 'ssh')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/></svg>\n      <span>Servidores</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showSettings()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <span>Config</span>\n    </button>\n  </nav>\n\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<div class=\"overlay\" id=\"exit-modal\" onclick=\"closeExitModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">👋 Até logo</div>\n    <div class=\"modal-title\">Sair do <span id=\"exit-modal-appname\">app</span></div>\n    <div class=\"modal-sub\">O que você deseja fazer?</div>\n    <button class=\"modal-btn modal-btn-minimize\" id=\"exit-modal-minimize\" onclick=\"exitModalMinimize()\">📱 Minimizar (segundo plano)</button>\n    <button class=\"modal-btn modal-btn-exit\" onclick=\"exitModalExit()\">🚪 Sair completamente</button>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"closeExitModal()\">↩️ Cancelar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"cred-modal\" onclick=\"closeCredModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">🔐 Login necessário</div>\n    <div class=\"modal-title\">Credenciais SSH</div>\n    <div class=\"modal-sub\">Esse servidor pede usuário e senha pra conectar.</div>\n    <div class=\"cred-label\">👤 Usuário</div>\n    <input type=\"text\" id=\"cred-user\" class=\"cred-input\" placeholder=\"Digite o usuário\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <div class=\"cred-label\">🔒 Senha</div>\n    <div style=\"position:relative;\">\n      <input type=\"password\" id=\"cred-pass\" class=\"cred-input\" placeholder=\"Digite a senha\" style=\"padding-right:46px;\">\n      <span id=\"cred-pass-toggle\" style=\"position:absolute; right:14px; top:50%; transform:translateY(-50%); cursor:pointer; font-size:15px; user-select:none;\">👁️</span>\n    </div>\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:18px;\" onclick=\"saveCredField(); closeCredModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"uuid-modal\" onclick=\"closeUuidModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">🔑 Ativação necessária</div>\n    <div class=\"modal-title\">UUID / Chave</div>\n    <div class=\"modal-sub\">Esse perfil é premium e precisa da chave de ativação.</div>\n    <div class=\"cred-label\">🔑 UUID</div>\n    <input type=\"text\" id=\"xray-uuid-input\" class=\"cred-input\" placeholder=\"Cole o UUID aqui\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:18px;\" onclick=\"saveUuidField(); closeUuidModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"autherror-modal\" onclick=\"closeAuthErrorModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\" style=\"background:rgba(251,113,133,.16); border-color:rgba(251,113,133,.4); color:var(--red);\">⚠️ Falha no login</div>\n    <div class=\"modal-title\" id=\"autherror-title\">Usuário ou senha incorretos</div>\n    <div class=\"modal-sub\" id=\"autherror-sub\">Não foi possível autenticar nesse servidor com as credenciais informadas. Confira e tente de novo.</div>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"fixCredsAfterAuthError()\">Corrigir credenciais</button>\n    <button class=\"modal-btn modal-btn-minimize\" onclick=\"closeAuthErrorModal()\">Fechar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"sheet-ssh\" onclick=\"closeSheet('ssh')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">    <div class=\"sheet-title\">Servidores SSH <span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n    <div id=\"ssh-list\"></div>\n  </div>\n</div>\n<div class=\"overlay\" id=\"sheet-payload\" onclick=\"closeSheet('payload')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-title\">Payloads</div>\n    <div id=\"payload-list\"></div>\n  </div>\n</div>\n<div class=\"overlay\" id=\"sheet-xray\" onclick=\"closeSheet('xray')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-title\">Perfis XRAY <span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n    <div id=\"xray-list\"></div>\n  </div>\n</div>\n\n<div class=\"logs-page\" id=\"logs-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">Logs de Conexão</div>\n    <div class=\"logs-actions\">\n      <button class=\"logs-btn\" onclick=\"copyLogs()\">Copiar</button>\n      <button class=\"logs-btn\" onclick=\"clearLogs()\" style=\"color:var(--red);border-color:rgba(251,113,133,.35)\">Limpar</button>\n      <button class=\"logs-btn\" onclick=\"hideLogs()\">✕</button>\n    </div>\n  </div>\n  <div class=\"logs-body\" id=\"logs-body\">\n    <div class=\"logs-empty\"><span style=\"font-size:28px\">📋</span><span>Aguardando logs...</span></div>\n  </div>\n  <div class=\"logs-footer\">\n    <div class=\"autoscroll-toggle\">\n      <div class=\"switch on\" id=\"autoscroll-switch\" onclick=\"toggleAutoscroll()\"></div>\n      <span>Rolagem automática</span>\n    </div>\n  </div>\n</div>\n\n<div class=\"settings-page\" id=\"settings-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">Configurações</div>\n    <div class=\"logs-actions\"><button class=\"logs-btn\" onclick=\"hideSettings()\">Fechar</button></div>\n  </div>\n  <div class=\"settings-body\">\n\n    <div class=\"settings-section-title\">🎨 Aparência</div>\n    <div class=\"theme-current-label\">Tema atual: <span id=\"theme-current-name\">Cyber</span></div>\n    <div class=\"panel theme-preview-card\" id=\"theme-preview-card\">\n      <div class=\"theme-preview-title\">Prévia ao vivo</div>\n      <div class=\"theme-preview-row\">\n        <div class=\"theme-preview-orb\">\n          <div class=\"theme-preview-orb-ring\"></div>\n          <div class=\"theme-preview-orb-core\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" width=\"20\" height=\"20\"><path d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\"/></svg>\n          </div>\n        </div>\n        <div class=\"theme-preview-meta\">\n          <div class=\"theme-preview-status\">Conectado</div>\n          <button class=\"theme-preview-btn\">Conectar</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"palette-grid\" id=\"palette-grid\"></div>\n    <div class=\"bg-color-row\">\n      <div style=\"flex:1\">\n        <div class=\"setting-item-title\">Cor de fundo</div>\n        <div class=\"setting-item-sub\">Toque no círculo pra escolher</div>\n      </div>\n      <input type=\"color\" id=\"bg-color-input\" value=\"#0c0a1a\">\n      <button class=\"bg-color-reset\" onclick=\"resetBgColor()\">Padrão</button>\n    </div>\n\n    <div class=\"settings-section-title\">⚙️ Conexão</div>\n    <div class=\"setting-item\" onclick=\"toggleAutoConnect()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Conectar ao abrir o app</div>\n        <div class=\"setting-item-sub\">Usa o último servidor/perfil selecionado</div>\n      </div>\n      <div class=\"switch\" id=\"autoconnect-switch\"></div>\n    </div>\n    <div class=\"setting-item\" id=\"uuid-item\" onclick=\"promptUuid()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">UUID / Chave</div>\n        <div class=\"setting-item-sub\" id=\"uuid-sub\">Não configurado</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"toast('Puxe a barra de notificação e segure num ícone pra adicionar o atalho de Ajustes Rápidos do VB Injector 💡')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2L2 7l10 5 10-5-10-5z\"/><path d=\"M2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atalho rápido</div>\n        <div class=\"setting-item-sub\">Conectar sem abrir o app (Ajustes Rápidos)</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n\n    <div class=\"settings-section-title\">🛠️ Avançado</div>\n    <div class=\"setting-item\" onclick=\"doUpdate()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atualizar Configuração</div>\n        <div class=\"setting-item-sub\">Buscar dados do servidor agora</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"if (B && B.openSettings) { B.openSettings(); } else { toast('Disponível só no app.'); }\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Configurações Avançadas</div>\n        <div class=\"setting-item-sub\">DNS, UDP, SSH, Sistema...</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"toggleDiagBox()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Diagnóstico</div>\n        <div class=\"setting-item-sub\">Gerar relatório pra suporte</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div id=\"diag-wrap\" style=\"display:none\">\n      <div class=\"diag-box\" id=\"diag-box\"></div>\n      <button class=\"logs-btn\" style=\"width:100%;margin-top:8px;padding:10px;\" onclick=\"copyDiag()\">Copiar diagnóstico</button>\n    </div>\n\n  </div>\n</div>\n\n<script>\nvar B = window.VBBridge;\nvar app = {\n  mode: 'SSH', connected: false, connectTime: 0, timerInt: null, pollInt: null,\n  favorites: [], autoscroll: true\n};\n\nfunction bp(raw, fb) { try { return JSON.parse(raw) || fb; } catch(e) { return fb; } }\n\nfunction forceRepaint(el) {\n  if (!el) return;\n  requestAnimationFrame(function () {\n    requestAnimationFrame(function () {\n      el.style.transform = 'translateZ(0)';\n      void el.offsetHeight;\n      el.style.transform = '';\n    });\n  });\n}\n\nfunction init() {\n  if (!B) { showMsg('Bridge não encontrado. Modo de preview.'); return; }\n  if (B.isTamperDetected && B.isTamperDetected()) showTamperWarning();\n\n  var cfg = bp(B.getConfig(), {});\n  if (cfg.appName) document.getElementById('app-name').textContent = cfg.appName;\n  if (cfg.configVersion) document.getElementById('config-ver').textContent = 'v' + cfg.configVersion;\n  if (B.getHtmlVersion) document.getElementById('html-ver').textContent = 'h' + (B.getHtmlVersion() || '--');\n  if (cfg.notice && cfg.notice.enabled) showNoticeBar(cfg.notice.title || 'Aviso', cfg.notice.message || '');\n\n  var uuid = B.getUuid ? B.getUuid() : '';\n  if (uuid) document.getElementById('uuid-sub').textContent = uuid.substring(0,8) + '...';\n\n  initPalette();\n  initAutoConnectSwitch();\n  setupCredModal();\n  setupUuidModal();\n\n  var savedMode = B.getMode ? B.getMode() : 'SSH';\n  setMode(savedMode === 'XRAY' ? 'XRAY' : 'SSH', true);\n\n  refreshFavorites();\n  refreshSelected();\n  updateNetBadge();\n  refreshIpInfo();\n\n  app.pollInt = setInterval(pollStatus, 700);\n  setInterval(updateNetBadge, 5000);\n  pollStatus();\n  maybeAutoConnect();\n}\n\nfunction maybeAutoConnect() {\n  if (!B || !B.getAutoConnect || !B.getAutoConnect()) return;\n  if (app.connected) return;\n  var st = bp(B.getStatus(), {});\n  if (st.connected) return;\n  setTimeout(function () { doConnect(); }, 600);\n}\n\nfunction updateNetBadge() {\n  if (!B || !B.getNetworkInfo) return;\n  try {\n    var info = bp(B.getNetworkInfo(), {});\n    document.getElementById('net-badge-text').textContent = info.type || '--';\n    document.getElementById('net-badge').classList.toggle('online', !!info.online);\n  } catch(e) {}\n}\n\n/* ── IP / LOCALIZAÇÃO ── */\nfunction refreshIpInfo() {\n  if (!B || !B.requestIpInfo) {\n    setTimeout(refreshIpInfo, 500);\n    return;\n  }\n  document.getElementById('ip-status-line').textContent = 'Consultando...';\n  var timeoutId = setTimeout(function() {\n    document.getElementById('ip-status-line').textContent = 'Timeout na consulta';\n    document.getElementById('ip-value').textContent = '—';\n  }, 15000);\n  var oldOnVBIpInfo = window.onVBIpInfo;\n  window.onVBIpInfo = function(info) {\n    clearTimeout(timeoutId);\n    if (oldOnVBIpInfo) oldOnVBIpInfo(info);\n  };\n  B.requestIpInfo();\n}\nwindow.onVBIpInfo = function(info) {\n  var line = document.getElementById('ip-status-line');\n  if (!info || !info.ip || info.success === false) {\n    document.getElementById('ip-value').textContent = '—';\n    document.getElementById('ip-loc').textContent = '';\n    line.textContent = 'Não foi possível consultar agora';\n    return;\n  }\n  document.getElementById('ip-value').textContent = info.ip;\n  var country = info.country_name || info.country || '';\n  var loc = [info.city, info.region, country].filter(Boolean).join(', ');\n  document.getElementById('ip-loc').textContent = loc;\n  line.textContent = app.connected ? 'IP mascarado pelo túnel ✓' : 'Esse é o seu IP real (sem túnel)';\n};\n\n/* ── PING ── */\nfunction testPing() {\n  if (!B || !B.requestPing) return;\n  var target = currentTarget();\n  if (!target) { toast('Escolha um servidor primeiro'); return; }\n  var chip = document.getElementById('ping-chip');\n  chip.className = 'chip loading';\n  document.getElementById('ping-label').textContent = 'Testando...';\n  B.requestPing(target.host, target.port);\n}\nfunction currentTarget() {\n  try {\n    if (app.mode === 'XRAY') {\n      var x = bp(B.getSelectedXray(), {});\n      if (x.host && x.port) return { host: x.host, port: x.port };\n    } else {\n      var s = bp(B.getSelectedServer(), {});\n      if (s.host && s.port) return { host: s.host, port: s.port };\n    }\n  } catch(e) {}\n  return null;\n}\nwindow.onVBPingResult = function(result) {\n  var chip = document.getElementById('ping-chip');\n  var label = document.getElementById('ping-label');\n  if (result && result.ok) {\n    var ms = result.ms;\n    var quality = ms < 150 ? 'ok' : (ms < 400 ? '' : 'bad');\n    var bars = ms < 100 ? 4 : (ms < 200 ? 3 : (ms < 450 ? 2 : 1));\n    chip.className = 'chip ' + quality;\n    label.innerHTML = '<span class=\"signal-bars lit-' + bars + '\"><i></i><i></i><i></i><i></i></span><span class=\"chip-val\">' + ms + 'ms</span>';\n  } else {\n    chip.className = 'chip bad';\n    label.textContent = 'Falhou';\n  }\n};\n\n/* ── TESTE DE VELOCIDADE ── */\nfunction runSpeedTest() {\n  if (!B || !B.requestSpeedTest) return;\n  var chip = document.getElementById('speedtest-chip');\n  chip.className = 'chip loading';\n  document.getElementById('speedtest-label').textContent = 'Medindo...';\n  document.getElementById('speedtest-panel').classList.add('show');\n  document.getElementById('gauge-needle').style.transform = 'rotate(-90deg)';\n  document.getElementById('gauge-val').textContent = '...';\n  B.requestSpeedTest();\n}\nfunction closeSpeedTest() {\n  document.getElementById('speedtest-panel').classList.remove('show');\n}\nwindow.onVBSpeedTestResult = function(result) {\n  var chip = document.getElementById('speedtest-chip');\n  var label = document.getElementById('speedtest-label');\n  if (result && result.ok) {\n    var mbps = result.mbps;\n    chip.className = 'chip ' + (mbps > 15 ? 'ok' : (mbps > 4 ? '' : 'bad'));\n    label.innerHTML = '<span class=\"chip-val\">' + mbps.toFixed(1) + '</span> Mbps';\n    document.getElementById('gauge-val').textContent = mbps.toFixed(1);\n    var pct = Math.min(mbps / 60, 1);\n    var deg = -90 + (pct * 180);\n    document.getElementById('gauge-needle').style.transform = 'rotate(' + deg + 'deg)';\n  } else {\n    chip.className = 'chip bad';\n    label.textContent = 'Falhou';\n    document.getElementById('gauge-val').textContent = '--';\n  }\n};\n\n/* ── FAVORITOS ── */\nfunction refreshFavorites() {\n  if (!B || !B.getFavorites) return;\n  app.favorites = bp(B.getFavorites(), []);\n}\nfunction isFavorite(id) { return app.favorites.indexOf(id) !== -1; }\nfunction toggleFavoriteItem(id, evt) {\n  if (evt) evt.stopPropagation();\n  if (!B || !B.toggleFavorite) return;\n  B.toggleFavorite(id);\n  refreshFavorites();\n  if (currentOpenSheet) openSheet(currentOpenSheet);\n}\n\n/* ── STATUS ── */\nfunction pollStatus() {\n  if (!B) return;\n  try {\n    var st = bp(B.getStatus(), {});\n    var connected = !!st.connected;\n    if (connected !== app.connected) {\n      app.connected = connected;\n      applyConnected(connected, st.mode || app.mode, st.connectedAt);\n    }\n  } catch(e) {}\n}\n\nfunction applyConnected(on, mode, connectedAt) {\n  document.body.classList.toggle('connected', on);\n  document.body.classList.remove('connecting');\n  var label = document.getElementById('orb-label');\n  var sub = document.getElementById('orb-sub');\n  var btn = document.getElementById('connect-btn');\n  var timer = document.getElementById('timer');\n  var speed = document.getElementById('speed-row');\n\n  if (on) {\n    label.textContent = 'CONECTADO';\n    sub.textContent = (mode || app.mode) + ' ativo