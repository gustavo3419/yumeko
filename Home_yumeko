{"version": "123", "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<title>VB INJECTOR // CYBER</title>\n<link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root {\n  --bg: #04050a;\n  --panel: rgba(10,14,22,.88);\n  --panel-border: rgba(0,240,255,.18);\n  --panel-border-strong: rgba(0,240,255,.32);\n  --accent: #00e8ff;\n  --accent2: #ff2ee6;\n  --green: #39ff88;\n  --yellow: #ffe156;\n  --red: #ff3860;\n  --text: #e8f6f8;\n  --muted: #44546b;\n  --muted2: #7d93ad;\n  --mono: 'JetBrains Mono', monospace;\n  --sans: 'Space Grotesk', sans-serif;\n}\n* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\nhtml, body { height: 100%; background: var(--bg); overflow: hidden; }\nbody { font-family: var(--sans); color: var(--text); }\n\n\n/* \u2500\u2500 FUNDO: GRADE + SCANLINE \u2500\u2500 */\n.mesh-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: var(--bg); }\n.mesh-bg::before {\n  content: ''; position: absolute; inset: 0; pointer-events: none;\n  background-image:\n    linear-gradient(rgba(0,232,255,.05) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(0,232,255,.05) 1px, transparent 1px);\n  background-size: 38px 38px;\n  mask-image: radial-gradient(ellipse 75% 65% at 50% 25%, black 25%, transparent 78%);\n}\n.scanline { position: absolute; left: 0; right: 0; top: -140px; height: 140px; background: linear-gradient(180deg, transparent, rgba(0,232,255,.05), transparent); animation: scan 7s linear infinite; will-change: transform; }\n@keyframes scan { 0% { transform: translateY(0); } 100% { transform: translateY(calc(100vh + 140px)); } }\n.blob { position: absolute; border-radius: 50%; filter: blur(85px); will-change: transform; opacity: .4; }\n.blob1 { width: 260px; height: 260px; background: var(--accent); top: -70px; left: -70px; animation: drift1 19s ease-in-out infinite; }\n.blob2 { width: 300px; height: 300px; background: var(--accent2); top: 35%; right: -110px; opacity: .28; animation: drift2 23s ease-in-out infinite; }\nbody.connected .blob2 { background: var(--green); opacity: .32; }\n@keyframes drift1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(30px,40px); } }\n@keyframes drift2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-35px,25px); } }\n\n.shell { position: relative; z-index: 1; width: 100%; max-width: 480px; margin: 0 auto; height: 100vh; display: flex; flex-direction: column; padding-top: var(--vb-inset-top, env(safe-area-inset-top)); padding-bottom: var(--vb-inset-bottom, env(safe-area-inset-bottom)); }\n\n\n/* \u2500\u2500 PAINEL BASE (cantos cortados) \u2500\u2500 */\n.panel {\n  background: var(--panel);\n  border: 1px solid var(--panel-border);\n  clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));\n  position: relative;\n}\n.panel::before {\n  content: ''; position: absolute; top: 0; left: 0; width: 18px; height: 1px; background: var(--accent); opacity: .8;\n}\n\n\n/* \u2500\u2500 HEADER \u2500\u2500 */\n.header { margin: 10px 12px 4px; padding: 13px 16px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n.header-left { min-width: 0; flex: 1; }\n.header-brand { font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); font-family: var(--mono); text-shadow: 0 0 12px rgba(0,232,255,.5); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.header-meta { display: flex; align-items: center; gap: 6px; margin-top: 4px; flex-wrap: wrap; }\n.header-ver { font-size: 9.5px; color: var(--muted2); font-family: var(--mono); letter-spacing: .04em; }\n.net-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 9px; font-weight: 700; font-family: var(--mono); letter-spacing: .06em; color: var(--muted2); padding: 3px 8px; background: rgba(255,255,255,.03); border: 1px solid var(--panel-border); }\n.net-badge .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--muted); }\n.net-badge.online .dot { background: var(--green); box-shadow: 0 0 6px rgba(57,255,136,.9); }\n.header-right { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }\n.btn-icon { width: 36px; height: 36px; background: rgba(0,232,255,.06); border: 1px solid var(--panel-border); clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px)); display: grid; place-items: center; cursor: pointer; transition: all .2s; }\n.btn-icon:active { opacity: .6; transform: scale(.92); }\n.btn-icon svg { width: 16px; height: 16px; color: var(--accent); }\n.btn-icon.spinning svg { animation: spin-slow 1s linear infinite; }\n\n\n/* \u2500\u2500 BODY \u2500\u2500 */\n.body { flex: 0 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 4px 10px 6px; display: flex; flex-direction: column; gap: 8px; -webkit-overflow-scrolling: touch; }\n\n\n/* \u2500\u2500 AVISO \u2500\u2500 */\n.notice-card { display: none; padding: 15px 16px; gap: 13px; align-items: flex-start; background: linear-gradient(160deg, rgba(255,225,86,.08), var(--panel) 60%); border-color: rgba(255,225,86,.3); }\n.notice-card.show { display: flex; }\n.notice-icon { font-size: 24px; line-height: 1; }\n.notice-content { flex: 1; min-width: 0; }\n.notice-title { color: var(--yellow); font-weight: 800; font-size: 11px; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 5px; font-family: var(--mono); }\n.notice-msg { font-size: 12.5px; line-height: 1.5; color: var(--text); opacity: .9; }\n\n\n/* \u2500\u2500 PAINEL DE IP (terminal) \u2500\u2500 */\n.ip-panel { padding: 14px 16px; font-family: var(--mono); }\n.ip-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }\n.ip-panel-title { font-size: 9.5px; font-weight: 800; color: var(--muted2); letter-spacing: .14em; text-transform: uppercase; display: flex; align-items: center; gap: 6px; }\n.ip-panel-title .led { width: 6px; height: 6px; border-radius: 50%; background: var(--red); }\nbody.connected .ip-panel-title .led { background: var(--green); box-shadow: 0 0 6px rgba(57,255,136,.9); }\n.ip-refresh-btn { font-size: 9px; color: var(--accent); cursor: pointer; letter-spacing: .06em; opacity: .8; }\n.ip-row { display: flex; align-items: baseline; gap: 8px; }\n.ip-value { font-size: 19px; font-weight: 700; color: var(--text); letter-spacing: .01em; transition: color .3s; }\nbody.connected .ip-value { color: var(--green); }\n.ip-loc { font-size: 11px; color: var(--muted2); }\n.ip-status-line { font-size: 9.5px; color: var(--muted); margin-top: 4px; letter-spacing: .04em; }\nbody.connected .ip-status-line { color: var(--green); }\n\n\n/* \u2500\u2500 RADAR / BOT\u00c3O DE CONEX\u00c3O \u2500\u2500 */\n.hero { padding: 18px 14px 16px; display: flex; flex-direction: column; align-items: center; position: relative; overflow: hidden; }\n.radar-wrap { position: relative; width: clamp(122px, 34vw, 150px); height: clamp(122px, 34vw, 150px); }\n.radar-ring { position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgba(0,232,255,.18); }\n.radar-ring.r2 { inset: -16px; border-color: rgba(0,232,255,.1); }\n.radar-ring.r3 { inset: -32px; border-color: rgba(0,232,255,.05); }\nbody.connected .radar-ring { border-color: rgba(57,255,136,.22); }\nbody.connected .radar-ring.r2 { border-color: rgba(57,255,136,.13); }\nbody.connected .radar-ring.r3 { border-color: rgba(57,255,136,.06); }\n.radar-sweep {\n  position: absolute; inset: 0; border-radius: 50%;\n  background: conic-gradient(from 0deg, transparent 0deg, rgba(0,232,255,.55) 18deg, transparent 60deg);\n  animation: spin-slow 3.4s linear infinite;\n}\nbody.connected .radar-sweep { background: conic-gradient(from 0deg, transparent 0deg, rgba(57,255,136,.55) 18deg, transparent 60deg); animation-duration: 5s; }\nbody.connecting .radar-sweep { animation-duration: 0.9s; }\n@keyframes spin-slow { to { transform: rotate(360deg); } }\n\n.radar-btn {\n  position: absolute; inset: 14px; border-radius: 50%;\n  background: radial-gradient(circle at 38% 32%, #0c1626, #050810 65%, #03050a);\n  border: 1.5px solid rgba(0,232,255,.3);\n  display: grid; place-items: center; cursor: pointer;\n  box-shadow: 0 0 26px rgba(0,232,255,.14), inset 0 1px 0 rgba(255,255,255,.05);\n  transition: all .25s;\n}\n.radar-btn:active { transform: scale(.95); }\nbody.connected .radar-btn { border-color: rgba(57,255,136,.4); box-shadow: 0 0 30px rgba(57,255,136,.2); }\nbody.connecting .radar-btn { border-color: rgba(255,225,86,.4); }\n.radar-icon svg { width: clamp(36px, 10vw, 44px); height: clamp(36px, 10vw, 44px); }\n.radar-icon svg path { transition: stroke .3s; }\n.radar-ring{display:none!important;}\n.radar-sweep{display:none!important;}\n.radar-btn{border:none!important;box-shadow:none!important;background:transparent!important;}\n\n.radar-label { margin-top: 18px; font-size: 14px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--muted2); font-family: var(--mono); transition: color .3s; }\nbody.connected .radar-label { color: var(--green); text-shadow: 0 0 14px rgba(57,255,136,.45); }\nbody.connecting .radar-label { color: var(--yellow); }\n.radar-sub { margin-top: 4px; font-size: 11px; color: var(--muted2); letter-spacing: .04em; text-align: center; min-height: 16px; }\n\n.timer { display: none; align-items: baseline; gap: 8px; margin-top: 14px; background: rgba(74,222,128,.1); border: 1px solid rgba(74,222,128,.25); padding: 8px 18px; border-radius: 100px; }\n.timer.show { display: flex; }\nbody.connected .action-chips { margin-top: 16px; }\n.timer-val { font-family: var(--mono); font-size: 16px; font-weight: 700; color: var(--green); letter-spacin