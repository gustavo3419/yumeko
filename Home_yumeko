ain()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>\n      <span>Início</span>\n    </button>\n  </nav>\n\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<div class=\"overlay\" id=\"exit-modal\" onclick=\"closeExitModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">👋 ATÉ LOGO</div>\n    <div class=\"modal-title\">Sair do <span id=\"exit-modal-appname\">app</span></div>\n    <div class=\"modal-sub\">O que você deseja fazer?</div>\n    <button class=\"modal-btn modal-btn-minimize\" id=\"exit-modal-minimize\" onclick=\"exitModalMinimize()\">📱 Minimizar (segundo plano)</button>\n    <button class=\"modal-btn modal-btn-exit\" onclick=\"exitModalExit()\">🚪 Sair completamente</button>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"closeExitModal()\">↩️ Cancelar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"cred-modal\" onclick=\"closeCredModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">🔐 LOGIN NECESSÁRIO</div>\n    <div class=\"modal-title\">Credenciais SSH</div>\n    <div class=\"modal-sub\">Esse servidor pede usuário e senha pra conectar.</div>\n    <div class=\"cred-label\">👤 Usuário</div>\n    <input type=\"text\" id=\"cred-user\" class=\"cred-input\" placeholder=\"Digite o usuário\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <div class=\"cred-label\">🔒 Senha</div>\n    <div style=\"position:relative;\">\n      <input type=\"password\" id=\"cred-pass\" class=\"cred-input\" placeholder=\"Digite a senha\" style=\"padding-right:42px;\">\n      <span id=\"cred-pass-toggle\" style=\"position:absolute; right:12px; top:50%; transform:translateY(-50%); cursor:pointer; font-size:15px; user-select:none;\">👁️</span>\n    </div>\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:16px;\" onclick=\"saveCredField(); closeCredModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"uuid-modal\" onclick=\"closeUuidModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">🔑 ATIVAÇÃO NECESSÁRIA</div>\n    <div class=\"modal-title\">UUID / Chave</div>\n    <div class=\"modal-sub\">Esse perfil é premium e precisa da chave de ativação.</div>\n    <div class=\"cred-label\">🔑 UUID</div>\n    <input type=\"text\" id=\"xray-uuid-input\" class=\"cred-input\" placeholder=\"Cole o UUID aqui\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:16px;\" onclick=\"saveUuidField(); closeUuidModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"autherror-modal\" onclick=\"closeAuthErrorModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\" style=\"background:rgba(242,104,94,.12); border-color:rgba(242,104,94,.35); color:var(--red);\">⚠️ FALHA NO LOGIN</div>\n    <div class=\"modal-title\" id=\"autherror-title\">Usuário ou senha incorretos</div>\n    <div class=\"modal-sub\" id=\"autherror-sub\">Não foi possível autenticar nesse servidor com as credenciais informadas. Confira e tente de novo.</div>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"fixCredsAfterAuthError()\">Corrigir credenciais</button>\n    <button class=\"modal-btn modal-btn-minimize\" onclick=\"closeAuthErrorModal()\">Fechar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"sheet-ssh\" onclick=\"closeSheet('ssh')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-title\">\n      <div class=\"sheet-title-text\"><span>Servidores SSH</span><span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n      <div class=\"sheet-close\" onclick=\"closeSheet('ssh')\">✕</div>\n    </div>\n    <div class=\"sheet-list\" id=\"ssh-list\"></div>\n  </div>\n</div>\n<div class=\"overlay\" id=\"sheet-payload\" onclick=\"closeSheet('payload')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-title\">\n      <div class=\"sheet-title-text\"><span>Payloads</span></div>\n      <div class=\"sheet-close\" onclick=\"closeSheet('payload')\">✕</div>\n    </div>\n    <div class=\"sheet-list\" id=\"payload-list\"></div>\n  </div>\n</div>\n<div class=\"overlay\" id=\"sheet-xray\" onclick=\"closeSheet('xray')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-title\">\n      <div class=\"sheet-title-text\"><span>Perfis XRAY</span><span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n      <div class=\"sheet-close\" onclick=\"closeSheet('xray')\">✕</div>\n    </div>\n    <div class=\"sheet-list\" id=\"xray-list\"></div>\n  </div>\n</div>\n\n<div class=\"logs-page\" id=\"logs-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">// Logs de Conexão</div>\n    <div class=\"logs-actions\">\n      <button class=\"logs-btn\" onclick=\"copyLogs()\">Copiar</button>\n      <button class=\"logs-btn\" onclick=\"clearLogs()\" style=\"color:var(--red);border-color:rgba(242,104,94,.3)\">Limpar</button>\n      <button class=\"logs-btn\" onclick=\"hideLogs()\">✕</button>\n    </div>\n  </div>\n  <div class=\"logs-body\" id=\"logs-body\">\n    <div class=\"logs-empty\"><span style=\"font-size:28px\">📋</span><span>Aguardando logs...</span></div>\n  </div>\n  <div class=\"logs-footer\">\n    <div class=\"autoscroll-toggle\">\n      <div class=\"switch on\" id=\"autoscroll-switch\" onclick=\"toggleAutoscroll()\"></div>\n      <span>Rolagem automática</span>\n    </div>\n  </div>\n</div>\n\n<div class=\"settings-page\" id=\"settings-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">// Configurações</div>\n    <div class=\"logs-actions\"><button class=\"logs-btn\" onclick=\"hideSettings()\">Fechar</button></div>\n  </div>\n  <div class=\"settings-body\">\n\n    <div class=\"settings-section-title\">🎨 Aparência</div>\n    <div class=\"theme-current-label\">Tema atual: <span id=\"theme-current-name\">Cyber</span></div>\n    <div class=\"panel theme-preview-card\" id=\"theme-preview-card\">\n      <div class=\"theme-preview-title\">PRÉVIA AO VIVO</div>\n      <div class=\"theme-preview-row\">\n        <div class=\"theme-preview-orb\">\n          <div class=\"theme-preview-orb-ring\"></div>\n          <div class=\"theme-preview-orb-core\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" width=\"18\" height=\"18\"><path d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\"/></svg>\n          </div>\n        </div>\n        <div class=\"theme-preview-meta\">\n          <div class=\"theme-preview-status\">CONECTADO</div>\n          <button class=\"theme-preview-btn\">Conectar</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"palette-grid\" id=\"palette-grid\"></div>\n    <div class=\"bg-color-row\">\n      <input type=\"color\" id=\"bg-color-input\" value=\"#241c16\">\n      <div style=\"flex:1\">\n        <div class=\"setting-item-title\">Cor de fundo</div>\n        <div class=\"setting-item-sub\">Toque no quadrado pra escolher</div>\n      </div>\n      <button class=\"bg-color-reset\" onclick=\"resetBgColor()\">Padrão</button>\n    </div>\n\n    <div class=\"settings-section-title\">⚙️ Conexão</div>\n    <div class=\"setting-item\" onclick=\"toggleAutoConnect()\">\n      <div class=\"switch\" id=\"autoconnect-switch\"></div>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Conectar ao abrir