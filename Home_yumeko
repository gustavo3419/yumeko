v>\n</div>\n\n<div class=\"overlay\" id=\"uuid-modal\" onclick=\"closeUuidModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">🔑 ATIVAÇÃO NECESSÁRIA</div>\n    <div class=\"modal-title\">UUID / Chave</div>\n    <div class=\"modal-sub\">Esse perfil é premium e precisa da chave de ativação.</div>\n    <div class=\"cred-label\">🔑 UUID</div>\n    <input type=\"text\" id=\"xray-uuid-input\" class=\"cred-input\" placeholder=\"Cole o UUID aqui\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:16px;\" onclick=\"saveUuidField(); closeUuidModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"autherror-modal\" onclick=\"closeAuthErrorModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\" style=\"background:rgba(255,56,96,.12); border-color:rgba(255,56,96,.35); color:var(--red);\">⚠️ FALHA NO LOGIN</div>\n    <div class=\"modal-title\" id=\"autherror-title\">Usuário ou senha incorretos</div>\n    <div class=\"modal-sub\" id=\"autherror-sub\">Não foi possível autenticar nesse servidor com as credenciais informadas. Confira e tente de novo.</div>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"fixCredsAfterAuthError()\">Corrigir credenciais</button>\n    <button class=\"modal-btn modal-btn-minimize\" onclick=\"closeAuthErrorModal()\">Fechar</button>\n  </div></div>\n</div>\n\n<div class=\"sheet-page\" id=\"sheet-ssh\">\n  <div class=\"sheet-page-header\">\n    <div class=\"sheet-page-title\">\n      <span class=\"sheet-page-icon\">🖥️</span>\n      <div class=\"sheet-title-text\"><span>Servidores SSH</span><span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n    </div>\n    <div class=\"sheet-close\" onclick=\"closeSheet('ssh')\">✕</div>\n  </div>\n  <div class=\"sheet-tabs\">\n    <button class=\"sheet-tab active\" data-filter=\"free\" onclick=\"setSheetFilter('ssh','free')\">Free</button>\n    <button class=\"sheet-tab\" data-filter=\"vip\" onclick=\"setSheetFilter('ssh','vip')\">VIP</button>\n  </div>\n  <div class=\"sheet-search-wrap\">\n    <span class=\"sheet-search-icon\">🔍</span>\n    <input type=\"text\" class=\"sheet-search-input\" id=\"ssh-search\" placeholder=\"Buscar servidor...\" oninput=\"filterSheetList('ssh')\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n  </div>\n  <div class=\"sheet-list\" id=\"ssh-list\"></div>\n</div>\n<div class=\"sheet-page\" id=\"sheet-payload\">\n  <div class=\"sheet-page-header\">\n    <div class=\"sheet-page-title\">\n      <span class=\"sheet-page-icon\">📦</span>\n      <div class=\"sheet-title-text\"><span>Payloads</span></div>\n    </div>\n    <div class=\"sheet-close\" onclick=\"closeSheet('payload')\">✕</div>\n  </div>\n  <div class=\"sheet-tabs\">\n    <button class=\"sheet-tab active\" data-filter=\"all\" onclick=\"setSheetFilter('payload','all')\">Todos</button>\n    <button class=\"sheet-tab\" data-filter=\"fav\" onclick=\"setSheetFilter('payload','fav')\">Favoritos</button>\n  </div>\n  <div class=\"sheet-search-wrap\">\n    <span class=\"sheet-search-icon\">🔍</span>\n    <input type=\"text\" class=\"sheet-search-input\" id=\"payload-search\" placeholder=\"Buscar payload...\" oninput=\"filterSheetList('payload')\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n  </div>\n  <div class=\"sheet-list\" id=\"payload-list\"></div>\n</div>\n<div class=\"sheet-page\" id=\"sheet-xray\">\n  <div class=\"sheet-page-header\">\n    <div class=\"sheet-page-title\">\n      <span class=\"sheet-page-icon\">⚡</span>\n      <div class=\"sheet-title-text\"><span>Perfis XRAY</span><span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n    </div>\n    <div class=\"sheet-close\" onclick=\"closeSheet('xray')\">✕</div>\n  </div>\n  <div class=\"sheet-tabs\">\n    <button class=\"sheet-tab active\" data-filter=\"free\" onclick=\"setSheetFilter('xray','free')\">Free</button>\n    <button class=\"sheet-tab\" data-filter=\"vip\" onclick=\"setSheetFilter('xray','vip')\">VIP</button>\n  </div>\n  <div class=\"sheet-search-wrap\">\n    <span class=\"sheet-search-icon\">🔍</span>\n    <input type=\"text\" class=\"sheet-search-input\" id=\"xray-search\" placeholder=\"Buscar perfil...\" oninput=\"filterSheetList('xray')\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n  </div>\n  <div class=\"sheet-list\" id=\"xray-list\"></div>\n</div>\n\n<div class=\"logs-page\" id=\"logs-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">Logs de Conexão</div>\n    <div class=\"logs-actions\">\n      <button class=\"logs-btn\" onclick=\"copyLogs()\">Copiar</button>\n      <button class=\"logs-btn\" onclick=\"clearLogs()\" style=\"color:var(--red);border-color:rgba(255,56,96,.3)\">Limpar</button>\n      <button class=\"logs-btn\" onclick=\"hideLogs()\">✕</button>\n    </div>\n  </div>\n  <div class=\"logs-body\" id=\"logs-body\">\n    <div class=\"logs-empty\"><span style=\"font-size:28px\">📋</span><span>Aguardando logs...</span></div>\n  </div>\n  <div class=\"logs-footer\">\n    <div class=\"autoscroll-toggle\">\n      <div class=\"switch on\" id=\"autoscroll-switch\" onclick=\"toggleAutoscroll()\"></div>\n      <span>Rolagem automática</span>\n    </div>\n  </div>\n</div>\n\n<div class=\"settings-page\" id=\"settings-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">Configurações</div>\n    <div class=\"logs-actions\"><button class=\"logs-btn\" onclick=\"hideSettings()\">Fechar</button></div>\n  </div>\n  <div class=\"settings-body\">\n\n    <div class=\"settings-section-title\">🎨 Aparência</div>\n    <div class=\"theme-current-label\">Tema atual: <span id=\"theme-current-name\">Lilás</span></div>\n    <div class=\"panel\" style=\"padding:16px;\">\n      <div class=\"palette-grid\" id=\"palette-grid\"></div>\n    </div>\n    <button class=\"theme-update-btn\" onclick=\"doUpdate()\">↻ Atualizar Configurações</button>\n    <div class=\"bg-color-row\">\n      <div style=\"flex:1\">\n        <div class=\"setting-item-title\">Cor de fundo</div>\n        <div class=\"setting-item-sub\">Toque no círculo pra escolher</div>\n      </div>\n      <input type=\"color\" id=\"bg-color-input\" value=\"#0a0913\">\n      <button class=\"bg-color-reset\" onclick=\"resetBgColor()\">Padrão</button>\n    </div>\n\n    <div class=\"settings-section-title\">⚙️ Conexão</div>\n    <div class=\"setting-item\" onclick=\"toggleAutoConnect()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Conectar ao abrir o app</div>\n        <div class=\"setting-item-sub\">Usa o último servidor/perfil selecionado</div>\n      </div>\n      <div class=\"switch\" id=\"autoconnect-switch\"></div>\n    </div>\n    <div class=\"setting-item\" id=\"uuid-item\" onclick=\"promptUuid()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">UUID / Chave</div>\n        <div class=\"setting-item-sub\" id=\"uuid-sub\">Não configurado</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"toast('Puxe a barra de notificação e segure num ícone pra adicionar o atalho de Ajustes Rápidos do VB Injector 💡')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2L2 7l10 5 10-5-10-5z\"/><path d=\"M2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atalho rápido</div>\n        <div class=\"setting-item-sub\">Conectar sem abrir o app (Ajustes Rápidos)</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n\n    <div class=\"settings-section-title\">🛠️ Avançado</div>\n    <div class=\"setting-item\" onclick=\"doUpdate()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atualizar Configuração</div>\n        <div class=\"setting-item-sub\">Buscar dados do servidor agora</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"if (B && B.openSettings) { B.openSettings(); } else { toast('Disponível só no app.'); }\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Configurações Avançadas</div>\n        <div class=\"setting-item-sub\">DNS, UDP, SSH, Sistema...</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"toggleDiagBox()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Diagnóstico</div>\n        <div class=\"setting-item-sub\">Gerar relatório pra suporte</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div id=\"diag-wrap\" style=\"display:none\">\n      <div class=\"diag-box\" id=\"diag-box\"></div>\n      <button class=\"logs-btn\" style=\"width:100%;margin-top:8px;padding:10px;\" onclick=\"copyDiag()\">Copiar diagnóstico</button>\n    </div>\n\n  </div>\n</div>\n\n<script>\nvar B = window.VBBridge;\nvar app = {\n  mode: 'SSH', connected: false, connectTime: 0, timerInt: null, pollInt: null,\n  favorites: [], autoscroll: true\n};\n\nfunction bp(raw, fb) { try { return JSON.parse(raw) || fb; } catch(e) { return fb; } }\n\nfunction forceRepaint(el) {\n  if (!el) return;\n  requestAnimationFrame(function () {\n    requestAnimationFrame(function () {\n      el.style.transform = 'translateZ(0)';\n      void el.offsetHeight;\n      el.style.transform = '';\n    });\n  });\n}\n\n// ============================================================\n// ═══ FLAG: usa APENAS o campo \"flag\" do JSON ═══\n// ============================================================\nfunction getFlagUrl(item) {\n  if (!item) return null;\n  var flag = item.flag || item.FLAG || '';\n  if (flag && typeof flag === 'string' && flag.startsWith('http')) {\n    return flag;\n  }\n  return null;\n}\n\nfunction setItemIcon(iconId, flagId, emojiId, item, defaultEmoji) {\n  var icon = document.getElementById(iconId);\n  var flag = document.getElementById(flagId);\n  var emoji = document.getElementById(emojiId);\n  if (!icon || !flag || !emoji) return;\n  var url = getFlagUrl(item);\n  if (url) {\n    flag.src = url;\n    flag.style.display = 'block';\n    emoji.style.display = 'none';\n  } else {\n    flag.style.display = 'none';\n    emoji.style.display = 'block';\n  }\n}\n\nfunction getItemFlagUrl(item) {\n  return getFlagUrl(item);\n}\n\nfunction init() {\n  if (!B) { showMsg('Bridge não encontrado. Modo de preview.'); return; }\n  if (B.isTamperDetected && B.isTamperDetected()) showTamperWarning();\n\n  var cfg = bp(B.getConfig(), {});\n  if (cfg.appName) document.getElementById('app-name').textContent = cfg.appName;\n  if (cfg.configVersion) document.getElementById('config-ver').textContent = 'v' + cfg.configVersion;\n  if (B.getHtmlVersion) document.getElementById('html-ver').textContent = 'h' + (B.getHtmlVersion() || '--');\n  if (cfg.notice && cfg.notice.enabled) showNoticeBar(cfg.notice.title || 'Aviso', cfg.notice.message || '');\n\n  var uuid = B.getUuid ? B.getUuid() : '';\n  if (uuid) document.getElementById('uuid-sub').textContent = uuid.substring(0,8) + '...';\n\n  initPalette();\n  initAutoConnectSwitch();\n  setupCredModal();\n  setupUuidModal();\n\n  var savedMode = B.getMode ? B.getMode() : 'SSH';\n  setMode(savedMode === 'XRAY' ? 'XRAY' : 'SSH', true);\n\n  refreshFavorites();\n  refreshSelected();\n  updateNetBadge();\n  refreshIpInfo();\n\n  app.pollInt = setInterval(pollStatus, 700);\n  setInterval(updateNetBadge, 5000);\n  pollStatus();\n  maybeAutoConnect();\n}\n\nfunction maybeAutoConnect() {\n  if (!B || !B.getAutoConnect || !B.getAutoConnect()) return;\n  if (app.connected) return;\n  var st = bp(B.getStatus(), {});\n  if (st.connected) return;\n  setTimeout(function () { doConnect(); }, 600);\n}\n\nfunction updateNetBadge() {\n  if (!B || !B.getNetworkInfo) return;\n  try {\n    var info = bp(B.getNetworkInfo(), {});\n    document.getElementById('net-badge-text').textContent = info.type || '--';\n    document.getElementById('net-badge').classList.toggle('online', !!info.online);\n  } catch(e) {}\n}\n\n\n/* ── IP / LOCALIZAÇÃO ── */\nfunction refreshIpInfo() {\n  if (!B || !B.requestIpInfo) {\n    setTimeout(refreshIpInfo, 500);\n    return;\n  }\n  document.getElementById('ip-status-line').textContent = 'Consultando...';\n  var timeoutId = setTimeout(function() {\n    document.getElementById('ip-status-line').textContent = 'Timeout na consulta';\n    document.getElementById('ip-value').textContent = '—';\n  }, 15000);\n  var oldOnVBIpInfo = window.onVBIpInfo;\n  window.onVBIpInfo = function(info) {\n    clearTimeout(timeoutId);\n    if (oldOnVBIpInfo) oldOnVBIpInfo(info);\n  };\n  B.requestIpInfo();\n}\nwindow.onVBIpInfo = function(info) {\n  var line = document.getElementById('ip-status-line');\n  if (!info || !info.ip || info.success === false) {\n    document.getElementById('ip-value').textContent = '—';\n    document.getElementById('ip-loc').textContent = '';\n    line.textContent = 'Não foi possível consultar agora';\n    return;\n  }\n  document.getElementById('ip-value').textContent = info.ip;\n  var country = info.country_name || info.country || '';\n  var loc = [info.city, info.region, country].filter(Boolean).join(', ');\n  document.getElementById('ip-loc').textContent = loc;\n  line.textContent = app.connected ? 'IP mascarado pelo túnel ✓' : 'Esse é o seu IP real (sem túnel)';\n};\n\n\n/* ── PING ── */\nfunction testPing() {\n  if (!B || !B.requestPing) return;\n  var target = currentTarget();\n  if (!target) { toast('Escolha um servidor primeiro'); return; }\n  var chip = document.getElementById('ping-chip');\n  chip.className = 'chip loading';\n  document.getElementById('ping-label').textContent = 'Testando...';\n  B.requestPing(target.host, target.port);\n}\nfunction currentTarget() {\n  try {\n    if (app.mode === 'XRAY') {\n      var x = bp(B.getSelectedXray(), {});\n      if (x.host && x.port) return { host: x.host, port: x.port };\n    } else {\n      var s = bp(B.getSelectedServer(), {});\n      if (s.host && s.port) return { host: s.host, port: s.port };\n    }\n  } catch(e) {}\n  return null;\n}\nwindow.onVBPingResult = function(result) {\n  var 