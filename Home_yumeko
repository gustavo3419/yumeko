{"version": "122", "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n<title>VB INJECTOR // TERMINAL</title>\n<link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&family=Space+Grotesk:wght@400;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root {\n    --bg: #020205;\n    --panel: rgba(10, 15, 25, 0.95);\n    --border: rgba(0, 255, 255, 0.15);\n    --border-bright: rgba(0, 255, 255, 0.4);\n    --accent: #00f2ff;\n    --matrix: #00ff41;\n    --yellow: #ffea00;\n    --red: #ff3131;\n    --text: #e0faff;\n    --muted: #4a5d6e;\n    --mono: 'JetBrains Mono', monospace;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\n\nhtml, body {\n    height: 100%;\n    background: var(--bg);\n    font-family: 'Space Grotesk', sans-serif;\n    color: var(--text);\n    overflow: hidden;\n}\n\n/* \u2500\u2500 MATRIX BACKGROUND EFFECT \u2500\u2500 */\n.matrix-bg {\n    position: fixed;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n    opacity: 0.05;\n    background: linear-gradient(rgba(0, 255, 65, 0.1) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(0, 255, 65, 0.1) 1px, transparent 1px);\n    background-size: 20px 20px;\n}\n\n.shell {\n    position: relative;\n    z-index: 1;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom);\n}\n\n/* \u2500\u2500 HEADER \u2500\u2500 */\n.header {\n    padding: 16px 20px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background: rgba(0, 0, 0, 0.4);\n    border-bottom: 1px solid var(--border);\n}\n\n.brand {\n    font-family: var(--mono);\n    font-size: 14px;\n    font-weight: 800;\n    color: var(--accent);\n    letter-spacing: 2px;\n    text-shadow: 0 0 10px rgba(0, 242, 255, 0.5);\n}\n\n.status-badge {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 10px;\n    font-family: var(--mono);\n    text-transform: uppercase;\n    color: var(--muted);\n}\n\n.status-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: var(--muted);\n    box-shadow: 0 0 5px rgba(255, 255, 255, 0.2);\n}\n\n.status-dot.active { background: var(--matrix); box-shadow: 0 0 10px var(--matrix); animation: pulse 1.5s infinite; }\n.status-dot.connecting { background: var(--yellow); box-shadow: 0 0 10px var(--yellow); animation: pulse 0.8s infinite; }\n.status-dot.error { background: var(--red); box-shadow: 0 0 10px var(--red); }\n\n@keyframes pulse {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.5; transform: scale(1.2); }\n}\n\n/* \u2500\u2500 CAMADA 1: STATUS VISUAL \u2500\u2500 */\n.visual-layer {\n    flex: 1;\n    padding: 20px;\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n    overflow-y: auto;\n}\n\n.terminal-window {\n    background: var(--panel);\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    padding: 15px;\n    position: relative;\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);\n}\n\n.terminal-header {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 12px;\n    font-family: var(--mono);\n    font-size: 9px;\n    color: var(--muted);\n    border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n    padding-bottom: 5px;\n}\n\n.status-feed {\n    min-height: 120px;\n    font-family: var(--mono);\n    font-size: 13px;\n    line-height: 1.6;\n}\n\n.feed-line {\n    display: flex;\n    gap: 10px;\n    margin-bottom: 4px;\n    opacity: 0.7;\n}\n\n.feed-line.active { opacity: 1; color: var(--accent); }\n.feed-line.success { color: var(--matrix); }\n.feed-line.error { color: var(--red); }\n\n.typing::after {\n    content: '_';\n    animation: blink 0.8s infinite;\n}\n\n@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }\n\n/* \u2500\u2500 PROGRESS BARS \u2500\u2500 */\n.metrics-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 10px;\n}\n\n.metric-card {\n    background: rgba(255, 255, 255, 0.02);\n    border: 1px solid var(--border);\n    padding: 12px;\n    border-radius: 6px;\n}\n\n.metric-label {\n    font-family: var(--mono);\n    font-size: 9px;\n    color: var(--muted);\n    margin-bottom: 8px;\n    display: flex;\n    justify-content: space-between;\n}\n\n.progress-container {\n    height: 6px;\n    background: rgba(255, 255, 255, 0.05);\n    border-radius: 3px;\n    overflow: hidden;\n}\n\n.progress-bar {\n    height: 100%;\n    width: 0%;\n    background: var(--accent);\n    box-shadow: 0 0 10px var(--accent);\n    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.progress-bar.matrix { background: var(--matrix); box-shadow: 0 0 10px var(--matrix); }\n.progress-bar.yellow { background: var(--yellow); box-shadow: 0 0 10px var(--yellow); }\n\n.ping-display {\n    display: flex;\n    align-items: baseline;\n    gap: 5px;\n}\n\n.ping-val { font-family: var(--mono); font-size: 20px; font-weight: 800; }\n.ping-unit { font-size: 10px; color: var(--muted); }\n\n/* \u2500\u2500 CAMADA 2: LOGS T\u00c9CNICOS (EXPANS\u00cdVEL) \u2500\u2500 */\n.expand-btn {\n    background: none;\n    border: 1px solid var(--border);\n    color: var(--accent);\n    font-family: var(--mono);\n    font-size: 11px;\n    padding: 12px;\n    width: 100%;\n    border-radius: 6px;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    transition: all 0.3s;\n}\n\n.expand-btn:active { background: rgba(0, 242, 255, 0.1); }\n\n.tech-logs-panel {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    height: 70vh;\n    background: #05050a;\n    border-top: 1px solid var(--border-bright);\n    z-index: 100;\n    transform: translateY(100%);\n    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n    display: flex;\n    flex-direction: column;\n}\n\n.tech-logs-panel.open { transform: translateY(0); }\n\n.panel-header {\n    padding: 12px 20px;\n    background: rgba(255, 255, 255, 0.03);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.panel-title { font-family: var(--mono); font-size: 11px; color: var(--accent); }\n\n.close-panel {\n    background: rgba(255, 255, 255, 0.05);\n    border: none;\n    color: var(--muted);\n    width: 24px;\n    height: 24px;\n    border-radius: 4px;\n    cursor: pointer;\n}\n\n.logs-container {\n    flex: 1;\n    overflow-y: auto;\n    padding: 15px;\n    font-family: var(--mono);\n    font-size: 10px;\n    color: #8899aa;\n}\n\n.log-row {\n    margin-bottom: 4px;\n    display: flex;\n    gap: 8px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.02);\n    padding-bottom: 2px;\n}\n\n.log-time { color: #445566; flex-shrink: 0; }\n.log-msg { word-break: break-all; }\n.log-error { color: var(--red); }\n.log-warn { color: var(--yellow); }\n.log-info { color: var(--accent); }\n\n/* \u2500\u2500 SCROLLBAR \u2500\u2500 */\n::-webkit-scrollbar { width: 4px; }\n::-webkit-scrollbar-track { background: transparent; }\n::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }\n\n</style>\n</head>\n<body>\n\n<div class=\"matrix-bg\"></div>\n\n<div class=\"shell\">\n    <!-- HEADER -->\n    <div class=\"header\">\n        <div class=\"brand\">VB INJECTOR v2</div>\n        <div class=\"status-badge\">\n            <span id=\"statusText\">Aguardando</span>\n            <div class=\"status-dot\" id=\"statusDot\"></div>\n        </div>\n    </div>\n\n    <!-- CAMADA 1: VISUAL -->\n    <div class=\"visual-layer\">\n        \n        <div class=\"terminal-window\">\n            <div class=\"terminal-header\">\n                <span>SYSTEM_DIAGNOSTICS_RUNNING</span>\n                <span id=\"sysTime\">00:00:00</span>\n            </div>\n            <div class=\"status-feed\" id=\"statusFeed\">\n                <!-- Linhas ser\u00e3o inseridas aqui -->\n            </div>\n        </div>\n\n        <div class=\"metrics-grid\">\n            <div class=\"metric-card\">\n                <div class=\"metric-label\">\n                    <span>PROXY TUNNEL</span>\n                    <span id=\"proxyVal\">0/6</span>\n                </div>\n                <div class=\"progress-container\">\n                    <div class=\"progress-bar yellow\" id=\"proxyBar\"></div>\n                </div>\n            </div>\n            <div class=\"metric-card\">\n                <div class=\"metric-label\">\n                    <span>PAYLOAD STATUS</span>\n                    <span id=\"payloadVal\">OFF</span>\n                </div>\n                <div class=\"progress-container\">\n                    <div class=\"progress-bar matrix\" id=\"payloadBar\"></div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"metric-card\">\n            <div class=\"metric-label\">CONNECTION LATENCY</div>\n            <div class=\"ping-display\">\n                <div class=\"ping-val\" id=\"pingMs\">---</div>\n                <div class=\"ping-unit\">MS</div>\n            </div>\n        </div>\n\n        <div style=\"margin-top: auto;\">\n            <button class=\"expand-btn\" onclick=\"toggleLogs(true)\">\n                <span>[\u25bc] VER DETALHES T\u00c9CNICOS</span>\n            </button>\n        </div>\n    </div>\n\n    <!-- CAMADA 2: LOGS -->\n    <div class=\"tech-logs-panel\" id=\"logsPanel\">\n        <div class=\"panel-header\">\n            <div class=\"panel-title\">CORE_LOGS_STREAM</div>\n            <button class=\"close-panel\" onclick=\"toggleLogs(false)\">\u2715</button>\n        </div>\n        <div class=\"logs-container\" id=\"logContainer\">\n            <div style=\"text-align: center; padding: 40px; color: #334455;\">\n                Aguardando fluxo de dados...\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\nconst MAX_LOGS = 500;\nlet logCount = 0;\nlet isPanelOpen = false;\n\n// \u2500\u2500 Fun\u00e7\u00f5es de Interface \u2500\u2500\nfunction toggleLogs(open) {\n    isPanelOpen = open;\n    document.getElementById('logsPanel').classList.toggle('open', open);\n}\n\nfunction updateSysTime() {\n    const now = new Date();\n    document.getElementById('sysTime').textContent = now.toLocaleTimeString('pt-BR', { hour12: false });\n}\nsetInterval(updateSysTime, 1000);\n\n// \u2500\u2500 Efeito de Digita\u00e7\u00e3o \u2500\u2500\nasync function typeLine(text, type = '') {\n    const feed = document.getElementById('statusFeed');\n    \n    // Remove active de outros\n    const prev = feed.querySelector('.feed-line.active');\n    if (prev) prev.classList.remove('active');\n\n    const line = document.createElement('div');\n    line.className = `feed-line active ${type}`;\n    line.innerHTML = `<span class=\"feed-prefix\">\u25ba</span> <span class=\"typing\"></span>`;\n    feed.appendChild(line);\n    \n    const textSpan = line.querySelector('.typing');\n    \n    for (let i = 0; i < text.length; i++) {\n        textSpan.textContent += text[i];\n        await new Promise(r => setTimeout(r, 30));\n    }\n    \n    textSpan.classList.remove('typing');\n    \n    // Auto scroll feed\n    if (feed.children.length > 6) feed.removeChild(feed.firstChild);\n}\n\n// \u2500\u2500 API: Interpretador de Logs \u2500\u2500\nfunction interpretLog(level, msg) {\n    const m = msg.toLowerCase();\n\n    // Ping\n    const pingMatch = msg.match(/(\\d+)\\s*ms/i);\n    if (pingMatch) {\n        const ms = parseInt(pingMatch[1]);\n        const el = document.getElementById('pingMs');\n        el.textContent = ms;\n        el.style.color = ms < 100 ? 'var(--matrix)' : ms < 300 ? 'var(--yellow)' : 'var(--red)';\n    }\n\n    // Payload\n    if (m.includes('payload')) {\n        document.getElementById('payloadVal').textContent = 'ACTIVE';\n        document.getElementById('payloadBar').style.width = '100%';\n        typeLine('Payload injetado com sucesso', 'success');\n    }\n\n    // Proxy\n    if (m.includes('proxy')) {\n        const numMatch = msg.match(/(\\d+)/);\n        if (numMatch) {\n            const n = numMatch[1];\n            document.getElementById('proxyVal').textContent = `${n}/6`;\n            document.getElementById('proxyBar').style.width = `${(n/6)*100}%`;\n        }\n    }\n\n    // Status Geral\n    if (m.includes('conectado') || m.includes('connected')) {\n        setStatus('CONECTADO', 'active');\n        typeLine('T\u00fanel estabelecido: ACESSO TOTAL', 'success');\n    } else if (m.includes('conectando') || m.includes('connecting')) {\n        setStatus('CONECTANDO', 'connecting');\n        typeLine('Inicializando protocolo de t\u00fanel...');\n    } else if (m.includes('erro') || m.includes('fail')) {\n        setStatus('ERRO', 'error');\n        typeLine('Falha na conex\u00e3o: Re-tentando...', 'error');\n    }\n}\n\nfunction setStatus(text, dotClass) {\n    document.getElementById('statusText').textContent = text;\n    const dot = document.getElementById('statusDot');\n    dot.className = `status-dot ${dotClass}`;\n    if (text === 'CONECTADO') dot.style.boxShadow = '0 0 15px var(--matrix)';\n}\n\n// \u2500\u2500 API: Entrada de Logs do Java \u2500\u2500\nfunction addLogs(logs) {\n    if (!Array.isArray(logs)) return;\n\n    const container = document.getElementById('logContainer');\n    if (logCount === 0) container.innerHTML = '';\n\n    logs.forEach(log => {\n        const level = log.level || 'info';\n        const msg = log.message || '';\n        const time = log.time || new Date().toLocaleTimeString('pt-BR', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });\n\n        interpretLog(level, msg);\n\n        const div = document.createElement('div');\n        div.className = 'log-row';\n        div.innerHTML = `<span class=\"log-time\">[${time}]</span> <span class=\"log-msg log-${level}\">${msg}</span>`;\n        container.appendChild(div);\n        logCount++;\n    });\n\n    if (container.children.length > MAX_LOGS) {\n        for(let i=0; i<logs.length; i++) container.removeChild(container.firstChild);\n    }\n\n    // Auto-scroll se o painel estiver aberto\n    if (isPanelOpen) container.scrollTop = container.scrollHeight;\n}\n\n// Simula\u00e7\u00e3o inicial\nsetTimeout(() => {\n    typeLine('VB Injector v2 System Ready');\n}, 500);\n\n</script>\n</body>\n</html>\n"}
