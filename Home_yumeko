{"version": "18", "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<title>VB INJECTOR</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root {\n  --bg: #050810;\n  --surface: #0d1117;\n  --surface2: #161b22;\n  --border: rgba(99,179,237,0.12);\n  --accent: #63b3ed;\n  --accent2: #4299e1;\n  --green: #48bb78;\n  --yellow: #ecc94b;\n  --red: #fc8181;\n  --text: #e2e8f0;\n  --muted: #4a5568;\n  --muted2: #718096;\n  --mono: 'JetBrains Mono', monospace;\n  --sans: 'Space Grotesk', sans-serif;\n}\n* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\nhtml, body { height: 100%; background: var(--bg); overflow: hidden; }\nbody { font-family: var(--sans); color: var(--text); }\n\n/* ── GRID DE FUNDO ── */\nbody::before {\n  content: '';\n  position: fixed; inset: 0; pointer-events: none; z-index: 0;\n  background-image:\n    linear-gradient(rgba(99,179,237,.04) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(99,179,237,.04) 1px, transparent 1px);\n  background-size: 40px 40px;\n}\n\n.shell {\n  position: relative; z-index: 1;\n  width: 100%; max-width: 480px;\n  margin: 0 auto; height: 100vh;\n  display: flex; flex-direction: column;\n  padding-bottom: env(safe-area-inset-bottom);\n}\n\n/* ── HEADER ── */\n.header {\n  padding: 16px 20px 12px;\n  display: flex; align-items: center; justify-content: space-between;\n  border-bottom: 1px solid var(--border);\n  background: rgba(5,8,16,.9);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n}\n.header-brand {\n  font-size: 11px; font-weight: 700;\n  letter-spacing: .2em; text-transform: uppercase;\n  color: var(--accent); font-family: var(--mono);\n}\n.header-right { display: flex; align-items: center; gap: 8px; }\n.header-ver {\n  font-size: 10px; color: var(--muted2);\n  font-family: var(--mono); letter-spacing: .08em;\n}\n.btn-icon {\n  width: 32px; height: 32px;\n  background: var(--surface2); border: 1px solid var(--border);\n  border-radius: 8px; display: grid; place-items: center;\n  cursor: pointer; transition: all .2s;\n}\n.btn-icon:active { opacity: .6; }\n.btn-icon svg { width: 16px; height: 16px; color: var(--accent); }\n\n/* ── SCROLL BODY ── */\n.body {\n  flex: 1; overflow-y: auto; overflow-x: hidden;\n  padding: 16px 16px 8px;\n  display: flex; flex-direction: column; gap: 12px;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* ── ORB DE CONEXÃO ── */\n.orb-section {\n  display: flex; flex-direction: column; align-items: center;\n  padding: 24px 0 16px;\n  position: relative;\n}\n.orb-wrap { position: relative; width: 160px; height: 160px; }\n\n/* Anel externo pulsante */\n.orb-ring {\n  position: absolute; inset: -12px; border-radius: 50%;\n  border: 1px solid rgba(99,179,237,.15);\n  transition: border-color .4s;\n}\n.orb-ring2 {\n  position: absolute; inset: -24px; border-radius: 50%;\n  border: 1px solid rgba(99,179,237,.07);\n  transition: border-color .4s;\n}\nbody.connected .orb-ring { border-color: rgba(72,187,120,.35); animation: pulse-ring 2s ease-in-out infinite; }\nbody.connected .orb-ring2 { border-color: rgba(72,187,120,.12); animation: pulse-ring 2s ease-in-out infinite .4s; }\nbody.connecting .orb-ring { border-color: rgba(236,201,75,.3); animation: spin-slow 3s linear infinite; }\n\n@keyframes pulse-ring {\n  0%, 100% { transform: scale(1); opacity: 1; }\n  50% { transform: scale(1.04); opacity: .6; }\n}\n@keyframes spin-slow { to { transform: rotate(360deg); } }\n\n/* Botão principal */\n.orb-btn {\n  width: 160px; height: 160px; border-radius: 50%;\n  background: radial-gradient(circle at 38% 35%, #1a2535, #0d1117 65%, #080b12);\n  border: 1.5px solid rgba(99,179,237,.2);\n  display: grid; place-items: center;\n  cursor: pointer; position: relative; overflow: hidden;\n  box-shadow: 0 0 0 0 rgba(99,179,237,0), 0 8px 32px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.05);\n  transition: all .3s;\n}\n.orb-btn::before {\n  content: '';\n  position: absolute; inset: 0; border-radius: 50%;\n  background: radial-gradient(circle at 38% 32%, rgba(99,179,237,.08), transparent 60%);\n}\n.orb-btn:active { transform: scale(.95); }\n\nbody.connected .orb-btn {\n  border-color: rgba(72,187,120,.35);\n  box-shadow: 0 0 40px rgba(72,187,120,.2), 0 8px 32px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.05);\n}\nbody.connecting .orb-btn {\n  border-color: rgba(236,201,75,.3);\n  box-shadow: 0 0 30px rgba(236,201,75,.15), 0 8px 32px rgba(0,0,0,.6);\n}\n\n.orb-icon { transition: all .3s; }\n.orb-icon svg { width: 52px; height: 52px; }\n.orb-icon svg path { transition: fill .3s, stroke .3s; }\n\n.orb-label {\n  margin-top: 20px;\n  font-size: 13px; font-weight: 700;\n  letter-spacing: .18em; text-transform: uppercase;\n  color: var(--muted2); transition: color .3s;\n  font-family: var(--mono);\n}\nbody.connected .orb-label { color: var(--green); }\nbody.connecting .orb-label { color: var(--yellow); }\n\n.orb-sub {\n  margin-top: 5px; font-size: 11px;\n  color: var(--muted); letter-spacing: .08em;\n  text-align: center; min-height: 16px;\n}\n\n/* Timer */\n.timer {\n  display: none; align-items: center; gap: 8px;\n  margin-top: 10px;\n  background: rgba(72,187,120,.08);\n  border: 1px solid rgba(72,187,120,.2);\n  border-radius: 20px; padding: 6px 16px;\n}\n.timer.show { display: flex; }\n.timer-val {\n  font-family: var(--mono); font-size: 15px;\n  color: var(--green); letter-spacing: .1em;\n}\n.timer-label { font-size: 10px; color: var(--muted2); text-transform: uppercase; letter-spacing: .1em; }\n\n/* ── CARDS ── */\n.card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 12px; overflow: hidden;\n  position: relative;\n}\n.card::before {\n  content: '';\n  position: absolute; top: 0; left: 0; right: 0; height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(99,179,237,.12), transparent);\n}\n\n/* Modo pill */\n.mode-row {\n  display: flex; gap: 6px; padding: 6px;\n}\n.mode-btn {\n  flex: 1; padding: 10px 8px;\n  border-radius: 8px; border: 1px solid transparent;\n  font-size: 12px; font-weight: 700;\n  letter-spacing: .1em; text-transform: uppercase;\n  color: var(--muted2); background: transparent;\n  cursor: pointer; transition: all .2s; font-family: var(--sans);\n}\n.mode-btn.active {\n  background: rgba(99,179,237,.1);\n  border-color: rgba(99,179,237,.3);\n  color: var(--accent);\n}\n.mode-btn:active { opacity: .7; }\n\n/* Server card */\n.server-card {\n  padding: 14px 16px;\n  display: flex; align-items: center; gap: 12px;\n  cursor: pointer; transition: background .2s;\n}\n.server-card:active { background: rgba(99,179,237,.04); }\n.server-icon {\n  width: 42px; height: 42px; border-radius: 10px;\n  background: rgba(99,179,237,.08);\n  border: 1px solid rgba(99,179,237,.15);\n  display: grid; place-items: center;\n  font-size: 20px; flex: 0 0 42px;\n}\n.server-meta { flex: 1; min-width: 0; }\n.server-label {\n  font-size: 9px; font-weight: 700; color: var(--accent);\n  letter-spacing: .18em; text-transform: uppercase; font-family: var(--mono);\n}\n.server-name {\n  font-size: 15px; font-weight: 600; margin-top: 2px;\n  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n}\n.server-sub {\n  font-size: 11px; color: var(--muted2); margin-top: 2px;\n  text-transform: uppercase; letter-spacing: .08em;\n}\n.server-chev { color: var(--muted); font-size: 18px; }\n\n/* Mensagem */\n.msg-card {\n  padding: 12px 16px;\n  display: flex; align-items: flex-start; gap: 10px;\n}\n.msg-dot {\n  width: 6px; height: 6px; border-radius: 50%;\n  background: var(--accent); flex: 0 0 6px; margin-top: 5px;\n}\n.msg-text { font-size: 12px; color: var(--muted2); line-height: 1.5; }\n\n/* ── BOTÃO CONECTAR ── */\n.connect-btn {\n  width: 100%; padding: 16px;\n  background: linear-gradient(135deg, #2b6cb0, #2c5282);\n  border: 1px solid rgba(99,179,237,.3);\n  border-radius: 12px;\n  font-size: 14px; font-weight: 700;\n  letter-spacing: .12em; text-transform: uppercase;\n  color: #fff; cursor: pointer; font-family: var(--sans);\n  transition: all .2s; position: relative; overflow: hidden;\n}\n.connect-btn::before {\n  content: '';\n  position: absolute; inset: 0;\n  background: linear-gradient(135deg, rgba(255,255,255,.08), transparent);\n}\n.connect-btn:active { transform: scale(.98); opacity: .9; }\nbody.connected .connect-btn {\n  background: linear-gradient(135deg, #276749, #22543d);\n  border-color: rgba(72,187,120,.3);\n}\nbody.connecting .connect-btn {\n  background: linear-gradient(135deg, #744210, #5f370e);\n  border-color: rgba(236,201,75,.3);\n}\n\n/* ── ACTION ROW ── */\n.action-row {\n  display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;\n}\n.action-btn {\n  background: var(--surface); border: 1px solid var(--border);\n  border-radius: 10px; padding: 14px 8px;\n  display: flex; flex-direction: column; align-items: center; gap: 5px;\n  cursor: pointer; transition: all .2s;\n}\n.action-btn:active { background: var(--surface2); }\n.action-btn svg { width: 20px; height: 20px; color: var(--accent); }\n.action-btn span {\n  font-size: 9px; font-weight: 700; color: var(--muted2);\n  text-transform: uppercase; letter-spacing: .12em;\n}\n\n/* ── BOTTOM NAV ── */\n.bottom-nav {\n  display: flex; border-top: 1px solid var(--border);\n  background: rgba(5,8,16,.95);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  padding-bottom: env(safe-area-inset-bottom);\n}\n.nav-btn {\n  flex: 1; padding: 12px 8px;\n  display: flex; flex-direction: column; align-items: center; gap: 4px;\n  cursor: pointer; border: none; background: none;\n  transition: opacity .2s;\n}\n.nav-btn:active { opacity: .6; }\n.nav-btn svg { width: 20px; height: 20px; color: var(--muted); transition: color .2s; }\n.nav-btn span {\n  font-size: 9px; font-weight: 700; color: var(--muted);\n  text-transform: uppercase; letter-spacing: .1em; transition: color .2s;\n}\n.nav-btn.active svg, .nav-btn.active span { color: var(--accent); }\n\n/* ── MODAL / OVERLAY ── */\n.overlay {\n  position: fixed; inset: 0; z-index: 100;\n  background: rgba(0,0,0,.7);\n  backdrop-filter: blur(4px);\n  -webkit-backdrop-filter: blur(4px);\n  display: none; align-items: flex-end;\n}\n.overlay.show { display: flex; }\n.sheet {\n  width: 100%; max-width: 480px; margin: 0 auto;\n  background: var(--surface);\n  border-top: 1px solid var(--border);\n  border-radius: 20px 20px 0 0;\n  max-height: 70vh; overflow-y: auto;\n  padding-bottom: env(safe-area-inset-bottom);\n}\n.sheet-handle {\n  width: 36px; height: 4px; border-radius: 2px;\n  background: var(--surface2); margin: 12px auto 16px;\n}\n.sheet-title {\n  font-size: 11px; font-weight: 700; color: var(--accent);\n  letter-spacing: .18em; text-transform: uppercase;\n  font-family: var(--mono); padding: 0 16px 12px;\n  border-bottom: 1px solid var(--border);\n}\n.sheet-item {\n  display: flex; align-items: center; gap: 12px;\n  padding: 14px 16px; cursor: pointer; transition: background .15s;\n  border-bottom: 1px solid rgba(99,179,237,.06);\n}\n.sheet-item:active { background: rgba(99,179,237,.05); }\n.sheet-item-icon {\n  width: 40px; height: 40px; border-radius: 10px;\n  background: rgba(99,179,237,.07);\n  border: 1px solid rgba(99,179,237,.12);\n  display: grid; place-items: center; font-size: 18px; flex: 0 0 40px;\n}\n.sheet-item-meta { flex: 1; min-width: 0; }\n.sheet-item-name {\n  font-size: 14px; font-weight: 600;\n  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n}\n.sheet-item-sub {\n  font-size: 10px; color: var(--muted2); margin-top: 2px;\n  text-transform: uppercase; letter-spacing: .08em;\n}\n.sheet-item-check { color: var(--green); display: none; }\n.sheet-item.selected .sheet-item-check { display: block; }\n.sheet-item.selected { background: rgba(72,187,120,.04); }\n\n/* ── PÁGINA DE LOGS ── */\n.logs-page {\n  position: fixed; inset: 0; z-index: 90;\n  background: var(--bg); display: none;\n  flex-direction: column;\n}\n.logs-page.show { display: flex; }\n.logs-header {\n  padding: 16px 16px 12px;\n  display: flex; align-items: center; justify-content: space-between;\n  border-bottom: 1px solid var(--border);\n}\n.logs-title {\n  font-size: 11px; font-weight: 700; color: var(--accent);\n  letter-spacing: .18em; text-transform: uppercase; font-family: var(--mono);\n}\n.logs-actions { display: flex; gap: 8px; }\n.logs-btn {\n  padding: 6px 12px; border-radius: 6px; font-size: 10px; font-weight: 700;\n  background: var(--surface2); border: 1px solid var(--border);\n  color: var(--text); cursor: pointer; font-family: var(--sans);\n  letter-spacing: .08em; text-transform: uppercase;\n}\n.logs-btn:active { opacity: .7; }\n.logs-body {\n  flex: 1; overflow-y: auto; padding: 8px 0;\n  font-family: var(--mono); font-size: 11.5px;\n  -webkit-overflow-scrolling: touch;\n  background: #030507;\n}\n.log-line {\n  display: flex; align-items: flex-start; gap: 8px;\n  padding: 4px 14px;\n  border-bottom: 1px solid rgba(255,255,255,.025);\n  line-height: 1.5; word-break: break-all;\n  transition: background .1s;\n}\n.log-line:active { background: rgba(255,255,255,.03); }\n.log-line .log-time {\n  flex: 0 0 auto; color: #2d3748;\n  font-size: 10px; padding-top: 1px;\n  white-space: nowrap;\n}\n.log-line .log-msg { flex: 1; }\n.log-line.info .log-msg { color: #718096; }\n.log-line.ok { background: rgba(72,187,120,.04); }\n.log-line.ok .log-msg { color: #68d391; font-weight: 600; }\n.log-line.warn .log-msg { color: #f6e05e; }\n.log-line.err { background: rgba(245,101,101,.04); }\n.log-line.err .log-msg { color: #fc8181; }\n.log-line.highlight { background: rgba(99,179,237,.06); }\n.log-line.highlight .log-msg { color: var(--accent); font-weight: 700; }\n.log-line.sep .log-msg {\n  color: #2d3748; letter-spacing: .1em;\n  font-size: 10px; text-align: center; width: 100%;\n}\n.logs-empty {\n  display: flex; flex-direction: column; align-items: center;\n  justify-content: center; height: 200px; gap: 10px;\n  color: var(--muted); font-size: 12px;\n}\n\n/* ── PÁGINA DE CONFIGURAÇÕES ── */\n.settings-page {\n  position: fixed; inset: 0; z-index: 90;\n  background: var(--bg); display: none;\n  flex-direction: column;\n}\n.settings-page.show { display: flex; }\n.settings-body { flex: 1; overflow-y: auto; padding: 12px 16px; display: flex; flex-direction: column; gap: 10px; }\n.setting-item {\n  background: var(--surface); border: 1px solid var(--border);\n  border-radius: 10px; padding: 14px 16px;\n  display: flex; align-items: center; gap: 12px;\n  cursor: pointer; transition: background .15s;\n}\n.setting-item:active { background: var(--surface2); }\n.setting-item svg { width: 20px; height: 20px; color: var(--accent); flex: 0 0 20px; }\n.setting-item-meta { flex: 1; }\n.setting-item-title { font-size: 14px; font-weight: 600; }\n.setting-item-sub { font-size: 11px; color: var(--muted2); margin-top: 2px; }\n.setting-item-chev { color: var(--muted); }\n\n/* ── TOAST ── */\n.toast {\n  position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%) translateY(20px);\n  background: var(--surface2); border: 1px solid var(--border);\n  border-radius: 10px; padding: 10px 18px;\n  font-size: 12px; font-weight: 600; color: var(--text);\n  z-index: 200; opacity: 0; transition: all .25s;\n  white-space: nowrap; pointer-events: none;\n  font-family: var(--mono);\n}\n.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n\n/* ── SPEED ROW ── */\n.speed-row {\n  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;\n}\n.speed-card {\n  background: var(--surface); border: 1px solid var(--border);\n  border-radius: 10px; padding: 12px 14px;\n}\n.speed-label {\n  font-size: 9px; font-weight: 700; color: var(--muted2);\n  text-transform: uppercase; letter-spacing: .15em; font-family: var(--mono);\n}\n.speed-val {\n  font-size: 18px; font-weight: 700; margin-top: 4px;\n  color: var(--accent); font-family: var(--mono);\n}\n</style>\n</head>\n<body>\n<div class=\"shell\">\n\n  <!-- HEADER -->\n  <header class=\"header\">\n    <div class=\"header-brand\" id=\"app-name\">VB INJECTOR</div>\n    <div class=\"header-right\">\n      <span class=\"header-ver\" id=\"config-ver\">v--</span>\n      <button class=\"btn-icon\" onclick=\"doUpdate()\" title=\"Atualizar\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      </button>\n    </div>\n  </header>\n\n  <!-- BODY -->\n  <div class=\"body\" id=\"main-body\">\n\n    <!-- ORB -->\n    <div class=\"orb-section\">\n      <div class=\"orb-wrap\">\n        <div class=\"orb-ring2\"></div>\n        <div class=\"orb-ring\"></div>\n        <div class=\"orb-btn\" onclick=\"doConnect()\" id=\"orb-btn\">\n          <div class=\"orb-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n              <path id=\"orb-svg-path\" d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\" stroke=\"rgba(99,179,237,.6)\"/>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"orb-label\" id=\"orb-label\">DESCONECTADO</div>\n      <div class=\"orb-sub\" id=\"orb-sub\">Toque para conectar</div>\n      <div class=\"timer\" id=\"timer\">\n        <span class=\"timer-label\">Tempo</span>\n        <span class=\"timer-val\" id=\"timer-val\">00:00:00</span>\n      </div>\n    </div>\n\n    <!-- SPEED -->\n    <div class=\"speed-row\" id=\"speed-row\" style=\"display:none\">\n      <div class=\"speed-card\">\n        <div class=\"speed-label\">↓ Download</div>\n        <div class=\"speed-val\" id=\"speed-dl\">0 B/s</div>\n      </div>\n      <div class=\"speed-card\">\n        <div class=\"speed-label\">↑ Upload</div>\n        <div class=\"speed-val\" id=\"speed-ul\">0 B/s</div>\n      </div>\n    </div>\n\n    <!-- TOTAL DA SESSÃO -->\n    <div class=\"speed-row\" id=\"total-row\" style=\"display:none\">\n      <div class=\"speed-card\">\n        <div class=\"speed-label\">↓ Total recebido</div>\n        <div class=\"speed-val\" id=\"total-dl\">0 B</div>\n      </div>\n      <div class=\"speed-card\">\n        <div class=\"speed-label\">↑ Total enviado</div>\n        <div class=\"speed-val\" id=\"total-ul\">0 B</div>\n      </div>\n    </div>\n\n    <!-- MODO -->\n    <div class=\"card\">\n      <div class=\"mode-row\">\n        <button class=\"mode-btn active\" id=\"mode-ssh\" onclick=\"setMode('SSH')\">SSH</button>\n        <button class=\"mode-btn\" id=\"mode-xray\" onclick=\"setMode('XRAY')\">XRAY</button>\n      </div>\n    </div>\n\n    <!-- SERVER CARD SSH -->\n    <div class=\"card\" id=\"card-ssh\" onclick=\"openSheet('ssh')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\">🖥️</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Servidor SSH</div>\n          <div class=\"server-name\" id=\"ssh-name\">Selecionar servidor</div>\n          <div class=\"server-sub\" id=\"ssh-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <!-- PAYLOAD CARD -->\n    <div class=\"card\" id=\"card-payload\" onclick=\"openSheet('payload')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\">📦</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Payload</div>\n          <div class=\"server-name\" id=\"payload-name\">Selecionar payload</div>\n          <div class=\"server-sub\" id=\"payload-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <!-- XRAY CARD -->\n    <div class=\"card\" id=\"card-xray\" style=\"display:none\" onclick=\"openSheet('xray')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\">⚡</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Perfil XRAY</div>\n          <div class=\"server-name\" id=\"xray-name\">Selecionar perfil</div>\n          <div class=\"server-sub\" id=\"xray-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <!-- BOTÃO CONECTAR -->\n    <button class=\"connect-btn\" id=\"connect-btn\" onclick=\"doConnect()\">Conectar SSH</button>\n\n    <!-- MENSAGEM -->\n    <div class=\"card msg-card\" id=\"msg-card\" style=\"display:none\">\n      <div class=\"msg-dot\"></div>\n      <div class=\"msg-text\" id=\"msg-text\"></div>\n    </div>\n\n    <!-- ACTIONS -->\n    <div class=\"action-row\">\n      <button class=\"action-btn\" onclick=\"showLogs()\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6M16 13H8M16 17H8M10 9H8\"/></svg>\n        <span>Logs</span>\n      </button>\n      <button class=\"action-btn\" onclick=\"doUpdate()\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n        <span>Atualizar</span>\n      </button>\n      <button class=\"action-btn\" onclick=\"showSettings()\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n        <span>Config</span>\n      </button>\n    </div>\n\n  </div><!-- /body -->\n\n  <!-- BOTTOM NAV -->\n  <nav class=\"bottom-nav\">\n    <button class=\"nav-btn active\" onclick=\"showMain()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>\n      <span>Início</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showLogs()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6M16 13H8\"/></svg>\n      <span>Logs</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"openSheet('ssh')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/></svg>\n      <span>Servidores</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showSettings()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <span>Config</span>\n    </button>\n  </nav>\n\n</div><!-- /shell -->\n\n<!-- TOAST -->\n<div class=\"toast\" id=\"toast\"></div>\n\n<!-- SHEET SSH -->\n<div class=\"overlay\" id=\"sheet-ssh\" onclick=\"closeSheet('ssh')\">\n  <div class=\"sheet\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-handle\"></div>\n    <div class=\"sheet-title\">// Servidores SSH</div>\n    <div id=\"ssh-list\"></div>\n  </div>\n</div>\n\n<!-- SHEET PAYLOAD -->\n<div class=\"overlay\" id=\"sheet-payload\" onclick=\"closeSheet('payload')\">\n  <div class=\"sheet\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-handle\"></div>\n    <div class=\"sheet-title\">// Payloads</div>\n    <div id=\"payload-list\"></div>\n  </div>\n</div>\n\n<!-- SHEET XRAY -->\n<div class=\"overlay\" id=\"sheet-xray\" onclick=\"closeSheet('xray')\">\n  <div class=\"sheet\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-handle\"></div>\n    <div class=\"sheet-title\">// Perfis XRAY</div>\n    <div id=\"xray-list\"></div>\n  </div>\n</div>\n\n<!-- PÁGINA DE LOGS -->\n<div class=\"logs-page\" id=\"logs-page\">\n  <div class=\"logs-header\">\n    <div>\n      <div class=\"logs-title\">// Logs de Conexão</div>\n    </div>\n    <div class=\"logs-actions\">\n      <button class=\"logs-btn\" onclick=\"copyLogs()\">Copiar</button>\n      <button class=\"logs-btn\" onclick=\"clearLogs()\" style=\"color:var(--red);border-color:rgba(252,129,129,.3)\">Limpar</button>\n      <button class=\"logs-btn\" onclick=\"hideLogs()\">✕</button>\n    </div>\n  </div>\n  <div class=\"logs-body\" id=\"logs-body\">\n    <div class=\"logs-empty\"><span style=\"font-size:28px\">📋</span><span>Aguardando logs...</span></div>\n  </div>\n</div>\n\n<!-- PÁGINA DE CONFIGURAÇÕES -->\n<div class=\"settings-page\" id=\"settings-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">// Configurações</div>\n    <div class=\"logs-actions\">\n      <button class=\"logs-btn\" onclick=\"hideSettings()\">Fechar</button>\n    </div>\n  </div>\n  <div class=\"settings-body\">\n    <div class=\"setting-item\" onclick=\"doUpdate()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atualizar Configuração</div>\n        <div class=\"setting-item-sub\">Buscar dados do servidor</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"showLogs()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Logs de Conexão</div>\n        <div class=\"setting-item-sub\">Ver registros do sistema</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" id=\"uuid-item\" onclick=\"promptUuid()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">UUID / Chave</div>\n        <div class=\"setting-item-sub\" id=\"uuid-sub\">Não configurado</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"if (B && B.openSettings) { B.openSettings(); } else { toast('Disponível só no app.'); }\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Configurações Avançadas</div>\n        <div class=\"setting-item-sub\">DNS, UDP, SSH, Sistema...</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n  </div>\n</div>\n\n<script>\nvar B = window.VBBridge;\nvar app = {\n  mode: 'SSH',\n  connected: false,\n  connectTime: 0,\n  timerInt: null,\n  pollInt: null\n};\n\n/* ── BRIDGE HELPER ── */\nfunction bp(raw, fb) {\n  try { return JSON.parse(raw) || fb; } catch(e) { return fb; }\n}\n\n/* ── INIT ── */\nfunction init() {\n  if (!B) {\n    showMsg('Bridge não encontrado. Modo de preview.');\n    return;\n  }\n  // Carrega config\n  var cfg = bp(B.getConfig(), {});\n  if (cfg.appName) document.getElementById('app-name').textContent = cfg.appName;\n  if (cfg.configVersion) document.getElementById('config-ver').textContent = 'v' + cfg.configVersion;\n\n  // Modo salvo\n  var savedMode = B.getMode ? B.getMode() : 'SSH';\n  if (savedMode === 'XRAY') setMode('XRAY', true);\n  else setMode('SSH', true);\n\n  // UUID\n  var uuid = B.getUuid ? B.getUuid() : '';\n  if (uuid) document.getElementById('uuid-sub').textContent = uuid.substring(0,8) + '...';\n\n  // Carrega selecionados\n  refreshSelected();\n\n  // Polling\n  app.pollInt = setInterval(pollStatus, 1500);\n  pollStatus();\n}\n\n/* ── POLLING DE STATUS ── */\nfunction pollStatus() {\n  if (!B) return;\n  try {\n    var st = bp(B.getStatus(), {});\n    var connected = !!st.connected;\n    var mode = st.mode || app.mode;\n\n    if (connected !== app.connected) {\n      app.connected = connected;\n      applyConnected(connected, mode);\n    }\n  } catch(e) {}\n}\n\nfunction applyConnected(on, mode) {\n  document.body.classList.toggle('connected', on);\n  document.body.classList.remove('connecting');\n\n  var label = document.getElementById('orb-label');\n  var sub = document.getElementById('orb-sub');\n  var btn = document.getElementById('connect-btn');\n  var timer = document.getElementById('timer');\n  var speed = document.getElementById('speed-row');\n  var total = document.getElementById('total-row');\n\n  if (on) {\n    label.textContent = 'CONECTADO';\n    sub.textContent = (mode || app.mode) + ' ativo';\n    btn.textContent = 'Desconectar';\n    timer.classList.add('show');\n    speed.style.display = 'grid';\n    total.style.display = 'grid';\n    app.connectTime = Date.now();\n    if (app.timerInt) clearInterval(app.timerInt);\n    app.timerInt = setInterval(updateTimer, 1000);\n  } else {\n    label.textContent = 'DESCONECTADO';\n    sub.textContent = 'Toque para conectar';\n    btn.textContent = 'Conectar ' + app.mode;\n    timer.classList.remove('show');\n    speed.style.display = 'none';\n    total.style.display = 'none';\n    document.getElementById('speed-dl').textContent = '0 B/s';\n    document.getElementById('speed-ul').textContent = '0 B/s';\n    document.getElementById('total-dl').textContent = '0 B';\n    document.getElementById('total-ul').textContent = '0 B';\n    if (app.timerInt) clearInterval(app.timerInt);\n  }\n}\n\nfunction updateTimer() {\n  var s = Math.floor((Date.now() - app.connectTime) / 1000);\n  var h = Math.floor(s / 3600);\n  var m = Math.floor((s % 3600) / 60);\n  var sec = s % 60;\n  document.getElementById('timer-val').textContent =\n    pad(h) + ':' + pad(m) + ':' + pad(sec);\n}\nfunction pad(n) { return n < 10 ? '0' + n : '' + n; }\n\n/* ── AÇÕES ── */\nfunction doConnect() {\n  if (!B) { toast('Bridge não disponível'); return; }\n  document.body.classList.add('connecting');\n  document.getElementById('orb-label').textContent = 'CONECTANDO...';\n  document.getElementById('orb-sub').textContent = 'Aguarde...';\n  document.getElementById('connect-btn').textContent = 'Aguarde...';\n  B.connect();\n}\n\nfunction doUpdate() {\n  if (!B) { toast('Bridge não disponível'); return; }\n  toast('Atualizando configuração...');\n  B.updateConfig();\n  setTimeout(function() {\n    init();\n    toast('Configuração atualizada!');\n  }, 3000);\n}\n\n/* ── MODO ── */\nfunction setMode(m, silent) {\n  app.mode = m;\n  document.getElementById('mode-ssh').classList.toggle('active', m === 'SSH');\n  document.getElementById('mode-xray').classList.toggle('active', m === 'XRAY');\n  document.getElementById('card-ssh').style.display = m === 'SSH' ? '' : 'none';\n  document.getElementById('card-payload').style.display = m === 'SSH' ? '' : 'none';\n  document.getElementById('card-xray').style.display = m === 'XRAY' ? '' : 'none';\n  document.getElementById('connect-btn').textContent = 'Conectar ' + m;\n  if (!silent && B) B.setMode(m);\n}\n\n/* ── REFRESH SELECIONADOS ── */\nfunction refreshSelected() {\n  if (!B) return;\n  // SSH\n  try {\n    var srv = bp(B.getSelectedServer(), {});\n    if (srv.name) {\n      document.getElementById('ssh-name').textContent = srv.name;\n      document.getElementById('ssh-sub').textContent = (srv.country || '') + ' · ' + (srv.operator || '');\n    }\n  } catch(e) {}\n  // Payload\n  try {\n    var pld = bp(B.getSelectedPayload(), {});\n    if (pld.name) {\n      document.getElementById('payload-name').textContent = pld.name;\n      document.getElementById('payload-sub').textContent = pld.operator || '';\n    }\n  } catch(e) {}\n  // Xray\n  try {\n    var xr = bp(B.getSelectedXray(), {});\n    if (xr.name) {\n      document.getElementById('xray-name').textContent = xr.name;\n      document.getElementById('xray-sub').textContent = (xr.protocol || '').toUpperCase() + ' · ' + (xr.security || '');\n    }\n  } catch(e) {}\n}\n\n/* ── SHEETS ── */\nfunction openSheet(type) {\n  if (!B) return;\n  var overlay = document.getElementById('sheet-' + type);\n  overlay.classList.add('show');\n\n  if (type === 'ssh') buildList('ssh-list', bp(B.getServers(), []), function(item, i) {\n    B.selectServer(item.id);\n    document.getElementById('ssh-name').textContent = item.name;\n    document.getElementById('ssh-sub').textContent = (item.country || '') + ' · ' + (item.operator || '');\n    closeSheet('ssh'); toast('Servidor: ' + item.name);\n  }, function(item) {\n    return item.name + '|' + (item.operator || '') + ' · ' + (item.method || '') + '|' + (item.selected ? 'selected' : '');\n  });\n\n  if (type === 'payload') buildList('payload-list', bp(B.getPayloads(), []), function(item, i) {\n    B.selectPayload(item.id);\n    document.getElementById('payload-name').textContent = item.name;\n    document.getElementById('payload-sub').textContent = item.operator || '';\n    closeSheet('payload'); toast('Payload: ' + item.name);\n  }, function(item) {\n    return item.name + '|' + (item.operator || '') + ' · ' + (item.networkType || '') + '|' + (item.selected ? 'selected' : '');\n  });\n\n  if (type === 'xray') buildList('xray-list', bp(B.getXrayProfiles(), []), function(item, i) {\n    B.selectXray(item.id);\n    document.getElementById('xray-name').textContent = item.name;\n    document.getElementById('xray-sub').textContent = (item.protocol || '').toUpperCase() + ' · ' + (item.security || '');\n    closeSheet('xray'); toast('Perfil: ' + item.name);\n  }, function(item) {\n    return item.name + '|' + (item.protocol || '').toUpperCase() + ' · ' + (item.security || '') + '|' + (item.selected ? 'selected' : '');\n  });\n}\n\nfunction buildList(containerId, items, onSelect, getInfo) {\n  var el = document.getElementById(containerId);\n  el.innerHTML = '';\n  if (!items.length) { el.innerHTML = '<div style=\"padding:20px;text-align:center;color:var(--muted2);font-size:12px;\">Nenhum item disponível</div>'; return; }\n  items.forEach(function(item, i) {\n    var info = getInfo(item).split('|');\n    var div = document.createElement('div');\n    div.className = 'sheet-item' + (info[2] === 'selected' ? ' selected' : '');\n    div.innerHTML = '<div class=\"sheet-item-icon\">📡</div>'\n      + '<div class=\"sheet-item-meta\"><div class=\"sheet-item-name\">' + (info[0]||'') + '</div>'\n      + '<div class=\"sheet-item-sub\">' + (info[1]||'') + '</div></div>'\n      + '<svg class=\"sheet-item-check\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" width=\"18\" height=\"18\"><polyline points=\"20 6 9 17 4 12\"/></svg>';\n    div.onclick = function() { onSelect(item, i); };\n    el.appendChild(div);\n  });\n}\n\nfunction closeSheet(type) {\n  document.getElementById('sheet-' + type).classList.remove('show');\n}\n\n/* ── LOGS ── */\nfunction showLogs() {\n  document.getElementById('logs-page').classList.add('show');\n  loadLogs();\n  if (logsRefreshInt) clearInterval(logsRefreshInt);\n  logsRefreshInt = setInterval(loadLogs, 2000);\n}\nfunction hideLogs() {\n  document.getElementById('logs-page').classList.remove('show');\n  if (logsRefreshInt) { clearInterval(logsRefreshInt); logsRefreshInt = null; }\n}\nfunction classifyLog(l) {\n  var lower = l.toLowerCase();\n  if (lower.includes('───') || lower.includes('━━━') || lower.includes('---')) return 'sep';\n  if (lower.includes('✅') || lower.includes('sucesso') || lower.includes('conectado') ||\n      lower.includes('connected') || lower.includes('ok') || lower.includes('🎉') ||\n      lower.includes('vpn service running') || lower.includes('ativo')) return 'ok';\n  if (lower.includes('error') || lower.includes('erro') || lower.includes('failed') ||\n      lower.includes('eof') || lower.includes('❌') || lower.includes('falhou')) return 'err';\n  if (lower.includes('warn') || lower.includes('aviso') || lower.includes('⚠️') ||\n      lower.includes('testando') || lower.includes('tentando') || lower.includes('aguard')) return 'warn';\n  if (lower.includes('iniciando') || lower.includes('🚀') || lower.includes('⚙️') ||\n      lower.includes('🔐') || lower.includes('connecting') || lower.includes('starting') ||\n      lower.includes('xray') || lower.includes('ssh conectad') || lower.includes('vpn')) return 'highlight';\n  return 'info';\n}\n\nfunction formatLogLine(l) {\n  // Extrai timestamp se existir [HH:MM:SS] ou [número]\n  var time = '';\n  var msg = l;\n  var m = l.match(/^\\[([\\d:]+)\\]\\s*/);\n  if (m) { time = m[1]; msg = l.slice(m[0].length); }\n  else {\n    var m2 = l.match(/^\\[\\d+\\]\\s*xray:\\s*/);\n    if (m2) { msg = l.slice(m2[0].length); time = 'xray'; }\n  }\n  return { time: time, msg: msg };\n}\n\nfunction loadLogs() {\n  if (!B) return;\n  try {\n    var raw = bp(B.getLogs(), []);\n    var el = document.getElementById('logs-body');\n    if (!raw.length) {\n      el.innerHTML = '<div class=\"logs-empty\"><span style=\"font-size:28px\">📋</span><span>Sem logs disponíveis</span></div>';\n      return;\n    }\n    // Filtra logs de DNS repetitivos\n    var filtered = raw.filter(function(l) {\n      return !l.includes('udp:8.8.8.8:53') && !l.includes('udp:1.1.1.1:53') &&\n             !l.includes('udp:8.8.4.4:53') && !l.includes('socks-in >> proxy');\n    });\n    el.innerHTML = filtered.map(function(l) {\n      var cls = classifyLog(l);\n      var parts = formatLogLine(l);\n      return '<div class=\"log-line ' + cls + '\">'\n        + (parts.time ? '<span class=\"log-time\">[' + parts.time + ']</span>' : '')\n        + '<span class=\"log-msg\">' + escHtml(parts.msg) + '</span>'\n        + '</div>';\n    }).join('');\n    el.scrollTop = el.scrollHeight;\n  } catch(e) {}\n}\n\n// Auto-refresh logs a cada 2s quando aberto\nvar logsRefreshInt = null;\nfunction copyLogs() {\n  if (!B) return;\n  try {\n    var raw = bp(B.getLogs(), []);\n    var text = raw.join('\\n');\n    var ta = document.createElement('textarea');\n    ta.value = text; document.body.appendChild(ta);\n    ta.select(); document.execCommand('copy');\n    document.body.removeChild(ta);\n    toast('Logs copiados!');\n  } catch(e) { toast('Erro ao copiar'); }\n}\nfunction clearLogs() {\n  if (B) B.clearLogs();\n  document.getElementById('logs-body').innerHTML = '<div class=\"log-line info\">Logs limpos.</div>';\n  toast('Logs limpos');\n}\n\n/* ── SETTINGS ── */\nfunction showSettings() { document.getElementById('settings-page').classList.add('show'); }\nfunction hideSettings() { document.getElementById('settings-page').classList.remove('show'); }\nfunction promptUuid() {\n  var cur = B ? B.getUuid() : '';\n  var val = prompt('UUID / Chave de ativação:', cur);\n  if (val !== null && B) {\n    B.setUuid(val.trim());\n    document.getElementById('uuid-sub').textContent = val ? val.substring(0,8) + '...' : 'Não configurado';\n    toast('UUID salvo!');\n  }\n}\n\n/* ── MAIN ── */\nfunction showMain() {\n  document.getElementById('logs-page').classList.remove('show');\n  document.getElementById('settings-page').classList.remove('show');\n}\n\n/* ── MENSAGEM ── */\nfunction showMsg(msg) {\n  var card = document.getElementById('msg-card');\n  var text = document.getElementById('msg-text');\n  card.style.display = 'flex';\n  text.textContent = msg;\n}\n\n/* ── TOAST ── */\nfunction toast(msg) {\n  var el = document.getElementById('toast');\n  el.textContent = msg;\n  el.classList.add('show');\n  setTimeout(function() { el.classList.remove('show'); }, 2500);\n}\n\n/* ── CALLBACKS DO APP ── */\nwindow.onVBStatus = function(s) {\n  var connected = !!s.connected;\n  var mode = s.mode || app.mode;\n  if (connected !== app.connected) {\n    app.connected = connected;\n    applyConnected(connected, mode);\n  }\n  if (s.lastUpdate) document.getElementById('config-ver').textContent = s.lastUpdate;\n  if (s.downloadText) document.getElementById('speed-dl').textContent = s.downloadText;\n  if (s.uploadText) document.getElementById('speed-ul').textContent = s.uploadText;\n  if (s.totalDownloadText) document.getElementById('total-dl').textContent = s.totalDownloadText;\n  if (s.totalUploadText) document.getElementById('total-ul').textContent = s.totalUploadText;\n};\nwindow.onVBMessage = function(msg) { toast(msg); };\n\n/* ── UTILS ── */\nfunction escHtml(s) {\n  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n}\n\n/* ── START ── */\ndocument.addEventListener('DOMContentLoaded', init);\n</script>\n</body>\n</html>\n@@"}
