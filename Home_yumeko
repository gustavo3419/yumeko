n    <div class=\"setting-item\" onclick=\"if (B && B.openSettings) { B.openSettings(); } else { toast('Disponível só no app.'); }\">\n      <span class=\"setting-item-chev\">›</span>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Configurações Avançadas</div>\n        <div class=\"setting-item-sub\">DNS, UDP, SSH, Sistema...</div>\n      </div>\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n    </div>\n    <div class=\"setting-item\" onclick=\"toggleDiagBox()\">\n      <span class=\"setting-item-chev\">›</span>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Diagnóstico</div>\n        <div class=\"setting-item-sub\">Gerar relatório pra suporte</div>\n      </div>\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 18l6-6-6-6\"/></svg>\n    </div>\n    <div id=\"diag-wrap\" style=\"display:none\">\n      <div class=\"diag-box\" id=\"diag-box\"></div>\n      <button class=\"logs-btn\" style=\"width:100%;margin-top:8px;padding:10px;\" onclick=\"copyDiag()\">Copiar diagnóstico</button>\n    </div>\n\n  </div>\n</div>\n\n<script>\nvar B = window.VBBridge;\nvar app = {\n  mode: 'SSH', connected: false, connectTime: 0, timerInt: null, pollInt: null,\n  favorites: [], autoscroll: true\n};\n\nfunction bp(raw, fb) { try { return JSON.parse(raw) || fb; } catch(e) { return fb; } }\n\nfunction forceRepaint(el) {\n  if (!el) return;\n  requestAnimationFrame(function () {\n    requestAnimationFrame(function () {\n      el.style.transform = 'translateZ(0)';\n      void el.offsetHeight;\n      el.style.transform = '';\n    });\n  });\n}\n\n// ============================================================\n// ═══ FLAG: usa APENAS o campo \"flag\" do JSON ═══\n// ============================================================\nfunction getFlagUrl(item) {\n  if (!item) return null;\n  var flag = item.flag || item.FLAG || '';\n  if (flag && typeof flag === 'string' && flag.startsWith('http')) {\n    return flag;\n  }\n  return null;\n}\n\nfunction setItemIcon(iconId, flagId, emojiId, item, defaultEmoji) {\n  var icon = document.getElementById(iconId);\n  var flag = document.getElementById(flagId);\n  var emoji = document.getElementById(emojiId);\n  if (!icon || !flag || !emoji) return;\n  var url = getFlagUrl(item);\n  if (url) {\n    flag.src = url;\n    flag.style.display = 'block';\n    emoji.style.display = 'none';\n  } else {\n    flag.style.display = 'none';\n    emoji.style.display = 'block';\n  }\n}\n\nfunction getItemFlagUrl(item) {\n  return getFlagUrl(item);\n}\n\nfunction init() {\n  if (!B) { showMsg('Bridge não encontrado. Modo de preview.'); return; }\n  if (B.isTamperDetected && B.isTamperDetected()) showTamperWarning();\n\n  var cfg = bp(B.getConfig(), {});\n  if (cfg.appName) document.getElementById('app-name').textContent = cfg.appName;\n  if (cfg.configVersion) document.getElementById('config-ver').textContent = 'v' + cfg.configVersion;\n  if (B.getHtmlVersion) document.getElementById('html-ver').textContent = 'h' + (B.getHtmlVersion() || '--');\n  if (cfg.notice && cfg.notice.enabled) showNoticeBar(cfg.notice.title || 'Aviso', cfg.notice.message || '');\n\n  var uuid = B.getUuid ? B.getUuid() : '';\n  if (uuid) document.getElementById('uuid-sub').textContent = uuid.substring(0,8) + '...';\n\n  initPalette();\n  initAutoConnectSwitch();\n  setupCredModal();\n  setupUuidModal();\n\n  var savedMode = B.getMode ? B.getMode() : 'SSH';\n  setMode(savedMode === 'XRAY' ? 'XRAY' : 'SSH', true);\n\n  refreshFavorites();\n  refreshSelected();\n  updateNetBadge();\n  refreshIpInfo();\n\n  app.pollInt = setInterval(pollStatus, 700);\n  setInterval(updateNetBadge, 5000);\n  pollStatus();\n  maybeAutoConnect();\n}\n\nfunction maybeAutoConnect() {\n  if (!B || !B.getAutoConnect || !B.getAutoConnect()) return;\n  if (app.connected) return;\n  var st = bp(B.getStatus(), {});\n  if (st.connected) return;\n  setTimeout(function () { doConnect(); }, 600);\n}\n\nfunction updateNetBadge() {\n  if (!B || !B.getNetworkInfo) return;\n  try {\n    var info = bp(B.getNetworkInfo(), {});\n    document.getElementById('net-badge-text').textContent = info.type || '--';\n    document.getElementById('net-badge').classList.toggle('online', !!info.online);\n  } catch(e) {}\n}\n\n\n/* ── IP / LOCALIZAÇÃO ── */\nfunction refreshIpInfo() {\n  if (!B || !B.requestIpInfo) {\n    setTimeout(refreshIpInfo, 500);\n    return;\n  }\n  document.getElementById('ip-status-line').textContent = 'Consultando...';\n  var timeoutId = setTimeout(function() {\n    document.getElementById('ip-status-line').textContent = 'Timeout na consulta';\n    document.getElementById('ip-value').textContent = '—';\n  }, 15000);\n  var oldOnVBIpInfo = window.onVBIpInfo;\n  window.onVBIpInfo = function(info) {\n    clearTimeout(timeoutId);\n    if (oldOnVBIpInfo) oldOnVBIpInfo(info);\n  };\n  B.requestIpInfo();\n}\nwindow.onVBIpInfo = function(info) {\n  var line = document.getElementById('ip-status-line');\n  if (!info || !info.ip || info.success === false) {\n    document.getElementById('ip-value').textContent = '—';\n    document.getElementById('ip-loc').textContent = '';\n    line.textContent = 'Não foi possível consultar agora';\n    return;\n  }\n  document.getElementById('ip-value').textContent = info.ip;\n  var country = info.country_name || info.country || '';\n  var loc = [info.city, info.region, country].filter(Boolean).join(', ');\n  document.getElementById('ip-loc').textContent = loc;\n  line.textContent = app.connected ? 'IP mascarado pelo túnel ✓' : 'Esse é o seu IP real (sem túnel)';\n};\n\n\n/* ── PING ── */\nfunction testPing() {\n  if (!B || !B.requestPing) return;\n  var target = currentTarget();\n  if (!target) { toast('Escolha um servidor primeiro'); return; }\n  var chip = document.getElementById('ping-chip');\n  chip.className = 'chip loading';\n  document.getElementById('ping-label').textContent = 'Testando...';\n  B.requestPing(target.host, target.port);\n}\nfunction currentTarget() {\n  try {\n    if (app.mode === 'XRAY') {\n      var x = bp(B.getSelectedXray(), {});\n      if (x.host && x.port) return { host: x.host, port: x.port };\n    } else {\n      var s = bp(B.getSelectedServer(), {});\n      if (s.host && s.port) return { host: s.host, port: s.port };\n    }\n  } catch(e) {}\n  return null;\n}\nwindow.onVBPingResult = function(result) {\n  var chip = document.getElementById('ping-chip');\n  var label = document.getElementById('ping-label');\n  if (result && result.ok) {\n    var ms = result.ms;\n    var quality = ms < 150 ? 'ok' : (ms < 400 ? '' : 'bad');\n    var bars = ms < 100 ? 4 : (ms < 200 ? 3 : (ms < 450 ? 2 : 1));\n    chip.className = 'chip ' + quality;\n    label.innerHTML = '<span class=\"signal-bars lit-' + bars + '\"><i></i><i></i><i></i><i></i></span><span class=\"chip-val\">' + ms + 'ms</span>';\n  } else {\n    chip.className = 'chip bad';\n    label.textContent = 'Falhou';\n  }\n};\n\n\n/* ── TESTE DE VELOCIDADE REAL ── */\nfunction runSpeedTest(silent) {\n  if (!B || !B.requestSpeedTest) return;\n  var chip = document.getElementById('speedtest-chip');\n  chip.className = 'chip loading';\n  document.getElementById('speedtest-label').textContent = 'Medindo...';\n  if (!silent) {\n    document.getElementById('speedtest-panel').classList.add('show');\n    document.getElementById('gauge-needle').style.transform = 'rotate(-90deg)';\n    document.getElementById('gauge-val').textContent = '...';\n  }\n  B.requestSpeedTest();\n}\nfunction closeSpeedTest() {\n  document.getElementById('speedtest-panel').classList.remove('show');\n}\nwindow.onVBSpeedTestResult = function(result) {\n  var chip = document.getElementById('speedtest-chip');\n  var label = document.getElementById('speedtest-label');\n  if (result && result.ok) {\n    var mbps = result.mbps;\n    chip.className = 'chip ' + (mbps > 15 ? 'ok' : (mbps > 4 ? '' : 'bad'));\n    label.innerHTML = '<span class=\"chip-val\">' + mbps.toFixed(1) + '</span> Mbps';\n    document.getElementById('gauge-val').textContent = mbps.toFixed(1);\n    var pct = Math.min(mbps / 60, 1);\n    var deg = -90 + (pct * 180);\n    document.getElementById('gauge-needle').style.transform = 'rotate(' + deg + 'deg)';\n  } else {\n    chip.className = 'chip bad';\n    label.textContent = 'Falhou';\n    document.getElementById('gauge-val').textContent = '--';\n  }\n};\n\n\n/* ── FAVORITOS ── */\nfunction refreshFavorites() {\n  if (!B || !B.getFavorites) return;\n  app.favorites = bp(B.getFavorites(), []);\n}\nfunction isFavorite(id) { return app.favorites.indexOf(id) !== -1; }\nfunction toggleFavoriteItem(id, evt) {\n  if (evt) evt.stopPropagation();\n  if (!B || !B.toggleFavorite) return;\n  B.toggleFavorite(id);\n  refreshFavorites();\n  if (currentOpenSheet) openSheet(currentOpenSheet);\n}\n\n\n/* ── STATUS ── */\nfunction pollStatus() {\n  if (!B) return;\n  try {\n    var st = bp(B.getStatus(), {});\n    var connected = !!st.connected;\n    var connecting = !!st.connecting;\n    if (connected !== app.connected) {\n      app.connected = connected;\n      applyConnected(connected, st.mode || app.mode, st.connectedAt);\n    }\n    if (!connected && !connecting && document.body.classList.contains('connecting')) {\n