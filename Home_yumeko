\"log-action-btn danger\" id=\"btn-clear-logs\">\uD83D\uDDD1 Limpar<\/button>\r\n      <\/div>\r\n      <div id=\"log-container\"><\/div>\r\n    <\/div>\r\n  <\/div>\r\n\r\n  <div class=\"modal-box method-modal-box\" id=\"modal-method\">\r\n    <div class=\"method-modal-head\">\r\n      <div class=\"method-modal-title\">\u2726 Escolher m\u00E9todo<\/div>\r\n      <button class=\"method-close-btn modal-close\">Fechar<\/button>\r\n    <\/div>\r\n    <div class=\"method-modal-sub\">Selecione como deseja conectar agora.<\/div>\r\n    <div class=\"method-list\">\r\n      <div class=\"method-item\" id=\"method-ssh\" onclick=\"selectMethod('SSH')\">\r\n        <div><div class=\"mi-title\">SSH<\/div><div class=\"mi-sub\">Servidor + payload<\/div><\/div>\r\n        <span class=\"mi-badge\">Ativo<\/span>\r\n      <\/div>\r\n      <div class=\"method-item\" id=\"method-xray\" onclick=\"selectMethod('XRAY')\">\r\n        <div><div class=\"mi-title\">XRAY<\/div><div class=\"mi-sub\">VLESS \/ XHTTP \/ TLS<\/div><\/div>\r\n        <span class=\"mi-badge\">Ativo<\/span>\r\n      <\/div>\r\n      <div class=\"method-item\" id=\"method-v2ray\" onclick=\"selectMethod('V2RAY')\">\r\n        <div><div class=\"mi-title\">V2RAY<\/div><div class=\"mi-sub\">VMess \/ VLESS \/ Trojan<\/div><\/div>\r\n        <span class=\"mi-badge\">Ativo<\/span>\r\n      <\/div>\r\n    <\/div>\r\n  <\/div>\r\n\r\n  <div class=\"modal-box creds-modal-box\" id=\"modal-creds\">\r\n    <div class=\"creds-modal-head\">\r\n      <div class=\"creds-modal-title\">\u2726 Credenciais<\/div>\r\n      <button class=\"icon-btn modal-close\">\u00D7<\/button>\r\n    <\/div>\r\n    <div class=\"creds-modal-sub\">Configure os dados por ordem de prioridade:<\/div>\r\n    <div class=\"creds-modal-body\">\r\n      <div class=\"creds-section-title\">\u2699 Ajuste SSH<\/div>\r\n      <div class=\"creds-input-wrap\">\r\n        <span class=\"ci-icon\">\uD83D\uDC64<\/span>\r\n        <input type=\"text\" id=\"ci-ssh-user\" placeholder=\"Usu\u00E1rio SSH\">\r\n      <\/div>\r\n      <div class=\"creds-input-wrap\">\r\n        <span class=\"ci-icon\">\uD83D\uDD12<\/span>\r\n        <input type=\"password\" id=\"ci-ssh-pass\" placeholder=\"Senha SSH\">\r\n        <button class=\"ci-eye\" onclick=\"toggleCiPass('ci-ssh-pass')\">\uD83D\uDC41<\/button>\r\n      <\/div>\r\n      <div class=\"creds-section-title\">\uD83D\uDCE1 Ajustes UDP \/ Hysteria<\/div>\r\n      <div class=\"creds-input-wrap\">\r\n        <span class=\"ci-icon\">\uD83D\uDD11<\/span>\r\n        <input type=\"text\" id=\"ci-udp-token\" placeholder=\"Token \/ Senha UDP Auth\">\r\n      <\/div>\r\n      <div class=\"creds-section-title\">\uD83C\uDF10 Ajustes V2Ray \/ Xray Core<\/div>\r\n      <div class=\"creds-input-wrap\">\r\n        <span class=\"ci-icon\">\uD83C\uDD94<\/span>\r\n        <input type=\"text\" id=\"ci-v2ray-uuid\" placeholder=\"ID DO USU\u00C1RIO \/ UUID V2Ray \/ vmess:\/\/\">\r\n      <\/div>\r\n    <\/div>\r\n    <div class=\"creds-modal-footer\">\r\n      <button class=\"creds-cancel-btn modal-close\">Cancelar<\/button>\r\n      <button class=\"creds-save-btn\" id=\"btn-creds-save\">Salvar<\/button>\r\n    <\/div>\r\n  <\/div>\r\n<\/div>\r\n\r\n<div class=\"toast-box\"><div class=\"toast\" id=\"toast\"><\/div><\/div>\r\n\r\n<script>\r\n(function(){\r\n'use strict';\r\n\r\nvar A={\r\n  call:function(m,arg){\r\n    try{if(window.Android&&typeof window.Android[m]==='function')return arg!==undefined?window.Android[m](arg):window.Android[m]();}\r\n    catch(e){console.warn('Bridge.'+m,e);}return null;\r\n  },\r\n  parse:function(raw,fb){try{return JSON.parse(raw)||fb;}catch(e){return fb;}},\r\n  connect:           function(){A.call('connect');},\r\n  getStatus:         function(){return A.call('getStatus')||'DESCONECTADO';},\r\n  getServers:        function(){return A.parse(A.call('getServers'),[]);},\r\n  getSelected:       function(){return A.parse(A.call('getSelectedServer'),{});},\r\n  selectServer:      function(pos){A.call('selectServer',pos);},\r\n  getMultiServers:   function(){return A.parse(A.call('getMultiServers'),[]);},\r\n  getSelectedMulti:  function(){return A.parse(A.call('getSelectedMultiServer'),{});},\r\n  selectMultiServer: function(pos){A.call('selectMultiServer',pos);},\r\n  getNote:           function(){return A.call('getNote')||'';},\r\n  getVersion:        function(){return A.call('getVersion')||'';},\r\n  getLogs:           function(){return A.parse(A.call('getLogs'),[]);},\r\n  clearLogs:         function(){A.call('clearLogs');},\r\n  openServers:       function(){A.call('openServers');},\r\n  checkUpdate:       function(){A.call('checkUpdate');},\r\n  requestInterstitial:function(){A.call('requestInterstitial');},\r\n  isAdsEnabled:      function(){return window.Android&&typeof Android.isAdsEnabled==='function'?Android.isAdsEnabled():false;},\r\n  getTimeLeft:       function(){return window.Android&&typeof Android.getTimeLeft==='function'?Android.getTimeLeft():0;},\r\n  watchAd:           function(){A.call('watchAd');}\r\n};\r\n\r\nvar STATE={\r\n  CONECTADO:    {cls:'st-conectado',   label:'Protegido',           sub:'Sua conex\u00E3o est\u00E1 segura.',                               auth:'ONLINE', authOk:true,  btn:'DESCONECTAR'},\r\n  DESCONECTADO: {cls:'st-desconectado',label:'Prote\u00E7\u00E3o pausada',    sub:'Toque na cruz para iniciar sua sess\u00E3o segura.',          auth:'\u2014',      authOk:false, btn:'CONECTAR'},\r\n  INICIANDO:    {cls:'st-conectando',  label:'Iniciando...',        sub:'Preparando conex\u00E3o...',                                  auth:'...',    authOk:false, btn:'CANCELAR'},\r\n  PARANDO:      {cls:'st-conectando',  label:'Parando...',          sub:'Encerrando t\u00FAnel...',                                    auth:'...',    authOk:false, btn:'AGUARDE...'},\r\n  CONECTANDO:   {cls:'st-conectando',  label:'Conectando...',       sub:'Estabelecendo conex\u00E3o segura...',                        auth:'...',    authOk:false, btn:'CANCELAR'},\r\n  AGUARDANDO:   {cls:'st-conectando',  label:'Aguardando...',       sub:'Aguardando resposta do servidor...',                     auth:'...',    authOk:false, btn:'CANCELAR'},\r\n  AUTENTICANDO: {cls:'st-conectando',  label:'Autenticando...',     sub:'Verificando credenciais...',                             auth:'...',    authOk:false, btn:'CANCELAR'},\r\n  RECONECTANDO: {cls:'st-conectando',  label:'Reconectando...',     sub:'Tentando restaurar conex\u00E3o...',                          auth:'...',    authOk:false, btn:'CANCELAR'},\r\n  NOPROCESS:    {cls:'',              label:'Prote\u00E7\u00E3o pausada',     sub:'Toque na cruz para iniciar sua sess\u00E3o segura.',          auth:'\u2014',      authOk:false, btn:'CONECTAR'},\r\n  ERRO:         {cls:'st-erro',        label:'Falha na conex\u00E3o',    sub:'Verifique suas configura\u00E7\u00F5es e tente novamente.',        auth:'FALHA',  authOk:false, btn:'TENTAR NOVAMENTE'}\r\n};\r\n\r\nvar ALL_STATE_CLASSES=['st-conectado','st-conectando','st-desconectado','st-erro'];\r\nvar app={rawState:'NOPROCESS',connected:false,busy:false,startedAt:0,timerHandle:null,pollHandle:null,_mode:'SSH'};\r\n\r\nfunction $(id){return document.getElementById(id);}\r\nfunction setText(id,v){var el=$(id);if(el)el.textContent=String(v==null?'':v);}\r\nfunction pad(n){return String(n).padStart(2,'0');}\r\nfunction esc(s){return String(s==null?'':s).replace(\/&\/g,'&amp;').replace(\/<\/g,'&lt;').replace(\/>\/g,'&gt;').replace(\/\"\/g,'&quot;').replace(\/'\/g,'&#39;');}\r\n\r\nfunction toast(msg,kind){\r\n  var el=$('toast');if(!el)return;\r\n  el.textContent=msg;\r\n  el.className='toast show'+(kind?' '+kind:'');\r\n  clearTimeout(el._t);\r\n  el._t=setTimeout(function(){el.className='toast';},2800);\r\n}\r\n\r\nfunction showPage(name){\r\n  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});\r\n  document.querySelectorAll('.nav-btn').forEach(function(b){b.classList.remove('active');});\r\n  var pg=$('page-'+name);if(pg)pg.classList.add('active');\r\n  var nb=$('nav-'+name);if(nb)nb.classList.add('active');\r\n  if(name==='servers')buildServerListPage();\r\n}\r\n\r\nfunction applyState(raw,detail){\r\n  raw=String(raw||'NOPROCESS').toUpperCase().trim();\r\n  app.rawState=raw;\r\n  var s=STATE[raw]||STATE['NOPROCESS'];\r\n  ALL_STATE_CLASSES.forEach(function(c){document.body.classList.remove(c);});\r\n  if(s.cls)document.body.classList.add(s.cls);\r\n  setText('status-label',s.label);\r\n  setText('status-detail',detail||s.sub);\r\n  setText('speed-status-label',s.label);\r\n  var modePill=$('speed-mode-pill');\r\n  if(modePill)modePill.textContent=(s.auth==='ONLINE'?'\u2713 ':'')+app._mode;\r\n  app.connected=(raw==='CONECTADO');\r\n  app.busy=['INICIANDO','CONECTANDO','AUTENTICANDO','AGUARDANDO','RECONECTANDO','PARANDO'].indexOf(raw)>=0;\r\n  if(app.connected&&!app.startedAt){app.startedAt=Date.now();startTimer();}\r\n  if(!app.connected&&!app.busy){\r\n    if(app.startedAt){app.startedAt=0;stopTimer();setText('timer-val','00:00');}\r\n    var tb=$('timer-bar');if(tb)tb.classList.remove('show');\r\n  }\r\n}\r\n\r\nfunction startTimer(){\r\n  stopTimer();\r\n  var tb=$('timer-bar');if(tb)tb.classList.add('show');\r\n  app.timerHandle=setInterval(function(){\r\n    var sec=Math.floor((Date.now()-app.startedAt)\/1000);\r\n    var h=Math.floor(sec\/3600),m=Math.floor((sec%3600)\/60),s=sec%60;\r\n    setText('timer-val',(h?pad(h)+':':'')+pad(m)+':'+pad(s));\r\n  },1000);\r\n}\r\nfunction stopTimer(){if(app.timerHandle){clearInterval(app.timerHandle);app.timerHandle=null;}}\r\n\r\nfunction startPolling(){\r\n  app.pollHandle=setInterval(function(){\r\n    var raw=A.getStatus();\r\n    if(raw!==app.rawState)applyState(raw);\r\n  },1200);\r\n}\r\n\r\nfunction renderLogs(){\r\n  var container=$('log-container');if(!container)return;\r\n  var logs=A.getLogs();\r\n  if(!logs||!logs.length){container.innerHTML='<div style=\"color:var(--muted);font-size:12px;padding:8px\">Nenhum log dispon\u00EDvel.<\/div>';return;}\r\n  var html='';\r\n  for(var i=logs.length-1;i>=0;i--){\r\n    var item=logs[i];\r\n    var level=String(item.level||'INFO').toUpperCase();\r\n    var msg=esc(item.message||'');\r\n    var time=item.time?formatLogTime(item.time):'';\r\n    html+='<div class=\"log-entry '+level+'\"><span class=\"log-time\">'+esc(time)+'<\/span><span class=\"log-msg\">'+msg+'<\/span><\/div>';\r\n  }\r\n  container.innerHTML=html;\r\n}\r\n\r\nfunction formatLogTime(ms){\r\n  var d=new Date(ms);return pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds());\r\n}\r\n\r\nfunction loadSavedCredentials(){\r\n  try{\r\n    var raw=window.Android&&window.Android.getSavedCredentials?window.Android.getSavedCredentials():'{}';\r\n    var creds=JSON.parse(raw);\r\n    var fUser=$('ci-ssh-user'),fPass=$('ci-ssh-pass');\r\n    var fUdp=$('ci-udp-token'),fV2=$('ci-v2ray-uuid');\r\n    if(fUser)fUser.value=creds.sshUser||'';\r\n    if(fPass)fPass.value=creds.sshPass||'';\r\n    if(fUdp)fUdp.value=creds.udpToken||'';\r\n    if(fV2)fV2.value=creds.v2uuid||'';\r\n  }catch(e){console.warn('Erro ao carregar credenciais',e);}\r\n}\r\n\r\nfunction refreshInfo(){\r\n  var ver=A.getVersion();if(ver)setText('config-version',ver);\r\n  var note=A.getNote();\r\n  var mc=$('message-card');if(mc){mc.classList.toggle('show',!!note);setText('message-text',note);}\r\n}\r\n\r\nfunction refreshSelected(){\r\n  var s=A.getSelected();\r\n  if(s&&s.Name){\r\n    setText('server-title',s.Name||'Servidor autom\u00E1tico');\r\n    setText('server-sub',s.Info||'Funcionando');\r\n    app._mode=s.Info||'SSH';\r\n    setText('speed-mode-pill',s.Info||'SSH');\r\n    var wrap=$('server-flag-wrap');\r\n    if(wrap&&(s.FlagUrl||s.Flag)){\r\n      var src=s.FlagUrl?s.FlagUrl:'file:\/\/\/android_asset\/flags\/'+s.Flag+'.png';\r\n      wrap.innerHTML='<img src=\"'+esc(src)+'\" onerror=\"this.parentElement.innerHTML=\\'\uD83C\uDF10\\'\" style=\"width:100%;height:100%;object-fit:cover;border-radius:10px\">';\r\n    }\r\n  }\r\n  var p=A.getSelectedMulti();\r\n  var pCard=$('select-premium');\r\n  if(p&&p.Name){\r\n    if(pCard)pCard.style.display='flex';\r\n    setText('premium-title',p.Name||'Selecionar servidor');\r\n    setText('premium-sub',p.Info||'Premium');\r\n    var pwrap=$('premium-flag-wrap');\r\n    if(pwrap&&(p.FlagUrl||p.Flag)){\r\n      var psrc=p.FlagUrl?p.FlagUrl:'file:\/\/\/android_asset\/flags\/'+p.Flag+'.png';\r\n      pwrap.innerHTML='<img src=\"'+esc(psrc)+'\" onerror=\"this.parentElement.innerHTML=\\'\u2726\\'\" style=\"width:100%;height:100%;object-fit:cover;border-radius:10px\">';\r\n    }\r\n  }else{if(pCard)pCard.style.display='none';}\r\n}\r\n\r\nfunction buildServerList(type){\r\n  var root=$('list-servers');if(!root)return;\r\n  root.innerHTML='';\r\n  var isPremium=(type==='premium');\r\n  var servers=isPremium?A.getMultiServers():A.getServers();\r\n  var selected=isPremium?A.getSelectedMulti():A.getSelected();\r\n  var selPos=selected?selected.position:-1;\r\n  if(!servers||!servers.length){\r\n    root.innerHTML='<div style=\"color:var(--muted);font-size:13px;padding:8px\">Nenhuma op\u00E7\u00E3o dispon\u00EDvel no momento.<\/div>';\r\n    return;\r\n  }\r\n  var mTitleEl=document.querySelector('#modal-servers .modal-title');\r\n  if(mTitleEl)mTitleEl.textContent=isPremium?'\u2726 Servidores Premium':'\u2726 Operadoras';\r\n  servers.forEach(function(s,i){\r\n    var isSel=(s.position===selPos||i===selPos);\r\n    var flagSrc=s.FlagUrl?s.FlagUrl:(s.Flag?'file:\/\/\/android_asset\/flags\/'+s.Flag+'.png':'');\r\n    var el=document.createElement('div');\r\n    el.className='list-item'+(isSel?' selected':'');\r\n    el.innerHTML='<div class=\"li-icon\">'+(flagSrc?'<img src=\"'+esc(flagSrc)+'\" onerror=\"this.parentElement.innerHTML=\\''+(isPremium?'\u2726':'\uD83C\uDF10')+'\\'\">':(isPremium?'\u2726':'\uD83C\uDF10'))+'<\/div>'+\r\n      '<div class=\"li-main\"><div class=\"li-title\">'+esc(s.Na