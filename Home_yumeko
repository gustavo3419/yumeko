function deletarItem(tipo, index) {
  if (!confirm("Deletar?")) return;
  cfg[tipo].splice(index, 1);
  if (tipo==="Servers") renderServers(); else renderMultis();
}

function fecharModal(id) { document.getElementById(id).classList.remove("show"); }

async function carregarGitHub() {
  toast("Carregando config...", "info");
  try {
    const r = await fetch(API+"?t="+Date.now(), { headers: {"Authorization":"Bearer "+TOKEN} });
    const data = await r.json();
    shaAtual = data.sha;
    cfg = JSON.parse(atob(data.content.replace(/\n/g,"")));
    carregarForm();
    toast("✅ Config carregado!", "ok");
  } catch(e) { toast("❌ Erro: "+e.message, "erro"); }
}

async function carregarHTML() {
  toast("Carregando Home UI...", "info");
  try {
    const r = await fetch(HTML_API+"?t="+Date.now(), { headers: {"Authorization":"Bearer "+TOKEN} });
    const data = await r.json();
    htmlSha = data.sha;
    const conteudo = JSON.parse(atob(data.content.replace(/\n/g,"")));
    document.getElementById("html_version").value = conteudo.version||"";
    document.getElementById("html_editor").value = conteudo.HtmlUI||"";
    toast("✅ Home UI carregado!", "ok");
  } catch(e) { toast("❌ Erro ao carregar Home UI: "+e.message, "erro"); }
}

async function salvarAtivo() {
  if (abaAtiva === "config") await salvarConfig();
  else await salvarHTML();
}

async function salvarConfig() {
  coletarForm();
  const btn = document.getElementById("btn-save");
  btn.disabled = true; btn.innerHTML = '<span class="loading"></span>Salvando...';
  try {
    const conteudo = btoa(unescape(encodeURIComponent(JSON.stringify(cfg,null,3))));
    const r = await fetch(API, {
      method: "PUT",
      headers: {"Authorization":"Bearer "+TOKEN,"Content-Type":"application/json"},
      body: JSON.stringify({message:"Editado pelo Web Editor",content:conteudo,sha:shaAtual})
    });
    if (r.status===200||r.status===201) {
      shaAtual = (await r.json()).content.sha;
      toast("✅ Config salvo!", "ok");
    } else { toast("❌ "+(await r.json()).message, "erro"); }
  } catch(e) { toast("❌ "+e.message, "erro"); }
  btn.disabled = false; btn.innerHTML = "💾 Salvar no GitHub";
}

async function salvarHTML() {
  const btn = document.getElementById("btn-save");
  btn.disabled = true; btn.innerHTML = '<span class="loading"></span>Salvando...';
  try {
    const obj = {
      version: document.getElementById("html_version").value,
      HtmlUI: document.getElementById("html_editor").value
    };
    const conteudo = btoa(unescape(encodeURIComponent(JSON.stringify(obj,null,2))));
    const r = await fetch(HTML_API, {
      method: "PUT",
      headers: {"Authorization":"Bearer "+TOKEN,"Content-Type":"application/json"},
      body: JSON.stringify({message:"Home UI editado pelo Web Editor",content:conteudo,sha:htmlSha})
    });
    if (r.status===200||r.status===201) {
      htmlSha = (await r.json()).content.sha;
      toast("✅ Home UI salvo!", "ok");
    } else { toast("❌ "+(await r.json()).message, "erro"); }
  } catch(e) { toast("❌ "+e.message, "erro"); }
  btn.disabled = false; btn.innerHTML = "💾 Salvar no GitHub";
}

document.querySelectorAll(".modal-overlay").forEach(el => {
  el.addEventListener("click", e => { if (e.target===el) el.classList.remove("show"); });
});

carregarGitHub();
</script>
