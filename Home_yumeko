t: space-between; border-bottom: 1px solid var(--panel-border); }\n.logs-title { font-size: 10.5px; font-weight: 800; color: var(--accent); letter-spacing: .14em; text-transform: uppercase; font-family: var(--mono); }\n.logs-actions { display: flex; gap: 8px; }\n.logs-btn { padding: 7px 12px; font-size: 9.5px; font-weight: 700; background: rgba(255,255,255,.04); border: 1px solid var(--panel-border); color: var(--text); cursor: pointer; font-family: var(--sans); letter-spacing: .06em; text-transform: uppercase; clip-path: polygon(5px 0, 100% 0, 100% 100%, calc(100% - 5px) 100%, 0 100%, 0 5px); }\n.logs-btn:active { opacity: .7; }\n.logs-body { flex: 1; overflow-y: auto; padding: 8px 0; font-family: var(--mono); font-size: 11px; background: #020308; }\n.log-line { display: flex; align-items: flex-start; gap: 8px; padding: 4px 14px; border-bottom: 1px solid rgba(255,255,255,.02); line-height: 1.5; word-break: break-all; }\n.log-line .log-time { flex: 0 0 auto; color: #232c3d; font-size: 9.5px; padding-top: 1px; white-space: nowrap; }\n.log-line .log-msg { flex: 1; }\n.log-line.info .log-msg { color: #647289; }\n.log-line.ok { background: rgba(57,255,136,.04); } .log-line.ok .log-msg { color: #5ef99a; font-weight: 600; }\n.log-line.warn .log-msg { color: var(--yellow); }\n.log-line.err { background: rgba(255,56,96,.05); } .log-line.err .log-msg { color: var(--red); }\n.log-line.sep .log-msg { color: #232c3d; letter-spacing: .1em; font-size: 9.5px; text-align: center; width: 100%; }\n.logs-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 200px; gap: 10px; color: var(--muted); font-size: 12px; }\n.logs-footer { padding: 10px 16px; border-top: 1px solid var(--panel-border); display: flex; align-items: center; justify-content: space-between; }\n.autoscroll-toggle { display: flex; align-items: center; gap: 8px; font-size: 10.5px; color: var(--muted2); }\n\n\n/* \u2500\u2500 CONFIG \u2500\u2500 */\n.settings-page { position: fixed; inset: 0; z-index: 90; background: var(--bg); display: none; flex-direction: column; padding-top: var(--vb-inset-top, 0px); padding-bottom: var(--vb-inset-bottom, 0px); }\n.settings-page.show { display: flex; }\n.settings-body { flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; }\n.settings-section-title { font-size: 10.5px; font-weight: 800; letter-spacing: .1em; color: var(--accent); text-transform: uppercase; margin-top: 10px; margin-bottom: 2px; font-family: var(--mono); }\n.settings-section-title:first-child { margin-top: 0; }\n.setting-item { background: var(--panel); border: 1px solid var(--panel-border); padding: 14px 16px; display: flex; align-items: center; gap: 12px; cursor: pointer; clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px)); }\n.setting-item:active { background: rgba(255,255,255,.03); }\n.setting-item svg { width: 19px; height: 19px; color: var(--accent); flex: 0 0 19px; }\n.setting-item-meta { flex: 1; min-width: 0; }\n.setting-item-title { font-size: 13.5px; font-weight: 700; }\n.setting-item-sub { font-size: 10.5px; color: var(--muted2); margin-top: 2px; }\n.setting-item-chev { color: var(--muted); flex: 0 0 auto; }\n\n.switch { width: 44px; height: 26px; background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); position: relative; flex: 0 0 auto; transition: background .2s; cursor: pointer; }\n.switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; background: var(--muted2); transition: all .2s; }\n.switch.on { background: rgba(57,255,136,.18); border-color: rgba(57,255,136,.45); }\n.switch.on::after { left: 22px; background: var(--green); }\n\n\n/* \u2500\u2500 APAR\u00caNCIA: pr\u00e9via ao vivo + tema atual \u2500\u2500 */\n.theme-current-label { font-size: 11px; color: var(--muted2); margin-bottom: 6px; letter-spacing: .04em; font-family: var(--mono); }\n.theme-current-label span