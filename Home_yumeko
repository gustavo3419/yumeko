 }\n.settings-page.show { display: flex; }\n.settings-body { flex: 1; overflow-y: auto; padding: 14px 18px; display: flex; flex-direction: column; gap: 8px; }\n.settings-section { font-size: 10.5px; font-weight: 800; color: var(--muted2); text-transform: uppercase; letter-spacing: .07em; margin-top: 12px; margin-bottom: 2px; }\n.settings-section:first-child { margin-top: 0; }\n.setting-row { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 14px 16px; display: flex; align-items: center; gap: 12px; cursor: pointer; }\n.setting-row:active { opacity: .85; }\n.setting-row svg { width: 18px; height: 18px; color: var(--accent); flex: 0 0 18px; }\n.setting-meta { flex: 1; min-width: 0; }\n.setting-title { font-size: 14px; font-weight: 700; }\n.setting-sub { font-size: 11px; color: var(--muted2); margin-top: 2px; }\n.setting-chev { color: var(--muted); }\n\n/* SWITCH */\n.switch { width: 46px; height: 26px; background: var(--card2); border: 1px solid var(--border); border-radius: 100px; position: relative; flex: 0 0 auto; cursor: pointer; transition: background .2s; }\n.switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: var(--muted2); transition: all .22s; }\n.switch.on { background: var(--accent); border-color: transparent; }\n.switch.on::after { left: 22px; background: #1c0f00; }\n\n/* ── APARÊNCIA ── */\n.theme-current { font-size: 12px; color: var(--muted2); margin-bottom: 8px; }\n.theme-current strong { color: var(--accent); }\n.theme-preview { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 16px; margin-bottom: 4px; }\n.preview-label { font-size: 9px; font-weight: 800; color: var(--muted2); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 13px; }\n.preview-row { display: flex; align-items: center; gap: 14px; }\n.preview-orb { width: 48px; height: 48px; border-radius: 50%; background: var(--card2); border: 2px solid var(--accent); display: grid; place-items: center; flex: 0 0 48px; }\n.preview-orb svg { width: 22px; height: 22px; color: var(--accent); }\n.preview-meta { flex: 1; }\n.preview-status { font-size: 10px; font-weight: 800; color: var(--text); margin-bottom: 9px; text-transform: uppercase; letter-spacing: .04em; }\n.preview-btn { padding: 9px 20px; border: none; background: var(--accent); color: #1c0f00; font-size: 11px; font-weight: 800; cursor: default; font-family: var(--sans); border-radius: 9px; }\n\n.palette-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 9px; }\n.palette-item { display: flex; flex-direction: column; align-items: center; gap: 5px; cursor: pointer; padding: 9px 4px; border-radius: 12px; border: 2px solid transparent; transition: border-color .15s, background .15s; }\n.palette-item.selected { border-color: var(--accent); background: rgba(245,158,11,.07); }\n.palette-item:active { transform: scale(.94); }\n.palette-circle { width: 40px; height: 40px; border-radius: 50%; border: 2px solid rgba(255,255,255,.1); position: relative; }\n.palette-circle .check { position: absolute; top: -4px; right: -4px; width: 15px; height: 15px; border-radius: 50%; background: var(--accent); color: #1c0f00; font-size: 9px; display: flex; align-items: center; justify-content: center; opacity: 0; }\n.palette-item.selected .check { opacity: 1; }\n.palette-label { font-size: 10px; font-weight: 700; color: var(--muted2); }\n.palette-item.selected .palette-label { color: var(--text); }\n\n.bg-color-row { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 13px 16px; display: flex; align-items: center; gap: 12px; }\n#bg-color-input { width: 40px; height: 40px; border: none; border-radius: 50%; padding: 0; background: none; cursor: pointer; box-shadow: 0 0 0 2px var(--accent); }\n#bg-color-input::-webkit-color-swatch-wrapper { padding: 2px; border-radius: 50%; }\n#bg-color-input::-webkit-color-swatch { border-radius: 50%; border: 2px solid rgba(255,255,255,.2); }\n.bg-color-reset { background: var(--card2); border: 1px solid var(--border); color: var(--muted2); font-size: 11px; font-weight: 700; padding: 8px 14px; cursor: pointer; border-radius: 9px; font-family: var(--sans); }\n\n.diag-box { background: #0a0b0d; border: 1px solid var(--border); padding: 12px 14px; font-family: var(--mono); font-size: 10px; color: var(--muted2); line-height: 1.6; white-space: pre-wrap; word-break: break-all; max-height: 220px; overflow-y: auto; border-radius: 10px; }\n\n/* ── TOAST ── */\n.toast { position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--card); border: 1px solid var(--border); padding: 11px 20px; font-size: 12px; font-weight: 600; color: var(--text); z-index: 200; opacity: 0; transition: opacity .22s, transform .22s; white-space: nowrap; pointer-events: none; max-width: 90vw; overflow: hidden; text-overflow: ellipsis; border-radius: 100px; box-shadow: 0 8px 24px rgba(0,0,0,.4); }\n.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n</style>\n</head>\n<body>\n<div class=\"shell\">\n\n  <header class=\"header\">\n    <div class=\"header-left\">\n      <div class=\"header-brand\" id=\"app-name\">VB INJECTOR</div>\n      <div class=\"header-meta\">\n        <span class=\"header-ver\" id=\"config-ver\">v--</span>\n        <span class=\"header-ver\" id=\"html-ver\">h--</span>\n        <span class=\"net-pill\" id=\"net-badge\"><span class=\"dot\"></span><span id=\"net-badge-text\">--</span></span>\n      </div>\n    </div>\n    <button class=\"header-refresh\" id=\"refresh-btn\" onclick=\"doUpdate()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n    </button>\n  </header>\n\n  <div class=\"body\" id=\"main-body\">\n\n    <div class=\"card notice-card\" id=\"notice-bar\">\n      <div class=\"notice-icon\">📣</div>\n      <div>\n        <div class=\"notice-title\" id=\"notice-title\">Aviso</div>\n        <div class=\"notice-msg\" id=\"notice-msg\"></div>\n      </div>\n    </div>\n\n    <div class=\"card ip-card\">\n      <div class=\"ip-led\"></div>\n      <div class=\"ip-info\">\n        <span class=\"ip-value\" id=\"ip-value\">•••.•••.•••.•••</span>\n        <div class=\"ip-sub\" id=\"ip-status-line\">Toque em atualizar pra ver seu IP real</div>\n      </div>\n      <span class=\"ip-refresh-btn\" id=\"ip-loc\" onclick=\"refreshIpInfo()\">↻ Atualizar</span>\n    </div>\n\n    <div class=\"card hero\">\n      <div class=\"orb-wrap\" onclick=\"doConnect()\">\n        <div class=\"orb-ring r3\"></div>\n        <div class=\"orb-ring r2\"></div>\n        <div class=\"orb-ring\"></div>\n        <div class=\"orb-core\" id=\"orb-btn\">\n          <div class=\"orb-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\">\n              <path id=\"orb-svg-path\" d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\" stroke=\"rgba(245,158,11,.9)\"/>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"orb-status\" id=\"orb-label\">DESCONECTADO</div>\n      <div class=\"orb-sub\" id=\"orb-sub\">Toque para conectar</div>\n      <div class=\"timer-pill\" id=\"timer\">\n        <span class=\"timer-val\" id=\"timer-val\">00:00:00</span>\n        <span class=\"timer-label\">tempo ativo</span>\n      </div>\n      <div class=\"chips-row\">\n        <div class=\"chip\" id=\"ping-chip\" onclick=\"testPing()\">\n          <span class=\"chip-dot\"></span>\n          <span id=\"ping-label\">Latência</span>\n        </div>\n        <div class=\"chip\" id=\"speedtest-chip\" onclick=\"runSpeedTest()\">\n          <span class=\"chip-dot\"></span>\n          <span id=\"speedtest-label\">Velocidade</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"card speedtest-panel\" id=\"speedtest-panel\">\n      <div class=\"gauge-wrap\">\n        <div class=\"gauge-bg\"></div>\n        <div class=\"gauge-needle\" id=\"gauge-needle\"></div>\n      </div>\n      <div class=\"gauge-val\" id=\"gauge-val\">0.0</div>\n      <div class=\"gauge-unit\">Mbps de download</div>\n      <div class=\"gauge-close\" onclick=\"closeSpeedTest()\">Fechar</div>\n    </div>\n\n    <div class=\"speed-row\" id=\"speed-row\" style=\"display:none\">\n      <div class=\"card speed-card\">\n        <div class=\"speed-label\">↓ DOWNLOAD</div>\n        <div class=\"speed-val\" id=\"speed-dl\">0 B/s</div>\n      </div>\n      <div class=\"card speed-card\">\n        <div class=\"speed-label\">↑ UPLOAD</div>\n        <div class=\"speed-val\" id=\"speed-ul\">0 B/s</div>\n      </div>\n    </div>\n\n    <button class=\"connect-btn\" id=\"connect-btn\" onclick=\"doConnect()\">Conectar SSH</button>\n\n    <div class=\"mode-row\">\n      <button class=\"mode-btn\" id=\"mode-ssh\" onclick=\"setMode('SSH')\">SSH</button>\n      <button class=\"mode-btn\" id=\"mode-xray\" onclick=\"setMode('XRAY')\">XRAY</button>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"server-row\" id=\"card-ssh\" onclick=\"openSheet('ssh')\">\n        <div class=\"server-icon\">🖥️</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Servidor SSH</div>\n          <div class=\"server-name\" id=\"ssh-name\">Selecionar servidor</div>\n          <div class=\"server-sub\" id=\"ssh-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n      <div class=\"divider\" id=\"payload-divider\"></div>\n      <div class=\"server-row\" id=\"card-payload\" onclick=\"openSheet('payload')\">\n        <div class=\"server-icon\">📦</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Payload</div>\n          <div class=\"server-name\" id=\"payload-name\">Selecionar payload</div>\n          <div class=\"server-sub\" id=\"payload-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n      <div class=\"server-row\" id=\"card-xray\" style=\"display:none\" onclick=\"openSheet('xray')\">\n        <div class=\"server-icon\">⚡</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Perfil XRAY</div>\n          <div class=\"server-name\" id=\"xray-name\">Selecionar perfil</div>\n          <div class=\"server-sub\" id=\"xray-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <div class=\"card msg-card\" id=\"msg-card\" style=\"display:none\">\n      <div class=\"msg-dot\"></div>\n      <div class=\"msg-text\" id=\"msg-text\"></div>\n    </div>\n\n  </div>\n\n  <nav class=\"bottom-nav\">\n    <button class=\"nav-btn active\" onclick=\"showMain()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>\n      <span>Início</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showLogs()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6M16 13H8\"/></svg>\n      <span>Logs</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"openSheet(app.mode === 'XRAY' ? 'xray' : 'ssh')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/></svg>\n      <span>Servidores</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showSettings()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <span>Config</span>\n    </button>\n  </nav>\n\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<!-- MODAIS -->\n<div class=\"overlay\" id=\"exit-modal\" onclick=\"closeExitModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-handle\"></div><div class=\"modal-pad\">\n    <div class=\"modal-badge\">👋 Até logo</div>\n    <div class=\"modal-title\">Sair do <span id=\"exit-modal-appname\">app</span></div>\n    <div class=\"modal-sub\">O que você deseja fazer?</div>\n    <button class=\"modal-btn modal-btn-minimize\" id=\"exit-modal-minimize\" onclick=\"exitModalMinimize()\">📱 Minimizar (segundo plano)</button>\n    <button class=\"modal-btn modal-btn-exit\" onclick=\"exitModalExit()\">🚪 Sair completamente</button>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"closeExitModal()\">Cancelar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"cred-modal\" onclick=\"closeCredModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-handle\"></div><div class=\"modal-pad\">\n    <div class=\"modal-badge\">🔐 Login necessário</div>\n    <div class=\"modal-title\">Credenciais SSH</div>\n    <div class=\"modal-sub\">Esse servidor pede usuário e senha pra conectar.</div>\n    <div class=\"cred-label\">👤 Usuário</div>\n    <input type=\"text\" id=\"cred-user\" class=\"cred-input\" placeholder=\"Digite o usuário\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <div class=\"cred-label\">🔒 Senha</div>\n    <div style=\"position:relative;\">\n      <input type=\"password\" id=\"cred-pass\" class=\"cred-input\" placeholder=\"Digite a senha\" style=\"padding-right:44px;\">\n      <span id=\"cred-pass-toggle\" style=\"position:absolute;right:14px;top:50%;transform:translateY(-50%);cursor:pointer;font-size:16px;user-select:none;\">👁️</span>\n    </div>\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:18px;\" onclick=\"saveCredField();closeCredModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"uuid-modal\" onclick=\"closeUuidModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-handle\"></div><div class=\"modal-pad\">\n    <div class=\"modal-badge\">🔑 Ativação necessária</div>\n    <div class=\"modal-title\">UUID / Chave</div>\n    <div class=\"modal-sub\">Esse perfil é premium e precisa da chave de ativação.</div>\n    <div class=\"cred-label\">🔑 UUID</div>\n    <input type=\"text\" id=\"xray-uuid-input\" class=\"cred-input\" placeholder=\"Cole o UUID aqui\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:18px;\" onclick=\"saveUuidField();closeUuidModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"autherror-modal\" onclick=\"closeAuthErrorModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-handle\"></div><div class=\"modal-pad\">\n    <div class=\"modal-badge\" style=\"background:rgba(239,68,68,.12);border-color:rgba(239,68,68,.35);color:var(--red);\">⚠️ Falha</div>\n    <div class=\"modal-title\" id=\"autherror-title\">Usuário ou senha incorretos</div>\n    <div class=\"modal-sub\" id=\"autherror-sub\">Não foi possível autenticar. Confira e tente de novo.</div>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"fixCredsAfterAuthError()\">Corrigir credenciais</button>\n    <button class=\"modal-btn modal-btn-minimize\" onclick=\"closeAuthErrorModal()\">Fechar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"sheet-ssh\" onclick=\"closeSheet('ssh')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-handle\"></div><div class=\"modal-pad\">\n    <div class=\"sheet-title\">Servidores SSH <span class=\"sheet-hint\">★ pra favoritar</span></div>\n    <div id=\"ssh-list\"></div>\n  </div></div>\n</div>\n<div class=\"overlay\" id=\"sheet-payload\" onclick=\"closeSheet('payload')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-handle\"></div><div class=\"modal-pad\">\n    <div class=\"sheet-title\">Payloads</div>\n    <div id=\"payload-list\"></div>\n  </div></div>\n</div>\n<div class=\"overlay\" id=\"sheet-xray\" onclick=\"closeSheet('xray')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-handle\"></div><div class=\"modal-pad\">\n    <div class=\"sheet-title\">Perfis XRAY <span class=\"sheet-hint\">★ pra favoritar</span></div>\n    <div id=\"xray-list\"></div>\n  </div></div>\n</div>\n\n<!-- LOGS -->\n<div class=\"logs-page\" id=\"logs-page\">\n  <div class=\"page-header\">\n    <div class=\"page-title\">Logs de Conexão</div>\n    <div class=\"page-actions\">\n      <button class=\"page-btn\" onclick=\"copyLogs()\">Copiar</button>\n      <button class=\"page-btn\" onclick=\"clearLogs()\" style=\"color:var(--red)\">Limpar</button>\n      <button class=\"page-btn\" onclick=\"hideLogs()\">✕</button>\n    </div>\n  </div>\n  <div class=\"logs-body\" id=\"logs-body\">\n    <div class=\"logs-empty\"><span style=\"font-size:28px\">📋</span><span>Aguardando logs...</span></div>\n  </div>\n  <div class=\"logs-footer\">\n    <div class=\"autoscroll-toggle\">\n      <div class=\"switch on\" id=\"autoscroll-switch\" onclick=\"toggleAutoscroll()\"></div>\n      <span>Rolagem automática</span>\n    </div>\n  </div>\n</div>\n\n<!-- CONFIG -->\n<div class=\"settings-page\" id=\"settings-page\">\n  <div class=\"page-header\">\n    <div class=\"page-title\">Configurações</div>\n    <div class=\"page-actions\"><button class=\"page-btn\" onclick=\"hideSettings()\">Fechar</button></div>\n  </div>\n  <div class=\"settings-body\">\n\n    <div class=\"settings-section\">🎨 Aparência</div>\n    <div class=\"theme-current\">Tema atual: <strong id=\"theme-current-name\">Forge</strong></div>\n    <div class=\"theme-preview\">\n      <div class=\"preview-label\">Prévia ao vivo</div>\n      <div class=\"preview-row\">\n        <div class=\"preview-orb\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" width=\"22\" height=\"22\" color=\"var(--accent)\"><path d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\" stroke=\"var(--accent)\"/></svg>\n        </div>\n        <div class=\"preview-meta\">\n          <div class=\"preview-status\">Conectado</div>\n          <button class=\"preview-btn\">Conectar</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"palette-grid\" id=\"palette-grid\"></div>\n    <div class=\"bg-color-row\">\n      <div style=\"flex:1\">\n        <div style=\"font-size:13.5px;font-weight:700;\">Cor de fundo</div>\n        <div style=\"font-size:11px;color:var(--muted2);margin-top:2px;\">Toque no círculo pra escolher</div>\n      </div>\n      <input type=\"color\" id=\"bg-color-input\" value=\"#111214\">\n      <button class=\"bg-color-reset\" onclick=\"resetBgColor()\">Padrão</button>\n    </div>\n\n    <div class=\"settings-section\">⚙️ Conexão</div>\n    <div class=\"setting-row\" onclick=\"toggleAutoConnect()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n      <div class=\"setting-meta\">\n        <div class=\"setting-title\">Conectar ao abrir</div>\n        <div class=\"setting-sub\">Usa o último servidor/perfil selecionado</div>\n      </div>\n      <div class=\"switch\" id=\"autoconnect-switch\"></div>\n    </div>\n    <div class=\"setting-row\" onclick=\"promptUuid()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>\n      <div class=\"setting-meta\">\n        <div class=\"setting-title\">UUID / Chave</div>\n        <div class=\"setting-sub\" id=\"uuid-sub\">Não configurado</div>\n      </div>\n      <span class=\"setting-chev\">›</span>\n    </div>\n    <div class=\"setting-row\" onclick=\"toast('Puxe a barra de notificação e segure num ícone pra adicionar o atalho 💡')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2L2 7l10 5 10-5-10-5z\"/><path d=\"M2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\n      <div class=\"setting-meta\">\n        <div class=\"setting-title\">Atalho rápido</div>\n        <div class=\"setting-sub\">Conectar sem abrir o app (Ajustes Rápidos)</div>\n      </div>\n      <span class=\"setting-chev\">›</span>\n    </div>\n\n    <div class=\"settings-section\">🛠️ Avançado</div>\n    <div class=\"setting-row\" onclick=\"doUpdate()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      <div class=\"setting-meta\">\n        <div class=\"setting-title\">Atualizar Configuração</div>\n        <div class=\"setting-sub\">Buscar dados do servidor agora</div>\n      </div>\n      <span class=\"setting-chev\">›</span>\n    </div>\n    <div class=\"setting-row\" onclick=\"if(B&&B.openSettings){B.openSettings();}else{toast('Disponível só no app.');}\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <div class=\"setting-meta\">\n        <div class=\"setting-title\">Configurações Avançadas</div>\n        <div class=\"setting-sub\">DNS, UDP, SSH, Sistema...</div>\n      </div>\n      <span class=\"setting-chev\">›</span>\n    </div>\n    <div class=\"setting-row\" onclick=\"toggleDiagBox()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      <div class=\"setting-meta\">\n        <div class=\"setting-title\">Diagnóstico</div>\n        <div class=\"setting-sub\">Gerar relatório pra suporte</div>\n      </div>\n      <span class=\"setting-chev\">›</span>\n    </div>\n    <div id=\"diag-wrap\" style=\"display:none\">\n      <div class=\"diag-box\" id=\"diag-box\"></div>\n      <button class=\"page-btn\" style=\"width:100%;margin-top:8px;padding:10px;border-radius:10px;\" onclick=\"copyDiag()\">Copiar diagnóstico</button>\n    </div>\n\n  </div>\n</div>\n\n<script>\nvar B = window.VBBridge;\nvar app = { mode:'SSH', connected:false, connectTime:0, timerInt:null, pollInt:null, favorites:[], autoscroll:true };\n\nfunction bp(raw,fb){try{return JSON.parse(raw)||fb;}catch(e){return fb;}}\n\nfunction init(){\n  if(!B){showMsg('Bridge não encontrado.');return;}\n  if(B.isTamperDetected&&B.isTamperDetected())showTamperWarning();\n  var cfg=bp(B.getConfig(),{});\n  if(cfg.appName)document.getElementById('app-name').textContent=cfg.appName;\n  if(cfg.configVersion)document.getElementById('config-ver').textContent='v'+cfg.configVersion;\n  if(B.getHtmlVersion)document.getElementById('html-ver').textContent='h'+(B.getHtmlVersion()||'--');\n  if(cfg.notice&&cfg.notice.enabled)showNoticeBar(cfg.notice.title||'Aviso',cfg.notice.message||'');\n  var uuid=B.getUuid?B.getUuid():'';\n  if(uuid)document.getElementById('uuid-sub').textContent=uuid.substring(0,8)+'...';\n  initPalette();initAutoConnectSwitch();setupCredModal();setupUuidModal();\n  var savedMode=B.getMode?B.getMode():'SSH';\n  setMode(savedMode==='XRAY'?'XRAY':'SSH',true);\n  refreshFavorites();refreshSelected();updateNetBadge();refreshIpInfo();\n  app.pollInt=setInterval(pollStatus,700);setInterval(updateNetBadge,5000);pollStatus();maybeAutoConnect();\n}\n\nfunction maybeAutoConnect(){\n  if(!B||!B.getAutoConnect||!B.getAutoConnect())return;\n  if(app.connected)return;\n  var st=bp(B.getStatus(),{});\n  if(st.connected)return;\n  setTimeout(function(){doConnect();},600);\n}\n\nfunction updateNetBadge(){\n  if(!B||!B.getNetworkInfo)return;\n  try{\n    var info=bp(B.getNetworkInfo(),{});\n    document.getElementById('net-badge-text').textContent=info.type||'--';\n    document.getElementById('net-badge').classList.toggle('online',!!info.online);\n  }catch(e){}\n}\n\nfunction refreshIpInfo(){\n  if(!B||!B.requestIpInfo){setTimeout(refreshIpInfo,500);return;}\n  document.getElementById('ip-status-line').textContent='Consultando...';\n  var tid=setTimeout(function(){\n    document.getElementById('ip-status-line').textContent='Timeout na consulta';\n    document.getElementById('ip-value').textContent='—';\n  },15000);\n  var old=window.onVBIpInfo;\n  window.onVBIpInfo=function(info){clearTimeout(tid);if(old)old(info);};\n  B.requestIpInfo();\n}\nwindow.onVBIpInfo=function(info){\n  if(!info||!info.ip){\n    document.getElementById('ip-value').textContent='—';\n    document.getElementById('ip-status-line').textContent='Não foi possível consultar agora';\n    return;\n  }\n  document.getElementById('ip-value').textContent=info.ip;\n  var country=info.country_name||info.country||'';\n  var loc=[info.city,info.region,country].filter(Boolean).join(', ');\n  document.getElementById('ip-status-line').textContent=(app.connected?'IP mascarado pelo túnel ✓':'IP real (sem túnel)')+(loc?' · '+loc:'');\n};\n\nfunction testPing(){\n  if(!B||!B.requestPing)return;\n  var target=currentTarget();\n  if(!target){toast('Escolha um servidor primeiro');return;}\n  var chip=document.getElementById('ping-chip');\n  chip.className='chip loading';document.getElementById('ping-label').textContent='Testando...';\n  B.requestPing(target.host,target.port);\n}\nfunction currentTarget(){\n  try{\n    if(app.mode==='XRAY'){var x=bp(B.getSelectedXray(),{});if(x.host&&x.port)return{host:x.host,port:x.port};}\n    else{var s=bp(B.getSelectedServer(),{});if(s.host&&s.port)return{host:s.host,port:s.port};}\n  }catch(e){}\n  return null;\n}\nwindow.onVBPingResult=function(result){\n  var chip=document.getElementById('ping-chip');var label=document.getElementById('ping-label');\n  if(result&&result.ok){\n    var ms=result.ms;var q=ms<150?'ok':(ms<400?'':'bad');var bars=ms<100?4:(ms<200?3:(ms<450?2:1));\n    chip.className='chip '+q;\n    label.innerHTML='<span class=\"signal-bars lit-'+bars+'\"><i></i><i></i><i></i><i></i></span><span class=\"chip-val\">'+ms+'ms</span>';\n  }else{chip.className='chip bad';label.textContent='Falhou';}\n};\n\nfunction runSpeedTest(){\n  if(!B||!B.requestSpeedTest)return;\n  var chip=document.getElementById('speedtest-chip');chip.className='chip loading';\n  document.getElementById('speedtest-label').textContent='Medindo...';\n  document.getElementById('speedtest-panel').classList.add('show');\n  document.getElementById('gauge-needle').style.transform='rotate(-90deg)';\n  document.getElementById('gauge-val').textContent='...';B.requestSpeedTest();\n}\nfunction closeSpeedTest(){document.getElementById('speedtest-panel').classList.remove('show');}\nwindow.onVBSpeedTestResult=function(result){\n  var chip=document.getElementById('speedtest-chip');var label=document.getElementById('speedtest-label');\n  if(result&&result.ok){\n    var mbps=result.mbps;chip.className='chip '+(mbps>15?'ok':(mbps>4?'':'bad'));\n    label.innerHTML='<span class=\"chip-val\">'+mbps.toFixed(1)+'</span> Mbps';\n    document.getElementById('gauge-val').textContent=mbps.toFixed(1);\n    var deg=-90+(Math.min(mbps/60,1)*180);\n    document.getElementById('gauge-needle').style.transform='rotate('+deg+'deg)';\n  }else{chip.className='chip bad';label.textContent='Falhou';document.getElementById('gauge-val').textContent='--';}\n};\n\nfunction refreshFavorites(){if(!B||!B.getFavorites)return;app.favorites=bp(B.getFavorites(),[]);}\nfunction isFavorite(id){return app.favorites.indexOf(id)!==-1;}\nfunction toggleFavoriteItem(id,evt){\n  if(evt)evt.stopPropagation();if(!B||!B.toggleFavorite)return;\n  B.toggleFavorite(id);refreshFavorites();if(currentOpenSheet)openSheet(currentOpenSheet);\n}\n\nfunction pollStatus(){\n  if(!B)return;\n  try{var st=bp(B.getStatus(),{});var connected=!!st.connected;if(connected!==app.connected){app.connected=connected;applyConnected(connected,st.mode||app.mode,st.connectedAt);}}catch(e){}\n}\n\nfunction applyConnected(on,mode,connectedAt){\n  document.body.classList.toggle('connected',on);document.body.classList.remove('connecting');\n  var label=document.getElementById('orb-label');var sub=document.getElementById('orb-sub');\n  var btn=document.getElementById('connect-btn');var timer=document.getElementById('timer');\n  var speed=document.getElementById('speed-row');\n  if(on){\n    label.textContent='CONECTADO';sub.textContent=(mode||app.mode)+' ativo';btn.textContent='Desconectar';\n    timer.classList.add('show');speed.style.display='grid';\n    app.connectTime=(connectedAt&&connectedAt>0)?connectedAt:Date.now();\n    updateTimer();if(app.timerInt)clearInterval(app.timerInt);app.timerInt=setInterval(updateTimer,1000);\n    setTimeout(refreshIpInfo,1200);\n  }else{\n    label.textContent='DESCONECTADO';sub.textContent='Toque para conectar';btn.textContent='Conectar '+app.mode;\n    timer.classList.remove('show');speed.style.display='none';\n    document.getElementById('speed-dl').textContent='0 B/s';document.getElementById('speed-ul').textContent='0 B/s';\n    if(app.timerInt)clearInterval(app.timerInt);refreshIpInfo();\n  }\n}\n\nfunction updateTimer(){\n  var s=Math.floor((Date.now()-app.connectTime)/1000);\n  var h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=s%60;\n  document.getElementById('timer-val').textContent=pad(h)+':'+pad(m)+':'+pad(sec);\n}\nfunction pad(n){return n<10?'0'+n:''+n;}\n\nfunction doConnect(){\n  if(!B){toast('Bridge não disponível');return;}\n  if(app.mode==='SSH'){\n    var srv=bp(B.getSelectedServer(),{});var uv=(document.getElementById('cred-user').value||'').trim();var pv=(document.getElementById('cred-pass').value||'').trim();\n    if(srv.name&&!srv.hasCredentials&&!uv&&!pv){showCredModal();toast('Preenche usuário e senha pra conectar');return;}\n  }else if(app.mode==='XRAY'){\n    var xr=bp(B.getSelectedXray(),{});var uuidV=(document.getElementById('xray-uuid-input').value||'').trim();\n    if(xr.name&&xr.uuidRequired&&!xr.hasUuid&&!uuidV){showUuidModal();toast('Cole o UUID pra conectar');return;}\n  }\n  document.body.classList.add('connecting');\n  document.getElementById('orb-label').textContent='CONECTANDO...';document.getElementById('orb-sub').textContent='Aguarde...';document.getElementById('connect-btn').textContent='Aguarde...';\n  if(B.consumeLastError)B.consumeLastError();if(app.mode==='XRAY')saveUuidField();B.connect();watchForConnectError();\n}\n\nfunction watchForConnectError(){\n  var checks=0,maxChecks=65;\n  var interval=setInterval(function(){\n    checks++;if(!B||!B.consumeLastError){clearInterval(interval);return;}\n    var err=B.consumeLastError();\n    if(err==='AUTH_FAILED'||err==='XRAY_NO_TRAFFIC'){\n      clearInterval(interval);document.body.classList.remove('connecting');\n      document.getElementById('orb-label').textContent='DESCONECTADO';document.getElementById('orb-sub').textContent='Toque para conectar';document.getElementById('connect-btn').textContent='Conectar '+app.mode;\n      showAuthErrorModal(err);\n    }else if(checks>=maxChecks){clearInterval(interval);}\n  },300);\n}\n\nfunction showAuthErrorModal(errType){\n  var title=document.getElementById('autherror-title');var sub=document.getElementById('autherror-sub');\n  if(errType==='XRAY_NO_TRAFFIC'){title.textContent='Conexão não confirmada';sub.textContent='O túnel abriu mas nenhum dado passou - verifique o UUID ou o servidor.';}\n  else{title.textContent='Usuário ou senha incorretos';sub.textContent='Não foi possível autenticar. Confira e tente de novo.';}\n  document.getElementById('autherror-modal').classList.add('show');\n}\nfunction closeAuthErrorModal(){document.getElementById('autherror-modal').classList.remove('show');}\nfunction fixCredsAfterAuthError(){closeAuthErrorModal();if(app.mode==='XRAY')showUuidModal();else showCredModal();}\n\nfunction doUpdate(){\n  if(!B){toast('Bridge não disponível');return;}\n  document.getElementById('refresh-btn').classList.add('spinning');toast('Atualizando...');B.updateConfig();\n  setTimeout(function(){init();document.getElementById('refresh-btn').classList.remove('spinning');toast('Configuração atualizada!');},3000);\n}\n\nfunction setMode(m,silent){\n  app.mode=m;\n  document.getElementById('mode-ssh').classList.toggle('active',m==='SSH');document.getElementById('mode-xray').classList.toggle('active',m==='XRAY');\n  var sshBlock=document.getElementById('card-ssh');var payBlock=document.getElementById('card-payload');var xrayBlock=document.getElementById('card-xray');var divider=document.getElementById('payload-divider');\n  if(m==='SSH'){sshBlock.style.display='';payBlock.style.display='';xrayBlock.style.display='none';if(divider)divider.style.display='';}\n  else{sshBlock.style.display='none';payBlock.style.display='none';xrayBlock.style.display='';if(divider)divider.style.display='none';}\n  document.getElementById('connect-btn').textContent=(app.connected?'Desconectar':'Conectar '+m);\n  if(!silent&&B)B.setMode(m);updateCredCard();updateUuidCard();resetPingChip();\n}\nfunction resetPingChip(){var chip=document.getElementById('ping-chip');if(!chip)return;chip.className='chip';document.getElementById('ping-label').textContent='Latência';}\n\nfunction setupCredModal(){\n  var u=document.getElementById('cred-user');var p=document.getElementById('cred-pass');\n  u.addEventListener('input',function(){var c=u.value.replace(/\\s/g,'');if(c!==u.value)u.value=c;saveCredField();});\n  p.addEventListener('input',saveCredField);u.addEventListener('blur',saveCredField);p.addEventListener('blur',saveCredField);\n  document.getElementById('cred-pass-toggle').addEventListener('click',function(){var s=p.type==='text';p.type=s?'password':'text';this.textContent=s?'👁️':'🙈';});\n  var saved=bp(B&&B.getManualCredentials?B.getManualCredentials():'{}',{});if(saved.username)u.value=saved.username;if(saved.password)p.value=saved.password;\n}\nfunction showCredModal(){document.getElementById('cred-modal').classList.add('show');}\nfunction closeCredModal(){document.getElementById('cred-modal').classList.remove('show');}\nfunction updateCredCard(){if(!B)return;var srv=bp(B.getSelectedServer(),{});setCredBadge(app.mode==='SSH'&&srv.name&&!srv.hasCredentials);}\nfunction promptCredIfNeeded(srv){if(app.mode==='SSH'&&srv&&srv.name&&!srv.hasCredentials)setTimeout(showCredModal,250);}\nfunction setCredBadge(show){\n  var icon=document.querySelector('#card-ssh .server-icon');if(!icon)return;var badge=document.getElementById('cred-needed-badge');\n  if(show){if(!badge){badge=document.createElement('span');badge.id='cred-needed-badge';badge.textContent='🔐';badge.style.cssText='position:absolute;top:-7px;right:-7px;font-size:13px;background:var(--bg);border-radius:50%;line-height:1;';badge.onclick=function(e){e.stopPropagation();showCredModal();};icon.appendChild(badge);}}else if(badge){badge.remove();}\n}\nfunction saveCredField(){if(B&&B.setManualCredentials)B.setManualCredentials(document.getElementById('cred-user').value.trim(),document.getElementById('cred-pass').value.trim());}\n\nfunction setupUuidModal(){var u=document.getElementById('xray-uuid-input');u.addEventListener('input',saveUuidField);u.addEventListener('blur',saveUuidField);u.value=(B&&B.getUuid)?B.getUuid():'';}\nfunction saveUuidField(){if(B&&B.setUuid)B.setUuid(document.getElementById('xray-uuid-input').value.trim().toLowerCase());}\nfunction showUuidModal(){document.getElementById('uuid-modal').classList.add('show');}\nfunction closeUuidModal(){document.getElementById('uuid-modal').classList.remove('show');}\nfunction updateUuidCard(){if(!B)return;var xr=bp(B.getSelectedXray(),{});setUuidBadge(app.mode==='XRAY'&&xr.name&&xr.uuidRequired&&!xr.hasUuid);}\nfunction promptUuidIfNeeded(xr){if(app.mode==='XRAY'&&xr&&xr.name&&xr.uuidRequired&&!xr.hasUuid)setTimeout(showUuidModal,250);}\nfunction setUuidBadge(show){\n  var icon=document.querySelector('#card-xray .server-icon');if(!icon)return;var badge=document.getElementById('uuid-needed-badge');\n  if(show){if(!badge){badge=document.createElement('span');badge.id='uuid-needed-badge';badge.textContent='🔑';badge.style.cssText='position:absolute;top:-7px;right:-7px;font-size:13px;background:var(--bg);border-radius:50%;line-height:1;';badge.onclick=function(e){e.stopPropagation();showUuidModal();};icon.appendChild(badge);}}else if(badge){badge.remove();}\n}\n\nfunction refreshSelected(){\n  if(!B)return;\n  try{var srv=bp(B.getSelectedServer(),{});if(srv.name){document.getElementById('ssh-name').textContent=srv.name;document.getElementById('ssh-sub').textContent=(srv.country||'')+' · '+(srv.operator||'');}}catch(e){}\n  try{var pld=bp(B.getSelectedPayload(),{});if(pld.name){document.getElementById('payload-name').textContent=pld.name;document.getElementById('payload-sub').textContent=pld.operator||'';}}catch(e){}\n  try{var xr=bp(B.getSelectedXray(),{});if(xr.name){document.getElementById('xray-name').textContent=xr.name;document.getElementById('xray-sub').textContent=(xr.protocol||'').toUpperCase()+' · '+(xr.security||'');}}catch(e){}\n  updateCredCard();updateUuidCard();\n}\n\nvar currentOpenSheet=null;\nfunction openSheet(type){\n  if(!B)return;currentOpenSheet=type;document.getElementById('sheet-'+type).classList.add('show');\n  if(type==='ssh')buildList('ssh-list',bp(B.getServers(),[]),function(item){B.selectServer(item.id);document.getElementById('ssh-name').textContent=item.name;document.getElementById('ssh-sub').textContent=(item.country||'')+' · '+(item.operator||'');updateCredCard();resetPingChip();closeSheet('ssh');toast('Servidor: '+item.name);promptCredIfNeeded(bp(B.getSelectedServer(),{}));},function(item){return item.name+'|'+(item.operator||'')+' · '+(item.method||')+'|'+(item.selected?'selected':'');});\n  if(type==='payload')buildList('payload-list',bp(B.getPayloads(),[]),function(item){B.selectPayload(item.id);document.getElementById('payload-name').textContent=item.name;document.getElementById('payload-sub').textContent=item.operator||'';closeSheet('payload');toast('Payload: '+item.name);},function(item){return item.name+'|'+(item.operator||'')+' · '+(item.networkType||'')+'|'+(item.selected?'selected':'');});\n  if(type==='xray')buildList('xray-list',bp(B.getXrayProfiles(),[]),function(item){B.selectXray(item.id);document.getElementById('xray-name').textContent=item.name;document.getElementById('xray-sub').textContent=(item.protocol||'').toUpperCase()+' · '+(item