x 12px;\r\n  display:flex;align-items:center;gap:12px;\r\n}\r\n.page-title{font-size:18px;font-weight:700;font-family:'Cinzel',serif;color:var(--gold);}\r\n\r\n.server-list-wrap{padding:0 14px;flex:1;overflow-y:auto;}\r\n\r\n\/* list items *\/\r\n.list-item{\r\n  display:flex;align-items:center;gap:12px;\r\n  padding:13px 14px;border-radius:18px;margin-bottom:9px;\r\n  background:var(--card);border:1px solid var(--line);\r\n  cursor:pointer;transition:opacity .15s;\r\n}\r\n.list-item:active{opacity:.75;}\r\n.list-item.selected{border-color:rgba(201,168,76,.45);background:rgba(201,168,76,.07);}\r\n.li-icon{\r\n  width:42px;height:42px;flex:0 0 42px;border-radius:13px;\r\n  display:grid;place-items:center;\r\n  background:rgba(201,168,76,.08);color:var(--gold);overflow:hidden;font-size:18px;\r\n}\r\n.li-icon img{width:100%;height:100%;object-fit:cover;}\r\n.li-main{min-width:0;flex:1;}\r\n.li-title{font-weight:700;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\r\n.li-sub{color:var(--muted);font-size:11px;margin-top:4px;font-weight:600;}\r\n.li-check{color:var(--gold);display:none;font-size:18px;}\r\n.list-item.selected .li-check{display:block;}\r\n\r\n\/* \u2500\u2500 SPEED PAGE \u2500\u2500 *\/\r\n.speed-page-body{padding:10px 18px;flex:1;display:flex;flex-direction:column;gap:14px;}\r\n.speed-big-card{\r\n  background:var(--card);border-radius:22px;padding:22px;\r\n  border:1px solid var(--line);text-align:center;\r\n}\r\n.speed-big-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-family:'Cinzel',serif;}\r\n.speed-big-val{font-size:48px;font-weight:900;font-variant-numeric:tabular-nums;margin:8px 0 4px;}\r\n.speed-big-unit{font-size:13px;color:var(--muted);font-weight:700;}\r\n.speed-dl{color:var(--gold);}\r\n.speed-ul{color:var(--amber);}\r\n.speed-cards-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}\r\n\r\n\/* \u2500\u2500 TOOLS PAGE \u2500\u2500 *\/\r\n.tools-body{pad