ius: 12px; }\n.nav-btn { flex: 1; padding: 10px 4px; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 6px; cursor: pointer; border: none; background: none; transition: all .2s; border-radius: 8px; }\n.nav-btn:active { opacity: .6; }\n.nav-btn svg { width: 16px; height: 16px; color: var(--muted); transition: color .2s; }\n.nav-btn span { font-size: 8.5px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; transition: color .2s; }\n.nav-btn.active { background: rgba(207,138,74,.12); }\n.nav-btn.active svg, .nav-btn.active span { color: var(--accent); }\n\n\n/* ── OVERLAY / MODAL ── */\n.overlay { position: fixed; inset: 0; z-index: 100; background: rgba(10,10,11,.8); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); display: none; align-items: center; padding: calc(20px + var(--vb-inset-top, 0px)) 20px calc(20px + var(--vb-inset-bottom, 0px)); }\n.overlay.show { display: flex; }\n.modal { width: 100%; max-width: 360px; margin: 0 auto; background: var(--bg-soft); border: 1px solid var(--panel-border-strong); max-height: 76vh; overflow-y: auto; box-shadow: 0 24px 70px rgba(0,0,0,.5); border-radius: 14px; }\n.modal-pad { padding: 22px 20px; }\n.modal-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(207,138,74,.12); border: 1px solid rgba(207,138,74,.3); color: var(--text); font-size: 10.5px; font-weight: 700; letter-spacing: .06em; padding: 6px 13px; margin-bottom: 15px; font-family: var(--mono); border-radius: 7px; }\n.modal-title { font-size: 18px; font-weight: 800; margin-bottom: 7px; }\n.modal-sub { font-size: 12.5px; color: var(--muted2); margin-bottom: 18px; }\n.modal-btn { width: 100%; padding: 14px; border: none; font-size: 12.5px; font-weight: 800; cursor: pointer; margin-bottom: 9px; display: flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--sans); letter-spacing: .02em; border-radius: 9px; }\n.modal-btn:last-chil