"exit-modal\" onclick=\"closeExitModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">\ud83d\udc4b AT\u00c9 LOGO</div>\n    <div class=\"modal-title\">Sair do <span id=\"exit-modal-appname\">app</span></div>\n    <div class=\"modal-sub\">O que voc\u00ea deseja fazer?</div>\n    <button class=\"modal-btn modal-btn-minimize\" id=\"exit-modal-minimize\" onclick=\"exitModalMinimize()\">\ud83d\udcf1 Minimizar (segundo plano)</button>\n    <button class=\"modal-btn modal-btn-exit\" onclick=\"exitModalExit()\">\ud83d\udeaa Sair completamente</button>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"closeExitModal()\">\u21a9\ufe0f Cancelar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"cred-modal\" onclick=\"closeCredModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">\ud83d\udd10 LOGIN NECESS\u00c1RIO</div>\n    <div class=\"modal-title\">Credenciais SSH</div>\n    <div class=\"modal-sub\">Esse servidor pede usu\u00e1rio e senha pra conectar.</div>\n    <div class=\"cred-label\">\ud83d\udc64 Usu\u00e1rio</div>\n    <input type=\"text\" id=\"cred-user\" class=\"cred-input\" placeholder=\"Digite o usu\u00e1rio\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <div class=\"cred-label\">\ud83d\udd12 Senha</div>\n    <div style=\"position:relative;\">\n      <input type=\"password\" id=\"cred-pass\" class=\"cred-input\" placeholder=\"Digite a senha\" style=\"padding-right:42px;\">\n      <span id=\"cred-pass-toggle\" style=\"position:absolute; right:12px; top:50%; transform:translateY(-50%); cursor:pointer; font-size:15px; user-select:none;\">\ud83d\udc41\ufe0f</span>\n    </div>\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:16px;\" onclick=\"saveCredField(); closeCredModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"uuid-modal\" onclick=\"closeUuidModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\">\ud83d\udd11 ATIVA\u00c7\u00c3O NECESS\u00c1RIA</div>\n    <div class=\"modal-title\">UUID / Chave</div>\n    <div class=\"modal-sub\">Esse perfil \u00e9 premium e precisa da chave de ativa\u00e7\u00e3o.</div>\n    <div class=\"cred-label\">\ud83d\udd11 UUID</div>\n    <input type=\"text\" id=\"xray-uuid-input\" class=\"cred-input\" placeholder=\"Cole o UUID aqui\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\">\n    <button class=\"modal-btn modal-btn-save\" style=\"margin-top:16px;\" onclick=\"saveUuidField(); closeUuidModal();\">Salvar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"autherror-modal\" onclick=\"closeAuthErrorModal()\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\"><div class=\"modal-pad\">\n    <div class=\"modal-badge\" style=\"background:rgba(255,56,96,.12); border-color:rgba(255,56,96,.35); color:var(--red);\">\u26a0\ufe0f FALHA NO LOGIN</div>\n    <div class=\"modal-title\" id=\"autherror-title\">Usu\u00e1rio ou senha incorretos</div>\n    <div class=\"modal-sub\" id=\"autherror-sub\">N\u00e3o foi poss\u00edvel autenticar nesse servidor com as credenciais informadas. Confira e tente de novo.</div>\n    <button class=\"modal-btn modal-btn-cancel\" onclick=\"fixCredsAfterAuthError()\">Corrigir credenciais</button>\n    <button class=\"modal-btn modal-btn-minimize\" onclick=\"closeAuthErrorModal()\">Fechar</button>\n  </div></div>\n</div>\n\n<div class=\"overlay\" id=\"sheet-ssh\" onclick=\"closeSheet('ssh')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">    <div class=\"sheet-title\">// Servidores SSH <span class=\"sheet-hint\">toque \u2605 pra favoritar</span></div>\n    <div id=\"ssh-list\"></div>\n  </div>\n</div>\n<div class=\"overlay\" id=\"sheet-payload\" onclick=\"closeSheet('payload')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-title\">// Payloads</div>\n    <div id=\"payload-list\"></div>\n  </div>\n</div>\n<div class=\"overlay\" id=\"sheet-xray\" onclick=\"closeSheet('xray')\">\n  <div class=\"modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-title\">// Perfis XRAY <span class=\"sheet-hint\">toque \u2605 pra favoritar</span></div>\n    <div id=\"xray-list\"></div>\n  </div>\n</div>\n\n<div class=\"logs-page\" id=\"logs-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">// Logs de Conex\u00e3o</div>\n    <div class=\"logs-actions\">\n      <button class=\"logs-btn\" onclick=\"copyLogs()\">Copiar</button>\n      <button class=\"logs-btn\" onclick=\"clearLogs()\" style=\"color:var(--red);border-color:rgba(255,56,96,.3)\">Limpar</button>\n      <button class=\"logs-btn\" onclick=\"hideLogs()\">\u2715</button>\n    </div>\n  </div>\n  <div class=\"logs-body\" id=\"logs-body\">\n    <div class=\"logs-empty\"><span style=\"font-size:28px\">\ud83d\udccb</span><span>Aguardando logs...</span></div>\n  </div>\n  <div class=\"logs-footer\">\n    <div class=\"autoscroll-toggle\">\n      <div class=\"switch on\" id=\"autoscroll-switch\" onclick=\"toggleAutoscroll()\"></div>\n      <span>Rolagem autom\u00e1tica</span>\n    </div>\n  </div>\n</div>\n\n<div class=\"settings-page\" id=\"settings-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">// Configura\u00e7\u00f5es</div>\n    <div class=\"logs-actions\"><button class=\"logs-btn\" onclick=\"hideSettings()\">Fechar</button></div>\n  </div>\n  <div class=\"settings-body\">\n\n    <div class=\"settings-section-title\">\ud83c\udfa8 Apar\u00eancia</div>\n    <div class=\"theme-current-label\">Tema atual: <span id=\"theme-current-name\">Cyber</span></div>\n    <div class=\"panel theme-preview-card\" id=\"theme-preview-card\">\n      <div class=\"theme-preview-title\">PR\u00c9VIA AO VIVO</div>\n      <div class=\"theme-preview-row\">\n        <div class=\"theme-preview-orb\">\n          <div class=\"theme-preview-orb-ring\"></div>\n          <div class=\"theme-preview-orb-core\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" width=\"20\" height=\"20\"><path d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\"/></svg>\n          </div>\n        </div>\n        <div class=\"theme-preview-meta\">\n          <div class=\"theme-preview-status\">CONECTADO</div>\n          <button class=\"theme-preview-btn\">Conectar</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"palette-grid\" id=\"palette-grid\"></div>\n    <div class=\"bg-color-row\">\n      <div style=\"flex:1\">\n        <div class=\"setting-item-title\">Cor de fundo</div>\n        <div class=\"setting-item-sub\">Toque no c\u00edrculo pra escolher</div>\n      </div>\n      <input type=\"color\" id=\"bg-color-input\" value=\"#04050a\">\n      <button class=\"bg-color-reset\" onclick=\"resetBgColor()\">Padr\u00e3o</button>\n    </div>\n\n    <div class=\"settings-section-title\">\u2699\ufe0f Conex\u00e3o</div>\n    <div class=\"setting-item\" onclick=\"toggleAutoConnect()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Conectar ao abrir o app</div>\n        <div class=\"setting-item-sub\">Usa o \u00faltimo servidor/perfil selecionado</div>\n      </div>\n      <div class=\"switch\" id=\"autoconnect-switch\"></div>\n    </div>\n    <div class=\"setting-item\" id=\"uuid-item\" onclick=\"promptUuid()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">UUID / Chave</div>\n        <div class=\"setting-item-sub\" id=\"uuid-sub\">N\u00e3o configurado</div>\n      </div>\n      <span class=\"setting-item-chev\">\u203a</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"toast('Puxe a barra de notifica\u00e7\u00e3o e segure num \u00edcone pra adicionar o atalho de Ajustes R\u00e1pidos do VB Injector \ud83d\udca1')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2L2 7l10 5 10-5-10-5z\"/><path d=\"M2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atalho r\u00e1pido</div>\n        <div class=\"setting-item-sub\">Conectar sem abrir o app (Ajustes R\u00e1pidos)</div>\n      </div>\n      <span class=\"setting-item-chev\">\u203a</span>\n    </div>\n\n    <div class=\"settings-section-title\">\ud83d\udee0\ufe0f Avan\u00e7ado</div>\n    <div class=\"setting-item\" onclick=\"doUpdate()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atualizar Configura\u00e7\u00e3o</div>\n        <div class=\"setting-item-sub\">Buscar dados do servidor agora</div>\n      </div>\n      <span class=\"setting-item-chev\">\u203a</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"if (B && B.openSettings) { B.openSettings(); } else { toast('Dispon\u00edvel s\u00f3 no app.'); }\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Configura\u00e7\u00f5es Avan\u00e7adas</div>\n        <div class=\"setting-item-sub\">DNS, UDP, SSH, Sistema...</div>\n      </div>\n      <span class=\"setting-item-chev\">\u203a</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"toggleDiagBox()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Diagn\u00f3stico</div>\n        <div class=\"setting-item-sub\">Gerar relat\u00f3rio pra suporte</div>\n      </div>\n      <span class=\"setting-item-chev\">\u203a</span>\n    </div>\n    <div id=\"diag-wrap\" style=\"display:none\">\n      <div class=\"diag-box\" id=\"diag-box\"></div>\n      <button class=\"logs-btn\" style=\"width:100%;margin-top:8px;padding:10px;\" onclick=\"copyDiag()\">Copiar diagn\u00f3stico</button>\n    </div>\n\n  </div>\n</div>\n\n<script>\nvar B = window.VBBridge;\nvar app = {\n  mode: 'SSH', connected: false, connectTime: 0, timerInt: null, pollInt: null,\n  favorites: [], autoscroll: true\n};\n\nfunction bp(raw, fb) { try { return JSON.parse(raw) || fb; } catch(e) { return fb; } }\n\nfunction forceRepaint(el) {\n  if (!el) return;\n  requestAnimationFrame(function () {\n    requestAnimationFrame(function () {\n      el.style.transform = 'translateZ(0)';\n      void el.offsetHeight;\n      el.style.transform = '';\n    });\n  });\n}\n\n// ============================================================\n// \u2550\u2550\u2550 FLAG: usa APENAS o campo \"flag\" do JSON \u2550\u2550\u2550\n// ============================================================\nfunction getFlagUrl(item) {\n  if (!item) return null;\n  var flag = item.flag || item.FLAG || '';\n  if (flag && typeof flag === 'string' && flag.startsWith('http')) {\n    return flag;\n  }\n  return null;\n}\n\nfunction setItemIcon(iconId, flagId, emojiId, item, defaultEmoji) {\n  var icon = document.getElementById(iconId);\n  var flag = document.getElementById(flagId);\n  var emoji = document.getElementById(emojiId);\n  if (!icon || !flag || !emoji) return;\n  var url = getFlagUrl(item);\n  if (url) {\n    flag.src = url;\n    flag.style.display = 'block';\n    emoji.style.display = 'none';\n  } else {\n    flag.style.display = 'none';\n    emoji.style.display = 'block';\n  }\n}\n\nfunction getItemFlagUrl(item) {\n  return getFlagUrl(item);\n}\n\nfunction init() {\n  if (!B) { showMsg('Bridge n\u00e3o encontrado. Modo de preview.'); return; }\n  if (B.isTamperDetected && B.isTamperDetected()) showTamperWarning();\n\n  var cfg = bp(B.getConfig(), {});\n  if (cfg.appName) document.getElementById('app-name').textContent = cfg.appName;\n  if (cfg.configVersion) document.getElementById('config-ver').textContent = 'v' + cfg.configVersion;\n  if (B.getHtmlVersion) document.getElementById('html-ver').textContent = 'h' + (B.getHtmlVersion() || '--');\n  if (cfg.notice && cfg.notice.enabled) showNoticeBar(cfg.notice.title || 'Aviso', cfg.notice.message || '');\n\n  var uuid = B.getUuid ? B.getUuid() : '';\n  if (uuid) document.getElementById('uuid-sub').textContent = uuid.substring(0,8) + '...';\n\n  initPalette();\n  initAutoConnectSwitch();\n  setupCredModal();\n  setupUuidModal();\n\n  var savedMode = B.getMode ? B.getMode() : 'SSH';\n  setMode(savedMode === 'XRAY' ? 'XRAY' : 'SSH', true);\n\n  refreshFavorites();\n  refreshSelected();\n  updateNetBadge();\n  refreshIpInfo();\n\n  app.pollInt = setInterval(pollStatus, 700);\n  setInterval(updateNetBadge, 5000);\n  pollStatus();\n  maybeAutoConnect();\n}\n\nfunction maybeAutoConnect() {\n  if (!B || !B.getAutoConnect || !B.getAutoConnect()) return;\n  if (app.connected) return;\n  var st = bp(B.getStatus(), {});\n  if (st.connected) return;\n  setTimeout(function () { doConnect(); }, 600);\n}\n\nfunction updateNetBadge() {\n  if (!B || !B.getNetworkInfo) return;\n  try {\n    var info = bp(B.getNetworkInfo(), {});\n    document.getElementById('net-badge-text').textContent = info.type || '--';\n    document.getElementById('net-badge').classList.toggle('online', !!info.online);\n  } catch(e) {}\n}\n\n\n/* \u2500\u2500 IP / LOCALIZA\u00c7\u00c3O \u2500\u2500 */\nfunction refreshIpInfo() {\n  if (!B || !B.requestIpInfo) {\n    setTimeout(refreshIpInfo, 500);\n    return;\n  }\n  document.getElementById('ip-status-line').textContent = 'Consultando...';\n  var timeoutId = setTimeout(function() {\n    document.getElementById('ip-status-line').textContent = 'Timeout na consulta';\n    document.getElementById('ip-value').textContent = '\u2014';\n  }, 15000);\n  var oldOnVBIpInfo = window.onVBIpInfo;\n  window.onVBIpInfo = function(info) {\n    clearTimeout(timeoutId);\n    if (oldOnVBIpInfo) oldOnVBIpInfo(info);\n  };\n  B.requestIpInfo();\n}\nwindow.onVBIpInfo = function(info) {\n  var line = document.getElementById('ip-status-line');\n  if (!info || !info.ip || info.success === false) {\n    document.getElementById('ip-value').textContent = '\u2014';\n    document.getElementById('ip-loc').textContent = '';\n    line.textContent = 'N\u00e3o foi poss\u00edvel consultar agora';\n    return;\n  }\n  document.getElementById('ip-value').textContent = info.ip;\n  var country = info.country_name || info.country || '';\n  var loc = [info.city, info.region, country].filter(Boolean).join(', ');\n  document.getElementById('ip-loc').textContent = loc;\n  line.textContent = app.connected ? 'IP mascarado pelo t\u00fanel \u2713' : 'Esse \u00e9 o seu IP real (sem t\u00fanel)';\n};\n\n\n/* \u2500\u2500 PING \u2500\u2500 */\nfunction testPing() {\n  if (!B || !B.requestPing) return;\n  var target = currentTarget();\n  if (!target) { toast('Escolha um servidor primeiro'); return; }\n  var chip = document.getElementById('ping-chip');\n  chip.className = 'chip loading';\n  document.getElementById('ping-label').textContent = 'Testando...';\n  B.requestPing(target.host, target.port);\n}\nfunction currentTarget() {\n  try {\n    if (app.mode === 'XRAY') {\n      var x = bp(B.getSelectedXray(), {});\n      if (x.host && x.port) return { host: x.host, port: x.port };\n    } else {\n      var s = bp(B.getSelectedServer(), {});\n      if (s.host && s.port) return { host: s.host, port: s.port };\n    }\n  } catch(e) {}\n  return null;\n}\nwindow.onVBPingResult = function(result) {\n  var chip = document.getElementById('ping-chip');\n  var label = document.getElementById('ping-label');\n  if (result && result.ok) {\n    var ms = result.ms;\n    var quality = ms < 150 ? 'ok' : (ms < 400 ? '' : 'bad');\n    var bars = ms < 100 ? 4 : (ms < 200 ? 3 : (ms < 450 ? 2 : 1));\n    chip.className = 'chip ' + quality;\n    label.innerHTML = '<span class=\"signal-bars lit-' + bars + '\"><i></i><i></i><i></i><i></i></span><span class=\"chip-val\">' + ms + 'ms</span>';\n  } else {\n    chip.className = 'chip bad';\n    label.textContent = 'Falhou';\n  }\n};\n\n\n/* \u2500\u2500 TESTE DE VELOCIDADE REAL \u2500\u2500 */\nfunction runSpeedTest() {\n  if (!B || !B.requestSpeedTest) return;\n  var chip = document.getElementById('speedtest-chip');\n  chip.className = 'chip loading';\n  document.getElementById('speedtest-label').textContent = 'Medindo...';\n  document.getElementById('speedtest-panel').classList.add('show');\n  document.getElementById('gauge-needle').style.transform = 'rotate(-90deg)';\n  document.getElementById('gauge-val').textContent = '...';\n  B.requestSpeedTest();\n}\nfunction closeSpeedTest() {\n  document.getElementById('speedtest-panel').classList.remove('show');\n}\nwindow.onVBSpeedTestResult = function(result) {\n  var chip = document.getElementById('speedtest-chip');\n  var label = document.getElementById('speedtest-label');\n  if (result && result.ok) {\n    var mbps = result.mbps;\n    chip.className = 'chip ' + (mbps > 15 ? 'ok' : (mbps > 4 ? '' : 'bad'));\n    label.innerHTML = '<span class=\"chip-val\">' + mbps.toFixed(1) + '</span> Mbps';\n    document.getElementById('gauge-val').textContent = mbps.toFixed(1);\n    var pct = Math.min(mbps / 60, 1);\n    var deg = -90 + (pct * 180);\n    document.getElementById('gauge-needle').style.transform = 'rotate(' + deg + 'deg)';\n  } else {\n    chip.className = 'chip bad';\n    label.textContent = 'Falhou';\n    document.getElementById('gauge-val').textContent = '--';\n  }\n};\n\n\n/* \u2500\u2500 FAVORITOS \u2500\u2500 */\nfunction refreshFavorites() {\n  if (!B || !B.getFavorites) return;\n  app.favorites = bp(B.getFavorites(), []);\n}\nfunction isFavorite(id) { return app.favorites.indexOf(id) !== -1; }\nfunction toggleFavoriteItem(id, evt) {\n  if (evt) evt.stopPropagation();\n  if (!B || !B.toggleFavorite) return;\n  B.toggleFavorite(id);\n  refreshFavorites();\n  if (currentOpenSheet) openSheet(currentOpenSheet);\n}\n\n\n/* \u2500\u2500 STATUS \u2500\u2500 */\nfunction pollStatus() {\n  if (!B) return;\n  try {\n    var st = bp(B.getStatus(), {});\n    var connected = !!st.connected;\n    var connecting = !!st.connecting;\n    if (connected !== app.connected) {\n      app.connected = connected;\n      applyConnected(connected, st.mode || app.mode, st.connectedAt);\n    }\n    if (!connected && !connecting && document.body.classList.contains('connecting')) {\n      var graceMs = 6000;\n      if (app.connectingSince && (Date.now() - app.connectingSince) > graceMs) {\n        applyConnected(false, st.mode || app.mode, 0);\n      }\n    }\n  } catch(e) {}\n}\n\nfunction applyConnected(on, mode, connectedAt) {\n  document.body.classList.toggle('connected', on);\n  document.body.classList.remove('connecting');\n  var label = document.getElementById('orb-label');\n  var sub = document.getElementById('orb-sub');\n  var btn = document.getElementById('connect-btn');\n  var timer = document.getElementById('timer');\n  var speed = document.getElementById('speed-row');\n\n  if (on) {\n    label.textContent = 'CONECTADO';\n    sub.textContent = (mode || app.mode) + ' ativo';\n    btn.textContent = 'Desconectar';\n    timer.classList.add('show');\n    speed.style.display = 'grid';\n    app.connectTime = (connectedAt && connectedAt > 0) ? connectedAt : Date.now();\n    updateTimer();\n    if (app.timerInt) clearInterval(app.timerInt);\n    app.timerInt = setInterval(updateTimer, 1000);\n    setTimeout(refreshIpInfo, 1200);\n  } else {\n    label.textContent = 'DESCONECTADO';\n    sub.textContent = 'Toque para conectar';\n    btn.textContent = 'Conectar ' + app.mode;\n    timer.classList.remove('show');\n    speed.style.display = 'none';\n    document.getElementById('speed-dl').textContent = '0 B/s';\n    document.getElementById('speed-ul').textContent = '0 B/s';\n    if (app.timerInt) clearInterval(app.timerInt);\n    refreshIpInfo();\n  }\n  forceRepaint(document.getElementById('main-body'));\n}\n\nfunction updateTimer() {\n  var s = Math.floor((Date.now() - app.connectTime) / 1000);\n  var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;\n  document.getElementById('timer-val').textContent = pad(h) + ':' + pad(m) + ':' + pad(sec);\n}\nfunction pad(n) { return n < 10 ? '0' + n : '' + n; }\n\nfunction doConnect() {\n  if (!B) { toast('Bridge n\u00e3o dispon\u00edvel'); return; }\n  if (app.mode === 'SSH') {\n    var srv = bp(B.getSelectedServer(), {});\n    var userVal = (document.getElementById('cred-user').value || '').trim();\n    var passVal = (document.getElementById('cred-pass').value || '').trim();\n    if (srv.name && !srv.hasCredentials && !userVal && !passVal) {\n      showCredModal(); toast('Preenche usu\u00e1rio e senha pra conectar'); return;\n    }\n  } else if (app.mode === 'XRAY') {\n    var xr = bp(B.getSelectedXray(), {});\n    var uuidVal = (document.getElementById('xray-uuid-input').value || '').trim();\n    if (xr.name && xr.uuidRequired && !xr.hasUuid && !uuidVal) {\n      showUuidModal(); toast('Cole o UUID pra conectar'); return;\n    }\n  }\n  document.body.classList.add('connecting');\n  app.connectingSince = Date.now();\n  document.getElementById('orb-label').textContent = 'CONECTANDO...';\n  document.getElementById('orb-sub').textContent = 'Aguarde...';\n  document.getElementById('connect-btn').textContent = 'Aguarde...';\n  if (B.consumeLastError) B.consumeLastError();\n  if (app.mode === 'XRAY') saveUuidField();\n  B.connect();\n  watchForConnectError();\n}\n\nfunction watchForConnectError() {\n  var checks = 0;\n  var maxChecks = 65;\n  var interval = setInterval(function() {\n    checks++;\n    if (!B || !B.consumeLastError) { clearInterval(interval); return; }\n    var err = B.consumeLastError();\n    if (err === 'AUTH_FAILED' || err === 'XRAY_NO_TRAFFIC') {\n      clearInterval(interval);\n      document.body.classList.remove('connecting');\n      document.getElementById('orb-label').textContent = 'DESCONECTADO';\n      document.getElementById('orb-sub').textContent = 'Toque para conectar';\n      document.getElementById('connect-btn').textContent = 'Conectar ' + app.mode;\n      showAuthErrorModal(err);\n    } else if (checks >= maxChecks) {\n      clearInterval(interval);\n    }\n  }, 300);\n}\n\nfunction showAuthErrorModal(errType) {\n  var title = document.getElementById('autherror-title');\n  var sub = document.getElementById('autherror-sub');\n  if (errType === 'XRAY_NO_TRAFFIC') {\n    title.textContent = 'Conex\u00e3o n\u00e3o confirmada';\n    sub.textContent = 'O t\u00fanel abriu mas nenhum dado passou por ele - pode ser o UUID errado ou o servidor fora do ar. Confira e tente de novo.';\n  } else {\n    title.textContent = 'Usu\u00e1rio ou senha incorretos';\n    sub.textContent = 'N\u00e3o foi poss\u00edvel autenticar nesse servidor com as credenciais informadas. Confira e tente de novo.';\n  }\n  document.getElementById('autherror-modal').classList.add('show');\n}\nfunction closeAuthErrorModal() {\n  document.getElementById('autherror-modal').classList.remove('show');\n}\nfunction fixCredsAfterAuthError() {\n  closeAuthErrorModal();\n  if (app.mode === 'XRAY') showUuidModal();\n  else showCredModal();\n}\n\nfunction doUpdate() {\n  if (!B) { toast('Bridge n\u00e3o dispon\u00edvel'); return; }\n  var icon = document.getElementById('refresh-btn');\n  icon.classList.add('spinning');\n  toast('Atualizando configura\u00e7\u00e3o...');\n  B.updateConfig();\n  setTimeout(function() { init(); icon.classList.remove('spinning'); toast('Configura\u00e7\u00e3o atualizada!'); }, 3000);\n}\n\nfunction setMode(m, silent) {\n  app.mode = m;\n  document.getElementById('mode-ssh').classList.toggle('active', m === 'SSH');\n  document.getElementById('mode-xray').classList.toggle('active', m === 'XRAY');\n  document.getElementById('card-ssh').style.display = m === 'SSH' ? '' : 'none';\n  document.getElementById('card-payload').style.display = m === 'SSH' ? '' : 'none';\n  document.getElementById('card-xray').style.display = m === 'XRAY' ? '' : 'none';\n  document.getElementById('connect-btn').textContent = (app.connected ? 'Desconectar' : 'Conectar ' + m);\n  if (!silent && B) B.setMode(m);\n  updateCredCard();\n  updateUuidCard();\n  resetPingChip();\n  forceRepaint(document.getElementById('main-body'));\n}\nfunction resetPingChip() {\n  var chip = document.getElementById('ping-chip');\n  if (!chip) return;\n  chip.className = 'chip';\n  document.getElementById('ping-label').textContent = 'Lat\u00eancia';\n}\n\n\n/* \u2500\u2500 CREDENCIAL SSH (modal) \u2500\u2500 */\nfunction setupCredModal() {\n  var userInput = document.getElementById('cred-user');\n  var passInput = document.getElementById('cred-pass');\n  userInput.addEventListener('input', function () {\n    var clean = userInput.value.replace(/\\s/g, '');\n    if (clean !== userInput.value) userInput.value = clean;\n    saveCredField();\n  });\n  passInput.addEventListener('input', saveCredField);\n  userInput.addEventListener('blur', saveCredField);\n  passInput.addEventListener('blur', saveCredField);\n  document.getElementById('cred-pass-toggle').addEventListener('click', function () {\n    var showing = passInput.type === 'text';\n    passInput.type = showing ? 'password' : 'text';\n    this.textContent = showing ? '\ud83d\udc41\ufe0f' : '\ud83d\ude48';\n  });\n  var saved = bp(B && B.getManualCredentials ? B.getManualCredentials() : '{}', {});\n  if (saved.username) userInput.value = saved.username;\n  if (saved.password) passInput.value = saved.password;\n}\nfunction showCredModal() { document.getElementById('cred-modal').classList.add('show'); }\nfunction closeCredModal() { document.getElementById('cred-modal').classList.remove('show'); }\nfunction updateCredCard() {\n  if (!B) return;\n  var srv = bp(B.getSelectedServer(), {});\n  var needsCred = app.mode === 'SSH' && srv.name && !srv.hasCredentials;\n  setCredBadge(needsCred);\n  setItemIcon('ssh-icon', 'ssh-flag', 'ssh-emoji', srv, '\ud83d\udda5\ufe0f');\n}\nfunction promptCredIfNeeded(srv) {\n  var needsCred = app.mode === 'SSH' && srv && srv.name && !srv.hasCredentials;\n  if (needsCred) setTimeout(showCredModal, 250);\n}\nfunction setCredBadge(show) {\n  var icon = document.querySelector('#card-ssh .server-icon');\n  if (!icon) return;\n  var badge = document.getElementById('cred-needed-badge');\n  if (show) {\n    if (!badge) {\n      badge = document.createElement('span');\n      badge.id = 'cred-needed-badge';\n      badge.textContent = '\ud83d\udd10';\n      badge.title = 'Login necess\u00e1rio';\n      badge.style.cssText = 'position:absolute; top:-7px; right:-7px; font-size:13px; background:var(--bg); border-radius:50%; line-height:1;';\n      badge.onclick = function (e) { e.stopPropagation(); showCredModal(); };\n      icon.appendChild(badge);\n    }\n  } else if (badge) {\n    badge.remove();\n  }\n}\nfunction saveCredField() {\n  if (B && B.setManualCredentials) B.setManualCredentials(document.getElementById('cred-user').value.trim(), document.getElementById('cred-pass').value.trim());\n}\n\n\n/* \u2500\u2500 CREDENCIAL XRAY (UUID, modal) \u2500\u2500 */\nfunction setupUuidModal() {\n  var uuidInput = document.getElementById('xray-uuid-input');\n  uuidInput.addEventListener('input', saveUuidField);\n  uuidInput.addEventListener('blur', saveUuidField);\n  uuidInput.value = (B && B.getUuid) ? B.getUuid() : '';\n}\nfunction saveUuidField() {\n  if (B && B.setUuid) B.setUuid(document.getElementById('xray-uuid-input').value.trim().toLowerCase());\n}\nfunction showUuidModal() { document.getElementById('uuid-modal').classList.add('show'); }\nfunction closeUuidModal() { document.getElementById('uuid-modal').classList.remove('show'); }\nfunction updateUuidCard() {\n  if (!B) return;\n  var xr = bp(B.getSelectedXray(), {});\n  var needsUuid = app.mode === 'XRAY' && xr.name && xr.uuidRequired && !xr.hasUuid;\n  setUuidBadge(needsUuid);\n  setItemIcon('xray-icon', 'xray-flag', 'xray-emoji', xr, '\u26a1');\n}\nfunction promptUuidIfNeeded(xr) {\n  var needsUuid = app.mode === 'XRAY' && xr && xr.name && xr.uuidRequired && !xr.hasUuid;\n  if (needsUuid) setTimeout(showUuidModal, 250);\n}\nfunction setUuidBadge(show) {\n  var icon = document.querySelector('#card-xray .server-icon');\n  if (!icon) return;\n  var badge = document.getElementById('uuid-needed-badge');\n  if (show) {\n    if (!badge) {\n      badge = document.createElement('span');\n      badge.id = 'uuid-needed-badge';\n      badge.textContent = '\ud83d\udd11';\n      badge.title = 'Ativa\u00e7\u00e3o necess\u00e1ria';\n      badge.style.cssText = 'position:absolute; top:-7px; righ