{"version": "15", "HtmlUI": "@<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<title>VB INJECTOR</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Space+Grotesk:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n:root {\n  --bg: #0a0913;\n  --bg2: #0e0d1a;\n  --panel: #14121f;\n  --panel-border: rgba(255,255,255,.06);\n  --panel-border-strong: rgba(255,255,255,.1);\n  --accent: #8b6bff;\n  --accent2: #4fd1ff;\n  --green: #34d399;\n  --yellow: #fbbf24;\n  --red: #fb7185;\n  --text: #f3f1fb;\n  --muted: #55516e;\n  --muted2: #918caf;\n  --mono: 'JetBrains Mono', monospace;\n  --sans: 'Space Grotesk', sans-serif;\n  --display: 'Baloo 2', var(--sans);\n}\n* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\nhtml, body { height: 100%; background: var(--bg); overflow: hidden; }\nbody { font-family: var(--sans); color: var(--text); }\n\n\n/* ── FUNDO: LISO, SEM GRADE/SCANLINE — só um glow bem sutil ── */\n.mesh-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: var(--bg); }\n.mesh-bg::before {\n  content: ''; position: absolute; inset: 0; pointer-events: none;\n  background: radial-gradient(ellipse 60% 40% at 82% 8%, rgba(139,107,255,.16), transparent 60%),\n              radial-gradient(ellipse 55% 45% at 8% 95%, rgba(79,209,255,.09), transparent 60%);\n}\n.scanline { display: none; }\n.blob { position: absolute; border-radius: 50%; filter: blur(110px); will-change: transform; opacity: .22; }\n.blob1 { width: 280px; height: 280px; background: var(--accent); top: -90px; left: -80px; animation: drift1 24s ease-in-out infinite; }\n.blob2 { width: 260px; height: 260px; background: var(--accent2); bottom: -100px; right: -90px; opacity: .16; animation: drift2 28s ease-in-out infinite; }\n.blob3 { display: none; }\nbody.connected .blob2 { background: var(--green); opacity: .18; }\n@keyframes drift1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(24px,30px); } }\n@keyframes drift2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-26px,20px); } }\n\n.shell { position: relative; z-index: 1; width: 100%; max-width: 480px; margin: 0 auto; height: 100vh; display: flex; flex-direction: column; padding-top: var(--vb-inset-top, env(safe-area-inset-top)); padding-bottom: var(--vb-inset-bottom, env(safe-area-inset-bottom)); }\n\n\n/* ── PAINEL BASE: card sólido, discreto, sem blur ── */\n.panel {\n  background: var(--panel);\n  border: 1px solid var(--panel-border);\n  border-radius: 20px;\n  position: relative;\n}\n\n\n/* ── HEADER ── */\n.header { margin: 14px 14px 6px; padding: 0; display: flex; align-items: center; justify-content: space-between; gap: 10px; background: none; border: none; }\n.header-icon { width: 82px; height: 82px; flex: 0 0 82px; border-radius: 17px; background: none; display: grid; place-items: center; overflow: hidden; }\n.header-icon svg { width: 22px; height: 22px; color: #fff; }\n.header-left { min-width: 0; flex: 1; display: flex; align-items: center; gap: 11px; }\n.header-brand { font-size: 19px; font-weight: 700; font-family: var(--display); color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: .01em; }\n.header-meta { display: flex; align-items: center; gap: 6px; margin-top: 2px; flex-wrap: wrap; }\n.header-ver { font-size: 9px; color: var(--muted2); font-family: var(--mono); letter-spacing: .02em; }\n.net-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 9px; font-weight: 700; font-family: var(--mono); letter-spacing: .03em; color: var(--muted2); padding: 2px 7px; background: rgba(255,255,255,.04); border: 1px solid var(--panel-border); border-radius: 999px; }\n.net-badge .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--muted); }\n.net-badge.online .dot { background: var(--green); box-shadow: 0 0 6px rgba(52,211,153,.9); }\n.header-right { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }\n.btn-icon { width: 34px; height: 34px; background: var(--panel); border: 1px solid var(--panel-border); border-radius: 50%; display: grid; place-items: center; cursor: pointer; transition: all .2s; }\n.btn-icon:active { opacity: .6; transform: scale(.92); }\n.btn-icon svg { width: 15px; height: 15px; color: var(--muted2); }\n.btn-icon.spinning svg { animation: spin-slow 1s linear infinite; }\n\n\n/* ── BODY ── */\n.body { flex: 0 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 4px 10px 6px; display: flex; flex-direction: column; gap: 8px; -webkit-overflow-scrolling: touch; }\n\n\n/* ── AVISO ── */\n.notice-card { display: none; padding: 15px 16px; gap: 13px; align-items: flex-start; background: var(--panel); border-color: var(--panel-border); border-left: 3px solid var(--yellow); }\n.notice-card.show { display: flex; }\n.notice-icon { font-size: 24px; line-height: 1; }\n.notice-content { flex: 1; min-width: 0; }\n.notice-title { color: var(--text); font-weight: 800; font-size: 11px; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 5px; font-family: var(--mono); }\n.notice-msg { font-size: 12.5px; line-height: 1.5; color: var(--text); opacity: .9; }\n\n\n/* ── PAINEL DE IP (terminal) ── */\n.ip-panel { padding: 14px 16px; font-family: var(--mono); }\n.ip-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }\n.ip-panel-title { font-size: 9.5px; font-weight: 800; color: var(--muted2); letter-spacing: .14em; text-transform: uppercase; display: flex; align-items: center; gap: 6px; }\n.ip-panel-title .led { width: 6px; height: 6px; border-radius: 50%; background: var(--red); }\nbody.connected .ip-panel-title .led { background: var(--green); box-shadow: 0 0 6px rgba(57,255,136,.9); }\n.ip-refresh-btn { font-size: 9px; color: var(--text); cursor: pointer; letter-spacing: .06em; opacity: .8; }\n.ip-row { display: flex; align-items: baseline; gap: 8px; }\n.ip-value { font-size: 19px; font-weight: 700; color: var(--text); letter-spacing: .01em; transition: color .3s; }\nbody.connected .ip-value { color: var(--green); }\n.ip-loc { font-size: 11px; color: var(--muted2); }\n.ip-status-line { font-size: 9.5px; color: var(--muted); margin-top: 4px; letter-spacing: .04em; }\nbody.connected .ip-status-line { color: var(--green); }\n\n\n/* ── HERO DE CONEXÃO (compacto: sem círculo, status em texto no centro) ──\n   O círculo foi removido de propósito: já existe o botão grande\n   \"Conectar/Desconectar\" lá embaixo (#connect-btn) que faz exatamente a\n   mesma função, então o círculo era um controle duplicado e só ocupava\n   espaço. */\n.hero { padding: 22px 20px 18px; display: flex; flex-direction: column; align-items: center; position: relative; overflow: hidden; }\n\n.hero-icon { position: absolute; top: 14px; right: 16px; width: 46px; height: 46px; display: grid; place-items: center; opacity: .85; }\n.hero-icon svg { width: 40px; height: 40px; color: var(--muted); filter: drop-shadow(0 0 10px rgba(255,255,255,.05)); transition: all .4s; }\nbody.connected .hero-icon svg { color: var(--green); filter: drop-shadow(0 0 14px rgba(52,211,153,.55)); }\nbody.connecting .hero-icon svg { color: var(--yellow); filter: drop-shadow(0 0 14px rgba(251,191,36,.5)); }\n\n.hero-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; }\n.hero-speed { flex: 0 0 auto; width: 84px; display: flex; flex-direction: column; align-items: center; gap: 3px; min-width: 0; opacity: .4; transition: opacity .3s; }\nbody.connected .hero-speed { opacity: 1; }\n.hero-speed-label { font-size: 8.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted2); font-family: var(--mono); white-space: nowrap; }\n/* Download e upload ficam neutros de propósito - só o status central usa\n   cor de destaque, pra não competir visualmente. */\n.hero-speed-val { font-size: 13px; font-weight: 700; color: var(--muted2); font-family: var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; transition: color .3s; }\nbody.connected .hero-speed-val { color: var(--text); }\n\n.hero-status { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding-right: 30px; }\n.radar-label { font-size: 22px; font-weight: 700; font-family: var(--display); color: var(--text); transition: color .3s; }\nbody.connected .radar-label { color: var(--green); }\nbody.connecting .radar-label { color: var(--yellow); }\n.radar-sub { margin-top: 4px; font-size: 12px; color: var(--muted2); text-align: center; min-height: 14px; }\n\n/* Sempre visível (com placeholder \"--:--:--\" enquanto desconectado) pra\n   não mudar a altura do card ao conectar. */\n.timer { display: flex; align-items: baseline; gap: 7px; margin-top: 12px; background: rgba(255,255,255,.03); border: 1px solid var(--panel-border); padding: 6px 14px; border-radius: 100px; opacity: .55; transition: all .3s; }\nbody.connected .timer { background: rgba(52,211,153,.09); border-color: rgba(52,211,153,.25); opacity: 1; }\nbody.connected .action-chips { margin-top: 12px; }\n.timer-val { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--muted2); letter-spacing: .04em; transition: color .3s; }\nbody.connected .timer-val { color: var(--green); }\n.timer-label { font-size: 9px; color: var(--muted2); text-transform: uppercase; letter-spacing: .08em; }\n\n\n/* ── CHIPS DE AÇÃO (ping + velocidade) ── */\n.action-chips { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; justify-content: center; }\n.chip { display: inline-flex; align-items: center; gap: 7px; background: rgba(255,255,255,.03); border: 1px solid var(--panel-border); padding: 7px 13px; font-size: 10.5px; font-family: var(--mono); color: var(--muted2); cursor: pointer; transition: all .2s; border-radius: 999px; }\n.chip:active { opacity: .7; transform: scale(.97); }\n.chip .chip-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); flex: 0 0 6px; }\n.chip.ok .chip-dot { background: var(--green); box-shadow: 0 0 6px rgba(57,255,136,.8); }\n.chip.bad .chip-dot { background: var(--red); }\n.chip.loading .chip-dot { background: var(--yellow); animation: blink 1s ease-in-out infinite; }\n@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: .3; } }\n.chip .chip-val { color: var(--text); font-weight: 700; }\n.signal-bars { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; }\n.signal-bars i { display: block; width: 3px; border-radius: 1px; background: var(--muted); }\n.signal-bars i:nth-child(1) { height: 4px; } .signal-bars i:nth-child(2) { height: 7px; } .signal-bars i:nth-child(3) { height: 10px; } .signal-bars i:nth-child(4) { height: 13px; }\n.signal-bars.lit-1 i:nth-child(1) { background: var(--red); }\n.signal-bars.lit-2 i:nth-child(1), .signal-bars.lit-2 i:nth-child(2) { background: var(--yellow); }\n.signal-bars.lit-3 i:nth-child(1), .signal-bars.lit-3 i:nth-child(2), .signal-bars.lit-3 i:nth-child(3) { background: #a3e635; }\n.signal-bars.lit-4 i { background: var(--green); }\n\n\n/* ── GAUGE DE VELOCIDADE ── */\n.speedtest-panel { padding: 16px; display: none; flex-direction: column; align-items: center; }\n.speedtest-panel.show { display: flex; }\n.gauge-wrap { position: relative; width: 150px; height: 84px; }\n.gauge-bg, .gauge-fill { position: absolute; top: 0; left: 0; width: 150px; height: 75px; border-radius: 150px 150px 0 0; }\n.gauge-bg { background: conic-gradient(from 270deg at 50% 100%, var(--accent) 0deg, var(--accent2) 90deg, var(--green) 180deg); clip-path: polygon(0 100%, 0 30%, 4% 16%, 10% 8%, 50% 0%, 90% 8%, 96% 16%, 100% 30%, 100% 100%, 88% 100%, 88% 35%, 50% 14%, 12% 35%, 12% 100%); opacity: .3; }\n.gauge-needle { position: absolute; left: 50%; bottom: 0; width: 2px; height: 64px; background: var(--accent); transform-origin: bottom center; transform: rotate(-90deg); transition: transform .6s cubic-bezier(.34,1.56,.64,1); box-shadow: 0 0 8px rgba(169,112,255,.7); }\n.gauge-needle::after { content: ''; position: absolute; bottom: -5px; left: -4px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }\n.gauge-val { margin-top: 8px; font-family: var(--mono); font-size: 24px; font-weight: 800; color: var(--accent); }\n.gauge-unit { font-size: 11px; color: var(--muted2); letter-spacing: .08em; text-transform: uppercase; }\n.gauge-close { margin-top: 10px; font-size: 10px; color: var(--muted2); cursor: pointer; letter-spacing: .06em; text-transform: uppercase; }\n\n\n\n\n\n/* ── CARDS ── */\n.mode-row { display: flex; gap: 4px; padding: 5px; background: rgba(0,0,0,.18); border-radius: 14px; margin: 6px; }\n.mode-btn { flex: 1; padding: 10px 8px; border: none; font-size: 12px; font-weight: 700; letter-spacing: .04em; color: var(--muted2); background: transparent; cursor: pointer; transition: all .25s; font-family: var(--sans); border-radius: 10px; }\n.mode-btn.active { background: linear-gradient(115deg, var(--accent), var(--accent2)); color: #14102b; font-weight: 800; box-shadow: 0 4px 14px -4px rgba(139,107,255,.5); }\n.mode-btn:active { opacity: .8; }\n\n.server-card { padding: 14px 16px 16px; display: flex; align-items: center; gap: 13px; cursor: pointer; transition: background .2s; }\n.server-card:active { background: rgba(255,255,255,.02); }\n.server-icon { width: 42px; height: 42px; background: rgba(169,112,255,.07); border: 1px solid var(--panel-border); display: grid; place-items: center; font-size: 19px; flex: 0 0 42px; position: relative; border-radius: 12px; }\n.server-icon .flag { display: block; width: 32px; height: 24px; object-fit: cover; border-radius: 2px; border: 1px solid rgba(255,255,255,.08); background: rgba(0,0,0,.2); }\n.server-meta { flex: 1; min-width: 0; }\n.server-label { font-size: 9px; font-weight: 800; color: var(--text); letter-spacing: .14em; text-transform: uppercase; font-family: var(--mono); }\n.server-name { font-size: 15px; font-weight: 700; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.server-sub { font-size: 10.5px; color: var(--muted2); margin-top: 2px; text-transform: uppercase; letter-spacing: .06em; }\n.server-chev { color: var(--muted); font-size: 18px; flex: 0 0 auto; }\n\n.cred-label { font-size: 10.5px; font-weight: 700; color: var(--muted2); text-transform: uppercase; letter-spacing: .07em; margin: 10px 0 6px; }\n.cred-label:first-child { margin-top: 0; }\n.cred-input { width: 100%; background: rgba(0,0,0,.22); border: 1px solid var(--panel-border); padding: 13px 15px; color: var(--text); font-size: 13.5px; outline: none; font-family: var(--sans); border-radius: 14px; }\n.cred-input::placeholder { color: var(--muted); }\n\n.msg-card { padding: 12px 16px; display: flex; align-items: flex-start; gap: 10px; }\n.msg-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: 0 0 6px; margin-top: 5px; }\n.msg-text { font-size: 12px; color: var(--muted2); line-height: 1.5; }\n\n\n/* ── BOTÃO CONECTAR ── */\n.connect-btn { width: 100%; padding: 16px; border: none; background: linear-gradient(115deg, var(--accent), var(--accent2)); font-size: 15px; font-weight: 700; letter-spacing: .01em; color: #14102b; cursor: pointer; font-family: var(--sans); transition: all .2s; box-shadow: 0 10px 24px -8px rgba(139,107,255,.55); border-radius: 16px; }\n.connect-btn:active { transform: scale(.98); }\nbody.connected .connect-btn { background: linear-gradient(115deg, var(--green), #22b892); box-shadow: 0 10px 24px -8px rgba(52,211,153,.45); }\nbody.connecting .connect-btn { background: linear-gradient(115deg, var(--yellow), #f0a94e); box-shadow: 0 10px 24px -8px rgba(251,191,36,.45); }\n\n\n/* ── NAV ── */\n.bottom-nav { display: flex; margin: 4px 14px 12px; padding: 6px; gap: 2px; }\n.nav-btn { flex: 1; padding: 9px 6px; display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; border: none; background: none; transition: all .2s; border-radius: 13px; }\n.nav-btn:active { opacity: .6; }\n.nav-btn svg { width: 19px; height: 19px; color: var(--muted); transition: color .2s; }\n.nav-btn span { font-size: 9px; font-weight: 600; color: var(--muted); letter-spacing: .01em; transition: color .2s; }\n.nav-btn.active { background: rgba(139,107,255,.14); }\n.nav-btn.active svg, .nav-btn.active span { color: var(--accent2); }\n\n\n/* ── OVERLAY / MODAL ── */\n.overlay { position: fixed; inset: 0; z-index: 100; background: rgba(2,3,7,.78); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); display: none; align-items: center; padding: calc(20px + var(--vb-inset-top, 0px)) 20px calc(20px + var(--vb-inset-bottom, 0px)); }\n.overlay.show { display: flex; }\n.modal { width: 100%; max-width: 360px; margin: 0 auto; background: #070a12; border: 1px solid var(--panel-border-strong); max-height: 76vh; overflow-y: auto; box-shadow: 0 24px 70px rgba(0,0,0,.6); border-radius: 20px; }\n.modal-pad { padding: 22px 20px; }\n.modal-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(169,112,255,.1); border: 1px solid rgba(169,112,255,.3); color: var(--text); font-size: 10.5px; font-weight: 700; letter-spacing: .06em; padding: 6px 13px; margin-bottom: 15px; font-family: var(--mono); }\n.modal-title { font-size: 19px; font-weight: 800; margin-bottom: 7px; }\n.modal-sub { font-size: 12.5px; color: var(--muted2); margin-bottom: 18px; }\n.modal-btn { width: 100%; padding: 14px; border: none; font-size: 12.5px; font-weight: 800; cursor: pointer; margin-bottom: 9px; display: flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--sans); letter-spacing: .02em; border-radius: 10px; }\n.modal-btn:last-child { margin-bottom: 0; }\n.modal-btn:active { opacity: .85; }\n.modal-btn-minimize { background: rgba(255,255,255,.05); border: 1px solid var(--panel-border); color: var(--text); }\n.modal-btn-exit { background: linear-gradient(115deg, var(--red), #c4123f); color: #1a0408; }\n.modal-btn-cancel { background: linear-gradient(115deg, var(--accent2), #8a1440); color: #1a0510; }\n.modal-btn-save { background: linear-gradient(115deg, var(--accent), #a3102b); color: #1a0509; }\n\n/* ── SHEETS DE SELEÇÃO (servidor/payload/xray): página cheia, com\n   cabeçalho/abas/busca FIXOS e só a lista rolando dentro de um espaço\n   limitado - corrige o card que ficava \"esticando\" enorme na tela. ── */\n.sheet-page { position: fixed; inset: 0; z-index: 95; background: var(--bg); display: none; flex-direction: column; padding-top: var(--vb-inset-top, 0px); padding-bottom: var(--vb-inset-bottom, 0px); }\n.sheet-page.show { display: flex; }\n.sheet-page-header { padding: 16px 16px 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; border-bottom: 1px solid var(--panel-border); flex: 0 0 auto; }\n.sheet-page-title { display: flex; align-items: center; gap: 10px; min-width: 0; }\n.sheet-page-icon { font-size: 19px; flex: 0 0 auto; filter: drop-shadow(0 0 8px rgba(139,107,255,.4)); }\n.sheet-title-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }\n.sheet-title-text > span:first-child { font-size: 15px; font-weight: 800; color: var(--text); letter-spacing: .01em; font-family: var(--display); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.sheet-hint { color: var(--muted); font-size: 9px; letter-spacing: .04em; text-transform: none; font-family: var(--mono); }\n.sheet-close { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--panel-border); background: rgba(255,255,255,.05); color: var(--muted2); display: grid; place-items: center; cursor: pointer; flex: 0 0 30px; font-size: 13px; transition: all .15s; }\n.sheet-close:active { opacity: .6; transform: scale(.92); }\n\n
