color:var(--yellow);text-shadow:0 0 6px rgba(255,200,0,.4);}\r\n.cu-item-value.green{color:var(--green);}\r\n\r\n\/* Time card *\/\r\n.time-card{\r\n  display:none;border-radius:16px;padding:12px 16px;\r\n  background:var(--card);border:1px solid rgba(255,200,0,.25);\r\n}\r\n.time-card.show{display:block;}\r\n.time-card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}\r\n.time-card-title{font-family:'Orbitron',sans-serif;font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--yellow);}\r\n.time-remaining{font-family:'Orbitron',sans-serif;font-size:20px;font-weight:900;font-variant-numeric:tabular-nums;color:var(--yellow);}\r\n.time-bar-track{height:4px;background:rgba(255,255,255,.07);border-radius:999px;overflow:hidden;margin-bottom:12px;}\r\n.time-bar-fill{height:100%;background:linear-gradient(90deg,var(--yellow),#ff8800);border-radius:999px;transition:width .5s;}\r\n.watch-ad-btn{\r\n  width:100%;padding:11px;border-radius:12px;\r\n  background:rgba(255,200,0,.1);border:1px solid rgba(255,200,0,.3);\r\n  color:var(--yellow);font-size:12px;font-weight:900;cursor:pointer;\r\n  font-family:'Orbitron',sans-serif;letter-spacing:.06em;\r\n  transition:opacity .15s;\r\n}\r\n.watch-ad-btn:active{opacity:.75;}\r\n.watch-ad-btn:disabled{opacity:.35;cursor:not-allowed;}\r\n\r\n\/* Message card *\/\r\n.message-card{\r\n  display:none;align-items:center;gap:12px;\r\n  padding:12px 14px;border-radius:14px;\r\n  background:var(--card);border:1px solid rgba(255,200,0,.25);\r\n}\r\n.message-card.show{display:flex;}\r\n.msg-icon{font-size:18px;}\r\n.msg-title{font-size:9px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--yellow);}\r\n.msg-text{font-size:12px;color:rgba(255,255,255,.85);margin-top:2px;}\r\n\r\n\/* Creds block *\/\r\n.creds-block{\r\n  background:var(--card);border-radius:16px;\r\n  padding:10px 12px;border:1px solid var(--border);\r\n  display:flex;flex-direction:column;gap:8px;cursor:pointer;\r\n}\r\n.creds-field{\r\n  display:flex;align-items:center;gap:10px;\r\n  background:var(--card2);border-radius:10px;\r\n  padding:10px 13px;border:1px solid rgba(130,0,255,.25);\r\n  pointer-events:none;\r\n}\r\n.creds-field-icon{font-size:15px;flex:0 0 auto;}\r\n.creds-field input{\r\n  flex:1;background:none;border:none;outline:none;\r\n  color:var(--muted);font-size:13px;font-weight:600;\r\n  font-family:'Exo 2',sans-serif;\r\n}\r\n.creds-field input::placeholder{color:var(--muted);}\r\n\r\n\/* Action row *\/\r\n.action-row{\r\n  display:grid;grid-template-columns:repeat(3,1fr);gap:8px;\r\n  padding:0 0 4px;\r\n}\r\n.action-pill{\r\n  background:var(--card);border:1px solid var(--border);\r\n  border-radius:14px;padding:13px 6px;\r\n  display:flex;flex-direction:column;align-items:center;gap:6px;\r\n  color:var(--muted);font-size:9px;font-weight:800;\r\n  text-transform:uppercase;letter-spacing:.06em;\r\n  cursor:pointer;transition:opacity .15s,border-color .2s;\r\n}\r\n.action-pill:active{opacity:.7;}\r\n.action-pill:hover{border-color:var(--purple);}\r\n.action-pill .ap-icon{font-size:20px;color:var(--text);}\r\n\r\n\/* Version row *\/\r\n.version-row{\r\n  text-align:center;color:var(--muted);\r\n  font-size:10px;font-weight:700;\r\n  padding:4px 0 2px;\r\n  font-family:'Orbitron',sans-serif;letter-spacing:.08em;\r\n}\r\n\r\n\/* Branding *\/\r\n.branding-wrap{\r\n  text-align:center;padding:6px 0 2px;\r\n  pointer-events:none;\r\n}\r\n.branding-text{\r\n  font-family:'Dancing Script',cursive;\r\n  font-size:26px;font-weight:700;\r\n  background:linear-gradient(135deg,#ffffff,#ddbbff,#ffaaee);\r\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\r\n  filter:drop-shadow(0 2px 8px rgba(150,0,255,.4));\r\n}\r\n\r\n\/* \u2500\u2500\u2500 PAGE HEADER \u2500\u2500\u2500 *\/\r\n.page-header{\r\n  padding:16px 16px 10px;\r\n  display:flex;align-items:center;gap:12px;\r\n  background:rgba(8,0,15,.6);\r\n  border-bottom:1px solid rgba(130,0,255,.2);\r\n}\r\n.page-title{\r\n  font-family:'Orbitron',sans-serif;\r\n  font-size:16px;font-weight:900;\r\n  color:var(--text);\r\n  text-shadow:0 0 10px rgba(150,0,255,.4);\r\n}\r\n\r\n\/* \u2500\u2500\u2500 SERVERS PAGE \u2500\u2500\u2500 *\/\r\n.server-list-wrap{padding:10px 14px;flex:1;overflow-y:auto;}\r\n\r\n.list-item{\r\n  display:flex;align-items:center;gap:12px;\r\n  padding:12px 14px;border-radius:16px;margin-bottom:8px;\r\n  background:var(--card);border:1px solid var(--border);\r\n  cursor:pointer;transition:opacity .15s,border-color .2s,background .2s;\r\n}\r\n.list-item:active{opacity:.75;}\r\n.list-item.selected{\r\n  border-color:rgba(0,200,60,.5);\r\n  background:rgba(0,200,60,.06);\r\n}\r\n.li-icon{\r\n  width:42px;height:42px;flex:0 0 42px;border-radius:13px;\r\n  display:grid;place-items:center;\r\n  background:rgba(130,0,255,.12);font-size:18px;overflow:hidden;\r\n}\r\n.li-icon img{width:100%;height:100%;object-fit:cover;}\r\n.li-main{min-width:0;flex:1;}\r\n.li-title{font-weight:800;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:'Orbitron',sans-serif;font-size:12px;}\r\n.li-sub{color:var(--muted);font-size:11px;margin-top:3px;font-weight:600;}\r\n.li-check{color:var(--green);display:none;font-size:18px;}\r\n.list-item.selected .li-check{display:block;}\r\n\r\n\/* \u2500\u2500\u2500 SPEED PAGE \u2500\u2500\u2500 *\/\r\n.speed-page-body{padding:10px 16px;flex:1;display:flex;flex-direction:column;gap:12px;}\r\n.speed-big-card{\r\n  background:var(--card);border-radius:20px;padding:20px;\r\n  border:1px solid var(--border);text-align:center;\r\n}\r\n.speed-big-label{font-family:'Orbitron',sans-serif;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);}\r\n.speed-big-val{font-family:'Orbitron',sans-serif;font-size:46px;font-weight:900;font-variant-numeric:tabular-nums;margin:8px 0 4px;}\r\n.speed-big-unit{font-size:13px;color:var(--muted);font-weight:700;}\r\n.speed-dl{color:var(--blue2);}\r\n.speed-ul{color:var(--green);}\r\n.speed-cards-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}\r\n\r\n\/* \u2500\u2500\u2500 TOOLS PAGE \u2500\u2500\u2500 *\/\r\n.tools-body{padding:10px 14px;flex:1;display:flex;flex-direction:column;gap:10px;}\r\n.tool-btn{\r\n  background:var(--card);border:1px solid var(--border);\r\n  border-radius:16px;padding:15px 16px;\r\n  display:flex;align-items:center;gap:13px;\r\n  cursor:pointer;transition:opacity .15s;width:100%;\r\n}\r\n.tool-btn:active{opacity:.75;}\r\n.tool-btn-icon{\r\n  font-size:22px;width:42px;height:42px;\r\n  display:grid;place-items:center;\r\n  background:rgba(130,0,255,.1);border-radius:13px;flex:0 0 42px;\r\n}\r\n.tool-btn-text{text-align:left;}\r\n.tool-btn-title{font-size:14px;font-weight:800;font-family:'Orbitron',sans-serif;font-size:12px;}\r\n.tool-btn-sub{font-size:11px;color:var(--muted);margin-top:3px;font-weight:600;}\r\n.tool-btn-chev{margin-left:auto;color:var(--muted);font-size:18px;}\r\n\r\n\/* \u2500\u2500\u2500 LOGS \u2500\u2500\u2500 *\/\r\n.logs-toolbar{\r\n  display:flex;gap:8px;justify-content:flex-end;\r\n  padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.06);\r\n  margin-bottom:10px;\r\n}\r\n.log-action-btn{\r\n  padding:5px 11px;border-radius:9px;font-size:10px;font-weight:900;\r\n  background:rgba(130,0,255,.1);border:1px solid rgba(130,0,255,.25);color:var(--text);\r\n  cursor:pointer;\r\n}\r\n.log-action-btn.danger{background:rgba(200,0,0,.1);border-color:rgba(200,0,0,.3);color:#ff4444;}\r\n#log-container{font-family:'Courier New',monospace;font-size:11px;line-height:1.65;}\r\n.log-entry{\r\n  display:flex;gap:8px;align-items:flex-start;\r\n  padding:4px 8px;border-radius:8px;margin-bottom:3px;\r\n  border-left:2px solid transparent;\r\n}\r\n.log-entry.INFO{background:rgba(130,0,255,.05);border-left-color:rgba(180,100,255,.4);}\r\n.log-entry.DEBUG{background:rgba(0,200,255,.04);border-left-color:rgba(0,200,255,.3);}\r\n.log-entry.WARNING{background:rgba(255,200,0,.06);border-left-color:var(--yellow);}\r\n.log-entry.ERROR{background:rgba(200,0,0,.07);border-left-color:var(--red);}\r\n.log-time{color:var(--muted);font-size:9px;white-space:nowrap;padding-top:1px;flex:0 0 auto;}\r\n.log-msg{color:var(--text);word-break:break-all;font-size:11px;}\r\n.log-entry.WARNING .log-msg{color:var(--yellow);}\r\n.log-entry.ERROR .log-msg{color:#ff4444;}\r\n.log-entry.DEBUG .log-msg{color:rgba(0,200,255,.9);}\r\n\r\n\/* \u2500\u2500\u2500 BOTTOM NAV \u2500\u2500\u2500 *\/\r\n.bottom-nav{\r\n  position:fixed;bottom:0;left:50%;transform:translateX(-50%);\r\n  width:min(100%,480px);\r\n  height:calc(var(--nav-h) + env(safe-area-inset-bottom));\r\n  padding-bottom:env(safe-area-inset-bottom);\r\n  background:rgba(8,0,18,.95);\r\n  border-top:1px solid rgba(130,0,255,.3);\r\n  display:grid;grid-template-columns:repeat(4,1fr);\r\n  z-index:50;\r\n  backdrop-filter:blur(12px);\r\n}\r\n.nav-btn{\r\n  display:flex;flex-direction:column;align-items:center;justify-content:center;\r\n  gap:4px;color:var(--muted);font-size:8px;font-weight:800;\r\n  text-transform:uppercase;letter-spacing:.07em;\r\n  transition:color .2s;position:relative;padding:0;\r\n  font-family:'Orbitron',sans-serif;\r\n}\r\n.nav-btn.active{color:var(--text);}\r\n.nav-btn.active::before{\r\n  content:'';position:absolute;top:0;left:20%;right:20%;height:2px;\r\n  background:linear-gradient(90deg,var(--purple),var(--pink));\r\n  border-radius:0 0 4px 4px;\r\n  box-shadow:0 0 8px rgba(200,0,200,.6);\r\n}\r\n.nav-btn svg{width:22px;height:22px;}\r\n\r\n\/* \u2500\u2500\u2500 MODALS \u2500\u2500\u2500 *\/\r\n.modal-mask{\r\n  position:fixed;inset:0;z-index:80;\r\n  display:flex;align-items:flex-end;justify-content:center;\r\n  padding:14px;background:rgba(0,0,0,.75);\r\n  opacity:0;pointer-events:none;transition:.22s;\r\n}\r\n.modal-mask.show{opacity:1;pointer-events:auto;}\r\n.modal-box{\r\n  display:none;flex-direction:column;\r\n  width:min(100%,460px);max-height:80vh;\r\n  border-radius:22px 22px 16px 16px;\r\n  background:#0e0020;border:1px solid rgba(130,0,255,.35);\r\n  overflow:hidden;\r\n  transform:translateY(24px);opacity:0;\r\n  transition:transform .22s,opacity .22s;\r\n}\r\n.modal-mask.show .modal-box.active{display:flex;transform:translateY(0);opacity:1;}\r\n.modal-head{\r\n  display:flex;align-items:center;justify-content:space-between;\r\n  padding:14px 16px 11px;border-bottom:1px solid rgba(130,0,255,.2);\r\n  flex:0 0 auto;\r\n}\r\n.modal-title{\r\n  font-family:'Orbitron',sans-serif;font-weight:900;font-size:14px;\r\n  text-shadow:0 0 10px rgba(150,0,255,.4);\r\n}\r\n.icon-btn{\r\n  width:38px;height:38px;border-radius:11px;\r\n  display:inline-flex;align-items:center;justify-content:center;\r\n  color:var(--text);background:rgba(130,0,255,.12);\r\n  font-size:18px;cursor:pointer;\r\n}\r\n.icon-btn:active{opacity:.75;}\r\n.modal-body{padding:12px 14px;overflow-y:auto;flex:1;}\r\n\r\n\/* Method modal *\/\r\n.method-modal-box{\r\n  background:#0e001a;\r\n  border-radius:22px 22px 18px 18px;\r\n  border:1px solid rgba(0,200,60,.2);overflow:hidden;\r\n}\r\n.method-modal-head{display:flex;align-items:center;justify-content:space-between;padding:18px 18px 12px;}\r\n.method-modal-title{font-family:'Orbitron',sans-serif;font-size:18px;font-weight:900;color:var(--text);text-shadow:0 0 10px rgba(0,255,60,.3);}\r\n.method-close-btn{color:var(--green);font-size:13px;font-weight:800;background:none;border:none;cursor:pointer;padding:4px 8px;font-family:'Orbitron',sans-serif;}\r\n.method-modal-sub{color:var(--muted);font-size:12px;padding:0 18px 14px;}\r\n.method-list{padding:0 12px 14px;display:flex;flex-direction:column;gap:9px;}\r\n.method-item{\r\n  border-radius:14px;padding:14px 16px;\r\n  background:rgba(130,0,255,.07);border:1px solid rgba(130,0,255,.2);\r\n  cursor:pointer;transition:opacity .15s;\r\n  display:flex;align-items:center;justify-content:space-between;\r\n}\r\n.method-item:active{opacity:.75;}\r\n.method-item.active-method{\r\n  background:linear-gradient(135deg,var(--green2),#1a8a1a);\r\n  border-color:transparent;\r\n  box-shadow:0 0 16px rgba(0,200,60,.3);\r\n}\r\n.method-item.active-method .mi-title,\r\n.method-item.active-method .mi-sub{color:#fff;}\r\n.method-item.active-method .mi-badge{display:block;}\r\n.mi-title{font-size:14px;font-weight:900;color:var(--text);font-family:'Orbitron',sans-serif;font-size:12px;}\r\n.mi-sub{font-size:11px;color:var(--muted);margin-top:3px;font-weight:600;}\r\n.mi-badge{display:none;font-size:11px;font-weight:900;color:#fff;background:rgba(0,0,0,.25);padding:3px 9px;border-radius:20px;}\r\n\r\n\/* Creds modal *\/\r\n.creds-modal-box{\r\n  background:#0c001a;\r\n  border-radius:22px 22px 18px 18px;\r\n  border:1px solid rgba(130,0,255,.25);overflow:hidden;\r\n}\r\n.creds-modal-head{\r\n  display:flex;align-items:center;justify-content:space-between;\r\n  padding:16px 16px 9px;border-bottom:1px solid rgba(130,0,255,.15);\r\n}\r\n.creds-modal-title{font-family:'Orbitron',sans-serif;font-size:15px;font-weight:900;}\r\n.creds-modal-sub{font-size:11px;color:var(--muted);padding:9px 16px 3px;}\r\n.creds-modal-body{padding:8px 16px 16px;overflow-y:auto;flex:1;}\r\n.creds-section-title{\r\n  font-family:'Orbitron',sans-serif;\r\n  font-size:10px;font-weight:900;color:var(--blue2);\r\n  text-transform:uppercase;letter-spacing:.1em;\r\n  margin:12px 0 7px;\r\n}\r\n.creds-input-wrap{\r\n  background:var(--card2);border-radius:12px;\r\n  border:1px solid rgba(130,0,255,.2);\r\n  display:flex;align-items:center;gap:10px;\r\n  padding:11px 13px;margin-bottom:7px;\r\n}\r\n.creds-input-wrap input{\r\n  flex:1;background:none;border:none;outline:none;\r\n  color:var(--text);font-size:13px;font-weight:600;font-family:'Exo 2',sans-serif;\r\n}\r\n.creds-input-wrap input::placeholder{color:var(--muted);}\r\n.ci-icon{color:var(--muted);font-size:15px;flex:0 0 auto;}\r\n.ci-eye{color:var(--muted);font