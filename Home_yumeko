-weight: 600; }\n.setting-item-sub { font-size: 11px; color: var(--muted2); margin-top: 2px; }\n.setting-item-chev { color: var(--muted); flex: 0 0 auto; }\n\n.switch { width: 44px; height: 26px; border-radius: 14px; background: var(--surface2); border: 1px solid var(--border); position: relative; flex: 0 0 auto; transition: background .2s; cursor: pointer; }\n.switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: var(--muted2); transition: all .2s; }\n.switch.on { background: rgba(72,187,120,.25); border-color: rgba(72,187,120,.4); }\n.switch.on::after { left: 22px; background: var(--green); }\n\n.palette-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10px; }\n.palette-item { display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; padding: 8px 4px; border-radius: 12px; border: 2px solid transparent; transition: border-color .15s, background .15s; }\n.palette-item.selected { border-color: var(--accent); background: var(--surface2); }\n.palette-circle { width: 44px; height: 44px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.15); position: relative; }\n.palette-circle .check { position: absolute; top: -4px; right: -4px; width: 16px; height: 16px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 10px; display: flex; align-items: center; justify-content: center; opacity: 0; }\n.palette-item.selected .check { opacity: 1; }\n.palette-label { font-size: 11px; font-weight: 600; color: var(--muted2); }\n.palette-item.selected .palette-label { color: var(--text); }\n\n.bg-color-row { display: flex; align-items: center; gap: 10px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }\n.bg-color-label { flex: 1; }\n#bg-color-input { width: 38px; height: 38px; border: none; border-radius: 50%; padding: 0; background: none; cursor: pointer; }\n#bg-color-input::-webkit-color-swatch-wrapper { padding: 0; border-radius: 50%; }\n#bg-color-input::-webkit-color-swatch { border-radius: 50%; border: 2px solid rgba(255,255,255,0.2); }\n.bg-color-reset { background: var(--surface2); border: 1px solid var(--border); color: var(--muted2); font-size: 11px; font-weight: 700; padding: 8px 12px; border-radius: 8px; cursor: pointer; }\n\n/* ── TOAST ── */\n.toast {\n  position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%) translateY(20px);\n  background: var(--surface2); border: 1px solid var(--border);\n  border-radius: 10px; padding: 10px 18px;\n  font-size: 12px; font-weight: 600; color: var(--text);\n  z-index: 200; opacity: 0; transition: all .25s;\n  white-space: nowrap; pointer-events: none; font-family: var(--mono);\n  max-width: 90vw; overflow: hidden; text-overflow: ellipsis;\n}\n.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n\n/* ── SPEED ── */\n.speed-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.speed-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }\n.speed-label { font-size: 9px; font-weight: 700; color: var(--muted2); text-transform: uppercase; letter-spacing: .15em; font-family: var(--mono); }\n.speed-val { font-size: 18px; font-weight: 700; margin-top: 4px; color: var(--accent); font-family: var(--mono); }\n\n/* ── MODAL DE SAÍDA ── */\n.exit-overlay { align-items: center; padding: 24px; }\n.exit-modal { width: 100%; max-width: 340px; background: linear-gradient(165deg, var(--surface2), var(--surface)); border: 1px solid var(--border); border-radius: 20px; padding: 24px 22px; box-shadow: 0 20px 60px rgba(0,0,0,.5); }\n.exit-modal-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(99,179,237,.12); border: 1px solid rgba(99,179,237,.3); color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .06em; padding: 6px 14px; border-radius: 20px; margin-bottom: 16px; }\n.exit-modal-title { font-size: 20px; font-weight: 700; margin-bottom: 8px; }\n.exit-modal-sub { font-size: 13px; color: var(--muted2); margin-bottom: 20px; }\n.exit-modal-btn { width: 100%; padding: 14px; border-radius: 12px; border: none; font-size: 13px; font-weight: 700; cursor: pointer; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--sans); letter-spacing: .02em; }\n.exit-modal-btn:last-child { margin-bottom: 0; }\n.exit-modal-btn:active { opacity: .85; }\n.exit-modal-btn-minimize { background: var(--surface2); border: 1px solid var(--border); color: var(--text); }\n.exit-modal-btn-exit { background: linear-gradient(135deg, #fc8181, #f56565); color: #2a0a0a; }\n.exit-modal-btn-cancel { background: linear-gradient(135deg, var(--accent2), var(--accent)); color: #06121f; }\n\n/* ── DIAGNÓSTICO ── */\n.diag-box {\n  background: #030507; border: 1px solid var(--border); border-radius: 10px;\n  padding: 12px 14px; font-family: var(--mono); font-size: 10.5px;\n  color: var(--muted2); line-height: 1.6; white-space: pre-wrap;\n  word-break: break-all; max-height: 220px; overflow-y: auto;\n}\n\n.fade-in { animation: fade-in .25s ease both; }\n</style>\n</head>\n<body>\n<div class=\"shell\">\n\n  <!-- HEADER -->\n  <header class=\"header\">\n    <div class=\"header-left\">\n      <div class=\"header-brand\" id=\"app-name\">VB INJECTOR</div>\n      <div class=\"header-meta\">\n        <span class=\"header-ver\" id=\"config-ver\">v--</span>\n        <span class=\"header-ver\" id=\"html-ver\">h--</span>\n        <span class=\"net-badge\" id=\"net-badge\"><span class=\"dot\"></span><span id=\"net-badge-text\">--</span></span>\n      </div>\n    </div>\n    <div class=\"header-right\">\n      <button class=\"btn-icon\" id=\"refresh-btn\" onclick=\"doUpdate()\" title=\"Atualizar\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      </button>\n    </div>\n  </header>\n\n  <!-- BODY -->\n  <div class=\"body\" id=\"main-body\">\n\n    <!-- AVISO -->\n    <div class=\"card notice-card\" id=\"notice-bar\">\n      <div class=\"notice-icon\">📣</div>\n      <div class=\"notice-content\">\n        <div class=\"notice-title\" id=\"notice-title\">Aviso</div>\n        <div class=\"notice-msg\" id=\"notice-msg\"></div>\n      </div>\n    </div>\n\n    <!-- ORB -->\n    <div class=\"orb-section\">\n      <div class=\"orb-wrap\">\n        <div class=\"orb-ring2\"></div>\n        <div class=\"orb-ring\"></div>\n        <div class=\"orb-btn\" onclick=\"doConnect()\" id=\"orb-btn\">\n          <div class=\"orb-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n              <path id=\"orb-svg-path\" d=\"M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v4m0 14v-4m10-6h-4M6 12H2m15.07-7.07l-2.83 2.83M8.76 15.24l-2.83 2.83m0-14.14l2.83 2.83M15.24 15.24l2.83 2.83\" stroke=\"rgba(99,179,237,.6)\"/>\n            </svg>\n          </div>\n        </div>\n      </div>\n      <div class=\"orb-label\" id=\"orb-label\">DESCONECTADO</div>\n      <div class=\"orb-sub\" id=\"orb-sub\">Toque para conectar</div>\n      <div class=\"timer\" id=\"timer\">\n        <span class=\"timer-label\">Tempo</span>\n        <span class=\"timer-val\" id=\"timer-val\">00:00:00</span>\n      </div>\n      <div class=\"ping-row\">\n        <div class=\"ping-chip\" id=\"ping-chip\" onclick=\"testPing()\">\n          <span class=\"ping-dot\"></span>\n          <span id=\"ping-label\">Testar conexão</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- SPEED -->\n    <div class=\"speed-row\" id=\"speed-row\" style=\"display:none\">\n      <div class=\"speed-card\">\n        <div class=\"speed-label\">↓ Download</div>\n        <div class=\"speed-val\" id=\"speed-dl\">0 B/s</div>\n      </div>\n      <div class=\"speed-card\">\n        <div class=\"speed-label\">↑ Upload</div>\n        <div class=\"speed-val\" id=\"speed-ul\">0 B/s</div>\n      </div>\n    </div>\n\n    <!-- MODO -->\n    <div class=\"card\">\n      <div class=\"mode-row\">\n        <button class=\"mode-btn\" id=\"mode-ssh\" onclick=\"setMode('SSH')\">SSH</button>\n        <button class=\"mode-btn\" id=\"mode-xray\" onclick=\"setMode('XRAY')\">XRAY</button>\n      </div>\n    </div>\n\n    <!-- SERVER CARD SSH -->\n    <div class=\"card\" id=\"card-ssh\" onclick=\"openSheet('ssh')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\">🖥️<span class=\"fav-star\" id=\"ssh-fav\" style=\"display:none;position:absolute;top:-6px;right:-6px;font-size:13px;\" onclick=\"event.stopPropagation()\">★</span></div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Servidor SSH</div>\n          <div class=\"server-name\" id=\"ssh-name\">Selecionar servidor</div>\n          <div class=\"server-sub\" id=\"ssh-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <!-- PAYLOAD CARD -->\n    <div class=\"card\" id=\"card-payload\" onclick=\"openSheet('payload')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\">📦</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Payload</div>\n          <div class=\"server-name\" id=\"payload-name\">Selecionar payload</div>\n          <div class=\"server-sub\" id=\"payload-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <!-- XRAY CARD -->\n    <div class=\"card\" id=\"card-xray\" style=\"display:none\" onclick=\"openSheet('xray')\">\n      <div class=\"server-card\">\n        <div class=\"server-icon\">⚡</div>\n        <div class=\"server-meta\">\n          <div class=\"server-label\">Perfil XRAY</div>\n          <div class=\"server-name\" id=\"xray-name\">Selecionar perfil</div>\n          <div class=\"server-sub\" id=\"xray-sub\">—</div>\n        </div>\n        <div class=\"server-chev\">›</div>\n      </div>\n    </div>\n\n    <!-- BOTÃO CONECTAR -->\n    <button class=\"connect-btn\" id=\"connect-btn\" onclick=\"doConnect()\">Conectar SSH</button>\n\n    <!-- MENSAGEM -->\n    <div class=\"card msg-card\" id=\"msg-card\" style=\"display:none\">\n      <div class=\"msg-dot\"></div>\n      <div class=\"msg-text\" id=\"msg-text\"></div>\n    </div>\n\n  </div><!-- /body -->\n\n  <!-- BOTTOM NAV -->\n  <nav class=\"bottom-nav\">\n    <button class=\"nav-btn active\" onclick=\"showMain()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>\n      <span>Início</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showLogs()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6M16 13H8\"/></svg>\n      <span>Logs</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"openSheet(app.mode === 'XRAY' ? 'xray' : 'ssh')\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/></svg>\n      <span>Servidores</span>\n    </button>\n    <button class=\"nav-btn\" onclick=\"showSettings()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <span>Config</span>\n    </button>\n  </nav>\n\n</div><!-- /shell -->\n\n<!-- TOAST -->\n<div class=\"toast\" id=\"toast\"></div>\n\n<!-- MODAL DE SAÍDA -->\n<div class=\"overlay exit-overlay\" id=\"exit-modal\" onclick=\"closeExitModal()\">\n  <div class=\"exit-modal\" onclick=\"event.stopPropagation()\">\n    <div class=\"exit-modal-badge\">👋 Até logo</div>\n    <div class=\"exit-modal-title\">Sair do <span id=\"exit-modal-appname\">app</span></div>\n    <div class=\"exit-modal-sub\">O que você deseja fazer?</div>\n    <button class=\"exit-modal-btn exit-modal-btn-minimize\" id=\"exit-modal-minimize\" onclick=\"exitModalMinimize()\">📱 Minimizar (rodando em segundo plano)</button>\n    <button class=\"exit-modal-btn exit-modal-btn-exit\" onclick=\"exitModalExit()\">🚪 Sair completamente</button>\n    <button class=\"exit-modal-btn exit-modal-btn-cancel\" onclick=\"closeExitModal()\">↩️ Cancelar</button>\n  </div>\n</div>\n\n<!-- SHEET SSH -->\n<div class=\"overlay\" id=\"sheet-ssh\" onclick=\"closeSheet('ssh')\">\n  <div class=\"sheet\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-handle\"></div>\n    <div class=\"sheet-title\">// Servidores SSH <span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n    <div id=\"ssh-list\"></div>\n  </div>\n</div>\n\n<!-- SHEET PAYLOAD -->\n<div class=\"overlay\" id=\"sheet-payload\" onclick=\"closeSheet('payload')\">\n  <div class=\"sheet\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-handle\"></div>\n    <div class=\"sheet-title\">// Payloads</div>\n    <div id=\"payload-list\"></div>\n  </div>\n</div>\n\n<!-- SHEET XRAY -->\n<div class=\"overlay\" id=\"sheet-xray\" onclick=\"closeSheet('xray')\">\n  <div class=\"sheet\" onclick=\"event.stopPropagation()\">\n    <div class=\"sheet-handle\"></div>\n    <div class=\"sheet-title\">// Perfis XRAY <span class=\"sheet-hint\">toque ★ pra favoritar</span></div>\n    <div id=\"xray-list\"></div>\n  </div>\n</div>\n\n<!-- PÁGINA DE LOGS -->\n<div class=\"logs-page\" id=\"logs-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">// Logs de Conexão</div>\n    <div class=\"logs-actions\">\n      <button class=\"logs-btn\" onclick=\"copyLogs()\">Copiar</button>\n      <button class=\"logs-btn\" onclick=\"clearLogs()\" style=\"color:var(--red);border-color:rgba(252,129,129,.3)\">Limpar</button>\n      <button class=\"logs-btn\" onclick=\"hideLogs()\">✕</button>\n    </div>\n  </div>\n  <div class=\"logs-body\" id=\"logs-body\">\n    <div class=\"logs-empty\"><span style=\"font-size:28px\">📋</span><span>Aguardando logs...</span></div>\n  </div>\n  <div class=\"logs-footer\">\n    <div class=\"autoscroll-toggle\">\n      <div class=\"switch on\" id=\"autoscroll-switch\" onclick=\"toggleAutoscroll()\"></div>\n      <span>Rolagem automática</span>\n    </div>\n  </div>\n</div>\n\n<!-- PÁGINA DE CONFIGURAÇÕES -->\n<div class=\"settings-page\" id=\"settings-page\">\n  <div class=\"logs-header\">\n    <div class=\"logs-title\">// Configurações</div>\n    <div class=\"logs-actions\">\n      <button class=\"logs-btn\" onclick=\"hideSettings()\">Fechar</button>\n    </div>\n  </div>\n  <div class=\"settings-body\">\n\n    <div class=\"settings-section-title\">🎨 Aparência</div>\n    <div class=\"palette-grid\" id=\"palette-grid\"></div>\n    <div class=\"bg-color-row\">\n      <div class=\"bg-color-label\">\n        <div class=\"setting-item-title\">Cor de fundo</div>\n        <div class=\"setting-item-sub\">Toque no círculo pra escolher</div>\n      </div>\n      <input type=\"color\" id=\"bg-color-input\" value=\"#050810\">\n      <button class=\"bg-color-reset\" onclick=\"resetBgColor()\">Padrão</button>\n    </div>\n\n    <div class=\"settings-section-title\">⚙️ Conexão</div>\n    <div class=\"setting-item\" onclick=\"toggleAutoConnect()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Conectar ao abrir o app</div>\n        <div class=\"setting-item-sub\">Usa o último servidor/perfil selecionado</div>\n      </div>\n      <div class=\"switch\" id=\"autoconnect-switch\"></div>\n    </div>\n    <div class=\"setting-item\" id=\"uuid-item\" onclick=\"promptUuid()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">UUID / Chave</div>\n        <div class=\"setting-item-sub\" id=\"uuid-sub\">Não configurado</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n\n    <div class=\"settings-section-title\">🛠️ Avançado</div>\n    <div class=\"setting-item\" onclick=\"doUpdate()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Atualizar Configuração</div>\n        <div class=\"setting-item-sub\">Buscar dados do servidor agora</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"if (B && B.openSettings) { B.openSettings(); } else { toast('Disponível só no app.'); }\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Configurações Avançadas</div>\n        <div class=\"setting-item-sub\">DNS, UDP, SSH, Sistema...</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div class=\"setting-item\" onclick=\"toggleDiagBox()\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      <div class=\"setting-item-meta\">\n        <div class=\"setting-item-title\">Diagnóstico</div>\n        <div class=\"setting-item-sub\">Gerar relatório pra suporte</div>\n      </div>\n      <span class=\"setting-item-chev\">›</span>\n    </div>\n    <div id=\"diag-wrap\" style=\"display:none\">\n      <div class=\"diag-box\" id=\"diag-box\"></div>\n      <button class=\"logs-btn\" style=\"width:100%;margin-top:8px;padding:10px;\" onclick=\"copyDiag()\">Copiar diagnóstico</button>\n    </div>\n\n  </div>\n</div>\n\n<script>\nvar B = window.VBBridge;\nvar app = {\n  mode: 'SSH',\n  connected: false,\n  connectTime: 0,\n  timerInt: null,\n  pollInt: null,\n  favorites: [],\n  autoscroll: true\n};\n\n/* ── BRIDGE HELPER ── */\nfunction bp(raw, fb) {\n  try { return JSON.parse(raw) || fb; } catch(e) { return fb; }\n}\n\n/* Alguns WebViews do Android deixam um \"fantasma\" do conteúdo anterior na\n   tela depois que o JS insere ou esconde/mostra elementos dinamicamente.\n   O texto antigo some, mas o WebView não repinta aquela área até o\n   próximo scroll - visualmente parece texto cortado ou sobreposto. Isso\n   força o repaint depois que o navegador já terminou de recalcular o\n   layout da mudança (por isso o duplo requestAnimationFrame). */\nfunction forceRepaint(el) {\n  if (!el) return;\n  requestAnimationFrame(function () {\n    requestAnimationFrame(function () {\n      el.style.transform = 'translateZ(0)';\n      void el.offsetHeight;\n      el.style.transform = '';\n    });\n  });\n}\n\n/* ── INIT ── */\nfunction init() {\n  if (!B) {\n    showMsg('Bridge não encontrado. Modo de preview.');\n    return;\n  }\n\n  if (B.isTamperDetected && B.isTamperDetected()) {\n    showTamperWarning();\n  }\n\n  var cfg = bp(B.getConfig(), {});\n  if (cfg.appName) document.getElementById('app-name').textContent = cfg.appName;\n  if (cfg.configVersion) document.getElementById('config-ver').textContent = 'v' + cfg.configVersion;\n  if (B.getHtmlVersion) document.getElementById('html-ver').textContent = 'h' + (B.getHtmlVersion() || '--');\n\n  if (cfg.notice && cfg.notice.enabled) {\n    showNoticeBar(cfg.notice.title || 'Aviso', cfg.notice.message || '');\n  }\n\n  var savedMode = B.getMode ? B.getMode() : 'SSH';\n  setMode(savedMode === 'XRAY' ? 'XRAY' : 'SSH', true);\n\n  var uuid = B.getUuid ? B.getUuid() : '';\n  if (uuid) document.getElementById('uuid-sub').textContent = uuid.substring(0,8) + '...';\n\n  initPalette();\n  initAutoConnectSwitch();\n  refreshFavorites();\n  refreshSelected();\n  updateNetBadge();\n\n  app.pollInt = setInterval(pollStatus, 1500);\n  setInterval(updateNetBadge, 5000);\n  pollStatus();\n\n  maybeAutoConnect();\n}\n\nfunction maybeAutoConnect() {\n  if (!B || !B.getAutoConnect) return;\n  if (!B.getAutoConnect()) return;\n  if (app.connected) return;\n  var st = bp(B.getStatus(), {});\n  if (st.connected) return;\n  setTimeout(function () { doConnect(); }, 600);\n}\n\n/* ── REDE ── */\nfunction updateNetBadge() {\n  if (!B || !B.getNetworkInfo) return;\n  try {\n    var info = bp(B.getNetworkInfo(), {});\n    var badge = document.getElementById('net-badge');\n    var label = document.getElementById('net-badge-text');\n    label.textContent = info.type || '--';\n    badge.classList.toggle('online', !!info.online);\n  } catch(e) {}\n}\n\n/* ── PING ── */\nfunction testPing() {\n  if (!B || !B.requestPing) return;\n  var target = currentTarget();\n  if (!target) { toast('Escolha um servidor primeiro'); return; }\n  var chip = document.getElementById('ping-chip');\n  var label = document.getElementById('ping-label');\n  chip.className = 'ping-chip loading';\n  label.textContent = 'Testando...';\n  B.requestPing(target.host, target.port);\n}\n\nfunction currentTarget() {\n  try {\n    if (app.mode === 'XRAY') {\n      var x = bp(B.getSelectedXray(), {});\n      if (x.host && x.port) return { host: x.host, port: x.port };\n    } else {\n      var s = bp(B.getSelectedServer(), {});\n      if (s.host && s.port) return { host: s.host, port: s.port };\n    }\n  } catch(e) {}\n  return null;\n}\n\nwindow.onVBPingResult = function(result) {\n  var chip = document.getElementById('ping-chip');\n  var label = document.getElementById('ping-label');\n  if (result && result.ok) {\n    var ms = result.ms;\n    var quality = ms < 150 ? 'ok' : (ms < 400 ? '' : 'bad');\n    chip.className = 'ping-chip ' + quality;\n    label.innerHTML = '<span class=\"ping-val\">' + ms + 'ms</span> até o servidor';\n  } else {\n    chip.className = 'ping-chip bad';\n    label.textContent = 'Falha na conexão';\n  }\n};\n\n/* ── FAVORITOS ── */\nfunction refreshFavorites() {\n  if (!B || !B.getFavorites) return;\n  app.favorites = bp(B.getFavorites(), []);\n  var starEl = document.getElementById('ssh-fav');\n  if (starEl) starEl.style.display = '';\n}\n\nfunction isFavorite(id) {\n  return app.favorites.indexOf(id) !== -1;\n}\n\nfunction toggleFavoriteItem(id, evt) {\n  if (evt) evt.stopPropagation();\n  if (!B || !B.toggleFavorite) return;\n  B.toggleFavorite(id);\n  refreshFavorites();\n  if (currentOpenSheet) openSheet(currentOpenSheet);\n}\n\n/* ── POLLING DE STATUS ── */\nfunction pollStatus() {\n  if (!B) return;\n  try {\n    var st = bp(B.getStatus(), {});\n    var connected = !!st.connected;\n    var mode = st.mode || app.mode;\n\n    if (connected !== app.connected) {\n      app.connected = connected;\n      applyConnected(connected, mode, st.connectedAt);\n    }\n  } catch(e) {}\n}\n\nfunction applyConnected(on, mode, connectedAt) {\n  document.body.classList.toggle('connected', on);\n  document.body.classList.remove('connecting');\n\n  var label = document.getElementById('orb-label');\n  var sub = document.getElementById('orb-sub');\n  var btn = document.getElementById('connect-btn');\n  var timer = document.getElementById('timer');\n  var speed = document.getElementById('speed-row');\n\n  if (on) {\n    label.textContent = 'CONECTADO';\n    sub.textContent = (mode || app.mode) + ' ativo';\n    btn.textContent = 'Desconectar';\n    timer.classList.add('show');\n    speed.style.display = 'grid';\n    app.connectTime = (connectedAt && connectedAt > 0) ? connectedAt : Date.now();\n    updateTimer();\n    if (app.timerInt) clearInterval(app.timerInt);\n    app.timerInt = setInterval(updateTimer, 1000);\n  } else {\n    label.textContent = 'DESCONECTADO';\n    sub.textContent = 'Toque para conectar';\n    btn.textContent = 'Conectar ' + app.mode;\n    timer.classList.remove('show');\n    speed.style.display = 'none';\n    document.getElementById('speed-dl').textContent = '0 B/s';\n    document.getElementById('speed-ul').textContent = '0 B/s';\n    if (app.timerInt) clearInterval(app.timerInt);\n  }\n  forceRepaint(document.getElementById('main-body'));\n}\n\nfunction updateTimer() {\n  var s = Math.floor((Date.now() - app.connectTime) / 1000);\n  var h = Math.floor(s / 3600);\n  var m = Math.floor((s % 3600) / 60);\n  var sec = s % 60;\n  document.getElementById('timer-val').textContent = pad(h) + ':' + pad(m) + ':' + pad(sec);\n}\nfunction pad(n) { return n < 10 ? '0' + n : '' + n; }\n\n/* ── AÇÕES ── */\nfunction doConnect() {\n  if (!B) { toast('Bridge não disponível'); return; }\n  document.body.classList.add('connecting');\n  document.getElementById('orb-label').textContent = 'CONECTANDO...';\n  document.getElementById('orb-sub').textContent = 'Aguarde...';\n  document.getElementById('connect-btn').textContent = 'Aguarde...';\n  B.connect();\n}\n\nfunction doUpdate() {\n  if (!B) { toast('Bridge não disponível'); return; }\n  var icon = document.getElementById('refresh-btn');\n  icon.classList.add('spinning');\n  toast('Atualizando configuração...');\n  B.updateConfig();\n  setTimeout(function() {\n    init();\n    icon.classList.remove('spinning');\n    toast('Configuração atualizada!');\n  }, 3000);\n}\n\n/* ── MODO ── */\nfunction setMode(m, silent) {\n  app.mode = m;\n  document.getElementById('mode-ssh').classList.toggle('active', m === 'SSH');\n  document.getElementById('mode-xray').classList.toggle('active', m === 'XRAY');\n  document.getElementById('card-ssh').style.display = m === 'SSH' ? '' : 'none';\n  document.getElementById('card-payload').style.display = m === 'SSH' ? '' : 'none';\n  document.getElementById('card-xray').style.display = m === 'XRAY' ? '' : 'none';\n  document.getElementById('connect-btn').textContent = (app.connected ? 'Desconectar' : 'Conectar ' + m);\n  if (!silent && B) B.setMode(m);\n  updateCredCard();\n  updateUuidCard();\n  resetPingChip();\n  forceRepaint(document.getElementById('main-body'));\n}\n\nfunction resetPingChip() {\n  var chip = document.getElementById('ping-chip');\n  if (!chip) return;\n  chip.className = 'ping-chip';\n  document.getElementById('ping-label').textContent = 'Testar conexão';\n}\n\n/* ── CREDENCIAL SSH ── */\nfunction ensureCredCard() {\n  if (document.getElementById('card-cred')) return;\n  var anchor = document.getElementById('card-payload');\n  if (!anchor || !anchor.parentNode) return;\n\n  var div = document.createElement('div');\n  div.className = 'card';\n  div.id = 'card-cred';\n  div.style.display = 'none';\n  div.innerHTML =\n    '<div class=\"cred-card\">' +\n      '<div class=\"cred-label\">👤 Usuário</div>' +\n      '<input type=\"text\" id=\"cred-user\" class=\"cred-input\" placeholder=\"Digite o usuário\" autocomplete=\"off\">' +\n      '<div class=\"cred-label\">🔒 Senha</div>' +\n      '<div style=\"position:relative;\">' +\n        '<input type=\"password\" id=\"cred-pass\" class=\"cred-input\" placeholder=\"Digite a senha\" style=\"padding-right:42px;\">' +\n        '<span id=\"cred-pass-toggle\" style=\"position:absolute; right:12px; top:50%; transform:translateY(-50%); cursor:pointer; font-size:15px; user-select:none;\">👁️</span>' +\n      '</div>' +\n    '</div>';\n  anchor.parentNode.insertBefore(div, anchor.nextSibling);\n  forceRepaint(anchor.parentNode);\n\n  var userInput = document.getElementById('cred-user');\n  var passInput = document.getElementById('cred-pass');\n  userInput.addEventListener('input', saveCredField);\n  passInput.addEventListener('input', saveCredField);\n  userInput.addEventListener('focus', function () { scrollFieldIntoView(userInput); });\n  passInput.addEventListener('focus', function () { scrollFieldIntoView(passInput); });\n  document.getElementById('cred-pass-toggle').addEventListener('click', function () {\n    var showing = passInput.type === 'text';\n    passInput.type = showing ? 'password' : 'text';\n    this.textContent = showing ? '👁️' : '🙈';\n  });\n\n  var saved = bp(B && B.getManualCredentials ? B.getManualCredentials() : '{}', {});\n  if (saved.username) userInput.value = saved.username;\n  if (saved.password) passInput.value = saved.password;\n}\n\nfunction scrollFieldIntoView(input) {\n  setTimeout(function () {\n    input.scrollIntoView({ behavior: 'smooth', block: 'center' });\n  }, 300);\n}\n\nfunction updateCredCard() {\n  if (!B) return;\n  ensureCredCard();\n  var card = document.getElementById('card-cred');\n  if (!card) return;\n  var srv = bp(B.getSelectedServer(), {});\n  var needsCred = app.mode === 'SSH' && srv.name && !srv.hasCredentials;\n  card.style.display = needsCred ? '' : 'none';\n  forceRepaint(card.parentNode);\n}\n\nfunction saveCredField() {\n  if (B && B.setManualCredentials) {\n    B.setManualCredentials(document.getElementById('cred-user').value, document.getElementById('cred-pass').value);\n  }\n}\n\n/* ── CREDENCIAL XRAY (UUID) ── */\nfunction ensureUuidCard() {\n  if (document.getElementById('card-uuid')) return;\n  var anchor = document.getElementById('card-xray');\n  if (!anchor || !anchor.parentNode) return;\n\n  var div = document.createElement('div');\n  div.className = 'card';\n  div.id = 'card-uuid';\n  div.style.display = 'none';\n  div.innerHTML =\n    '<div class=\"cred-card\">' +\n      '<div class=\"cred-label\">🔑 UUID / Chave de ativação</div>' +\n      '<input type=\"text\" id=\"xray-uuid-input\" class=\"cred-input\" placeholder=\"Cole o UUID aqui\" autocomplete=\"off\">' +\n    '</div>';\n  anchor.parentNode.insertBefore(div, anchor.nextSibling);\n  forceRepaint(anchor.parentNode);\n\n  var uuidInput = document.getElementById('xray-uuid-input');\n  uuidInput.addEventListener('input', function () {\n    if (B && B.setUuid) B.setUuid(uuidInput.value.trim());\n  });\n  uuidInput.addEventListener('focus', function () { scrollFieldIntoView(uuidInput); });\n  uuidInput.value = (B && B.getUuid) ? B.getUuid() : '';\n}\n\nfunction updateUuidCard() {\n  if (!B) return;\n  ensureUuidCard();\n  var card = document.getElementById('card-uuid');\n  if (!card) return;\n  var xr = bp(B.getSelectedXray(), {});\n  var needsUuid = app.mode === 'XRAY' && xr.name && xr.uuidRequired && !xr.hasUuid;\n  card.style.display = needsUuid ? '' : 'none';\n  forceRepaint(card.parentNode);\n}\n\n/* ── SELEÇÃO ATUAL ── */\nfunction refreshSelected() {\n  if (!B) return;\n  try {\n    var srv = bp(B.getSelectedServer(), {});\n    if (srv.name) {\n      document.getElementById('ssh-name').textContent = srv.name;\n      document.getElementById('ssh-sub').textContent = (srv.country || '') + ' · ' + (srv.operator || '');\n    }\n  } catch(e) {}\n  try {\n    var pld = bp(B.getSelectedPayload(), {});\n    if (pld.name) {\n      document.getElementById('payload-name').textContent = pld.name;\n      document.getElementById('payload-sub').textContent = pld.operator || '';\n    }\n  } catch(e) {}\n  try {\n    var xr = bp(B.getSelectedXray(), {});\n    if (xr.name) {\n      document.getElementById('xray-name').textContent = xr.name;\n      document.getElementById('xray-sub').textContent = (xr.protocol || '').toUpperCase() + ' · ' + (xr.security || '');\n    }\n  } catch(e) {}\n  updateCredCard();\n  updateUuidCard();\n  forceRepaint(document.getElementById('main-body'));\n}\n\n/* ── SHEETS ── */\nvar currentOpenSheet = null;\n\nfunction openSheet(type) {\n  if (!B) return;\n  currentOpenSheet = type;\n  var overlay = document.getElementById('sheet-' + type);\n  overlay.classList.add('show');\n\n  if (type === 'ssh') buildList('ssh-list', bp(B.getServers(), []), function(item, i) {\n    B.selectServer(item.id);\n    document.getElementById('ssh-name').textContent = item.name;\n    document.getElementById('ssh-sub').textContent = (item.country || '') + ' · ' + (item.operator || '');\n    updateCredCard();\n    resetPingChip();\n    closeSheet('ssh'); toast('Servidor: ' + item.name);\n  }, function(item) {\n    return item.name + '|' + (item.operator || '') + ' · ' + (item.method || '') + '|' + (item.selected ? 'selected' : '');\n  });\n\n  if (type === 'payload') buildList('payload-list', bp(B.getPayloads(), []), function(item, i) {\n    B.selectPayload(item.id);\n    document.getElementById('payload-name').textContent = item.name;\n    document.getElementById('payload-sub').textContent = item.operator || '';\n    closeSheet('payload'); toast('Payload: ' + item.name);\n  }, function(item) {\n    return item.name + '|' + (item.operator || '') + ' · ' + (item.networkType || '') + '|' + (item.selected ? 'selected' : '');\n  });\n\n  if (type === 'xray') buildList('xray-list', bp(B.getXrayProfiles(), []), function(item, i) {\n    B.selectXray(item.id);\n    document.getElementById('xray-name').textContent = item.name;\n    document.getElementById('xray-sub').textContent = (item.protocol || '').toUpperCase() + ' · ' + (item.security || '');\n    updateUuidCard();\n    resetPingChip();\n    closeSheet('xray'); toast('Perfil: ' + item.name);\n  }, function(item) {\n    return item.name + '|' + (item.protocol || '').toUpperCase() + ' · ' + (item.security || '')+ '|' + (item.selected ? 'selected' : '');\n  });\n}\n\nfunction buildList(containerId, items, onSelect, getInfo) {\n  var el = document.getElementById(containerId);\n  el.innerHTML = '';\n  if (!items.length) { el.innerHTML = '<div style=\"padding:20px;text-align:center;color:var(--muted2);font-size:12px;\">Nenhum item disponível</div>'; return; }\n\n  // Favoritos primeiro, sem embaralhar a ordem original dentro de cada grupo.\n  var sorted = items.slice().sort(function(a, b) {\n    var fa = isFavorite(a.id) ? 1 : 0;\n    var fb = isFavorite(b.id) ? 1 : 0;\n    return fb - fa;\n  });\n\n  sorted.forEach(function(item, i) {\n    var info = getInfo(item).split('|');\n    var div = document.createElement('div');\n    div.className = 'sheet-item' + (info[2] === 'selected' ? ' selected' : '');\n    div.innerHTML = '<div class=\"sheet-item-icon\">📡</div>'\n      + '<div class=\"sheet-item-meta\"><div class=\"sheet-item-name\">' + escHtml(info[0]||'') + '</div>'\n      + '<div class=\"sheet-item-sub\">' + escHtml(info[1]||'') + '</div></div>'\n      + '<span class=\"fav-star' + (isFavorite(item.id) ? ' active' : '') + '\" data-id=\"' + item.id + '\">★</span>'\n      + '<svg class=\"sheet-item-check\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" width=\"18\" height=\"18\"><polyline points=\"20 6 9 17 4 12\"/></svg>';\n    div.onclick = function() { onSelect(item, i); };\n    var star = div.querySelector('.fav-star');\n    star.onclick = function(e) { toggleFavoriteItem(item.id, e); };\n    el.appendChild(div);\n  });\n}\n\nfunction closeSheet(type) {\n  document.getElementById('sheet-' + type).classList.remove('show');\n  currentOpenSheet = null;\n}\n\n/* ── LOGS ── */\nvar logsRefreshInt = null;\n\nfunction showLogs() {\n  document.getElementById('logs-page').classList.add('show');\n  loadLogs();\n  if (logsRefreshInt) clearInterval(logsRefreshInt);\n  logsRefreshInt = setInterval(loadLogs, 2000);\n}\nfunction hideLogs() {\n  document.getElementById('logs-page').classList.remove('show');\n  if (logsRefreshInt) { clearInterval(logsRefreshInt); logsRefreshInt = null; }\n}\n\nfunction toggleAutoscroll() {\n  app.autoscroll = !app.autoscroll;\n  document.getElementById('autoscroll-switch').classList.toggle('on', app.autoscroll);\n}\n\nfunction loadLogs() {\n  if (!B || !B.getLogs) return;\n  var lines = bp(B.getLogs(), []);\n  var body = document.getElementById('logs-body');\n  if (!lines.length) {\n    body.innerHTML = '<div class=\"logs-empty\"><span style=\"font-size:28px\">📋</span><span>Aguardando logs...</span></div>';\n    return;\n  }\n  var html = '';\n  lines.forEach(function(line) {\n    var cls = 'info';\n    var low = (line.text || line).toLowerCase();\n    if (low.indexOf('✅') !== -1 || low.indexOf('conectado') !== -1) cls = 'ok';\n    else if (low.indexOf('⚠️') !== -1 || low.indexOf('falha') !== -1 || low.indexOf('erro') !== -1) cls = 'err';\n    else if (low.indexOf('━') !== -1) cls = 'sep';\n    var time = line.time || '';\n    var text = line.text || line;\n    html += '<div class=\"log-line ' + cls + '\">'\n      + (time ? '<span class=\"log-time\">[' + escHtml(time) + ']</span>' : '')\n      + '<span class=\"log-msg\">' + escHtml(text) + '</span></div>';\n  });\n  body.innerHTML = html;\n  if (app.autoscroll) body.scrollTop = body.scrollHeight;\n}\n\nfunction copyLogs() {\n  if (!B) return;\n  try {\n    var lines = bp(B.getLogs(), []);\n    var text = lines.map(function(l) { return (l.time ? '[' + l.time + '] ' : '') + (l.text || l); }).join('\\n');\n    if (navigator.clipboard) navigator.clipboard.writeText(text);\n    toast('Logs copiados!');\n  } catch(e) { toast('Erro ao copiar'); }\n}\nfunction clearLogs() {\n  if (B) B.clearLogs();\n  document.getElementById('logs-body').innerHTML = '<div class=\"log-line info\">Logs limpos.</div>';\n  toast('Logs limpos');\n}\n\n/* ── SETTINGS ── */\nfunction showSettings() {\n  document.getElementById('settings-page').classList.add('show');\n  initAutoConnectSwitch();\n}\nfunction hideSettings() { document.getElementById('settings-page').classList.remove('show'); }\n\nfunction initAutoConnectSwitch() {\n  if (!B || !B.getAutoConnect) return;\n  var sw = document.getElementById('autoconnect-switch');\n  if (sw) sw.classList.toggle('on', !!B.getAutoConnect());\n}\nfunction toggleAutoConnect() {\n  if (!B || !B.setAutoConnect) return;\n  var sw = document.getElementById('autoconnect-switch');\n  var newVal = !sw.classList.contains('on');\n  sw.classList.toggle('on', newVal);\n  B.setAutoConnect(newVal);\n  toast(newVal ? 'Vai conectar ao abrir o app' : 'Auto-conectar desativado');\n}\n\n/* ── DIAGNÓSTICO ── */\nfunction toggleDiagBox() {\n  var wrap = document.getElementById('diag-wrap');\n  var show = wrap.style.display === 'none';\n  wrap.style.display = show ? '' : 'none';\n  if (show) buildDiag();\n}\nfunction buildDiag() {\n  if (!B) return;\n  var cfg = bp(B.getConfig(), {});\n  var srv = bp(B.getSelectedServer(), {});\n  var xr = bp(B.getSelectedXray(), {});\n  var pld = bp(B.getSelectedPayload(), {});\n  var st = bp(B.getStatus(), {});\n  var net = bp(B.getNetworkInfo ? B.getNetworkInfo() : '{}', {});\n  var lines = [\n    '=== VB Injector — Diagnóstico ===',\n    'App: ' + (cfg.appName || '-') + ' (v' + (cfg.configVersion || '-') + ', h' + (B.getHtmlVersion ? B.getHtmlVersion() : '-') + ')',\n    'Modo: ' + app.mode,\n    'Status: ' + (st.connected ? 'Conectado' : 'Desconectado'),\n    'Rede: ' + (net.type || '-'),\n    '',\n    '— SSH —',\n    'Servidor: ' + (srv.name || '-') + ' (' + (srv.host || '-') + ':' + (srv.port || '-') + ')',\n    'Payload: ' + (pld.name || '-'),\n    '',\n    '— XRAY —',\n    'Perfil: ' + (xr.name || '-') + ' (' + (xr.protocol || '-') + ' · ' + (xr.security || '-') + ')',\n    'Host: ' + (xr.host || '-') + ':' + (xr.port || '-')\n  ];\n  document.getElementById('diag-box').textContent = lines.join('\\n');\n}\nfunction copyDiag() {\n  var text = document.getElementById('diag-box').textContent;\n  if (navigator.clipboard) navigator.clipboard.writeText(text);\n  toast('Diagnóstico copiado!');\n}\n\n/* ── PALETA DE CORES ── */\nvar PALETTES = [\n  { id: 'escuro',   label: 'Escuro',   accent: '#63b3ed', accent2: '#4299e1' },\n  { id: 'gustavo',  label: 'Gustavo',  accent: '#22C77A', accent2: '#2EB8F5' },\n  { id: 'azul',     label: 'Azul',     accent: '#3b82f6', accent2: '#06b6d4' },\n  { id: 'vermelho', label: 'Vermelho', accent: '#f87171', accent2: '#fb923c' },\n  { id: 'dourado',  label: 'Dourado',  accent: '#fbbf24', accent2: '#f59e0b' },\n  { id: 'neon',     label: 'Neon',     accent: '#34d399', accent2: '#10b981' },\n  { id: 'rosa',     label: 'Rosa',     accent: '#ec4899', accent2: '#a855f7' },\n  { id: 'aurora',   label: 'Aurora ✨', accent: '#a78bfa', accent2: '#22d3ee' }\n];\n\nfunction hexToHsl(hex) {\n  var rgb = hexToRgb(hex);\n  var r = rgb.r / 255, g = rgb.g / 255, b = rgb.b / 255;\n  var max = Math.max(r, g, b), min = Math.min(r, g, b);\n  var h, s, l = (max + min) / 2;\n  if (max === min) { h = 0; s = 0; }\n  else {\n    var d = max - min;\n    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);\n    if (max === r) h = (g - b) / d + (g < b ? 6 : 0);\n    else if (max === g) h = (b - r) / d + 2;\n    else h = (r - g) / d + 4;\n    h /= 6;\n  }\n  return { h: h * 360, s: s * 100, l: l * 100 };\n}\n\nfunction applyPalette(id) {\n  var p = PALETTES.find(function(x){ return x.id === id; }) || PALETTES[0];\n  var hue = hexToHsl(p.accent).h;\n\n  document.documentElement.style.setProperty('--accent', p.accent);\n  document.documentElement.style.setProperty('--accent2', p.accent2);\n  document.documentElement.style.setProperty('--bg', 'hsl(' + hue + ',42%,5%)');\n  document.documentElement.style.setProperty('--surface', 'hsl(' + hue + ',36%,9%)');\n  document.documentElement.style.setProperty('--surface2', 'hsl(' + hue + ',30%,14%)');\n  document.documentElement.style.setProperty('--border', 'hsla(' + hue + ',70%,62%,0.20)');\n  document.documentElement.style.setProperty('--text', 'hsl(' + hue + ',22%,93%)');\n  document.documentElement.style.setProperty('--muted', 'hsl(' + hue + ',18%,40%)');\n  document.documentElement.style.setProperty('--muted2', 'hsl(' + hue + ',20%,58%)');\n}\n\nfunction selectPalette(id) {\n  applyPalette(id);\n  if (B && B.setThemePalette) B.setThemePalette(id);\n  renderPaletteGrid(id);\n  resetBgColor();\n}\n\nfunction renderPaletteGrid(selectedId) {\n  var grid = document.getElementById('palette-grid');\n  if (!grid) return;\n  grid.innerHTML = '';\n  PALETTES.forEach(function(p) {\n    var item = document.createElement('div');\n    item.className = 'palette-item' + (p.id === selectedId ? ' selected' : '');\n    item.onclick = function() { selectPalette(p.id); };\n    var circle = document.createElement('div');\n    circle.className = 'palette-circle';\n    circle.style.background = 'linear-gradient(135deg, ' + p.accent + ' 50%, ' + p.accent2 + ' 50%)';\n    var check = document.createElement('div');\n    check.className = 'check';\n    check.textContent = '✓';\n    circle.appendChild(check);\n    var label = document.createElement('div');\n    label.className = 'palette-label';\n    label.textContent = p.label;\n    item.appendChild(circle);\n    item.appendChild(label);\n    grid.appendChild(item);\n  });\n}\n\nfunction initPalette() {\n  var saved = (B && B.getThemePalette) ? B.getThemePalette() : 'escuro';\n  applyPalette(saved);\n  renderPaletteGrid(saved);\n\n  var savedBg = (B && B.getBgColor) ? B.getBgColor() : '';\n  if (savedBg) {\n    applyBgColor(savedBg);\n    document.getElementById('bg-color-input').value = savedBg;\n  }\n  document.getElementById('bg-color-input').addEventListener('input', function(e) {\n    applyBgColor(e.target.value);\n    if (B && B.setBgColor) B.setBgColor(e.target.value);\n  });\n}\n\nfunction hexToRgb(hex) {\n  var c = hex.replace('#', '');\n  if (c.length === 3) c = c.split('').map(function(ch){ return ch + ch; }).join('');\n  return {\n    r: parseInt(c.substring(0,2), 16),\n    g: parseInt(c.substring(2,4), 16),\n    b: parseInt(c.substring(4,6), 16)\n  };\n}\n\nfunction lighten(hex, amt) {\n  var rgb = hexToRgb(hex);\n  var r = Math.min(255, rgb.r + amt);\n  var g = Math.min(255, rgb.g + amt);\n  var b = Math.min(255, rgb.b + amt);\n  return '#' + [r, g, b].map(function(v) {\n    return Math.round(v).toString(16).padStart(2, '0');\n  }).join('');\n}\n\nfunction applyBgColor(hex) {\n  document.documentElement.style.setProperty('--bg', hex);\n  document.documentElement.style.setProperty('--surface', lighten(hex, 12));\n  document.documentElement.style.setProperty('--surface2', lighten(hex, 22));\n}\n\nfunction resetBgColor() {\n  document.getElementById('bg-color-input').value = '#050810';\n  if (B && B.setBgColor) B.setBgColor('');\n  var current = (B && B.getThemePalette) ? B.getThemePalette() : 'escuro';\n  applyPalette(current);\n}\n\nfunction promptUuid() {\n  var cur = B ? B.getUuid() : '';\n  var val = prompt('UUID / Chave de ativação:', cur);\n  if (val !== null && B) {\n    B.setUuid(val.trim());\n    document.getElementById('uuid-sub').textContent = val ? val.substring(0,8) + '...' : 'Não configurado';\n    toast('UUID salvo!');\n  }\n}\n\n/* ── MAIN ── */\nfunction showMain() {\n  document.getElementById('logs-page').classList.remove('show');\n  document.getElementById('settings-page').classList.remove('show');\n  if (logsRefreshInt) { clearInterval(logsRefreshInt); logsRefreshInt = null; }\n}\n\n/* ── MENSAGEM ── */\nfunction showMsg(msg) {\n  var card = document.getElementById('msg-card');\n  var text = document.getElementById('msg-text');\n  card.style.display = 'flex';\n  text.textContent = msg;\n}\n\n/* ── AVISO ── */\nfunction showNoticeBar(title, message) {\n  var bar = document.getElementById('notice-bar');\n  if (!bar) return;\n  document.getElementById('notice-title').textContent = title;\n  document.getElementById('notice-msg').textContent = message;\n  bar.classList.add('show');\n}\n\n/* ── TOAST ── */\nfunction toast(msg) {\n  var el = document.getElementById('toast');\n  el.textContent = msg;\n  el.classList.add('show');\n  setTimeout(function() { el.classList.remove('show'); }, 2500);\n}\n\n/* ── MODAL DE SAÍDA ── */\nfunction showExitModal(connected) {\n  document.getElementById('exit-modal-minimize').style.display = connected ? '' : 'none';\n  document.getElementById('exit-modal-appname').textContent = document.getElementById('app-name').textContent || 'app';\n  document.getElementById('exit-modal').classList.add('show');\n}\nfunction closeExitModal() {\n  document.getElementById('exit-modal').classList.remove('show');\n}\nfunction exitModalMinimize() {\n  closeExitModal();\n  if (B && B.minimizeApp) B.minimizeApp();\n}\nfunction exitModalExit() {\n  closeExitModal();\n  if (B && B.disconnect) B.disconnect();\n  if (B && B.close) B.close();\n}\n\n/* ── CALLBACKS DO APP ── */\nwindow.onVBStatus = function(s) {\n  var connected = !!s.connected;\n  var mode = s.mode || app.mode;\n  if (connected !== app.connected) {\n    app.connected = connected;\n    applyConnected(connected, mode, s.connectedAt);\n  }\n  if (s.downloadText) document.getElementById('speed-dl').textContent = s.downloadText;\n  if (s.uploadText) document.getElementById('speed-ul').textContent = s.uploadText;\n};\nwindow.onVBMessage = function(msg) { toast(msg); };\n\n/* ── UTILS ── */\nfunction escHtml(s) {\n  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n}\n\nfunction showTamperWarning() {\n  var overlay = document.createElement('div');\n  overlay.style.cssText = 'position:fixed; inset:0; z-index:500; background:rgba(2,5,10,.82); display:flex; align-items:center; justify-content:center; padding:24px;';\n\n  var card = document.createElement('div');\n  card.style.cssText = 'width:100%; max-width:340px; background:linear-gradient(160deg,#101a2e,#0a121f); border:1px solid rgba(255,140,60,.35); border-radius:18px; padding:24px 22px; box-shadow:0 20px 60px rgba(0,0,0,.5);';\n\n  card.innerHTML =\n    '<div style=\"display:flex; align-items:center; gap:10px; margin-bottom:14px;\">' +\n      '<span style=\"font-size:22px;\">⚠️</span>' +\n      '<span style=\"font-size:15px; font-weight:800; color:#ffb35c; letter-spacing:.3px;\">Aviso de Segurança</span>' +\n    '</div>' +\n    '<div style=\"font-size:13.5px; line-height:1.55; color:#c4cdda;\">' +\n      'Foi detectada uma modificação não autorizada neste aplicativo.<br><br>' +\n      'Esta cópia não é oficial e pode conter alterações que comprometem a segurança e o funcionamento correto do app.' +\n    '</div>' +\n    '<button id=\"tamper-close-btn\" style=\"margin-top:20px; width:100%; padding:12px; border:none; border-radius:10px; background:linear-gradient(120deg,#ff8c3c,#ff5f6d); color:#1a0e06; font-weight:800; font-size:13px; letter-spacing:.5px; cursor:pointer;\">ENTENDI</button>';\n\n  overlay.appendChild(card);\n  document.body.appendChild(overlay);\n\n  document.getElementById('tamper-close-btn').addEventListener('click', function () {\n    overlay.remove();\n  });\n}\n\n/* ── START ── */\ndocument.addEventListener('DOMContentLoaded', init);\n</script>\n</body>\n</html>\n"}
